@model TrackerKerja.ViewModels.AnnouncementIndexViewModel
@{
    ViewData["Title"] = "Kelola Pengumuman";
    var today = DateTime.Today;
}

<div class="space-y-6 max-w-7xl mx-auto animate-fade-in">
    @Html.AntiForgeryToken()

    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-rose-500 to-pink-600 text-white flex items-center justify-center shadow-lg shadow-rose-500/25">
                <i class="fas fa-bullhorn text-xl"></i>
            </div>
            <div>
                <h1 class="text-2xl font-black text-slate-800 dark:text-white">Kelola Pengumuman</h1>
                <p class="text-slate-500 dark:text-slate-400 text-xs mt-0.5">Kelola informasi penting & pengumuman umum yang muncul sebagai modal popup ke semua pengguna</p>
            </div>
        </div>

        <div class="flex items-center gap-2.5">
            <a href="/Announcement/Create"
               class="flex items-center gap-2 bg-gradient-to-r from-rose-600 to-pink-600 hover:from-rose-700 hover:to-pink-700 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow-md shadow-rose-500/20 transition-all cursor-pointer">
                <i class="fas fa-plus"></i>
                <span>Tambah Pengumuman</span>
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200 text-xs font-semibold flex items-center gap-3">
            <i class="fas fa-check-circle text-base text-emerald-600"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800 text-red-800 dark:text-red-200 text-xs font-semibold flex items-center gap-3">
            <i class="fas fa-exclamation-circle text-base text-red-600"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Stat Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3.5">
        <!-- Total -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl p-4 border border-slate-200/80 dark:border-slate-700 shadow-2xs">
            <div class="flex items-center justify-between mb-2">
                <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Total</span>
                <div class="w-7 h-7 rounded-lg bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 flex items-center justify-center text-xs">
                    <i class="fas fa-list"></i>
                </div>
            </div>
            <p class="text-2xl font-black text-slate-800 dark:text-white">@Model.TotalCount</p>
            <span class="text-[11px] text-slate-400">Seluruh pengumuman</span>
        </div>

        <!-- Sedang Tayang -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl p-4 border border-emerald-100 dark:border-emerald-900/40 shadow-2xs">
            <div class="flex items-center justify-between mb-2">
                <span class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">Sedang Tayang</span>
                <div class="w-7 h-7 rounded-lg bg-emerald-50 dark:bg-emerald-900/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xs">
                    <i class="fas fa-broadcast-tower"></i>
                </div>
            </div>
            <p class="text-2xl font-black text-emerald-600 dark:text-emerald-400">@Model.ActiveCount</p>
            <span class="text-[11px] text-slate-400">Muncul di modal pengguna</span>
        </div>

        <!-- Informasi Penting -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl p-4 border border-rose-100 dark:border-rose-900/40 shadow-2xs">
            <div class="flex items-center justify-between mb-2">
                <span class="text-[11px] font-bold text-rose-600 dark:text-rose-400 uppercase tracking-wider">Informasi Penting</span>
                <div class="w-7 h-7 rounded-lg bg-rose-50 dark:bg-rose-900/40 text-rose-600 dark:text-rose-400 flex items-center justify-center text-xs">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
            </div>
            <p class="text-2xl font-black text-rose-600 dark:text-rose-400">@Model.ImportantCount</p>
            <span class="text-[11px] text-slate-400">Prioritas tinggi / mendesak</span>
        </div>

        <!-- Pengumuman Umum -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl p-4 border border-indigo-100 dark:border-indigo-900/40 shadow-2xs">
            <div class="flex items-center justify-between mb-2">
                <span class="text-[11px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider">Pengumuman Umum</span>
                <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-900/40 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-xs">
                    <i class="fas fa-bullhorn"></i>
                </div>
            </div>
            <p class="text-2xl font-black text-indigo-600 dark:text-indigo-400">@Model.GeneralCount</p>
            <span class="text-[11px] text-slate-400">Informasi standar</span>
        </div>

        <!-- Kedaluwarsa -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl p-4 border border-amber-100 dark:border-amber-900/40 shadow-2xs">
            <div class="flex items-center justify-between mb-2">
                <span class="text-[11px] font-bold text-amber-600 dark:text-amber-400 uppercase tracking-wider">Kedaluwarsa</span>
                <div class="w-7 h-7 rounded-lg bg-amber-50 dark:bg-amber-900/40 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xs">
                    <i class="fas fa-clock-rotate-left"></i>
                </div>
            </div>
            <p class="text-2xl font-black text-amber-600 dark:text-amber-400">@Model.ExpiredCount</p>
            <span class="text-[11px] text-slate-400">Melewati tanggal berakhir</span>
        </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="bg-white dark:bg-slate-800 rounded-2xl p-4 border border-slate-200/80 dark:border-slate-700 shadow-2xs">
        <form method="get" action="/Announcement/Index" class="flex flex-col md:flex-row items-center gap-3">
            <!-- Search -->
            <div class="relative flex-1 w-full">
                <i class="fas fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input type="text" name="search" value="@Model.Search" placeholder="Cari judul atau isi pengumuman..."
                       class="w-full pl-9 pr-4 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-xs text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-rose-500 transition-all">
            </div>

            <!-- Status Filter -->
            <div class="w-full md:w-48">
                <select name="statusFilter" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-xs text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-rose-500">
                    <option value="">Semua Status</option>
                    <option value="Informasi Penting" selected="@(Model.StatusFilter == "Informasi Penting")">🚨 Informasi Penting</option>
                    <option value="Pengumuman Umum" selected="@(Model.StatusFilter == "Pengumuman Umum")">📢 Pengumuman Umum</option>
                </select>
            </div>

            <!-- Active / Date Filter -->
            <div class="w-full md:w-48">
                <select name="activeFilter" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-xs text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-rose-500">
                    <option value="">Semua Kondisi</option>
                    <option value="active" selected="@(Model.ActiveFilter == "active")">🟢 Sedang Tayang</option>
                    <option value="inactive" selected="@(Model.ActiveFilter == "inactive")">⚪ Nonaktif</option>
                    <option value="expired" selected="@(Model.ActiveFilter == "expired")">🟡 Kedaluwarsa</option>
                </select>
            </div>

            <div class="flex items-center gap-2 w-full md:w-auto">
                <button type="submit" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-900 text-white text-xs font-bold transition-all flex items-center justify-center gap-1.5 cursor-pointer w-full md:w-auto">
                    <i class="fas fa-filter text-xs"></i>
                    <span>Filter</span>
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.StatusFilter) || !string.IsNullOrWhiteSpace(Model.ActiveFilter))
                {
                    <a href="/Announcement/Index" class="px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs font-bold transition-all text-center">
                        Reset
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Announcement Table -->
    <div class="bg-white dark:bg-slate-800 rounded-3xl border border-slate-200/80 dark:border-slate-700 shadow-2xs overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead>
                    <tr class="bg-slate-50/80 dark:bg-slate-900/80 border-b border-slate-200/80 dark:border-slate-700 text-slate-500 dark:text-slate-400 font-bold uppercase tracking-wider text-[11px]">
                        <th class="py-3.5 px-4 w-12 text-center">#</th>
                        <th class="py-3.5 px-4">Pengumuman & Isi</th>
                        <th class="py-3.5 px-4 w-44">Status & Kategori</th>
                        <th class="py-3.5 px-4 w-48">Periode Tayang</th>
                        <th class="py-3.5 px-4 w-28 text-center">Status Aktif</th>
                        <th class="py-3.5 px-4 w-36 text-center">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-700/60">
                    @if (!Model.Announcements.Any())
                    {
                        <tr>
                            <td colspan="6" class="py-12 text-center text-slate-400">
                                <div class="w-16 h-16 mx-auto mb-3 rounded-2xl bg-slate-100 dark:bg-slate-700 flex items-center justify-center text-slate-300 dark:text-slate-500 text-2xl">
                                    <i class="fas fa-bullhorn"></i>
                                </div>
                                <p class="font-bold text-slate-600 dark:text-slate-300">Belum ada pengumuman</p>
                                <p class="text-[11px] text-slate-400 mt-1">Klik tombol "Tambah Pengumuman" untuk membuat pengumuman baru bagi tim.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        int index = 1;
                        foreach (var item in Model.Announcements)
                        {
                            var isCurrentlyActive = item.IsActive && item.AnnouncementDate.Date <= today && item.EndDate.Date >= today;
                            var isUpcoming = item.AnnouncementDate.Date > today;
                            var isExpired = item.EndDate.Date < today;

                            <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-700/30 transition-colors">
                                <td class="py-4 px-4 text-center font-bold text-slate-400">@index</td>
                                
                                <!-- Judul & Isi -->
                                <td class="py-4 px-4">
                                    <div class="flex items-start gap-3">
                                        <div class="w-8 h-8 rounded-xl flex items-center justify-center text-xs flex-shrink-0 mt-0.5 @(item.Status == "Informasi Penting" ? "bg-rose-100 text-rose-600 dark:bg-rose-900/50 dark:text-rose-300" : "bg-indigo-100 text-indigo-600 dark:bg-indigo-900/50 dark:text-indigo-300")">
                                            <i class="fas @(item.Status == "Informasi Penting" ? "fa-exclamation-triangle" : "fa-bullhorn")"></i>
                                        </div>
                                        <div class="min-w-0">
                                            <h4 class="font-extrabold text-slate-800 dark:text-white text-sm leading-snug">@item.Title</h4>
                                            <p class="text-slate-500 dark:text-slate-400 text-xs mt-1 line-clamp-2 leading-relaxed">@item.Content</p>
                                            <div class="flex items-center gap-2 mt-1.5 text-[10px] text-slate-400">
                                                <span><i class="fas fa-user-edit mr-1"></i>@(item.CreatedByUser?.FullName ?? "Admin")</span>
                                                <span>&bull;</span>
                                                <span><i class="fas fa-clock mr-1"></i>@item.CreatedAt.ToString("dd MMM yyyy HH:mm")</span>
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Status & Kategori -->
                                <td class="py-4 px-4">
                                    @if (item.Status == "Informasi Penting")
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-black bg-rose-100 text-rose-700 dark:bg-rose-950/60 dark:text-rose-300 border border-rose-200 dark:border-rose-800">
                                            <i class="fas fa-shield-exclamation"></i>
                                            <span>Informasi Penting</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-black bg-indigo-100 text-indigo-700 dark:bg-indigo-950/60 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800">
                                            <i class="fas fa-bullhorn"></i>
                                            <span>Pengumuman Umum</span>
                                        </span>
                                    }
                                </td>

                                <!-- Periode Tayang -->
                                <td class="py-4 px-4">
                                    <div class="space-y-1">
                                        <div class="text-xs font-semibold text-slate-700 dark:text-slate-300">
                                            @item.AnnouncementDate.ToString("dd MMM yyyy") &rarr; @item.EndDate.ToString("dd MMM yyyy")
                                        </div>
                                        <div>
                                            @if (isCurrentlyActive)
                                            {
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-bold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300 border border-emerald-200">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                                    Sedang Tayang
                                                </span>
                                            }
                                            else if (isUpcoming)
                                            {
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-bold bg-blue-50 text-blue-700 dark:bg-blue-950/50 dark:text-blue-300 border border-blue-200">
                                                    Akan Datang
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-bold bg-slate-100 text-slate-500 dark:bg-slate-700 dark:text-slate-400">
                                                    Kedaluwarsa
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <!-- Status Aktif Toggle -->
                                <td class="py-4 px-4 text-center">
                                    <button type="button"
                                            onclick="toggleAnnouncementActive(@item.Id, this)"
                                            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl text-xs font-bold transition-all cursor-pointer @(item.IsActive ? "bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100" : "bg-slate-100 text-slate-500 border border-slate-200 hover:bg-slate-200")"
                                            title="Klik untuk mengubah status aktif">
                                        <i class="fas @(item.IsActive ? "fa-toggle-on text-emerald-600 text-sm" : "fa-toggle-off text-slate-400 text-sm")"></i>
                                        <span>@(item.IsActive ? "Aktif" : "Nonaktif")</span>
                                    </button>
                                </td>

                                <!-- Aksi -->
                                <td class="py-4 px-4 text-center">
                                    <div class="flex items-center justify-center gap-1.5">
                                        <!-- Preview Button -->
                                        <button type="button"
                                                data-id="@item.Id"
                                                data-title="@item.Title"
                                                data-content="@item.Content"
                                                data-start="@item.AnnouncementDate.ToString("dd MMMM yyyy")"
                                                data-end="@item.EndDate.ToString("dd MMMM yyyy")"
                                                data-status="@item.Status"
                                                onclick="openPreviewFromBtn(this)"
                                                class="w-8 h-8 rounded-xl bg-purple-50 hover:bg-purple-100 text-purple-700 flex items-center justify-center transition-colors cursor-pointer"
                                                title="Pratinjau Popup Modal">
                                            <i class="fas fa-eye text-xs"></i>
                                        </button>

                                        <!-- Edit Button -->
                                        <a href="/Announcement/Edit/@item.Id"
                                           class="w-8 h-8 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-700 flex items-center justify-center transition-colors cursor-pointer"
                                           title="Edit Pengumuman">
                                            <i class="fas fa-pencil-alt text-xs"></i>
                                        </a>

                                        <!-- Delete Button -->
                                        <button type="button"
                                                data-id="@item.Id"
                                                data-title="@item.Title"
                                                onclick="deleteAnnouncementFromBtn(this)"
                                                class="w-8 h-8 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 flex items-center justify-center transition-colors cursor-pointer"
                                                title="Hapus Pengumuman">
                                            <i class="fas fa-trash-alt text-xs"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Preview Container -->
<div id="adminAnnouncementPreviewModal" class="hidden fixed inset-0 z-[100000] overflow-y-auto bg-slate-900/70 backdrop-blur-sm flex items-center justify-center p-3 sm:p-4" role="dialog" aria-modal="true">
    <div class="relative bg-white dark:bg-slate-800 rounded-3xl shadow-2xl border border-slate-200 dark:border-slate-700 w-full max-w-lg overflow-hidden animate-fade-in flex flex-col">
        
        <!-- Header -->
        <div id="previewHeaderBar" class="px-6 py-4 bg-gradient-to-r from-rose-600 to-pink-600 text-white flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div id="previewIconWrap" class="w-10 h-10 rounded-2xl bg-white/20 backdrop-blur-md flex items-center justify-center text-white text-lg">
                    <i id="previewIcon" class="fas fa-bullhorn"></i>
                </div>
                <div>
                    <span id="previewBadge" class="text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full bg-white/25 text-white">
                        Pengumuman
                    </span>
                    <h3 id="previewTitle" class="font-extrabold text-base leading-tight mt-0.5">Judul Pengumuman</h3>
                </div>
            </div>
            <button type="button" onclick="closeAdminPreviewModal()" class="w-8 h-8 rounded-xl bg-white/15 hover:bg-white/30 text-white flex items-center justify-center transition-colors cursor-pointer">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>

        <!-- Body -->
        <div class="p-6 space-y-4">
            <div class="flex items-center justify-between text-xs text-slate-500 border-b border-slate-100 dark:border-slate-700 pb-3">
                <span><i class="fas fa-calendar-alt mr-1 text-slate-400"></i><strong id="previewDates">Periode</strong></span>
                <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 font-bold text-[10px]">Tayang Aktif</span>
            </div>
            <div id="previewContent" class="text-xs sm:text-sm text-slate-700 dark:text-slate-200 whitespace-pre-line leading-relaxed">
                Isi pengumuman...
            </div>
        </div>

        <!-- Footer -->
        <div class="px-6 py-3 bg-slate-50 dark:bg-slate-900 border-t border-slate-200/80 dark:border-slate-700 flex items-center justify-between">
            <span class="text-[11px] text-slate-400">👁️ Ini adalah simulasi tampilan modal pengguna</span>
            <button type="button" onclick="closeAdminPreviewModal()" class="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white rounded-xl text-xs font-bold transition-all cursor-pointer">
                Tutup Simulasi
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function toggleAnnouncementActive(id, btn) {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const formData = new URLSearchParams();
        if (token) formData.append('__RequestVerificationToken', token);

        fetch('/Announcement/ToggleActive/' + id, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: formData.toString()
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                if (data.isActive) {
                    btn.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl text-xs font-bold transition-all cursor-pointer bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100';
                    btn.innerHTML = '<i class="fas fa-toggle-on text-emerald-600 text-sm"></i><span>Aktif</span>';
                } else {
                    btn.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl text-xs font-bold transition-all cursor-pointer bg-slate-100 text-slate-500 border border-slate-200 hover:bg-slate-200';
                    btn.innerHTML = '<i class="fas fa-toggle-off text-slate-400 text-sm"></i><span>Nonaktif</span>';
                }
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: data.message,
                    showConfirmButton: false,
                    timer: 2000
                });
            } else {
                Swal.fire('Error', data.message || 'Gagal mengubah status.', 'error');
            }
        })
        .catch(err => {
            Swal.fire('Error', 'Terjadi kesalahan jaringan.', 'error');
        });
    }

    function deleteAnnouncementFromBtn(btn) {
        const id = btn.getAttribute('data-id');
        const title = btn.getAttribute('data-title');
        deleteAnnouncement(id, title);
    }

    function openPreviewFromBtn(btn) {
        const id = btn.getAttribute('data-id');
        const title = btn.getAttribute('data-title');
        const content = btn.getAttribute('data-content');
        const startDate = btn.getAttribute('data-start');
        const endDate = btn.getAttribute('data-end');
        const status = btn.getAttribute('data-status');
        previewAnnouncementModal(id, title, content, startDate, endDate, status);
    }

    function deleteAnnouncement(id, title) {
        Swal.fire({
            title: 'Hapus Pengumuman?',
            html: `Apakah Anda yakin ingin menghapus pengumuman <strong>"${title}"</strong>? Pengumuman tidak akan ditampilkan lagi kepada pengguna.`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#e11d48',
            cancelButtonColor: '#64748b',
            confirmButtonText: '<i class="fas fa-trash-alt mr-1"></i> Ya, Hapus',
            cancelButtonText: 'Batal'
        }).then((result) => {
            if (result.isConfirmed) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Announcement/Delete/' + id;
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                if (token) {
                    const tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = token;
                    form.appendChild(tokenInput);
                }
                document.body.appendChild(form);
                form.submit();
            }
        });
    }

    function previewAnnouncementModal(id, title, content, startDate, endDate, status) {
        const modal = document.getElementById('adminAnnouncementPreviewModal');
        const header = document.getElementById('previewHeaderBar');
        const icon = document.getElementById('previewIcon');
        const badge = document.getElementById('previewBadge');
        const titleEl = document.getElementById('previewTitle');
        const contentEl = document.getElementById('previewContent');
        const datesEl = document.getElementById('previewDates');

        titleEl.textContent = title;
        contentEl.textContent = content;
        datesEl.textContent = `${startDate} s/d ${endDate}`;

        if (status === 'Informasi Penting') {
            header.className = 'px-6 py-4 bg-gradient-to-r from-red-600 via-rose-600 to-amber-600 text-white flex items-center justify-between';
            icon.className = 'fas fa-exclamation-triangle';
            badge.textContent = '🚨 INFORMASI PENTING';
            badge.className = 'text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full bg-white/30 text-white';
        } else {
            header.className = 'px-6 py-4 bg-gradient-to-r from-indigo-600 to-purple-600 text-white flex items-center justify-between';
            icon.className = 'fas fa-bullhorn';
            badge.textContent = '📢 PENGUMUMAN UMUM';
            badge.className = 'text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full bg-white/20 text-white';
        }

        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeAdminPreviewModal() {
        const modal = document.getElementById('adminAnnouncementPreviewModal');
        if (modal) {
            modal.classList.add('hidden');
            document.body.style.overflow = '';
        }
    }
</script>
}
