@{
    ViewData["Title"] = "Kalender Tugas";
}

<div class="bg-white rounded-2xl shadow-sm border border-indigo-100 overflow-hidden">
    <!-- Calendar Header -->
    <div class="p-5 border-b border-slate-100 flex items-center justify-between flex-wrap gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center text-indigo-600 shadow-sm border border-indigo-100/60">
                <i class="fas fa-calendar-alt text-lg"></i>
            </div>
            <div>
                <h3 class="font-bold text-slate-800 text-base leading-tight">Kalender Tugas</h3>
                <p class="text-xs text-slate-400">Visualisasi timeline jadwal dan tenggat waktu pengerjaan</p>
            </div>
        </div>

        <div class="flex items-center gap-3 flex-wrap">
            <!-- Filter Dropdown (Khusus Admin) atau Status Badge (Member) -->
            @if (User.IsInRole("Admin"))
            {
                <div class="flex items-center gap-2 bg-slate-50 hover:bg-slate-100/80 transition-colors border border-slate-200/80 rounded-xl px-3 py-1.5 shadow-sm">
                    <i class="fas fa-filter text-indigo-500 text-xs"></i>
                    <label for="taskFilter" class="text-xs font-semibold text-slate-500 whitespace-nowrap">Tampilan:</label>
                    <select id="taskFilter" class="bg-transparent text-xs font-bold text-slate-700 focus:outline-none cursor-pointer pr-1">
                        <option value="all" selected>🌐 Semua Tugas Tim</option>
                        <option value="mine">👤 Tugas Saya Sendiri</option>
                    </select>
                </div>
            }
            else
            {
                <div class="inline-flex items-center gap-2 bg-indigo-50/80 border border-indigo-100 rounded-xl px-3 py-1.5 text-xs font-bold text-indigo-700 shadow-sm" title="Menampilkan jadwal tugas yang ditugaskan kepada Anda">
                    <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
                    <i class="fas fa-user-check text-indigo-500"></i>
                    <span>Tugas Saya</span>
                </div>
            }

            <!-- Legend -->
            <div class="hidden lg:flex items-center gap-3 text-xs bg-slate-50/60 px-3 py-1.5 rounded-xl border border-slate-100">
                <span class="flex items-center gap-1.5 text-slate-600"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span> Selesai</span>
                <span class="flex items-center gap-1.5 text-slate-600"><span class="w-2.5 h-2.5 rounded-full bg-indigo-500 inline-block"></span> In Progress</span>
                <span class="flex items-center gap-1.5 text-slate-600"><span class="w-2.5 h-2.5 rounded-full bg-amber-400 inline-block"></span> Pending</span>
                <span class="flex items-center gap-1.5 text-slate-600"><span class="w-2.5 h-2.5 rounded-full bg-red-500 inline-block"></span> Terlambat</span>
            </div>

            <a href="/Task/Create" class="bg-gradient-to-r from-indigo-500 to-purple-600 text-white text-xs font-semibold px-4 py-2 rounded-xl hover:shadow-md hover:shadow-indigo-200 transition-all flex items-center gap-1.5">
                <i class="fas fa-plus"></i>
                <span>Tugas Baru</span>
            </a>
        </div>
    </div>

    <!-- Overlap Warning -->
    <div id="overlap-warning" class="hidden mx-5 mt-4 p-3 bg-amber-50 border border-amber-200 rounded-xl text-sm text-amber-700 flex items-center gap-2">
        <i class="fas fa-exclamation-triangle text-amber-500 flex-shrink-0"></i>
        <span id="overlap-message">Terdeteksi tugas yang beririsan jadwal!</span>
    </div>

    <!-- Calendar Container -->
    <div class="p-5">
        <div id="calendar"></div>
    </div>
</div>

<!-- Task Detail Modal -->
<div id="task-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 slide-in">
        <div class="flex items-center justify-between mb-4">
            <h3 class="font-bold text-slate-800 text-lg flex items-center gap-2" id="modal-title">
                <i class="fas fa-tasks text-indigo-500"></i>
                Detail Tugas
            </h3>
            <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center transition-colors">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div id="modal-content" class="space-y-3 text-sm text-slate-600"></div>
        <div class="flex gap-2 mt-5">
            <a id="modal-edit-link" href="#" class="flex-1 bg-gradient-to-r from-indigo-500 to-purple-600 text-white text-center py-2.5 rounded-xl font-semibold text-sm hover:shadow-md transition-all flex items-center justify-center gap-1.5">
                <i class="fas fa-edit"></i>
                <span>Lihat / Edit Tugas</span>
            </a>
            <button onclick="closeModal()" class="px-4 py-2.5 border border-slate-200 rounded-xl text-slate-600 text-sm hover:border-indigo-300 hover:bg-slate-50 transition-colors">
                Tutup
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    const calendarEl = document.getElementById('calendar');
    const filterEl = document.getElementById('taskFilter');
    let allEvents = [];

    const isMobile = window.innerWidth < 768;
    const calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: isMobile ? 'dayGridMonth' : 'dayGridMonth',
        locale: 'id',
        headerToolbar: isMobile ? {
            left: 'prev,next today',
            center: 'title',
            right: 'dayGridMonth,listWeek'
        } : {
            left: 'prev,next today',
            center: 'title',
            right: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek'
        },
        editable: true,
        eventSources: [{
            url: '/Calendar/GetEvents',
            method: 'GET',
            extraParams: function() {
                return {
                    filter: filterEl ? filterEl.value : 'mine'
                };
            },
            failure: function() { console.error('Gagal memuat event kalender'); }
        }],
        eventsSet: function(events) {
            allEvents = events;
            detectOverlaps(events);
        },
        eventClick: function(info) {
            showModal(info.event);
        },
        eventDrop: async function(info) {
            try {
                const res = await fetch('/Calendar/UpdateTaskDate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ taskId: info.event.id, newDate: info.event.startStr })
                });
                const data = await res.json();
                if (!data.success) {
                    if (data.message) alert(data.message);
                    info.revert();
                }
            } catch (err) {
                console.error(err);
                info.revert();
            }
        },
        eventDidMount: function(info) {
            const props = info.event.extendedProps;
            const pic = props.assigneeName ? ` | PIC: ${props.assigneeName}` : '';
            info.el.title = `${info.event.title}${pic} | Status: ${props.status} | Prioritas: ${props.priority}`;
        }
    });

    calendar.render();

    // Event listener untuk dropdown filter Admin
    if (filterEl) {
        filterEl.addEventListener('change', function () {
            calendar.refetchEvents();
        });
    }

    function detectOverlaps(events) {
        const overlaps = [];
        for (let i = 0; i < events.length; i++) {
            for (let j = i + 1; j < events.length; j++) {
                const a = events[i], b = events[j];
                if (a.start && b.start) {
                    const aStart = a.start.getTime(), aEnd = (a.end || a.start).getTime();
                    const bStart = b.start.getTime(), bEnd = (b.end || b.start).getTime();
                    if (aStart < bEnd && aEnd > bStart) {
                        overlaps.push(`"${a.title}" & "${b.title}"`);
                    }
                }
            }
        }
        const warning = document.getElementById('overlap-warning');
        if (overlaps.length > 0) {
            warning.classList.remove('hidden');
            document.getElementById('overlap-message').textContent = `⚠️ ${overlaps.length} tugas beririsan jadwal: ${overlaps.slice(0,2).join(', ')}${overlaps.length > 2 ? ` dan ${overlaps.length-2} lainnya` : ''}`;
        } else {
            warning.classList.add('hidden');
        }
    }

    function showModal(event) {
        const props = event.extendedProps;
        document.getElementById('modal-title').innerHTML = `<i class="fas fa-tasks text-indigo-500"></i> ${escapeHtml(event.title)}`;
        document.getElementById('modal-edit-link').href = event.url || '#';
        
        document.getElementById('modal-content').innerHTML = `
            <div class="flex items-center gap-2 p-3 rounded-xl" style="background:${event.backgroundColor}22">
                <span class="w-3 h-3 rounded-full" style="background:${event.backgroundColor}"></span>
                <span class="font-semibold text-sm" style="color:${event.backgroundColor}">${escapeHtml(props.status)}</span>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                    <p class="text-xs text-slate-400 font-medium">Prioritas</p>
                    <p class="font-bold text-slate-700 mt-0.5">${escapeHtml(props.priority)}</p>
                </div>
                <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                    <p class="text-xs text-slate-400 font-medium">Proyek</p>
                    <p class="font-bold text-slate-700 truncate mt-0.5" title="${escapeHtml(props.projectName || '-')}">${escapeHtml(props.projectName || '-')}</p>
                </div>
            </div>
            <div class="p-3 bg-slate-50 rounded-xl border border-slate-100 flex items-center justify-between">
                <div>
                    <p class="text-xs text-slate-400 font-medium">Penanggung Jawab (PIC)</p>
                    <p class="font-semibold text-slate-700 flex items-center gap-1.5 mt-0.5">
                        <i class="fas fa-user-circle text-indigo-500"></i>
                        <span>${escapeHtml(props.assigneeName || 'Belum Ditugaskan')}</span>
                    </p>
                </div>
                ${props.assigneeAvatar ? `<img src="${props.assigneeAvatar}" class="w-8 h-8 rounded-full object-cover border border-indigo-200" alt="Avatar" />` : ''}
            </div>
            ${event.start ? `
                <div class="p-3 bg-indigo-50/70 border border-indigo-100 rounded-xl">
                    <p class="text-xs text-indigo-500 font-medium">Deadline / Jadwal</p>
                    <p class="font-bold text-indigo-900 mt-0.5">${event.start.toLocaleDateString('id-ID', {weekday:'long', day:'numeric', month:'long', year:'numeric'})}</p>
                </div>` : ''}
        `;
        document.getElementById('task-modal').classList.remove('hidden');
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    window.closeModal = function() {
        document.getElementById('task-modal').classList.add('hidden');
    }

    document.getElementById('task-modal').addEventListener('click', function(e) {
        if (e.target === this) closeModal();
    });
});
</script>
}
