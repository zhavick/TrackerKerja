@model TrackerKerja.ViewModels.MemberFormViewModel
@{
    ViewData["Title"] = $"Edit Anggota - {Model.FullName}";
    var avatarColors = new[] { "#6366F1", "#06B6D4", "#10B981", "#F59E0B", "#EF4444", "#8B5CF6", "#EC4899", "#64748B" };
    var initial = !string.IsNullOrEmpty(Model.FullName) ? Model.FullName.Substring(0, 1).ToUpper() : "U";
    var currentAvatarColor = !string.IsNullOrEmpty(Model.AvatarColor) ? Model.AvatarColor : "#6366F1";
}

<div class="w-full space-y-6">

    <!-- Top Executive Header Banner (Full Width) -->
    <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 rounded-3xl p-5 sm:p-6 text-white shadow-xl border border-indigo-900/40 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-start sm:items-center gap-4 min-w-0">
            <!-- Avatar Display -->
            <div id="header-avatar-circle" class="w-14 h-14 rounded-2xl text-white flex items-center justify-center font-black text-2xl shadow-lg shrink-0 border-2 border-white/30 transition-colors"
                 style="background: @currentAvatarColor;">
                @initial
            </div>
            <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2 mb-1">
                    <a href="/Member" class="text-slate-400 hover:text-white text-xs font-semibold flex items-center gap-1 transition-colors">
                        <i class="fas fa-arrow-left text-[10px]"></i> Direktori Anggota
                    </a>
                    <span class="text-slate-600 text-xs">/</span>
                    <a href="/Member/Details/@Model.Id" class="text-slate-400 hover:text-white text-xs font-semibold transition-colors">
                        Profil Anggota
                    </a>
                    <span class="text-slate-600 text-xs">•</span>
                    <span class="bg-indigo-500/30 text-indigo-200 border border-indigo-400/30 text-xs px-2.5 py-0.5 rounded-lg font-bold">
                        @(Model.Role == "Admin" ? "🛡️ Administrator" : "👤 Team Member")
                    </span>
                </div>
                <h1 class="text-xl sm:text-2xl font-black text-white tracking-tight truncate">
                    Edit Anggota: @Model.FullName
                </h1>
                <p class="text-xs text-slate-400 mt-0.5 truncate">
                    @(string.IsNullOrEmpty(Model.JobTitle) ? "Spesialisasi belum diatur" : Model.JobTitle) • @Model.Email
                </p>
            </div>
        </div>
        <div class="flex items-center gap-3 shrink-0">
            <a href="/Member/Details/@Model.Id" class="px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold transition-all border border-white/20 flex items-center gap-1.5 shadow-xs">
                <i class="fas fa-arrow-left"></i>
                <span>Kembali ke Detail</span>
            </a>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-2xl text-xs shadow-xs">
            <div class="flex items-center gap-2 font-bold mb-1">
                <i class="fas fa-exclamation-circle text-red-500 text-sm"></i>
                <span>Terdapat kendala validasi pada formulir:</span>
            </div>
            @Html.ValidationSummary(false, "", new { @class = "list-disc pl-5 font-medium space-y-0.5" })
        </div>
    }

    <!-- Main Edit Form (2-Column Studio Layout) -->
    <form method="post" action="/Member/Edit/@Model.Id" class="space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

            <!-- ========================================== -->
            <!-- LEFT COLUMN: MAIN MEMBER PROFILE (8 COLS)  -->
            <!-- ========================================== -->
            <div class="lg:col-span-8 space-y-6">

                <div class="bg-white rounded-3xl shadow-sm border border-indigo-100 overflow-hidden">
                    <div class="bg-gradient-to-r from-indigo-600 to-purple-600 px-6 py-4 flex items-center justify-between text-white">
                        <div class="flex items-center gap-2.5">
                            <i class="fas fa-id-card text-lg"></i>
                            <h2 class="font-bold text-base">Informasi Identitas &amp; Kontak</h2>
                        </div>
                        <span class="text-xs bg-white/20 px-2.5 py-0.5 rounded-md font-mono">User ID: #@Model.Id</span>
                    </div>

                    <div class="p-6 space-y-5">
                        <!-- Full Name -->
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                                <i class="fas fa-user text-indigo-500 mr-1.5"></i>Nama Lengkap <span class="text-red-500">*</span>
                            </label>
                            <input type="text" name="FullName" value="@Model.FullName" required
                                   class="w-full px-4 py-3 rounded-2xl border border-indigo-200 focus:outline-none focus:ring-2 focus:ring-indigo-400 text-slate-800 text-sm sm:text-base font-semibold transition-all shadow-2xs">
                        </div>

                        <!-- Email & Job Title -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                                    <i class="fas fa-envelope text-indigo-500 mr-1.5"></i>Email Pengguna (Username)
                                </label>
                                <input type="email" name="Email" value="@Model.Email" readonly disabled
                                       class="w-full px-4 py-3 rounded-2xl border border-slate-200 bg-slate-50 text-slate-500 text-sm cursor-not-allowed font-medium shadow-2xs">
                                <p class="text-[11px] text-slate-400 mt-1.5">Alamat email terdaftar terkunci sebagai akun login sistem.</p>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                                    <i class="fas fa-briefcase text-indigo-500 mr-1.5"></i>Jabatan / Spesialisasi Kerja
                                </label>
                                <input type="text" name="JobTitle" value="@Model.JobTitle"
                                       placeholder="Contoh: Senior Fullstack Engineer"
                                       class="w-full px-4 py-3 rounded-2xl border border-indigo-200 focus:outline-none focus:ring-2 focus:ring-indigo-400 text-slate-800 text-sm font-medium transition-all shadow-2xs">
                                <p class="text-[11px] text-slate-400 mt-1.5">Muncul di kartu anggota, direktori, dan laporan timesheet.</p>
                            </div>
                        </div>

                        <!-- Phone Number -->
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                                <i class="fas fa-phone text-indigo-500 mr-1.5"></i>Nomor Telepon / WhatsApp
                            </label>
                            <input type="text" name="PhoneNumber" value="@Model.PhoneNumber"
                                   placeholder="Contoh: 081234567890"
                                   class="w-full px-4 py-3 rounded-2xl border border-indigo-200 focus:outline-none focus:ring-2 focus:ring-indigo-400 text-slate-800 text-sm font-medium transition-all shadow-2xs">
                            <p class="text-[11px] text-slate-400 mt-1.5">Kontak langsung untuk koordinasi tim cepat.</p>
                        </div>
                    </div>
                </div>

            </div>

            <!-- ============================================== -->
            <!-- RIGHT COLUMN: SIDEBAR INSPECTOR (4 COLS)       -->
            <!-- ============================================== -->
            <div class="lg:col-span-4 space-y-6 lg:sticky lg:top-4">

                <!-- Card 1: Hak Akses & Peran Akun -->
                <div class="bg-white rounded-3xl shadow-sm border border-indigo-100 overflow-hidden">
                    <div class="bg-slate-100 px-5 py-3.5 border-b border-slate-200 text-slate-700">
                        <span class="font-bold text-xs uppercase tracking-wider flex items-center gap-2">
                            <i class="fas fa-shield-alt text-indigo-500"></i>Hak Akses &amp; Peran Sistem
                        </span>
                    </div>

                    <div class="p-5 space-y-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                                Peran Akun (Role)
                            </label>
                            <select name="Role" class="select2 w-full" data-placeholder="Pilih Peran">
                                <option value="User" selected="@(Model.Role != "Admin")">👤 User / Team Member</option>
                                <option value="Admin" selected="@(Model.Role == "Admin")">🛡️ Administrator</option>
                            </select>
                        </div>
                        <p class="text-[11px] text-slate-400 leading-relaxed">
                            <strong>Administrator</strong> memiliki hak kelola master data, persetujuan user, import/export, dan konfigurasi sistem.
                        </p>
                    </div>
                </div>

                <!-- Card 2: Personalisasi Aksen Avatar -->
                <div class="bg-white rounded-3xl shadow-sm border border-indigo-100 overflow-hidden">
                    <div class="bg-slate-100 px-5 py-3.5 border-b border-slate-200 text-slate-700">
                        <span class="font-bold text-xs uppercase tracking-wider flex items-center gap-2">
                            <i class="fas fa-palette text-pink-500"></i>Warna Aksen Avatar
                        </span>
                    </div>

                    <div class="p-5 space-y-3">
                        <div class="grid grid-cols-4 gap-2.5">
                            @foreach (var color in avatarColors)
                            {
                                <label class="cursor-pointer">
                                    <input type="radio" name="AvatarColor" value="@color" class="sr-only peer"
                                           onchange="document.getElementById('header-avatar-circle').style.background='@color'"
                                           @(Model.AvatarColor == color ? "checked" : "") />
                                    <div class="h-10 rounded-2xl ring-2 ring-transparent peer-checked:ring-indigo-500 peer-checked:ring-offset-2 peer-checked:scale-105 transition-all flex items-center justify-center shadow-2xs"
                                         style="background:@color;">
                                        <i class="fas fa-check text-white text-xs opacity-0 peer-checked:opacity-100 font-black"></i>
                                    </div>
                                </label>
                            }
                        </div>
                        <p class="text-[11px] text-slate-400">
                            Warna avatar digunakan sebagai latar inisial pengguna saat tidak ada foto profil.
                        </p>
                    </div>
                </div>

                <!-- Card 3: Aksi Penyimpanan -->
                <div class="bg-white rounded-3xl shadow-sm border border-indigo-100 p-5 space-y-3">
                    <button type="submit"
                            class="w-full bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white font-bold py-3.5 px-6 rounded-2xl shadow-lg shadow-indigo-200 hover:shadow-indigo-300 hover:scale-[1.01] active:scale-[0.99] transition-all text-sm cursor-pointer flex items-center justify-center gap-2">
                        <i class="fas fa-save text-base"></i>
                        <span>Simpan Perubahan Anggota</span>
                    </button>
                    <a href="/Member/Details/@Model.Id"
                       class="w-full block text-center py-3 px-6 rounded-2xl border border-slate-200 text-slate-600 hover:text-indigo-600 hover:border-indigo-300 font-semibold text-sm transition-colors">
                        Batal
                    </a>
                </div>

            </div>

        </div>
    </form>

</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof window.initAppSelect2 === 'function') {
            window.initAppSelect2();
        }
    });
</script>
}
