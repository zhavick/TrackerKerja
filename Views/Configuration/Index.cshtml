</div>

@section Scripts {
<script>
let fullSqlText = '';

// =========================================================================
// SINKRONISASI HOST INDUK JAVASCRIPT LOGIC
// =========================================================================

function switchSyncTab(tabId) {
    const tabs = ['tab-online', 'tab-manual-export', 'tab-host-receiver'];
    const btns = {
        'tab-online': 'tab-btn-online',
        'tab-manual-export': 'tab-btn-manual-export',
        'tab-host-receiver': 'tab-btn-host-receiver'
    };

    tabs.forEach(t => {
        const el = document.getElementById(t);
        const btn = document.getElementById(btns[t]);
        if (t === tabId) {
            el.classList.remove('hidden');
            btn.className = 'flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold transition-all bg-indigo-600 text-white shadow-md cursor-pointer';
        } else {
            el.classList.add('hidden');
            btn.className = 'flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold transition-all text-slate-400 hover:text-white cursor-pointer';
        }
    });
}

function toggleApiKeyVisibility() {
    const input = document.getElementById('syncApiKeyInput');
    const icon = document.getElementById('toggle-key-icon');
    if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'fas fa-eye-slash';
    } else {
        input.type = 'password';
        icon.className = 'fas fa-eye';
    }
}

function generateRandomApiKey() {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
    let rand = 'TK-SYNC-';
    for (let i = 0; i < 16; i++) {
        rand += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    document.getElementById('syncApiKeyInput').value = rand;
    document.getElementById('syncApiKeyInput').type = 'text';
    document.getElementById('toggle-key-icon').className = 'fas fa-eye-slash';
    if (typeof SwalAlert === 'function') {
        SwalAlert('Key Baru Dibuat', 'Secret API Key baru berhasil digenerate. Jangan lupa klik "Simpan Konfigurasi"!', 'info');
    }
}

function copyApiKey() {
    const val = document.getElementById('syncApiKeyInput').value;
    navigator.clipboard.writeText(val).then(() => {
        if (typeof SwalAlert === 'function') {
            SwalAlert('Tersalin', 'Secret API Key berhasil disalin ke clipboard!', 'success');
        } else {
            alert('Secret API Key disalin!');
        }
    });
}

async function testHostIndukConnection() {
    const hostUrl = document.getElementById('syncHostUrlInput').value.trim();
    const apiKey = document.getElementById('syncApiKeyInput').value.trim();
    const btn = document.getElementById('btn-ping-host');
    const icon = document.getElementById('ping-icon');
    const text = document.getElementById('ping-text');
    const badge = document.getElementById('ping-status-badge');

    if (!hostUrl) {
        if (typeof SwalAlert === 'function') {
            SwalAlert('URL Kosong', 'Harap isi alamat Target Host Induk URL terlebih dahulu!', 'warning');
        } else {
            alert('Harap isi alamat Target Host Induk URL!');
        }
        return;
    }

    btn.disabled = true;
    icon.className = 'fas fa-spinner fa-spin text-cyan-400';
    text.innerText = 'Menguji...';
    badge.className = 'hidden';

    try {
        const res = await fetch('/Configuration/TestHostConnection', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ TargetHostUrl: hostUrl, ApiKey: apiKey })
        });

        const data = await res.json();
        btn.disabled = false;
        icon.className = 'fas fa-plug text-cyan-400';
        text.innerText = 'Test Koneksi Host';

        badge.classList.remove('hidden');

        if (data.success) {
            badge.className = 'text-xs font-bold px-3 py-1.5 rounded-xl bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 flex items-center gap-1.5';
            badge.innerHTML = `<i class="fas fa-check-circle"></i> Online (${data.data.databaseType || 'OK'})`;
            
            if (typeof SwalAlert === 'function') {
                SwalAlert('Koneksi Sukses!', `Host Induk di <strong>${hostUrl}</strong> merespons dengan sukses!<br><br>Status: <span class="text-emerald-600 font-bold">ONLINE</span><br>Tugas di Host: <strong>${data.data.totalTasks}</strong> | Sesi: <strong>${data.data.totalSessions}</strong>`, 'success');
            }
        } else {
            badge.className = 'text-xs font-bold px-3 py-1.5 rounded-xl bg-rose-500/20 text-rose-300 border border-rose-500/30 flex items-center gap-1.5';
            badge.innerHTML = `<i class="fas fa-times-circle"></i> Terputus`;

            if (typeof SwalAlert === 'function') {
                SwalAlert('Koneksi Gagal', data.message || 'Host Induk tidak dapat dijangkau.', 'error');
            }
        }
    } catch (err) {
        btn.disabled = false;
        icon.className = 'fas fa-plug text-cyan-400';
        text.innerText = 'Test Koneksi Host';
        badge.classList.remove('hidden');
        badge.className = 'text-xs font-bold px-3 py-1.5 rounded-xl bg-rose-500/20 text-rose-300 border border-rose-500/30 flex items-center gap-1.5';
        badge.innerHTML = `<i class="fas fa-times-circle"></i> Error`;

        if (typeof SwalAlert === 'function') {
            SwalAlert('Kesalahan Jaringan', `Gagal mengirim test ping ke Host Induk: ${err.message}`, 'error');
        }
    }
}

function executeOnlinePushSync() {
    const targetUrl = document.getElementById('syncHostUrlInput').value.trim();
    const apiKey = document.getElementById('syncApiKeyInput').value.trim();
    const cleanBefore = document.getElementById('pushCleanBeforeSync').checked;
    const backupBefore = document.getElementById('pushBackupBeforeSync').checked;
    const syncFiles = document.getElementById('pushSyncFiles')?.checked ?? true;

    if (!targetUrl) {
        if (typeof SwalAlert === 'function') {
            SwalAlert('Target Host Kosong', 'Harap isi URL Host Induk sebelum melakukan sinkronisasi.', 'warning');
        } else {
            alert('Harap isi URL Host Induk!');
        }
        return;
    }

    const confirmHtml = `
        <div class="text-left text-xs space-y-2 mt-2">
            <p>Anda akan mengirimkan seluruh data dan berkas saat ini ke Host Induk di <strong>${targetUrl}</strong>.</p>
            <div class="p-2.5 bg-slate-50 rounded-xl border border-slate-200">
                <div>• Opsi Bersihkan Data Lama di Host: <strong>${cleanBefore ? 'Ya (Clean Slate)' : 'Tidak (Merge)'}</strong></div>
                <div>• Opsi Buat Backup di Host: <strong>${backupBefore ? 'Ya (Otomatis .db)' : 'Tidak'}</strong></div>
                <div>• Opsi Sertakan Berkas Lampiran / Upload: <strong>${syncFiles ? 'Ya (Seluruh Berkas & Avatar)' : 'Tidak (Data Saja)'}</strong></div>
            </div>
            <p class="text-slate-500">Pastikan server Host Induk sedang aktif dan menerima koneksi API.</p>
        </div>
    `;

    if (typeof Swal === 'function') {
        Swal.fire({
            title: 'Kirim Data & Berkas ke Host Induk?',
            html: confirmHtml,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#4F46E5',
            cancelButtonColor: '#64748B',
            confirmButtonText: '<i class="fas fa-paper-plane mr-1.5"></i>Ya, Kirim Sekarang',
            cancelButtonText: 'Batal'
        }).then((result) => {
            if (result.isConfirmed) {
                performPushSync(targetUrl, apiKey, cleanBefore, backupBefore, syncFiles);
            }
        });
    } else {
        if (confirm(`Kirim data & berkas ke Host Induk (${targetUrl}) sekarang?`)) {
            performPushSync(targetUrl, apiKey, cleanBefore, backupBefore, syncFiles);
        }
    }
}

async function performPushSync(targetUrl, apiKey, cleanBefore, backupBefore, syncFiles) {
    const btn = document.getElementById('btn-push-sync');
    const origHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Sedang Mengirim &amp; Sinkronisasi Data &amp; Berkas...';

    try {
        const res = await fetch('/api/sync/push', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                TargetHostUrl: targetUrl,
                ApiKey: apiKey,
                CleanBeforeSync: cleanBefore,
                BackupBeforeSync: backupBefore,
                SyncFiles: syncFiles
            })
        });

        const data = await res.json();
        btn.disabled = false;
        btn.innerHTML = origHtml;

        if (data.success) {
            const tableList = data.data?.affectedTables?.join(', ') || 'Tabel transaksi & master';
            const duration = data.data?.executionDurationMs || 0;
            const filesSynced = data.data?.syncedFilesCount ?? 0;
            const filesSize = data.data?.syncedFilesSizeFormatted || '0 B';
            const fileInfo = filesSynced > 0 ? `<br><strong>Berkas disinkronkan:</strong> <span class="text-emerald-600 font-bold">${filesSynced} berkas (${filesSize})</span>` : '';
            const backupMsg = data.data?.backupFileName ? `<br><small class="text-slate-500">Backup Host: ${data.data.backupFileName}</small>` : '';

            if (typeof Swal === 'function') {
                Swal.fire({
                    title: 'Sinkronisasi Berhasil!',
                    html: `Seluruh data &amp; berkas berhasil dikirim dan diterapkan di Host Induk dalam <strong>${duration}ms</strong>.${fileInfo}<br><br><strong>Tabel yang diperbarui:</strong><br><span class="text-xs font-mono text-indigo-600">${tableList}</span>${backupMsg}`,
                    icon: 'success',
                    confirmButtonColor: '#4F46E5'
                }).then(() => {
                    window.location.reload();
                });
            } else {
                alert(`Sinkronisasi Berhasil! Durasi: ${duration}ms. Berkas: ${filesSynced}`);
                window.location.reload();
            }
        } else {
            if (typeof SwalAlert === 'function') {
                SwalAlert('Gagal Sinkronisasi', data.message || 'Terjadi kesalahan saat memproses data di Host Induk.', 'error');
            } else {
                alert('Gagal Sinkronisasi: ' + data.message);
            }
        }
    } catch (err) {
        btn.disabled = false;
        btn.innerHTML = origHtml;
        if (typeof SwalAlert === 'function') {
            SwalAlert('Kesalahan Jaringan', `Gagal menghubungi Host Induk: ${err.message}`, 'error');
        } else {
            alert('Kesalahan Jaringan: ' + err.message);
        }
    }
}

function executeOnlinePullSync() {
    const targetUrl = document.getElementById('syncHostUrlInput').value.trim();
    const apiKey = document.getElementById('syncApiKeyInput').value.trim();
    const cleanBefore = document.getElementById('pushCleanBeforeSync').checked;
    const backupBefore = document.getElementById('pushBackupBeforeSync').checked;

    if (!targetUrl) {
        if (typeof SwalAlert === 'function') {
            SwalAlert('Target Host Kosong', 'Harap isi URL Host Induk sebelum melakukan penarikan data.', 'warning');
        } else {
            alert('Harap isi URL Host Induk!');
        }
        return;
    }

    const confirmHtml = `
        <div class="text-left text-xs space-y-2 mt-2">
            <p>Anda akan <strong>menarik seluruh data dan berkas lampiran</strong> dari Host Induk (<strong>${targetUrl}</strong>) ke server ini.</p>
            <div class="p-2.5 bg-slate-50 rounded-xl border border-slate-200">
                <div>• Opsi Bersihkan Data Lokal: <strong>${cleanBefore ? 'Ya (Clean Slate)' : 'Tidak (Merge)'}</strong></div>
                <div>• Opsi Buat Backup Lokal: <strong>${backupBefore ? 'Ya (Otomatis .db)' : 'Tidak'}</strong></div>
            </div>
            <p class="text-amber-600 font-semibold">Data &amp; berkas lokal akan diperbarui sesuai data terbaru dari Host Induk.</p>
        </div>
    `;

    if (typeof Swal === 'function') {
        Swal.fire({
            title: 'Tarik Data & Berkas dari Host Induk?',
            html: confirmHtml,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#0284C7',
            cancelButtonColor: '#64748B',
            confirmButtonText: '<i class="fas fa-cloud-download-alt mr-1.5"></i>Ya, Tarik Sekarang',
            cancelButtonText: 'Batal'
        }).then((result) => {
            if (result.isConfirmed) {
                performPullSync(targetUrl, apiKey, cleanBefore, backupBefore);
            }
        });
    } else {
        if (confirm(`Tarik data & berkas dari Host Induk (${targetUrl}) sekarang?`)) {
            performPullSync(targetUrl, apiKey, cleanBefore, backupBefore);
        }
    }
}

async function performPullSync(targetUrl, apiKey, cleanBefore, backupBefore) {
    const btn = document.getElementById('btn-pull-sync');
    const origHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Sedang Mengunduh &amp; Menerapkan Data dari Host Induk...';

    try {
        const res = await fetch('/api/sync/pull', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                TargetHostUrl: targetUrl,
                ApiKey: apiKey,
                CleanBeforeSync: cleanBefore,
                BackupBeforeSync: backupBefore
            })
        });

        const data = await res.json();
        btn.disabled = false;
        btn.innerHTML = origHtml;

        if (data.success) {
            const tableList = data.data?.affectedTables?.join(', ') || 'Tabel database';
            const duration = data.data?.executionDurationMs || 0;
            const filesSynced = data.data?.syncedFilesCount ?? 0;
            const filesSize = data.data?.syncedFilesSizeFormatted || '0 B';
            const fileInfo = filesSynced > 0 ? `<br><strong>Berkas fisik yang disalin:</strong> <span class="text-emerald-600 font-bold">${filesSynced} berkas (${filesSize})</span>` : '';

            if (typeof Swal === 'function') {
                Swal.fire({
                    title: 'Tarik Data Berhasil!',
                    html: `Data &amp; berkas dari Host Induk berhasil diterapkan di instance lokal ini dalam <strong>${duration}ms</strong>.${fileInfo}<br><br><strong>Tabel yang diperbarui:</strong><br><span class="text-xs font-mono text-indigo-600">${tableList}</span>`,
                    icon: 'success',
                    confirmButtonColor: '#0284C7'
                }).then(() => {
                    window.location.reload();
                });
            } else {
                alert(`Tarik Data Berhasil! Durasi: ${duration}ms.`);
                window.location.reload();
            }
        } else {
            if (typeof SwalAlert === 'function') {
                SwalAlert('Gagal Tarik Data', data.message || 'Terjadi kesalahan saat menarik data dari Host Induk.', 'error');
            } else {
                alert('Gagal Tarik Data: ' + data.message);
            }
        }
    } catch (err) {
        btn.disabled = false;
        btn.innerHTML = origHtml;
        if (typeof SwalAlert === 'function') {
            SwalAlert('Kesalahan Jaringan', `Gagal menghubungi Host Induk: ${err.message}`, 'error');
        } else {
            alert('Kesalahan Jaringan: ' + err.message);
        }
    }
}

function handlePackageFileSelect(input) {
    const label = document.getElementById('packageFileLabel') || document.getElementById('sqlFileLabel');
    const submitBtn = document.getElementById('btn-submit-upload-package') || document.getElementById('btn-submit-upload-sql');
    if (input.files && input.files[0]) {
        const file = input.files[0];
        const isZip = file.name.endsWith('.zip');
        const icon = isZip ? 'fa-file-archive text-amber-400' : 'fa-file-code text-cyan-400';
        label.innerHTML = `<span class="text-emerald-300 font-bold"><i class="fas ${icon} mr-1"></i>${file.name}</span> (${(file.size / 1024).toFixed(1)} KB)`;
        submitBtn.disabled = false;
    } else {
        label.innerText = 'Pilih atau Drag & Drop berkas paket (.zip) atau naskah SQL (.sql) dari Child';
        submitBtn.disabled = true;
    }
}

function handleSqlFileSelect(input) {
    handlePackageFileSelect(input);
}

document.getElementById('form-upload-package-sync')?.addEventListener('submit', function(e) {
    const fileInput = document.getElementById('packageFileInput');
    if (!fileInput.files || !fileInput.files[0]) {
        e.preventDefault();
        if (typeof SwalAlert === 'function') {
            SwalAlert('Berkas Belum Dipilih', 'Silakan pilih berkas paket (.zip) atau SQL terlebih dahulu sebelum menjalankan sinkronisasi.', 'warning');
        }
    }
});

document.getElementById('form-upload-sql-sync')?.addEventListener('submit', function(e) {
    const fileInput = document.getElementById('sqlFileInput');
    if (!fileInput.files || !fileInput.files[0]) {
        e.preventDefault();
        if (typeof SwalAlert === 'function') {
            SwalAlert('File Belum Dipilih', 'Silakan pilih berkas SQL terlebih dahulu sebelum menjalankan sinkronisasi.', 'warning');
        }
    }
});

// =========================================================================
// EXISTING BASE URL & RESET MODAL LOGIC
// =========================================================================

function detectCurrentHost() {
    const origin = window.location.origin;
    document.getElementById('baseUrlInput').value = origin;
    updatePreviewUrl(origin);
}

document.getElementById('baseUrlInput')?.addEventListener('input', function(e) {
    updatePreviewUrl(e.target.value);
});

function updatePreviewUrl(val) {
    const clean = val.replace(/\/+$/, '');
    document.getElementById('preview-api-url').innerText = `${clean}/api/tasks`;
    document.getElementById('code-snippet').innerText = `curl -X GET "${clean}/api/tasks?pageSize=10" \\\n  -H "Accept: application/json"`;
}

function copyCodeSnippet() {
    const text = document.getElementById('code-snippet').innerText;
    navigator.clipboard.writeText(text).then(() => {
        if (typeof SwalAlert === 'function') {
            SwalAlert('Tersalin', 'Snippet perintah cURL berhasil disalin ke clipboard!', 'success');
        } else {
            alert('Snippet perintah cURL berhasil disalin!');
        }
    });
}

function openResetModal() {
    document.getElementById('reset-modal').classList.remove('hidden');
    document.getElementById('confirmationInput').value = '';
    document.getElementById('btn-execute-reset').disabled = true;
}

function closeResetModal() {
    document.getElementById('reset-modal').classList.add('hidden');
}

function validateResetCode() {
    const val = document.getElementById('confirmationInput').value.trim();
    const btn = document.getElementById('btn-execute-reset');
    btn.disabled = (val !== 'RESET-CONFIRM');
}

async function previewSqlDump() {
    const modal = document.getElementById('sql-preview-modal');
    const contentEl = document.getElementById('sql-preview-content');
    const subtitleEl = document.getElementById('sql-preview-subtitle');
    const metaEl = document.getElementById('sql-preview-meta');

    modal.classList.remove('hidden');
    contentEl.innerText = 'Sedang membuat skrip SQL DDL & data... Mohon tunggu.';
    metaEl.innerText = 'Generating...';

    try {
        const res = await fetch('/Configuration/GetSqlPreview');
        const data = await res.json();
        if (data.success) {
            fullSqlText = data.preview;
            contentEl.innerText = data.preview;
            subtitleEl.innerText = `Skrip DDL & Data (${(data.totalLength / 1024).toFixed(1)} KB)`;
            metaEl.innerText = `${(data.totalLength / 1024).toFixed(1)} KB`;
        } else {
            contentEl.innerText = 'Gagal memuat SQL preview: ' + (data.message || 'Unknown error');
            metaEl.innerText = 'Error';
        }
    } catch (err) {
        contentEl.innerText = 'Terjadi kesalahan koneksi saat memuat SQL preview: ' + err.message;
        metaEl.innerText = 'Connection Error';
    }
}

function closeSqlPreviewModal() {
    document.getElementById('sql-preview-modal').classList.add('hidden');
}

function copySqlPreview() {
    if (!fullSqlText) return;
    navigator.clipboard.writeText(fullSqlText).then(() => {
        const btn = document.getElementById('btn-copy-sql');
        const orig = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-check text-emerald-500"></i><span>Tersalin!</span>';
        setTimeout(() => { btn.innerHTML = orig; }, 2000);
        if (typeof SwalAlert === 'function') {
            SwalAlert('Tersalin', 'Skrip SQL berhasil disalin ke clipboard!', 'success');
        }
    });
}

function selectAndApplyFont(fontId) {
    if (typeof ThemeManager !== 'undefined') {
        ThemeManager.setGlobalFont(fontId, true);
    }
}

// Ensure active font is highlighted on page load
document.addEventListener('DOMContentLoaded', function () {
    const savedFont = localStorage.getItem('app_font') || '@currentAppFont' || 'inter';
    if (typeof ThemeManager !== 'undefined') {
        ThemeManager.applyFont(savedFont);
    }
});

document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
        closeResetModal();
        closeSqlPreviewModal();
    }
});
</script>
