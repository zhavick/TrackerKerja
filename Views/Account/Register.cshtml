@model TrackerKerja.ViewModels.RegisterViewModel
@{
    Layout = null;
    var companies = (List<TrackerKerja.Models.Company>?)ViewBag.Companies ?? new List<TrackerKerja.Models.Company>();
}
<!DOCTYPE html>
<html lang="id" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Daftar Akun & Perusahaan — Work Tracker Pro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .glass { background: rgba(255,255,255,0.92); backdrop-filter: blur(24px); }
        .input-field { transition: all 0.2s; }
        .input-field:focus { transform: translateY(-1px); box-shadow: 0 4px 20px rgba(16,185,129,0.15); }
        .floating-shape { animation: float 6s ease-in-out infinite; }
        @@keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-15px); }
        }
        .btn-register { transition: all 0.3s; }
        .btn-register:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(16,185,129,0.35); }
    </style>
</head>
<body class="min-h-full bg-gradient-to-br from-emerald-950 via-teal-900 to-slate-950 flex items-center justify-center p-4 relative overflow-x-hidden">

    <!-- Decorative shapes -->
    <div class="floating-shape absolute top-10 right-20 w-80 h-80 rounded-full bg-emerald-500/10 blur-3xl pointer-events-none"></div>
    <div class="floating-shape absolute bottom-10 left-20 w-72 h-72 rounded-full bg-teal-500/10 blur-3xl pointer-events-none"></div>

    <!-- Register Card -->
    <div class="glass border border-white/30 rounded-3xl shadow-2xl w-full max-w-xl p-8 sm:p-10 relative z-10 my-8">
        <!-- Logo -->
        <div class="text-center mb-6">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center mx-auto mb-3 shadow-xl shadow-emerald-500/30">
                <i class="fas fa-building-user text-white text-xl"></i>
            </div>
            <h1 class="text-2xl font-black text-slate-800">Daftar Akun Tim / Perusahaan</h1>
            <p class="text-slate-500 text-sm mt-1">Sistem Workspace & Multi-Tenant Terisolasi</p>
        </div>

        <!-- Admin Approval Notice -->
        <div class="mb-5 p-3.5 bg-amber-500/10 border border-amber-500/20 rounded-2xl flex items-start gap-2.5 text-xs text-amber-900">
            <i class="fas fa-shield-halved text-amber-600 mt-0.5 text-sm flex-shrink-0"></i>
            <span>Untuk keamanan workspace bersama, pendaftaran akun baru memerlukan <strong>persetujuan (approval) Administrator</strong> sebelum akun dapat digunakan untuk login.</span>
        </div>

        <!-- Errors -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="mb-5 p-4 bg-red-50 border border-red-200 rounded-2xl text-red-700 text-sm">
                @Html.ValidationSummary(true, null, new { @class = "list-disc pl-4" })
            </div>
        }

        <form method="post" asp-action="Register" asp-controller="Account">
            @Html.AntiForgeryToken()
            <input type="hidden" name="CompanyOption" id="companyOptionInput" value="@(Model?.CompanyOption ?? "new")" />

            <!-- STEP 1: Profil Pengguna -->
            <div class="mb-5 pb-4 border-b border-slate-200/80">
                <div class="flex items-center gap-2 mb-3 text-xs font-bold uppercase tracking-wider text-slate-400">
                    <i class="fas fa-user-circle text-emerald-500"></i> Informasi Pengguna
                </div>

                <!-- Full Name -->
                <div class="mb-3.5">
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">
                        Nama Lengkap <span class="text-red-500">*</span>
                    </label>
                    <input type="text" name="FullName" value="@Model?.FullName" required placeholder="Nama lengkap Anda"
                           class="input-field w-full px-4 py-2.5 rounded-xl border border-emerald-200 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-400 text-slate-800 text-sm">
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                    <!-- Email -->
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5">
                            Email Kerja <span class="text-red-500">*</span>
                        </label>
                        <input type="email" name="Email" value="@Model?.Email" required placeholder="nama@perusahaan.com"
                               class="input-field w-full px-4 py-2.5 rounded-xl border border-emerald-200 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-400 text-slate-800 text-sm">
                    </div>

                    <!-- Job Title -->
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5">
                            Jabatan / Posisi <span class="text-red-500">*</span>
                        </label>
                        <input type="text" name="JobTitle" value="@Model?.JobTitle" required placeholder="Contoh: Project Lead"
                               class="input-field w-full px-4 py-2.5 rounded-xl border border-emerald-200 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-400 text-slate-800 text-sm">
                    </div>
                </div>
            </div>

            <!-- STEP 2: Tim / Perusahaan Multi-Tenancy -->
            <div class="mb-5 pb-4 border-b border-slate-200/80">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-1.5">
                        <i class="fas fa-building text-emerald-500"></i> Afiliasi Tim / Perusahaan <span class="text-red-500">*</span>
                    </span>
                </div>

                <!-- Company Option Selector Tabs -->
                <div class="grid grid-cols-2 gap-2 p-1 bg-slate-100/90 rounded-2xl mb-3.5 border border-slate-200">
                    <button type="button" onclick="setCompanyMode('new')" id="tabModeNew"
                            class="py-2 px-3 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5 bg-white text-emerald-700 shadow-sm">
                        <i class="fas fa-sparkles text-emerald-500"></i> Buat Tim / Baru
                    </button>
                    <button type="button" onclick="setCompanyMode('existing')" id="tabModeExisting"
                            class="py-2 px-3 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5 text-slate-500 hover:text-slate-800">
                        <i class="fas fa-users-rectangle"></i> Gabung Tim Terdaftar
                    </button>
                </div>

                <!-- Mode 1: Buat Perusahaan Baru -->
                <div id="companyNewSection" class="space-y-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5">
                            Nama Tim / Perusahaan Baru <span class="text-red-500">*</span>
                        </label>
                        <input type="text" name="NewCompanyName" id="newCompanyNameInput" value="@Model?.NewCompanyName" placeholder="Contoh: PT Sumber Rejeki / Tim Alpha"
                               class="input-field w-full px-4 py-2.5 rounded-xl border border-emerald-200 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-400 text-slate-800 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">
                            Kode Tim / Singkatan <span class="text-slate-400 font-normal">(Opsional)</span>
                        </label>
                        <input type="text" name="NewCompanyCode" value="@Model?.NewCompanyCode" placeholder="Contoh: ALPHATEAM"
                               class="input-field w-full px-4 py-2 rounded-xl border border-emerald-200 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-400 text-slate-800 text-xs">
                    </div>
                </div>

                <!-- Mode 2: Gabung Perusahaan Terdaftar -->
                <div id="companyExistingSection" class="hidden">
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">
                        Pilih Tim / Perusahaan <span class="text-red-500">*</span>
                    </label>
                    <select name="CompanyId" id="companySelectInput" class="w-full px-4 py-2.5 rounded-xl border border-emerald-200 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-400 text-slate-800 text-sm">
                        <option value="">-- Pilih Perusahaan / Tim --</option>
                        @foreach (var c in companies)
                        {
                            <option value="@c.Id" selected="@(Model?.CompanyId == c.Id)">🏢 @c.Name @(!string.IsNullOrEmpty(c.Code) ? $"({c.Code})" : "")</option>
                        }
                    </select>
                </div>
            </div>

            <!-- STEP 3: Keamanan & Password -->
            <div class="mb-6">
                <div class="flex items-center gap-2 mb-3 text-xs font-bold uppercase tracking-wider text-slate-400">
                    <i class="fas fa-lock text-emerald-500"></i> Kata Sandi
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5">
                            Password <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <input type="password" name="Password" id="pwd" required placeholder="Min. 6 karakter"
                                   class="input-field w-full px-4 py-2.5 pr-10 rounded-xl border border-emerald-200 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-400 text-slate-800 text-sm">
                            <button type="button" onclick="togglePwd('pwd','eye1')"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-emerald-500">
                                <i class="fas fa-eye text-sm" id="eye1"></i>
                            </button>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5">
                            Konfirmasi Password <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <input type="password" name="ConfirmPassword" id="pwd2" required placeholder="Ulangi password"
                                   class="input-field w-full px-4 py-2.5 pr-10 rounded-xl border border-emerald-200 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-400 text-slate-800 text-sm">
                            <button type="button" onclick="togglePwd('pwd2','eye2')"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-emerald-500">
                                <i class="fas fa-eye text-sm" id="eye2"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Submit -->
            <button type="submit"
                    class="btn-register w-full bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white font-bold py-3.5 rounded-xl text-sm shadow-lg shadow-emerald-600/25 flex items-center justify-center gap-2 cursor-pointer">
                <i class="fas fa-user-plus"></i> Selesaikan Pendaftaran
            </button>
        </form>

        <p class="text-center text-slate-500 text-xs mt-5">
            Sudah memiliki akun?
            <a href="/Account/Login" class="text-emerald-600 font-bold hover:text-emerald-800 transition-colors">Masuk di sini</a>
        </p>
    </div>

    <script>
        function togglePwd(fieldId, iconId) {
            const f = document.getElementById(fieldId);
            const i = document.getElementById(iconId);
            f.type = f.type === 'password' ? 'text' : 'password';
            i.className = f.type === 'password' ? 'fas fa-eye text-sm' : 'fas fa-eye-slash text-sm';
        }

        function setCompanyMode(mode) {
            const hiddenInput = document.getElementById('companyOptionInput');
            const tabNew = document.getElementById('tabModeNew');
            const tabExisting = document.getElementById('tabModeExisting');
            const secNew = document.getElementById('companyNewSection');
            const secExisting = document.getElementById('companyExistingSection');
            const newNameInput = document.getElementById('newCompanyNameInput');
            const selectInput = document.getElementById('companySelectInput');

            hiddenInput.value = mode;

            if (mode === 'new') {
                tabNew.className = 'py-2 px-3 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5 bg-white text-emerald-700 shadow-sm';
                tabExisting.className = 'py-2 px-3 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5 text-slate-500 hover:text-slate-800';
                secNew.classList.remove('hidden');
                secExisting.classList.add('hidden');
                if (newNameInput) newNameInput.required = true;
                if (selectInput) selectInput.required = false;
            } else {
                tabExisting.className = 'py-2 px-3 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5 bg-white text-emerald-700 shadow-sm';
                tabNew.className = 'py-2 px-3 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5 text-slate-500 hover:text-slate-800';
                secExisting.classList.remove('hidden');
                secNew.classList.add('hidden');
                if (newNameInput) newNameInput.required = false;
                if (selectInput) selectInput.required = true;
            }
        }

        // Init based on model
        const currentOption = '@(Model?.CompanyOption ?? "new")';
        setCompanyMode(currentOption === 'existing' ? 'existing' : 'new');
    </script>
</body>
</html>
