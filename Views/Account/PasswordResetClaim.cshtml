@model TrackerKerja.ViewModels.PasswordResetClaimViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="id" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Klaim Reset Kata Sandi — Work Tracker Pro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        .glass { background: rgba(255,255,255,0.96); backdrop-filter: blur(24px); }
        .floating-shape { animation: float 6s ease-in-out infinite; }
        @@keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-15px); }
        }
        .btn-gradient {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 50%, #4338ca 100%);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .btn-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 25px -4px rgba(79, 70, 229, 0.4);
        }
    </style>
</head>
<body class="min-h-full bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-900 flex items-center justify-center p-4 relative overflow-x-hidden">

    <!-- Decorative floating shapes -->
    <div class="floating-shape absolute top-12 right-20 w-80 h-80 rounded-full bg-indigo-500/15 blur-3xl pointer-events-none"></div>
    <div class="floating-shape absolute bottom-12 left-20 w-72 h-72 rounded-full bg-purple-500/15 blur-3xl pointer-events-none"></div>

    <!-- Main Card -->
    <div class="glass border border-white/40 rounded-3xl shadow-2xl w-full max-w-xl p-8 sm:p-10 relative z-10 my-8">
        
        <!-- Header -->
        <div class="text-center mb-6">
            <div class="w-14 h-14 rounded-2xl @(Model.IsEmailConfigured ? "bg-emerald-500 text-emerald-100" : "bg-gradient-to-br from-amber-500 to-orange-600 text-white") flex items-center justify-center mx-auto mb-3 shadow-xl text-2xl">
                <i class="fas @(Model.IsEmailConfigured ? "fa-envelope-circle-check" : "fa-link")"></i>
            </div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-extrabold uppercase tracking-wider mb-2 @(Model.IsEmailConfigured ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-900 border border-amber-300")">
                <i class="fas @(Model.IsEmailConfigured ? "fa-paper-plane" : "fa-bolt")"></i>
                @(Model.IsEmailConfigured ? "Email Terkirim" : "Tautan Klaim Pengguna (Email SMTP Belum Disetting)")
            </div>
            <h1 class="text-2xl font-black text-slate-800">Klaim Pengaturan Kata Sandi</h1>
            <p class="text-slate-500 text-xs sm:text-sm mt-1">Akun: <strong>@Model.FullName</strong> (@Model.Email)</p>
        </div>

        <!-- Description Box -->
        <div class="mb-5 p-4 @(Model.IsEmailConfigured ? "bg-emerald-50 border-emerald-200 text-emerald-900" : "bg-amber-50 border-amber-200 text-amber-900") border rounded-2xl text-xs leading-relaxed">
            <div class="flex items-start gap-2.5">
                <i class="fas @(Model.IsEmailConfigured ? "fa-circle-info text-emerald-600" : "fa-shield-halved text-amber-600") text-base flex-shrink-0 mt-0.5"></i>
                <div>
                    <span class="font-bold">Informasi Status:</span>
                    <p class="mt-0.5">@Model.Message</p>
                </div>
            </div>
        </div>

        <!-- Claim Link Box -->
        <div class="space-y-4">
            <div class="p-4 bg-slate-900 rounded-2xl border border-slate-700 text-white relative">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-[11px] font-mono uppercase tracking-wider text-slate-400 flex items-center gap-1.5">
                        <i class="fas fa-lock text-indigo-400"></i>
                        <span>Tautan Klaim Langsung (Secure Claim URL)</span>
                    </span>
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-indigo-500/30 text-indigo-300 border border-indigo-500/40">
                        Expired: 15 Menit
                    </span>
                </div>
                <div class="bg-black/40 rounded-xl p-3 font-mono text-[11px] text-amber-300 break-all select-all border border-white/10" id="claimUrlBox">
                    @Model.ClaimUrl
                </div>
                <div class="mt-3 flex items-center justify-between gap-2 pt-2 border-t border-white/10">
                    <span class="text-[10px] text-slate-400 font-mono">
                        Dibuat: @Model.GeneratedAt.ToString("HH:mm:ss") &bull; Berlaku s/d: @Model.ExpiresAt.ToString("HH:mm:ss")
                    </span>
                    <button type="button" 
                            onclick="copyClaimUrl()" 
                            class="px-3 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer">
                        <i class="fas fa-copy text-xs" id="copyIcon"></i>
                        <span id="copyBtnText">Salin Tautan</span>
                    </button>
                </div>
            </div>

            <!-- Direct Action Button -->
            <a href="@Model.ClaimUrl" 
               class="btn-gradient w-full text-white font-black py-4 px-6 rounded-2xl text-sm shadow-xl flex items-center justify-center gap-2 cursor-pointer text-center">
                <span>Buka Formulir Reset Kata Sandi Sekarang</span>
                <i class="fas fa-arrow-right text-xs"></i>
            </a>

            <!-- Security Lockout Policy Warning -->
            <div class="p-4 bg-rose-50 border border-rose-200 rounded-2xl text-rose-800 text-xs space-y-1.5">
                <div class="flex items-center gap-2 font-black text-rose-700">
                    <i class="fas fa-triangle-exclamation"></i>
                    <span>Kebijakan Keamanan Akun & Lockout:</span>
                </div>
                <p class="text-[11px] text-rose-900/90 leading-relaxed">
                    1. Tautan klaim ini memiliki masa kedaluwarsa <strong>15 menit</strong> sejak diterbitkan.<br />
                    2. Jika tautan <strong>telah kedaluwarsa</strong> atau Anda melakukan kesalahan input/re-entry konfirmasi kata sandi sebanyak <strong>3 kali</strong> berturut-turut, akun Anda akan otomatis <strong>DIKUNCI selama 30 menit</strong> demi melindungi keamanan data.<br />
                    3. Jika akun terkunci, silakan hubungi Administrator untuk membuka kunci akun Anda.
                </p>
            </div>
        </div>

        <!-- Back to Login -->
        <div class="mt-6 pt-5 border-t border-slate-200/80 text-center">
            <a href="/Account/Login" class="text-xs font-bold text-slate-500 hover:text-slate-700 flex items-center justify-center gap-1.5 transition-colors">
                <i class="fas fa-arrow-left text-xs"></i>
                <span>Kembali ke Halaman Masuk (Login)</span>
            </a>
        </div>
    </div>

    <script>
        function copyClaimUrl() {
            const urlText = document.getElementById('claimUrlBox').innerText.trim();
            navigator.clipboard.writeText(urlText).then(() => {
                const btnText = document.getElementById('copyBtnText');
                const copyIcon = document.getElementById('copyIcon');
                btnText.innerText = 'Tersalin!';
                copyIcon.className = 'fas fa-check text-xs';
                setTimeout(() => {
                    btnText.innerText = 'Salin Tautan';
                    copyIcon.className = 'fas fa-copy text-xs';
                }, 2500);
            });
        }
    </script>
</body>
</html>
