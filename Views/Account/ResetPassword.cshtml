@model TrackerKerja.ViewModels.ResetPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="id" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Setel Kata Sandi Baru — Work Tracker Pro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .glass { background: rgba(255,255,255,0.96); backdrop-filter: blur(24px); }
        .input-field { transition: all 0.2s; }
        .input-field:focus { transform: translateY(-1px); box-shadow: 0 4px 20px rgba(99,102,241,0.15); }
        .floating-shape { animation: float 6s ease-in-out infinite; }
        @@keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-15px); }
        }
        .btn-gradient {
            background: linear-gradient(135deg, #10b981 0%, #059669 50%, #047857 100%);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .btn-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 25px -4px rgba(16, 185, 129, 0.4);
        }
    </style>
</head>
<body class="min-h-full bg-gradient-to-br from-slate-950 via-teal-950 to-slate-900 flex items-center justify-center p-4 relative overflow-x-hidden">

    <!-- Decorative floating shapes -->
    <div class="floating-shape absolute top-12 right-20 w-80 h-80 rounded-full bg-emerald-500/15 blur-3xl pointer-events-none"></div>
    <div class="floating-shape absolute bottom-12 left-20 w-72 h-72 rounded-full bg-teal-500/15 blur-3xl pointer-events-none"></div>

    <!-- Main Card -->
    <div class="glass border border-white/40 rounded-3xl shadow-2xl w-full max-w-lg p-8 sm:p-10 relative z-10 my-8">
        
        <!-- Header -->
        <div class="text-center mb-6">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center mx-auto mb-3 shadow-xl shadow-emerald-500/30 text-white text-2xl">
                <i class="fas fa-shield-cat"></i>
            </div>
            <h1 class="text-2xl font-black text-slate-800">Formulir Kata Sandi Baru</h1>
            <p class="text-slate-500 text-xs sm:text-sm mt-1">Buat kata sandi baru yang aman untuk akun Anda</p>
        </div>

        <!-- Security Warning & Re-entry Policy -->
        <div class="mb-5 p-4 bg-amber-500/10 border border-amber-500/30 rounded-2xl space-y-1.5 text-xs text-amber-950">
            <div class="flex items-center gap-2 font-black text-amber-800">
                <i class="fas fa-triangle-exclamation"></i>
                <span>Kebijakan Keamanan Re-Entry & Lockout:</span>
            </div>
            <p class="text-[11px] text-amber-900/90 leading-relaxed">
                Harap teliti saat memasukkan dan mengonfirmasi kata sandi. <strong>Jika salah re-entry sebanyak 3 kali</strong> atau token klaim telah <strong>kedaluwarsa (15 menit)</strong>, akun Anda akan otomatis <strong>DIKUNCI</strong> demi pencegahan peretasan.
            </p>
        </div>

        <!-- Error Alert -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="mb-5 p-4 bg-rose-50 border border-rose-200 rounded-2xl text-rose-700 text-xs">
                <div class="flex items-start gap-2.5">
                    <i class="fas fa-circle-xmark text-base flex-shrink-0 mt-0.5"></i>
                    <div>
                        <span class="font-bold">Gagal Memperbarui Kata Sandi:</span>
                        <div class="mt-1">
                            @Html.ValidationSummary(true, null, new { @class = "list-disc pl-4" })
                            <span asp-validation-for="Password" class="block font-medium"></span>
                            <span asp-validation-for="ConfirmPassword" class="block font-medium"></span>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Reset Password Form -->
        <form method="post" asp-action="ResetPassword" asp-controller="Account" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <!-- Email Display -->
            <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
                    <i class="fas fa-user-circle text-slate-400"></i>
                    <span>Akun Terverifikasi</span>
                </label>
                <div class="px-4 py-3 bg-slate-100 rounded-2xl border border-slate-200 text-slate-700 text-sm font-semibold flex items-center justify-between">
                    <span>@Model.Email</span>
                    <i class="fas fa-badge-check text-emerald-500"></i>
                </div>
            </div>

            <!-- New Password -->
            <div>
                <label for="password-input" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
                    <i class="fas fa-lock text-emerald-600"></i>
                    <span>Kata Sandi Baru</span>
                </label>
                <div class="relative">
                    <input type="password" 
                           id="password-input" 
                           asp-for="Password" 
                           required 
                           autocomplete="new-password"
                           placeholder="Minimal 6 karakter..." 
                           class="input-field w-full px-4 py-3 pl-11 pr-11 rounded-2xl border border-slate-300 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:border-emerald-500 font-medium transition-all" />
                    <i class="fas fa-key absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                    <button type="button" 
                            onclick="togglePassword('password-input', 'eye1')" 
                            class="absolute right-3 top-1/2 -translate-y-1/2 w-8 h-8 rounded-xl text-slate-400 hover:text-emerald-600 flex items-center justify-center transition-all cursor-pointer">
                        <i class="fas fa-eye text-xs" id="eye1"></i>
                    </button>
                </div>
            </div>

            <!-- Confirm New Password (Re-entry) -->
            <div>
                <label for="confirm-input" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
                    <i class="fas fa-shield-check text-emerald-600"></i>
                    <span>Konfirmasi Kata Sandi Baru (Re-Entry)</span>
                </label>
                <div class="relative">
                    <input type="password" 
                           id="confirm-input" 
                           asp-for="ConfirmPassword" 
                           required 
                           autocomplete="new-password"
                           placeholder="Ulangi kata sandi baru..." 
                           class="input-field w-full px-4 py-3 pl-11 pr-11 rounded-2xl border border-slate-300 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:border-emerald-500 font-medium transition-all" />
                    <i class="fas fa-rotate-right absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                    <button type="button" 
                            onclick="togglePassword('confirm-input', 'eye2')" 
                            class="absolute right-3 top-1/2 -translate-y-1/2 w-8 h-8 rounded-xl text-slate-400 hover:text-emerald-600 flex items-center justify-center transition-all cursor-pointer">
                        <i class="fas fa-eye text-xs" id="eye2"></i>
                    </button>
                </div>
            </div>

            <button type="submit" 
                    class="btn-gradient w-full text-white font-black py-4 px-6 rounded-2xl text-sm shadow-xl flex items-center justify-center gap-2 cursor-pointer mt-4">
                <i class="fas fa-check-circle text-sm"></i>
                <span>Simpan Kata Sandi Baru</span>
            </button>
        </form>

        <!-- Back to Login -->
        <div class="mt-6 pt-5 border-t border-slate-200/80 text-center">
            <a href="/Account/Login" class="text-xs font-bold text-slate-500 hover:text-slate-700 flex items-center justify-center gap-1.5 transition-colors">
                <i class="fas fa-arrow-left text-xs"></i>
                <span>Batalkan & Kembali ke Halaman Masuk</span>
            </a>
        </div>
    </div>

    <script>
        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (!input || !icon) return;
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'fas fa-eye-slash text-xs text-emerald-600';
            } else {
                input.type = 'password';
                icon.className = 'fas fa-eye text-xs text-slate-400';
            }
        }
    </script>
</body>
</html>
