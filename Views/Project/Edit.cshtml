@model TrackerKerja.Models.Project
@{
    ViewData["Title"] = $"Edit Proyek - {Model.Name}";
    var colors = new[] { "#6366F1","#06B6D4","#10B981","#F59E0B","#EF4444","#8B5CF6","#EC4899" };
    var managers = ViewBag.Managers as List<TrackerKerja.Models.AppUser> ?? new List<TrackerKerja.Models.AppUser>();
    var companies = ViewBag.Companies as List<TrackerKerja.Models.Company> ?? new();
}

<div class="w-full space-y-6">

    <!-- Top Executive Header Banner (Full Width) -->
    <div class="bg-gradient-to-r from-amber-600 via-orange-600 to-rose-600 rounded-3xl p-5 sm:p-6 text-white shadow-xl border border-orange-500/30 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-start sm:items-center gap-4 min-w-0">
            <div class="w-12 h-12 rounded-2xl bg-white/20 backdrop-blur-md flex items-center justify-center text-white text-xl shadow-inner shrink-0 border border-white/30">
                <i class="fas fa-folder-open"></i>
            </div>
            <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2 mb-1">
                    <a href="/Project" class="text-amber-100 hover:text-white text-xs font-semibold flex items-center gap-1 transition-colors">
                        <i class="fas fa-arrow-left text-[10px]"></i> Daftar Proyek
                    </a>
                    <span class="text-amber-200/60 text-xs">/</span>
                    <a href="/Project/Detail/@Model.Id" class="text-amber-100 hover:text-white text-xs font-semibold transition-colors">
                        Detail Proyek
                    </a>
                    <span class="text-amber-200/60 text-xs">•</span>
                    <span class="bg-white/20 text-white font-mono text-xs px-2.5 py-0.5 rounded-lg font-bold">ID: #@Model.Id</span>
                    <span class="bg-black/20 text-white text-xs px-2.5 py-0.5 rounded-lg font-bold">@Model.Status</span>
                </div>
                <h1 class="text-xl sm:text-2xl font-black text-white tracking-tight truncate" title="@Model.Name">
                    Edit Proyek: @Model.Name
                </h1>
                <p class="text-xs text-amber-100 mt-0.5 truncate">
                    @(string.IsNullOrEmpty(Model.ClientName) ? "Internal Project" : $"Klien: {Model.ClientName}") 
                    @(Model.Budget.HasValue ? $"• Budget: Rp {Model.Budget.Value:N0}" : "")
                </p>
            </div>
        </div>
        <div class="flex items-center gap-3 shrink-0">
            <a href="/Project/Detail/@Model.Id" class="px-4 py-2.5 rounded-xl bg-white/20 hover:bg-white/30 text-white text-xs font-bold transition-all border border-white/30 flex items-center gap-1.5 shadow-xs">
                <i class="fas fa-arrow-left"></i>
                <span>Kembali ke Detail</span>
            </a>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-700 text-xs shadow-xs">
            <div class="flex items-center gap-2 font-bold mb-1">
                <i class="fas fa-exclamation-circle text-rose-500 text-sm"></i>
                <span>Terdapat kendala validasi pada formulir:</span>
            </div>
            <ul class="list-disc list-inside space-y-0.5 text-rose-600 font-medium">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <!-- Main Edit Form (2-Column Studio Layout) -->
    <form id="editProjectForm" method="post" action="/Project/Edit/@Model.Id" class="space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

            <!-- ========================================== -->
            <!-- LEFT COLUMN: MAIN PROJECT STREAM (8 COLS)  -->
            <!-- ========================================== -->
            <div class="lg:col-span-8 space-y-6">

                <!-- Card 1: Nama & Deskripsi Proyek -->
                <div class="bg-white rounded-3xl shadow-sm border border-slate-200/80 overflow-hidden">
                    <div class="bg-gradient-to-r from-amber-500 via-orange-500 to-rose-500 px-6 py-4 flex items-center justify-between text-white">
                        <div class="flex items-center gap-2.5">
                            <i class="fas fa-project-diagram text-lg"></i>
                            <h2 class="font-bold text-base">Informasi Pokok &amp; Ruang Lingkup</h2>
                        </div>
                        <span class="text-xs bg-white/20 px-2.5 py-0.5 rounded-md font-mono">ID: #@Model.Id</span>
                    </div>

                    <div class="p-6 space-y-5">
                        <!-- Project Name -->
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                                <i class="fas fa-folder text-amber-500 mr-1.5"></i>Nama Proyek <span class="text-red-500">*</span>
                            </label>
                            <input type="text" name="Name" value="@Model.Name" required
                                   placeholder="Contoh: Redesign Aplikasi Mobile HRIS"
                                   class="w-full px-4 py-3 rounded-2xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500 text-slate-800 text-base font-semibold transition-all shadow-2xs">
                        </div>

                        <!-- Description -->
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                                <i class="fas fa-align-left text-slate-500 mr-1.5"></i>Deskripsi &amp; Ruang Lingkup Proyek
                            </label>
                            <textarea name="Description" rows="5"
                                      placeholder="Jelaskan ringkasan objektif, deliverable utama, dan batasan pekerjaan proyek ini..."
                                      class="w-full px-4 py-3 rounded-2xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500 text-slate-800 text-sm transition-all resize-y shadow-2xs">@Model.Description</textarea>
                        </div>

                        <!-- Tags / Labels -->
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                                <i class="fas fa-tags text-purple-500 mr-1.5"></i>Label / Kategori / Tags
                            </label>
                            <input type="text" name="Tags" value="@Model.Tags"
                                   placeholder="Pisahkan dengan koma, contoh: Mobile, Android, iOS, High-Priority"
                                   class="w-full px-4 py-3 rounded-2xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-purple-500 text-slate-800 text-sm transition-all shadow-2xs">
                            <p class="text-[11px] text-slate-400 mt-1.5">Gunakan tag untuk mengelompokkan proyek berdasarkan teknologi atau inisiatif bisnis.</p>
                        </div>
                    </div>
                </div>

                <!-- Card 2: Finansial & Stakeholder Proyek -->
                <div class="bg-white rounded-3xl shadow-sm border border-slate-200/80 overflow-hidden">
                    <div class="bg-slate-100 px-6 py-4 border-b border-slate-200 flex items-center justify-between text-slate-700">
                        <div class="flex items-center gap-2">
                            <i class="fas fa-coins text-emerald-600"></i>
                            <h3 class="font-bold text-sm">Finansial &amp; Stakeholder Proyek</h3>
                        </div>
                        <span class="text-xs text-slate-400">Budgeting & Cost</span>
                    </div>

                    <div class="p-6">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <!-- Client Name -->
                            <div class="sm:col-span-2">
                                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                                    <i class="fas fa-building text-amber-500 mr-1.5"></i>Nama Klien / Stakeholder
                                </label>
                                <input type="text" name="ClientName" value="@Model.ClientName"
                                       placeholder="Contoh: PT Wahana Makmur Sejahtera"
                                       class="w-full px-4 py-3 rounded-2xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500 text-slate-800 text-sm transition-all shadow-2xs">
                            </div>

                            <!-- Budget -->
                            <div>
                                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                                    <i class="fas fa-coins text-emerald-500 mr-1.5"></i>Anggaran / Budget (Rp)
                                </label>
                                <div class="relative">
                                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 font-semibold text-sm">Rp</span>
                                    <input type="number" name="Budget" value="@(Model.Budget.HasValue ? Model.Budget.Value.ToString("0") : "")" step="100000" min="0"
                                           placeholder="Contoh: 50000000"
                                           class="w-full pl-12 pr-4 py-3 rounded-2xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 text-slate-800 text-sm transition-all font-mono shadow-2xs">
                                </div>
                            </div>

                            <!-- Actual Cost -->
                            <div>
                                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                                    <i class="fas fa-receipt text-rose-500 mr-1.5"></i>Realisasi Biaya Aktual (Rp)
                                </label>
                                <div class="relative">
                                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 font-semibold text-sm">Rp</span>
                                    <input type="number" name="ActualCost" value="@(Model.ActualCost.HasValue ? Model.ActualCost.Value.ToString("0") : "0")" step="100000" min="0"
                                           placeholder="Contoh: 15000000"
                                           class="w-full pl-12 pr-4 py-3 rounded-2xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-rose-500 text-slate-800 text-sm transition-all font-mono shadow-2xs">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- ============================================== -->
            <!-- RIGHT COLUMN: SIDEBAR INSPECTOR (4 COLS)       -->
            <!-- ============================================== -->
            <div class="lg:col-span-4 space-y-6 lg:sticky lg:top-4">

                <!-- Card 1: Status & Pengelolaan Tim -->
                <div class="bg-white rounded-3xl shadow-sm border border-slate-200/80 overflow-hidden">
                    <div class="bg-slate-100 px-5 py-3.5 border-b border-slate-200 text-slate-700">
                        <span class="font-bold text-xs uppercase tracking-wider flex items-center gap-2">
                            <i class="fas fa-sliders-h text-amber-500"></i>Status &amp; Penugasan
                        </span>
                    </div>

                    <div class="p-5 space-y-4">
                        <!-- Status -->
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                                Status Proyek
                            </label>
                            <select name="Status" class="select2 w-full" data-placeholder="Pilih Status">
                                <option value="Active" selected="@(Model.Status == TrackerKerja.Models.ProjectStatus.Active)">🟢 Aktif / In Progress</option>
                                <option value="Completed" selected="@(Model.Status == TrackerKerja.Models.ProjectStatus.Completed)">✅ Selesai (Completed)</option>
                                <option value="Archived" selected="@(Model.Status == TrackerKerja.Models.ProjectStatus.Archived)">📦 Diarsipkan (Archived)</option>
                            </select>
                        </div>

                        <!-- Project Manager -->
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                                <i class="fas fa-user-tie text-indigo-500 mr-1.5"></i>Project Manager (PM)
                            </label>
                            <select name="ProjectManagerId" class="select2 w-full" data-placeholder="Pilih Project Manager">
                                <option value="">-- Pilih Project Manager --</option>
                                @foreach (var mgr in managers)
                                {
                                    <option value="@mgr.Id" selected="@(Model.ProjectManagerId == mgr.Id)">
                                        @mgr.FullName (@(string.IsNullOrEmpty(mgr.JobTitle) ? mgr.Email : mgr.JobTitle))
                                    </option>
                                }
                            </select>
                        </div>

                        <!-- Company (If Admin) -->
                        @if (User.IsInRole("Admin") && companies.Any())
                        {
                            <div>
                                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                                    <i class="fas fa-building text-amber-500 mr-1.5"></i>Perusahaan Pemilik Proyek <span class="text-red-500">*</span>
                                </label>
                                <select name="CompanyId" class="select2 w-full" data-placeholder="Pilih Perusahaan">
                                    @foreach (var c in companies)
                                    {
                                        <option value="@c.Id" selected="@(Model.CompanyId == c.Id)">
                                            🏢 @c.Name @(!string.IsNullOrEmpty(c.Code) ? $"[{c.Code}]" : "")
                                        </option>
                                    }
                                </select>
                            </div>
                        }

                        <!-- Deadline -->
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                                <i class="fas fa-calendar-alt text-amber-500 mr-1.5"></i>Target Deadline
                            </label>
                            <input type="date" name="Deadline" value="@(Model.Deadline?.ToString("yyyy-MM-dd"))"
                                   class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500 text-slate-700 text-sm shadow-2xs">
                        </div>
                    </div>
                </div>

                <!-- Card 2: Tema Warna Proyek -->
                <div class="bg-white rounded-3xl shadow-sm border border-slate-200/80 overflow-hidden">
                    <div class="bg-slate-100 px-5 py-3.5 border-b border-slate-200 text-slate-700">
                        <span class="font-bold text-xs uppercase tracking-wider flex items-center gap-2">
                            <i class="fas fa-palette text-rose-500"></i>Tema Warna Proyek
                        </span>
                    </div>

                    <div class="p-5 space-y-3">
                        <div class="flex items-center gap-3">
                            <input type="color" name="Color" value="@(string.IsNullOrEmpty(Model.Color) ? "#6366F1" : Model.Color)"
                                   class="w-10 h-10 rounded-2xl border border-slate-200 cursor-pointer p-0.5 shadow-2xs">
                            <div class="flex items-center gap-2 flex-wrap flex-1">
                                @foreach (var color in colors)
                                {
                                    <button type="button" onclick="document.querySelector('[name=Color]').value='@color'"
                                            class="w-7 h-7 rounded-xl border-2 border-white shadow-2xs hover:scale-110 transition-transform cursor-pointer"
                                            style="background:@color"></button>
                                }
                            </div>
                        </div>
                        <p class="text-[11px] text-slate-400">
                            Warna identitas visual pada kalender, chart analitik, dan kartu proyek.
                        </p>
                    </div>
                </div>

                <!-- Card 3: Aksi Penyimpanan & Penghapusan -->
                <div class="bg-white rounded-3xl shadow-sm border border-slate-200/80 p-5 space-y-3">
                    <button type="submit" form="editProjectForm"
                            class="w-full bg-gradient-to-r from-amber-500 via-orange-500 to-rose-500 hover:from-amber-600 hover:to-orange-600 text-white font-bold py-3.5 px-6 rounded-2xl shadow-lg shadow-orange-200 hover:shadow-orange-300 hover:scale-[1.01] active:scale-[0.99] transition-all text-sm cursor-pointer flex items-center justify-center gap-2">
                        <i class="fas fa-save text-base"></i>
                        <span>Simpan Perubahan Proyek</span>
                    </button>
                    
                    <a href="/Project/Detail/@Model.Id"
                       class="w-full block text-center py-3 px-6 rounded-2xl border border-slate-200 text-slate-600 hover:bg-slate-50 font-semibold text-sm transition-colors">
                        Batal
                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="pt-3 border-t border-slate-100">
                            <button type="button" onclick="if(confirm('Apakah Anda yakin ingin menghapus proyek ini secara permanen? Semua tugas di dalamnya akan terpengaruh.')) { document.getElementById('deleteProjectForm').submit(); }"
                                    class="w-full text-center py-2.5 px-4 rounded-xl text-rose-600 hover:text-rose-700 hover:bg-rose-50 text-xs font-bold transition-all flex items-center justify-center gap-1.5 cursor-pointer">
                                <i class="fas fa-trash-alt text-xs"></i>
                                <span>Hapus Proyek Permanen</span>
                            </button>
                        </div>
                    }
                </div>

            </div>

        </div>
    </form>

    @if (User.IsInRole("Admin"))
    {
        <form id="deleteProjectForm" method="post" action="/Project/Delete/@Model.Id" class="hidden">
            @Html.AntiForgeryToken()
        </form>
    }

</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof window.initAppSelect2 === 'function') {
            window.initAppSelect2();
        }
    });
</script>
}
