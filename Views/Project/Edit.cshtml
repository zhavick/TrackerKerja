@model TrackerKerja.Models.Project
@{
    ViewData["Title"] = $"Edit Proyek - {Model.Name}";
    var colors = new[] { "#6366F1","#06B6D4","#10B981","#F59E0B","#EF4444","#8B5CF6","#EC4899" };
    var managers = ViewBag.Managers as List<TrackerKerja.Models.AppUser> ?? new List<TrackerKerja.Models.AppUser>();
}

<div class="max-w-4xl mx-auto">
    <div class="mb-5 flex items-center justify-between">
        <a href="/Project/Detail/@Model.Id" class="text-indigo-600 hover:text-indigo-800 text-sm font-medium flex items-center gap-1.5 transition-colors">
            <i class="fas fa-arrow-left"></i> Kembali ke Detail Proyek
        </a>
        <span class="text-xs px-3 py-1 bg-slate-100 text-slate-600 rounded-full font-mono">
            ID Proyek: #@Model.Id
        </span>
    </div>

    <div class="bg-white rounded-3xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="bg-gradient-to-r from-amber-500 via-orange-500 to-rose-500 p-8 text-white">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 bg-white/20 backdrop-blur-md rounded-2xl flex items-center justify-center shadow-inner">
                    <i class="fas fa-edit text-2xl text-white"></i>
                </div>
                <div>
                    <h2 class="text-2xl font-black tracking-tight">Edit Informasi Proyek</h2>
                    <p class="text-amber-100 text-sm mt-0.5">Perbarui parameter proyek, anggaran, klien, jadwal, dan Project Manager</p>
                </div>
            </div>
        </div>

        <div class="p-8">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mb-6 p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-700 text-sm">
                    <div class="flex items-center gap-2 font-bold mb-1">
                        <i class="fas fa-exclamation-circle text-rose-500"></i>
                        <span>Terdapat kendala validasi pada formulir:</span>
                    </div>
                    <ul class="list-disc list-inside space-y-0.5 text-xs text-rose-600">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form id="editProjectForm" method="post" action="/Project/Edit/@Model.Id">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@Model.Id" />

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                    @if (User.IsInRole("Admin") && ViewBag.Companies != null)
                    {
                        var companies = ViewBag.Companies as List<TrackerKerja.Models.Company> ?? new();
                        <div class="md:col-span-2">
                            <label class="block text-sm font-bold text-slate-700 mb-2">
                                <i class="fas fa-building text-amber-500 mr-2"></i>Perusahaan / Tim Pemilik Proyek <span class="text-red-500">*</span>
                            </label>
                            <select name="CompanyId" class="select2 w-full" data-placeholder="Pilih Perusahaan">
                                @foreach (var c in companies)
                                {
                                    <option value="@c.Id" selected="@(Model.CompanyId == c.Id)">
                                        🏢 @c.Name @(!string.IsNullOrEmpty(c.Code) ? $"[{c.Code}]" : "")
                                    </option>
                                }
                            </select>
                        </div>
                    }

                    <!-- Project Name -->
                    <div class="md:col-span-2">
                        <label class="block text-sm font-bold text-slate-700 mb-2">
                            <i class="fas fa-folder text-amber-500 mr-2"></i>Nama Proyek <span class="text-red-500">*</span>
                        </label>
                        <input type="text" name="Name" value="@Model.Name" required
                               placeholder="Contoh: Redesign Aplikasi Mobile HRIS"
                               class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500 text-slate-800 transition-all font-medium">
                    </div>

                    <!-- Client Name -->
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">
                            <i class="fas fa-building text-amber-500 mr-2"></i>Nama Klien / Stakeholder
                        </label>
                        <input type="text" name="ClientName" value="@Model.ClientName"
                               placeholder="Contoh: PT Wahana Makmur Sejahtera"
                               class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500 text-slate-800 transition-all">
                    </div>

                    <!-- Project Manager -->
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">
                            <i class="fas fa-user-tie text-indigo-500 mr-2"></i>Project Manager (PM)
                        </label>
                        <select name="ProjectManagerId" class="select2 w-full" data-placeholder="Pilih Project Manager">
                            <option value="">-- Pilih Project Manager --</option>
                            @foreach (var mgr in managers)
                            {
                                <option value="@mgr.Id" selected="@(Model.ProjectManagerId == mgr.Id)">
                                    @mgr.FullName (@(string.IsNullOrEmpty(mgr.JobTitle) ? mgr.Email : mgr.JobTitle))
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Budget -->
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">
                            <i class="fas fa-coins text-emerald-500 mr-2"></i>Anggaran / Budget (Rp)
                        </label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 font-semibold text-sm">Rp</span>
                            <input type="number" name="Budget" value="@(Model.Budget.HasValue ? Model.Budget.Value.ToString("0") : "")" step="100000" min="0"
                                   placeholder="Contoh: 50000000"
                                   class="w-full pl-12 pr-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 text-slate-800 transition-all font-mono">
                        </div>
                    </div>

                    <!-- Actual Cost -->
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">
                            <i class="fas fa-receipt text-rose-500 mr-2"></i>Realisasi Biaya Aktual (Rp)
                        </label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 font-semibold text-sm">Rp</span>
                            <input type="number" name="ActualCost" value="@(Model.ActualCost.HasValue ? Model.ActualCost.Value.ToString("0") : "0")" step="100000" min="0"
                                   placeholder="Contoh: 15000000"
                                   class="w-full pl-12 pr-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-rose-500 text-slate-800 transition-all font-mono">
                        </div>
                    </div>

                    <!-- Deadline -->
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">
                            <i class="fas fa-calendar-alt text-amber-500 mr-2"></i>Target Deadline
                        </label>
                        <input type="date" name="Deadline" value="@(Model.Deadline?.ToString("yyyy-MM-dd"))"
                               class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500 text-slate-700 transition-all">
                    </div>

                    <!-- Status -->
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">
                            <i class="fas fa-toggle-on text-amber-500 mr-2"></i>Status Proyek
                        </label>
                        <select name="Status" class="select2 w-full" data-placeholder="Pilih Status">
                            <option value="Active" selected="@(Model.Status == TrackerKerja.Models.ProjectStatus.Active)">🟢 Aktif / In Progress</option>
                            <option value="Completed" selected="@(Model.Status == TrackerKerja.Models.ProjectStatus.Completed)">✅ Selesai (Completed)</option>
                            <option value="Archived" selected="@(Model.Status == TrackerKerja.Models.ProjectStatus.Archived)">📦 Diarsipkan (Archived)</option>
                        </select>
                    </div>

                    <!-- Tags -->
                    <div class="md:col-span-2">
                        <label class="block text-sm font-bold text-slate-700 mb-2">
                            <i class="fas fa-tags text-purple-500 mr-2"></i>Label / Kategori / Tags
                        </label>
                        <input type="text" name="Tags" value="@Model.Tags"
                               placeholder="Pisahkan dengan koma, contoh: Mobile, Android, iOS, High-Priority"
                               class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-purple-500 text-slate-800 transition-all">
                        <p class="text-xs text-slate-400 mt-1.5">Gunakan tag untuk mengelompokkan proyek berdasarkan teknologi atau inisiatif bisnis.</p>
                    </div>

                    <!-- Description -->
                    <div class="md:col-span-2">
                        <label class="block text-sm font-bold text-slate-700 mb-2">
                            <i class="fas fa-align-left text-slate-500 mr-2"></i>Deskripsi & Ruang Lingkup Proyek
                        </label>
                        <textarea name="Description" rows="4"
                                  placeholder="Jelaskan ringkasan objektif, deliverable utama, dan batasan pekerjaan proyek ini..."
                                  class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500 text-slate-800 transition-all resize-none">@Model.Description</textarea>
                    </div>

                    <!-- Color Picker -->
                    <div class="md:col-span-2">
                        <label class="block text-sm font-bold text-slate-700 mb-2">
                            <i class="fas fa-palette text-rose-500 mr-2"></i>Tema Warna Proyek
                        </label>
                        <div class="flex items-center gap-4 p-3 bg-slate-50 rounded-2xl border border-slate-100">
                            <input type="color" name="Color" value="@(string.IsNullOrEmpty(Model.Color) ? "#6366F1" : Model.Color)"
                                   class="w-12 h-12 rounded-xl border border-slate-200 cursor-pointer p-0.5">
                            <div class="flex gap-2.5 flex-wrap">
                                @foreach (var color in colors)
                                {
                                    <button type="button" onclick="document.querySelector('[name=Color]').value='@color'"
                                            class="w-8 h-8 rounded-full border-2 border-white shadow-sm hover:scale-110 transition-transform cursor-pointer"
                                            style="background:@color"></button>
                                }
                            </div>
                            <span class="text-xs text-slate-500 ml-auto hidden sm:inline">Pilih warna untuk identitas visual proyek pada kalender dan dashboard</span>
                        </div>
                    </div>
                </div>

                <div class="flex items-center justify-between pt-6 border-t border-slate-100">
                    <div>
                        @if (User.IsInRole("Admin"))
                        {
                            <button type="button" onclick="if(confirm('Apakah Anda yakin ingin menghapus proyek ini secara permanen? Semua tugas di dalamnya akan terpengaruh.')) { document.getElementById('deleteProjectForm').submit(); }"
                                    class="text-rose-600 hover:text-rose-800 text-sm font-bold flex items-center gap-1.5 transition-colors cursor-pointer">
                                <i class="fas fa-trash-alt"></i> Hapus Proyek
                            </button>
                        }
                    </div>

                    <div class="flex items-center gap-3">
                        <a href="/Project/Detail/@Model.Id" class="px-6 py-3 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 font-semibold transition-all">
                            Batal
                        </a>
                        <button type="submit" form="editProjectForm"
                                class="px-8 py-3 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white font-bold rounded-xl shadow-md hover:shadow-amber-200 transition-all flex items-center gap-2 cursor-pointer">
                            <i class="fas fa-save"></i>
                            Perbarui Proyek
                        </button>
                    </div>
                </div>
            </form>

            @if (User.IsInRole("Admin"))
            {
                <form id="deleteProjectForm" method="post" action="/Project/Delete/@Model.Id" style="display: none;">
                    @Html.AntiForgeryToken()
                </form>
            }
        </div>
    </div>
</div>
