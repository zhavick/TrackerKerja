@model List<TrackerKerja.Models.JsonHistory>
@{
    ViewData["Title"] = "JSON Tools";
}

<div class="grid grid-cols-1 xl:grid-cols-3 gap-5">

    <!-- JSON Editor Area -->
    <div class="xl:col-span-2 flex flex-col gap-5">

        <!-- Editor Card -->
        <div class="bg-white rounded-2xl shadow-sm border border-indigo-100 overflow-hidden">
            <div class="p-4 border-b border-slate-100 flex items-center justify-between flex-wrap gap-3">
                <h3 class="font-bold text-slate-800 flex items-center gap-2">
                    <i class="fas fa-code text-indigo-500"></i>
                    JSON Editor
                </h3>
                <!-- Action Buttons -->
                <div class="flex items-center gap-2 flex-wrap">
                    <button onclick="formatJson()" id="btn-format"
                            class="flex items-center gap-1.5 bg-indigo-500 hover:bg-indigo-600 text-white text-xs font-semibold px-3 py-2 rounded-lg transition-colors">
                        <i class="fas fa-magic"></i> Format
                    </button>
                    <button onclick="minifyJson()"
                            class="flex items-center gap-1.5 bg-cyan-500 hover:bg-cyan-600 text-white text-xs font-semibold px-3 py-2 rounded-lg transition-colors">
                        <i class="fas fa-compress-alt"></i> Minify
                    </button>
                    <button onclick="validateJson()"
                            class="flex items-center gap-1.5 bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-semibold px-3 py-2 rounded-lg transition-colors">
                        <i class="fas fa-check-circle"></i> Validate
                    </button>
                    <button onclick="toggleTreeView()"
                            class="flex items-center gap-1.5 bg-amber-500 hover:bg-amber-600 text-white text-xs font-semibold px-3 py-2 rounded-lg transition-colors">
                        <i class="fas fa-sitemap"></i> Tree View
                    </button>
                    <button onclick="copyResult()"
                            class="flex items-center gap-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold px-3 py-2 rounded-lg transition-colors">
                        <i class="fas fa-copy"></i> Copy
                    </button>
                    <button onclick="clearEditor()"
                            class="flex items-center gap-1.5 bg-red-50 hover:bg-red-100 text-red-600 text-xs font-semibold px-3 py-2 rounded-lg transition-colors">
                        <i class="fas fa-trash"></i> Clear
                    </button>
                </div>
            </div>

            <!-- Status Bar -->
            <div id="status-bar" class="hidden px-4 py-2 text-xs font-medium flex items-center gap-2"></div>

            <!-- Input -->
            <div class="p-4">
                <label class="block text-xs font-semibold text-slate-500 mb-2 uppercase tracking-wider">Input JSON</label>
                <textarea id="json-input" rows="12" placeholder='Paste JSON Anda di sini...&#10;&#10;Contoh:&#10;{&#10;  "name": "Work Tracker Pro",&#10;  "version": "1.0"&#10;}'
                          class="w-full px-4 py-3 rounded-xl border border-indigo-200 font-mono text-sm text-slate-800 bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:bg-white transition-all resize-none"></textarea>
            </div>

            <!-- Output -->
            <div class="px-4 pb-4" id="output-section">
                <div class="flex items-center justify-between mb-2">
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Output</label>
                    <span id="char-count" class="text-xs text-slate-400"></span>
                </div>
                <pre id="json-output" class="w-full min-h-32 px-4 py-3 rounded-xl border border-emerald-200 bg-emerald-50/50 font-mono text-xs text-slate-800 overflow-x-auto whitespace-pre-wrap word-break hidden"></pre>
                <div id="tree-output" class="hidden w-full min-h-32 px-4 py-3 rounded-xl border border-amber-200 bg-amber-50/50 overflow-x-auto"></div>
            </div>

            <!-- Save Bar -->
            <div class="px-4 pb-4 flex gap-2">
                <input type="text" id="save-name" placeholder="Nama untuk disimpan..."
                       class="flex-1 px-3 py-2 rounded-lg border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400">
                <button onclick="saveJson()"
                        class="flex items-center gap-1.5 bg-gradient-to-r from-indigo-500 to-purple-600 text-white text-sm font-semibold px-4 py-2 rounded-lg hover:shadow-md transition-all">
                    <i class="fas fa-save"></i> Simpan
                </button>
            </div>
        </div>
    </div>

    <!-- History Sidebar -->
    <div class="bg-white rounded-2xl shadow-sm border border-indigo-100 overflow-hidden">
        <div class="p-4 border-b border-slate-100">
            <h3 class="font-bold text-slate-800 flex items-center gap-2">
                <i class="fas fa-history text-amber-500"></i>
                Riwayat JSON
            </h3>
        </div>

        @if (!Model.Any())
        {
            <div class="p-8 text-center">
                <i class="fas fa-history text-slate-200 text-4xl mb-3"></i>
                <p class="text-slate-400 text-sm">Belum ada JSON tersimpan</p>
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-50 max-h-screen overflow-y-auto">
                @foreach (var item in Model)
                {
                    <div class="p-4 hover:bg-indigo-50/30 transition-colors group">
                        <div class="flex items-start justify-between gap-2">
                            <div class="min-w-0 flex-1">
                                <button onclick="loadHistory(@item.Id)" class="text-left w-full">
                                    <p class="text-sm font-semibold text-slate-700 truncate hover:text-indigo-600">@item.Name</p>
                                    <p class="text-xs text-slate-400 mt-0.5">@item.CreatedAt.ToString("dd MMM yyyy HH:mm")</p>
                                    @if (item.Task != null)
                                    {
                                        <span class="inline-flex items-center gap-1 text-xs text-indigo-500 mt-1">
                                            <i class="fas fa-link text-xs"></i>@item.Task.Title
                                        </span>
                                    }
                                    <p class="text-xs text-slate-300 font-mono truncate mt-1">@(item.Content.Length > 50 ? item.Content.Substring(0, 50) + "..." : item.Content)</p>
                                </button>
                            </div>
                            <button onclick="deleteHistory(@item.Id)"
                                    class="opacity-0 group-hover:opacity-100 text-red-400 hover:text-red-600 text-xs transition-all flex-shrink-0 mt-1">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
const input = document.getElementById('json-input');
const output = document.getElementById('json-output');
const treeOutput = document.getElementById('tree-output');
const statusBar = document.getElementById('status-bar');

function showStatus(msg, type) {
    statusBar.className = `px-4 py-2 text-xs font-medium flex items-center gap-2 ${
        type === 'success' ? 'bg-emerald-50 text-emerald-700' :
        type === 'error' ? 'bg-red-50 text-red-700' : 'bg-blue-50 text-blue-700'
    }`;
    statusBar.innerHTML = `<i class="fas fa-${type === 'success' ? 'check-circle' : type === 'error' ? 'times-circle' : 'info-circle'}"></i> ${msg}`;
    statusBar.classList.remove('hidden');
}

async function formatJson() {
    const content = input.value.trim();
    if (!content) { showStatus('Input kosong!', 'error'); return; }
    const res = await fetch('/JsonTools/Format', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content })
    });
    const data = await res.json();
    if (data.success) {
        output.textContent = data.result;
        output.classList.remove('hidden');
        treeOutput.classList.add('hidden');
        document.getElementById('char-count').textContent = `${data.result.length} karakter`;
        showStatus('JSON berhasil diformat!', 'success');
    } else {
        showStatus(data.error, 'error');
    }
}

async function minifyJson() {
    const content = input.value.trim();
    if (!content) { showStatus('Input kosong!', 'error'); return; }
    const res = await fetch('/JsonTools/Minify', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content })
    });
    const data = await res.json();
    if (data.success) {
        output.textContent = data.result;
        output.classList.remove('hidden');
        treeOutput.classList.add('hidden');
        document.getElementById('char-count').textContent = `${data.result.length} karakter`;
        showStatus('JSON berhasil diminify!', 'success');
    } else {
        showStatus(data.error, 'error');
    }
}

async function validateJson() {
    const content = input.value.trim();
    if (!content) { showStatus('Input kosong!', 'error'); return; }
    const res = await fetch('/JsonTools/Validate', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content })
    });
    const data = await res.json();
    showStatus(data.success ? '✅ ' + data.message : '❌ ' + data.error, data.success ? 'success' : 'error');
}

function toggleTreeView() {
    try {
        const content = input.value.trim();
        if (!content) { showStatus('Input kosong!', 'error'); return; }
        const parsed = JSON.parse(content);
        treeOutput.innerHTML = renderTree(parsed);
        treeOutput.classList.remove('hidden');
        output.classList.add('hidden');
        showStatus('Tree view aktif', 'info');
    } catch (e) {
        showStatus('JSON tidak valid: ' + e.message, 'error');
    }
}

function renderTree(obj, level = 0) {
    const indent = '  '.repeat(level);
    let html = '';
    if (typeof obj === 'object' && obj !== null) {
        const isArr = Array.isArray(obj);
        const keys = Object.keys(obj);
        html += `<span class="text-slate-400">${isArr ? '[' : '{'}</span>`;
        if (keys.length === 0) return html + `<span class="text-slate-400">${isArr ? ']' : '}'}</span>`;
        html += '<div class="ml-4 border-l-2 border-indigo-100 pl-2">';
        keys.forEach((key, i) => {
            const isLast = i === keys.length - 1;
            html += `<div class="my-0.5">`;
            if (!isArr) html += `<span class="text-indigo-600 font-medium">"${key}"</span><span class="text-slate-400">: </span>`;
            html += renderTree(obj[key], level + 1);
            if (!isLast) html += '<span class="text-slate-400">,</span>';
            html += `</div>`;
        });
        html += '</div>';
        html += `<span class="text-slate-400">${isArr ? ']' : '}'}</span>`;
    } else if (typeof obj === 'string') {
        html += `<span class="text-emerald-600">"${obj}"</span>`;
    } else if (typeof obj === 'number') {
        html += `<span class="text-amber-600">${obj}</span>`;
    } else if (typeof obj === 'boolean') {
        html += `<span class="text-purple-600">${obj}</span>`;
    } else {
        html += `<span class="text-slate-400">null</span>`;
    }
    return html;
}

function copyResult() {
    const text = output.textContent || input.value;
    navigator.clipboard.writeText(text).then(() => showStatus('Berhasil disalin!', 'success'));
}

function clearEditor() {
    input.value = '';
    output.textContent = '';
    output.classList.add('hidden');
    treeOutput.classList.add('hidden');
    statusBar.classList.add('hidden');
    document.getElementById('char-count').textContent = '';
}

async function saveJson() {
    const content = input.value.trim();
    const name = document.getElementById('save-name').value.trim();
    if (!content) { showStatus('Tidak ada konten untuk disimpan!', 'error'); return; }
    const res = await fetch('/JsonTools/Save', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content, name })
    });
    const data = await res.json();
    if (data.success) { showStatus('JSON berhasil disimpan!', 'success'); setTimeout(() => location.reload(), 1000); }
}

async function loadHistory(id) {
    const res = await fetch(`/JsonTools/GetHistory/${id}`);
    const data = await res.json();
    if (data.success) {
        input.value = data.content;
        document.getElementById('save-name').value = data.name;
        showStatus('JSON dimuat dari riwayat', 'info');
    }
}

async function deleteHistory(id) {
    const confirmed = typeof SwalConfirm === 'function'
        ? await SwalConfirm({
            title: 'Hapus Riwayat JSON?',
            text: 'Apakah Anda yakin ingin menghapus data riwayat JSON ini?',
            icon: 'warning',
            confirmButtonText: '<i class="fas fa-trash-alt mr-1.5"></i>Ya, Hapus',
            cancelButtonText: 'Batal',
            isDanger: true
        })
        : confirm('Hapus riwayat JSON ini?');
    if (!confirmed) return;
    await fetch(`/JsonTools/Delete/${id}`, { method: 'POST' });
    location.reload();
}

// Keyboard shortcut: Ctrl+Enter to format
document.getElementById('json-input').addEventListener('keydown', function(e) {
    if (e.ctrlKey && e.key === 'Enter') { formatJson(); }
});
</script>
}
