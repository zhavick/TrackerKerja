@model TrackerKerja.Models.Project
@{
    ViewData["Title"] = Model.Name;
}

<div class="mb-5">
    <a href="/Project" class="text-indigo-500 hover:text-indigo-700 text-sm flex items-center gap-1.5">
        <i class="fas fa-arrow-left"></i> Kembali ke Proyek
    </a>
</div>

<!-- Project Header -->
<div class="bg-white rounded-2xl shadow-sm border border-indigo-100 overflow-hidden mb-5">
    <div class="h-3 w-full" style="background: @Model.Color"></div>
    <div class="p-6">
        <div class="flex items-start justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl flex items-center justify-center shadow-md" style="background: @Model.Color + '22'">
                    <i class="fas fa-folder text-2xl" style="color: @Model.Color"></i>
                </div>
                <div>
                    <h2 class="text-2xl font-extrabold text-slate-800">@Model.Name</h2>
                    <p class="text-slate-500 text-sm mt-0.5">@Model.Description</p>
                </div>
            </div>
            @if (User.IsInRole("Admin"))
            {
                <div class="flex gap-2">
                    <a href="/Project/Edit/@Model.Id" class="bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-sm font-semibold px-4 py-2 rounded-xl transition-colors">
                        <i class="fas fa-edit mr-1"></i>Edit
                    </a>
                </div>
            }
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">
            <div class="text-center p-3 bg-slate-50 rounded-xl">
                <p class="text-2xl font-black text-slate-800">@Model.TotalTasks</p>
                <p class="text-xs text-slate-500">Total Tugas</p>
            </div>
            <div class="text-center p-3 bg-emerald-50 rounded-xl">
                <p class="text-2xl font-black text-emerald-600">@Model.CompletedTasks</p>
                <p class="text-xs text-slate-500">Selesai</p>
            </div>
            <div class="text-center p-3 bg-indigo-50 rounded-xl">
                <p class="text-2xl font-black text-indigo-600">@Model.ProgressPercent%</p>
                <p class="text-xs text-slate-500">Progress</p>
            </div>
            <div class="text-center p-3 @(Model.Deadline < DateTime.Now && Model.Status != TrackerKerja.Models.ProjectStatus.Completed ? "bg-red-50" : "bg-amber-50") rounded-xl">
                <p class="text-sm font-bold @(Model.Deadline < DateTime.Now && Model.Status != TrackerKerja.Models.ProjectStatus.Completed ? "text-red-600" : "text-amber-600")">@(Model.Deadline?.ToString("dd MMM yy") ?? "-")</p>
                <p class="text-xs text-slate-500">Deadline</p>
            </div>
        </div>

        <div class="mt-4">
            <div class="w-full bg-slate-100 rounded-full h-3">
                <div class="h-3 rounded-full transition-all duration-700 shadow-sm"
                     style="width:@Model.ProgressPercent%; background: linear-gradient(to right, @Model.Color, @Model.Color)"></div>
            </div>
        </div>
    </div>
</div>

<!-- Tasks in Project -->
<div class="bg-white rounded-2xl shadow-sm border border-indigo-100">
    <div class="p-5 border-b border-slate-100 flex items-center justify-between">
        <h3 class="font-bold text-slate-800 flex items-center gap-2">
            <i class="fas fa-tasks text-indigo-500"></i>
            Daftar Tugas dalam Proyek
        </h3>
        <a href="/Task/Create?projectId=@Model.Id" class="bg-gradient-to-r from-indigo-500 to-purple-600 text-white text-xs font-semibold px-3 py-2 rounded-lg hover:shadow-md transition-all">
            <i class="fas fa-plus mr-1"></i>Tambah Tugas
        </a>
    </div>

    @if (!Model.Tasks.Any())
    {
        <div class="p-12 text-center text-slate-400">
            <i class="fas fa-clipboard-list text-4xl mb-3 text-slate-200 block"></i>
            <p>Belum ada tugas dalam proyek ini</p>
        </div>
    }
    else
    {
        <div class="divide-y divide-slate-50">
            @foreach (var task in Model.Tasks.OrderBy(t => t.Status))
            {
                var statusColor = task.Status switch {
                    TrackerKerja.Models.TaskStatus.Done => "text-emerald-600",
                    TrackerKerja.Models.TaskStatus.InProgress => "text-indigo-600",
                    _ => "text-slate-400"
                };
                <div class="p-4 flex items-center gap-3 hover:bg-indigo-50/30 transition-colors">
                    <i class="fas @(task.Status == TrackerKerja.Models.TaskStatus.Done ? "fa-check-circle text-emerald-500" : task.Status == TrackerKerja.Models.TaskStatus.InProgress ? "fa-spinner text-indigo-500" : "fa-circle text-slate-300") w-5"></i>
                    <div class="flex-1 min-w-0">
                        <p class="font-semibold text-slate-800 text-sm truncate @(task.Status == TrackerKerja.Models.TaskStatus.Done ? "line-through text-slate-400" : "")">@task.Title</p>
                        <div class="flex items-center gap-2 mt-0.5">
                            <span class="text-xs text-slate-400">@task.DueDate?.ToString("dd MMM yyyy")</span>
                            <span class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-indigo-50 text-indigo-700 border border-indigo-100">
                                @(task.Milestone ?? "Implementation")
                            </span>
                        </div>
                    </div>
                    <span class="text-xs font-mono text-slate-400">@task.TotalDurationFormatted</span>
                    <a href="/Task/Edit/@task.Id" class="text-slate-300 hover:text-indigo-500">
                        <i class="fas fa-external-link-alt text-xs"></i>
                    </a>
                </div>
            }
        </div>
    }
</div>
