<div id="editBadgeModal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-6 max-w-lg w-full shadow-2xl border border-slate-100 animate-scale-in max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between mb-4 border-b border-slate-100 pb-3">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold">
                    <i class="fas fa-edit"></i>
                </div>
                <h3 class="font-bold text-slate-800 text-lg">Edit Badge & Achievement</h3>
            </div>
            <button type="button" onclick="closeModal('editBadgeModal')" class="text-slate-400 hover:text-slate-600"><i class="fas fa-times"></i></button>
        </div>

        <form method="post" action="/MasterData/EditBadge" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="editBadgeId" />

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Kode Unik</label>
                    <input type="text" name="Code" id="editBadgeCode" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm uppercase font-mono focus:ring-2 focus:ring-amber-500">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Kategori</label>
                    <select name="Category" id="editBadgeCategory" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-amber-500 bg-white">
                        <option value="Tasks">Tasks</option>
                        <option value="Timesheets">Timesheets</option>
                        <option value="Notes">Notes</option>
                        <option value="Profile">Profile</option>
                        <option value="Special">Special / Award</option>
                    </select>
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Nama Badge</label>
                <input type="text" name="Name" id="editBadgeName" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-amber-500">
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Kelangkaan (Rarity)</label>
                    <select name="Rarity" id="editBadgeRarity" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-amber-500 bg-white">
                        <option value="1">Common (⚪ Biasa)</option>
                        <option value="2">Rare (🔵 Langka)</option>
                        <option value="3">Epic (🟣 Epik)</option>
                        <option value="4">Legendary (🟡 Legendaris)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Poin EXP Reward</label>
                    <input type="number" name="Points" id="editBadgePoints" min="10" step="10" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-amber-500">
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Icon FontAwesome</label>
                    <div class="flex items-center gap-2">
                        <input type="text" name="Icon" id="editBadgeIcon" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-amber-500"
                               oninput="document.getElementById('editBadgeIconPreview').className = this.value">
                        <div class="w-9 h-9 rounded-xl bg-slate-100 flex items-center justify-center text-amber-500 border border-slate-200 flex-shrink-0">
                            <i id="editBadgeIconPreview" class="fa-solid fa-award"></i>
                        </div>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Warna Aksen</label>
                    <input type="color" name="Color" id="editBadgeColor" class="w-full h-10 rounded-xl border border-slate-200 cursor-pointer p-0.5">
                </div>
            </div>

            <div class="p-3.5 bg-amber-50/60 rounded-xl border border-amber-200/80 space-y-3">
                <label class="block text-xs font-bold text-amber-900 uppercase tracking-wider">Mekanisme Pemicu (Trigger)</label>
                <div>
                    <select name="TriggerType" id="editBadgeTriggerType" class="w-full px-3 py-2 rounded-xl border border-amber-200 text-xs bg-white focus:ring-2 focus:ring-amber-500 font-semibold">
                        <option value="1">Auto: Jumlah Tugas Selesai (Done Tasks)</option>
                        <option value="2">Auto: Total Jam Kerja (Hours Logged)</option>
                        <option value="3">Auto: Jumlah Catatan Kerja (Notes Count)</option>
                        <option value="4">Auto: Total Tugas Pernah Ditugaskan</option>
                        <option value="5">Auto: Kelengkapan Profil Pengguna</option>
                        <option value="0">Manual: Diberikan Spesial oleh Admin</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[11px] font-bold text-amber-800 mb-1">Target Ambang Batas (Threshold Target)</label>
                    <input type="number" name="TriggerThreshold" id="editBadgeThreshold" min="1" class="w-full px-3 py-1.5 rounded-xl border border-amber-200 text-xs bg-white">
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Deskripsi / Syarat</label>
                <textarea name="Description" id="editBadgeDesc" rows="2" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-amber-500 resize-none"></textarea>
            </div>

            <div class="grid grid-cols-2 gap-3 items-center">
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Urutan (Index)</label>
                    <input type="number" name="OrderIndex" id="editBadgeOrder" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm">
                </div>
                <div class="pt-4">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" name="IsActive" value="true" id="editBadgeIsActive" class="rounded text-amber-600 focus:ring-amber-500 w-4 h-4">
                        <span class="text-xs font-semibold text-slate-700">Badge Aktif</span>
                    </label>
                </div>
            </div>

            <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
                <button type="button" onclick="closeModal('editBadgeModal')" class="px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-100 rounded-xl">Batal</button>
                <button type="submit" class="px-5 py-2 bg-amber-500 hover:bg-amber-600 text-white text-sm font-bold rounded-xl shadow-md">Simpan Perubahan</button>
            </div>
        </form>
    </div>
</div>

<script>
    function closeModal(id) {
        const el = document.getElementById(id);
        if (el) {
            el.classList.add('hidden');
            el.classList.remove('flex');
        }
    }

    function openEditCatModal(id, name, color, desc) {
        document.getElementById('editCatId').value = id;
        document.getElementById('editCatName').value = name;
        document.getElementById('editCatColor').value = color || '#6366F1';
        document.getElementById('editCatDesc').value = desc || '';
        const modal = document.getElementById('editCategoryModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function openEditPriorityModal(id, name, color, icon, order, isDefault, desc) {
        document.getElementById('editPriId').value = id;
        document.getElementById('editPriName').value = name;
        document.getElementById('editPriColor').value = color || '#F59E0B';
        document.getElementById('editPriOrder').value = order;
        document.getElementById('editPriIsDefault').checked = isDefault;
        document.getElementById('editPriDesc').value = desc || '';
        const modal = document.getElementById('editPriorityModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function openEditStatusModal(id, name, color, order, isDone, isDefault, desc) {
        document.getElementById('editStatId').value = id;
        document.getElementById('editStatName').value = name;
        document.getElementById('editStatColor').value = color || '#06B6D4';
        document.getElementById('editStatOrder').value = order;
        document.getElementById('editStatIsDone').checked = isDone;
        document.getElementById('editStatIsDefault').checked = isDefault;
        document.getElementById('editStatDesc').value = desc || '';
        const modal = document.getElementById('editStatusModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function openEditMilestoneModal(id, name, color, icon, order, isDefault, desc) {
        document.getElementById('editMsId').value = id;
        document.getElementById('editMsName').value = name;
        document.getElementById('editMsColor').value = color || '#6366F1';
        document.getElementById('editMsIcon').value = icon || 'fa-flag';
        document.getElementById('editMsOrder').value = order;
        document.getElementById('editMsIsDefault').checked = isDefault;
        document.getElementById('editMsDesc').value = desc || '';
        const modal = document.getElementById('editMilestoneModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function openEditBadgeModal(id, code, name, desc, category, icon, color, points, rarity, triggerType, threshold, isActive, order) {
        document.getElementById('editBadgeId').value = id;
        document.getElementById('editBadgeCode').value = code;
        document.getElementById('editBadgeName').value = name;
        document.getElementById('editBadgeDesc').value = desc || '';
        document.getElementById('editBadgeCategory').value = category || 'Tasks';
        document.getElementById('editBadgeIcon').value = icon || 'fa-solid fa-award';
        document.getElementById('editBadgeIconPreview').className = icon || 'fa-solid fa-award';
        document.getElementById('editBadgeColor').value = color || '#F59E0B';
        document.getElementById('editBadgePoints').value = points;
        document.getElementById('editBadgeRarity').value = rarity;
        document.getElementById('editBadgeTriggerType').value = triggerType;
        document.getElementById('editBadgeThreshold').value = threshold;
        document.getElementById('editBadgeIsActive').checked = isActive;
        document.getElementById('editBadgeOrder').value = order;

        const modal = document.getElementById('editBadgeModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    // Color input hex live update
    const catPicker = document.getElementById('catColorPicker');
    if (catPicker) {
        catPicker.addEventListener('input', function(e) {
            document.getElementById('catColorHex').innerText = e.target.value.toUpperCase();
        });
    }
</script>
