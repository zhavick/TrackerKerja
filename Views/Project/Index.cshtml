@model List<TrackerKerja.Models.Project>
@{
    ViewData["Title"] = "Manajemen Proyek";
    var selectedStatus = ViewBag.SelectedStatus as TrackerKerja.Models.ProjectStatus?;
    var search = ViewBag.SearchTerm as string;
    decimal totalBudget = ViewBag.TotalBudget ?? 0m;
    decimal totalActualCost = ViewBag.TotalActualCost ?? 0m;
    decimal remainingBudget = ViewBag.TotalRemainingBudget ?? 0m;
}

<div class="space-y-6 w-full">

    <!-- Header & Action Buttons -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-indigo-500 to-purple-600 text-white flex items-center justify-center shadow-lg shadow-indigo-200">
                    <i class="fas fa-folder-open text-lg"></i>
                </div>
                <div>
                    <h2 class="text-2xl font-black text-slate-800">Manajemen Proyek</h2>
                    <p class="text-slate-500 text-xs mt-0.5">Kelola portofolio proyek, pantau anggaran (budget vs realisasi), dan lacak progres tim</p>
                </div>
            </div>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <div class="flex items-center gap-2">
                <a href="/Project/Create" class="flex items-center gap-2 bg-gradient-to-r from-indigo-500 via-indigo-600 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white text-xs sm:text-sm font-bold px-4 py-2.5 rounded-xl shadow-md hover:shadow-indigo-200 transition-all">
                    <i class="fas fa-plus"></i><span>Proyek Baru</span>
                </a>
            </div>
        }
    </div>

    <!-- Executive Financial & Progress KPI Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- 1. Total Projects -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-2xs hover:border-indigo-300 transition-all">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Total Portofolio</span>
                <div class="w-9 h-9 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-sm">
                    <i class="fas fa-cubes"></i>
                </div>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-2xl sm:text-3xl font-black text-slate-800">@ViewBag.TotalProjects</span>
                <span class="text-xs text-slate-400 font-semibold">Proyek</span>
            </div>
            <div class="mt-2 flex items-center gap-2 text-xs text-slate-500">
                <span class="inline-flex items-center gap-1 font-bold text-emerald-600">
                    <i class="fas fa-circle-play text-[10px]"></i> @ViewBag.ActiveProjects Aktif
                </span>
                <span>&bull;</span>
                <span class="inline-flex items-center gap-1 font-bold text-blue-600">
                    <i class="fas fa-circle-check text-[10px]"></i> @ViewBag.CompletedProjects Selesai
                </span>
            </div>
        </div>

        <!-- 2. Total Budget -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-2xs hover:border-emerald-300 transition-all">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Total Anggaran (Budget)</span>
                <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-sm">
                    <i class="fas fa-wallet"></i>
                </div>
            </div>
            <div class="flex items-baseline gap-1">
                <span class="text-xs text-emerald-600 font-bold">Rp</span>
                <span class="text-2xl sm:text-3xl font-black text-slate-800">@totalBudget.ToString("N0")</span>
            </div>
            <p class="mt-2 text-xs text-slate-500">Nilai kontrak seluruh proyek gabungan</p>
        </div>

        <!-- 3. Actual Cost Realized -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-2xs hover:border-amber-300 transition-all">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Realisasi Biaya (Actual)</span>
                <div class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-sm">
                    <i class="fas fa-receipt"></i>
                </div>
            </div>
            <div class="flex items-baseline gap-1">
                <span class="text-xs text-amber-600 font-bold">Rp</span>
                <span class="text-2xl sm:text-3xl font-black text-slate-800">@totalActualCost.ToString("N0")</span>
            </div>
            @{
                var overallBurn = totalBudget > 0 ? (int)Math.Min(100, Math.Round((totalActualCost / totalBudget) * 100)) : 0;
            }
            <div class="mt-2 flex items-center gap-1.5 text-xs text-slate-500">
                <span>Burn Rate:</span>
                <span class="font-bold @(overallBurn > 100 ? "text-red-600" : overallBurn > 80 ? "text-amber-600" : "text-emerald-600")">
                    @overallBurn% Anggaran
                </span>
            </div>
        </div>

        <!-- 4. Remaining Budget & Team Progress -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-2xs hover:border-purple-300 transition-all">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Sisa Anggaran Proyek</span>
                <div class="w-9 h-9 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-sm">
                    <i class="fas fa-scale-balanced"></i>
                </div>
            </div>
            <div class="flex items-baseline gap-1">
                <span class="text-xs @(remainingBudget < 0 ? "text-red-600" : "text-purple-600") font-bold">Rp</span>
                <span class="text-2xl sm:text-3xl font-black @(remainingBudget < 0 ? "text-red-600" : "text-slate-800")">
                    @remainingBudget.ToString("N0")
                </span>
            </div>
            <div class="mt-2 flex items-center justify-between text-xs text-slate-500">
                <span>Rata-rata Progres:</span>
                <span class="font-bold text-indigo-600">@ViewBag.AverageProgress%</span>
            </div>
        </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="bg-white rounded-2xl shadow-xs border border-slate-200 p-4">
        <form method="get" action="/Project" class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3">
            <div class="relative flex-1">
                <i class="fas fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input type="text" name="search" value="@search" placeholder="Cari nama proyek, nama klien, atau tag proyek..."
                       class="w-full pl-9 pr-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-xs text-slate-800 transition-all">
            </div>

            <!-- Status Pills Filter -->
            <div class="flex items-center gap-1.5 overflow-x-auto pb-1 md:pb-0">
                <a href="/Project@(string.IsNullOrEmpty(search) ? "" : $"?search={search}")"
                   class="px-3 py-1.5 rounded-xl text-xs font-bold transition-all @(!selectedStatus.HasValue ? "bg-slate-900 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                    Semua
                </a>
                <a href="/Project?status=Active@(string.IsNullOrEmpty(search) ? "" : $"&search={search}")"
                   class="px-3 py-1.5 rounded-xl text-xs font-bold transition-all @(selectedStatus == TrackerKerja.Models.ProjectStatus.Active ? "bg-emerald-600 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                    Aktif
                </a>
                <a href="/Project?status=Completed@(string.IsNullOrEmpty(search) ? "" : $"&search={search}")"
                   class="px-3 py-1.5 rounded-xl text-xs font-bold transition-all @(selectedStatus == TrackerKerja.Models.ProjectStatus.Completed ? "bg-blue-600 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                    Selesai
                </a>
                <a href="/Project?status=Archived@(string.IsNullOrEmpty(search) ? "" : $"&search={search}")"
                   class="px-3 py-1.5 rounded-xl text-xs font-bold transition-all @(selectedStatus == TrackerKerja.Models.ProjectStatus.Archived ? "bg-purple-600 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                    Arsip
                </a>
                <button type="submit" class="px-4 py-1.5 rounded-xl bg-indigo-50 text-indigo-700 font-bold text-xs hover:bg-indigo-100 transition-all cursor-pointer">
                    <i class="fas fa-filter mr-1"></i>Filter
                </button>
            </div>
        </form>
    </div>

    <!-- Project Cards Grid -->
    @if (!Model.Any())
    {
        <div class="bg-white rounded-3xl shadow-sm border border-slate-200 p-16 text-center">
            <div class="w-20 h-20 rounded-2xl bg-indigo-50 flex items-center justify-center mx-auto mb-4 text-indigo-400 text-3xl">
                <i class="fas fa-folder-open"></i>
            </div>
            <h3 class="text-slate-800 font-bold text-lg mb-1">Tidak ada proyek yang sesuai</h3>
            <p class="text-slate-400 text-xs max-w-md mx-auto mb-6">Sesuaikan kata kunci pencarian atau buat proyek baru untuk memulai pelacakan pekerjaan.</p>
            @if (User.IsInRole("Admin"))
            {
                <a href="/Project/Create" class="inline-flex items-center gap-2 bg-gradient-to-r from-indigo-500 to-purple-600 text-white px-5 py-2.5 rounded-xl font-bold text-xs shadow-md hover:shadow-indigo-200 transition-all">
                    <i class="fas fa-plus"></i>Buat Proyek Baru
                </a>
            }
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
            @foreach (var proj in Model)
            {
                var statusColor = proj.Status == TrackerKerja.Models.ProjectStatus.Active ? "bg-emerald-50 text-emerald-700 border-emerald-200"
                                : proj.Status == TrackerKerja.Models.ProjectStatus.Completed ? "bg-blue-50 text-blue-700 border-blue-200"
                                : "bg-slate-100 text-slate-600 border-slate-200";

                var statusLabel = proj.Status == TrackerKerja.Models.ProjectStatus.Active ? "🟢 Aktif"
                                : proj.Status == TrackerKerja.Models.ProjectStatus.Completed ? "✅ Selesai"
                                : "📦 Diarsipkan";

                <div class="bg-white rounded-3xl shadow-sm border border-slate-200 hover:border-indigo-300 hover:shadow-lg transition-all flex flex-col justify-between overflow-hidden group">
                    <!-- Project Color Top Bar -->
                    <div class="h-2.5 w-full" style="background: @proj.Color"></div>

                    <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
                        <!-- Top Header in Card -->
                        <div>
                            <div class="flex items-start justify-between gap-3">
                                <div class="flex items-center gap-2.5">
                                    <div class="w-10 h-10 rounded-2xl flex items-center justify-center shadow-xs shrink-0" style="background-color: @(proj.Color)22">
                                        <i class="fas fa-folder text-lg" style="color: @proj.Color"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <h3 class="font-extrabold text-slate-800 text-base group-hover:text-indigo-600 transition-colors truncate" title="@proj.Name">
                                            @proj.Name
                                        </h3>
                                        @if (!string.IsNullOrWhiteSpace(proj.ClientName))
                                        {
                                            <p class="text-xs text-indigo-600 font-semibold flex items-center gap-1 mt-0.5 truncate">
                                                <i class="fas fa-building text-[10px]"></i>
                                                <span>@proj.ClientName</span>
                                            </p>
                                        }
                                        else
                                        {
                                            <p class="text-xs text-slate-400 font-medium">Internal Project</p>
                                        }
                                    </div>
                                </div>
                                <span class="text-[11px] px-2.5 py-0.5 rounded-full font-bold border @statusColor shrink-0">
                                    @statusLabel
                                </span>
                            </div>

                            @if (!string.IsNullOrEmpty(proj.Description))
                            {
                                <p class="text-slate-500 text-xs mt-3 line-clamp-2 leading-relaxed">@proj.Description</p>
                            }
                        </div>

                        <!-- Project Manager & Tags -->
                        <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs text-slate-600 flex-wrap gap-2">
                            <div class="flex items-center gap-2">
                                <div class="w-6 h-6 rounded-full bg-slate-100 flex items-center justify-center text-[10px] font-bold text-slate-700">
                                    <i class="fas fa-user-tie text-indigo-500"></i>
                                </div>
                                <span class="font-semibold text-slate-700 truncate max-w-[130px]" title="@(proj.ProjectManager?.FullName ?? "Belum Ditunjuk")">
                                    PM: @(proj.ProjectManager?.FullName ?? "Belum Ditunjuk")
                                </span>
                            </div>

                            @if (proj.Deadline.HasValue)
                            {
                                var isOverdue = proj.Deadline < DateTime.Now && proj.Status != TrackerKerja.Models.ProjectStatus.Completed;
                                <span class="text-[11px] font-bold @(isOverdue ? "text-red-600 bg-red-50 px-2 py-0.5 rounded-md border border-red-200" : "text-slate-500") flex items-center gap-1">
                                    <i class="far fa-calendar-alt"></i> @proj.Deadline.Value.ToString("dd MMM yy")
                                </span>
                            }
                        </div>

                        <!-- Financial Health (Budget vs Actual Cost) -->
                        @if (proj.Budget.HasValue && proj.Budget.Value > 0)
                        {
                            <div class="p-3 rounded-2xl bg-slate-50/80 border border-slate-200/80 space-y-1.5">
                                <div class="flex justify-between items-center text-xs">
                                    <span class="text-slate-500 font-medium">Budget:</span>
                                    <span class="font-extrabold text-slate-800">Rp @proj.Budget.Value.ToString("N0")</span>
                                </div>
                                <div class="flex justify-between items-center text-xs">
                                    <span class="text-slate-500 font-medium">Realisasi:</span>
                                    <span class="font-bold @(proj.IsOverBudget ? "text-red-600" : "text-amber-600")">
                                        Rp @((proj.ActualCost ?? 0).ToString("N0"))
                                    </span>
                                </div>
                                <!-- Financial Burn Mini Progress Bar -->
                                <div class="w-full bg-slate-200 rounded-full h-1.5 overflow-hidden">
                                    <div class="h-full rounded-full transition-all duration-500 @(proj.IsOverBudget ? "bg-red-500" : proj.BudgetBurnPercent > 80 ? "bg-amber-500" : "bg-emerald-500")"
                                         style="width: @(Math.Min(100, proj.BudgetBurnPercent))%"></div>
                                </div>
                                <div class="flex justify-between items-center text-[10px] pt-0.5">
                                    <span class="text-slate-400">Burn: @proj.BudgetBurnPercent%</span>
                                    <span class="font-bold @(proj.RemainingBudget < 0 ? "text-red-600" : "text-emerald-700")">
                                        Sisa: Rp @proj.RemainingBudget.ToString("N0")
                                    </span>
                                </div>
                            </div>
                        }

                        <!-- Task Progress Ring/Bar -->
                        <div class="space-y-1.5">
                            <div class="flex justify-between text-xs text-slate-500 font-medium">
                                <span>Progres Tugas</span>
                                <span class="font-bold text-slate-800">@proj.CompletedTasks / @proj.TotalTasks (@proj.ProgressPercent%)</span>
                            </div>
                            <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden border border-slate-200/60">
                                <div class="h-full rounded-full transition-all duration-700"
                                     style="width: @proj.ProgressPercent%; background-color: @proj.Color"></div>
                            </div>
                        </div>

                        <!-- Card Action Buttons -->
                        <div class="pt-2 flex items-center gap-2">
                            <a href="/Project/Detail/@proj.Id"
                               class="flex-1 text-center bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-bold py-2.5 rounded-xl transition-all shadow-2xs">
                                <i class="fas fa-chart-pie mr-1.5"></i>Detail &amp; Laporan
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a href="/Project/Edit/@proj.Id"
                                   class="px-3 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition-all"
                                   title="Edit Informasi Proyek">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form method="post" action="/Project/Delete/@proj.Id"
                                      data-confirm="Apakah Anda yakin ingin menghapus proyek '@proj.Name'? Seluruh relasi tugas proyek ini akan dilepas."
                                      data-confirm-title="Hapus Proyek"
                                      data-confirm-btn="<i class='fas fa-trash-alt mr-1.5'></i>Ya, Hapus">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="px-3 py-2.5 rounded-xl bg-red-50 hover:bg-red-100 text-red-600 text-xs font-bold transition-all cursor-pointer" title="Hapus Proyek">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>
