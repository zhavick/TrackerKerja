@model TrackerKerja.ViewModels.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="id" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — Work Tracker Pro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .glass { background: rgba(255,255,255,0.85); backdrop-filter: blur(20px); }
        .input-field { transition: all 0.2s; }
        .input-field:focus { transform: translateY(-1px); box-shadow: 0 4px 20px rgba(99,102,241,0.15); }
        .floating-shape { animation: float 6s ease-in-out infinite; }
        .floating-shape-2 { animation: float 8s ease-in-out infinite reverse; }
        @@keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(5deg); }
        }
        .btn-login { transition: all 0.3s; }
        .btn-login:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(99,102,241,0.4); }
    </style>
</head>
<body class="h-full bg-gradient-to-br from-indigo-900 via-purple-900 to-slate-900 flex items-center justify-center p-4 relative overflow-hidden">

    <!-- Decorative shapes -->
    <div class="floating-shape absolute top-16 left-16 w-64 h-64 rounded-full bg-indigo-500/10 blur-3xl"></div>
    <div class="floating-shape-2 absolute bottom-16 right-16 w-80 h-80 rounded-full bg-purple-500/10 blur-3xl"></div>
    <div class="floating-shape absolute top-1/2 left-1/4 w-48 h-48 rounded-full bg-cyan-500/10 blur-2xl"></div>

    <!-- Login Card -->
    <div class="glass border border-white/20 rounded-3xl shadow-2xl w-full max-w-md p-8 relative z-10">
        <!-- Logo -->
        <div class="text-center mb-8">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center mx-auto mb-4 shadow-xl shadow-indigo-500/30">
                <i class="fas fa-rocket text-white text-2xl"></i>
            </div>
            <h1 class="text-2xl font-black text-slate-800">Work Tracker Pro</h1>
            <p class="text-slate-500 text-sm mt-1">Masuk ke dashboard kerja Anda</p>
        </div>

        <!-- Error Messages -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="mb-5 p-4 bg-red-50 border border-red-200 rounded-2xl">
                <div class="flex items-center gap-2 text-red-700 text-sm">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>@Html.ValidationSummary(true)</span>
                </div>
                @Html.ValidationSummary(true, null, new { @class = "text-red-700 text-sm mt-1" })
            </div>
        }

        <form method="post" asp-action="Login" asp-controller="Account">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

            <!-- Email -->
            <div class="mb-4">
                <label class="block text-sm font-semibold text-slate-700 mb-2">
                    <i class="fas fa-envelope text-indigo-400 mr-1.5"></i>Email
                </label>
                <input type="email" name="Email" value="@Model.Email" required
                       placeholder="nama@email.com" autocomplete="email"
                       class="input-field w-full px-4 py-3 rounded-xl border border-indigo-200 bg-white/70 focus:outline-none focus:ring-2 focus:ring-indigo-400 text-slate-800 placeholder-slate-400">
            </div>

            <!-- Password -->
            <div class="mb-4">
                <label class="block text-sm font-semibold text-slate-700 mb-2">
                    <i class="fas fa-lock text-indigo-400 mr-1.5"></i>Password
                </label>
                <div class="relative">
                    <input type="password" name="Password" id="password-field" required
                           placeholder="Password Anda" autocomplete="current-password"
                           class="input-field w-full px-4 py-3 pr-12 rounded-xl border border-indigo-200 bg-white/70 focus:outline-none focus:ring-2 focus:ring-indigo-400 text-slate-800 placeholder-slate-400">
                    <button type="button" onclick="togglePassword()" id="eye-btn"
                            class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-indigo-500 transition-colors">
                        <i class="fas fa-eye" id="eye-icon"></i>
                    </button>
                </div>
            </div>

            <!-- Remember Me -->
            <div class="flex items-center justify-between mb-6">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" name="RememberMe" class="w-4 h-4 rounded border-indigo-300 text-indigo-500 focus:ring-indigo-400">
                    <span class="text-sm text-slate-600">Ingat saya</span>
                </label>
            </div>

            <!-- Submit -->
            <button type="submit"
                    class="btn-login w-full bg-gradient-to-r from-indigo-500 to-purple-600 text-white font-bold py-3.5 rounded-xl text-base cursor-pointer">
                <i class="fas fa-sign-in-alt mr-2"></i>Masuk
            </button>
        </form>

        <!-- Register link -->
        <p class="text-center text-slate-500 text-sm mt-6">
            Belum punya akun?
            <a href="/Account/Register" class="text-indigo-600 font-semibold hover:text-indigo-800 transition-colors">Daftar sekarang</a>
        </p>

        <!-- Swagger API Quick Link -->
        <div class="mt-6 pt-4 border-t border-slate-200/60 text-center">
            <a href="/swagger" target="_blank" class="inline-flex items-center gap-2 text-xs font-semibold text-indigo-600 hover:text-indigo-800 bg-indigo-50 hover:bg-indigo-100 px-3 py-1.5 rounded-lg border border-indigo-200 transition-colors">
                <i class="fas fa-file-code text-indigo-500"></i>
                <span>Dokumentasi REST API (Swagger) &rarr;</span>
            </a>
        </div>
    </div>

    <script>
        function togglePassword() {
            const field = document.getElementById('password-field');
            const icon = document.getElementById('eye-icon');
            if (field.type === 'password') {
                field.type = 'text';
                icon.className = 'fas fa-eye-slash';
            } else {
                field.type = 'password';
                icon.className = 'fas fa-eye';
            }
        }
    </script>
</body>
</html>
