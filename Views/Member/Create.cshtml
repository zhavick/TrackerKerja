@model TrackerKerja.ViewModels.MemberFormViewModel
@{
    ViewData["Title"] = "Tambah Anggota Tim Baru";
    var avatarColors = new[] { "#6366F1", "#06B6D4", "#10B981", "#F59E0B", "#EF4444", "#8B5CF6", "#EC4899", "#64748B" };
}

<div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <a href="/Member" class="inline-flex items-center gap-2 text-xs font-semibold text-slate-500 hover:text-indigo-600 transition-colors">
            <i class="fas fa-arrow-left"></i>
            <span>Kembali ke Direktori Anggota</span>
        </a>
    </div>

    <div class="bg-white rounded-3xl shadow-sm border border-indigo-100 overflow-hidden">
        <div class="bg-gradient-to-r from-indigo-600 to-purple-600 p-6 text-white flex items-center gap-4">
            <div class="w-12 h-12 bg-white/20 rounded-2xl flex items-center justify-center backdrop-blur-sm text-xl font-bold">
                <i class="fas fa-user-plus"></i>
            </div>
            <div>
                <h2 class="text-xl font-black">Tambah Anggota Tim Baru</h2>
                <p class="text-indigo-100 text-xs mt-0.5">Daftarkan personel baru agar dapat menerima penugasan tugas dan menulis catatan</p>
            </div>
        </div>

        <form method="post" action="/Member/Create" class="p-6 space-y-5">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-2xl text-xs">
                    @Html.ValidationSummary(false, "", new { @class = "list-disc pl-5 font-medium" })
                </div>
            }

            <!-- Full Name -->
            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                    <i class="fas fa-user text-indigo-500 mr-1"></i>Nama Lengkap <span class="text-red-500">*</span>
                </label>
                <input type="text" name="FullName" value="@Model.FullName" required
                       placeholder="Contoh: Glenn Hakim"
                       class="w-full px-4 py-2.5 rounded-xl border border-indigo-200 focus:outline-none focus:ring-2 focus:ring-indigo-400 text-slate-800 text-sm">
            </div>

            <!-- Email & Job Title -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                        <i class="fas fa-envelope text-indigo-500 mr-1"></i>Email Pengguna <span class="text-red-500">*</span>
                    </label>
                    <input type="email" name="Email" value="@Model.Email" required
                           placeholder="nama@elistec.com"
                           class="w-full px-4 py-2.5 rounded-xl border border-indigo-200 focus:outline-none focus:ring-2 focus:ring-indigo-400 text-slate-800 text-sm">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                        <i class="fas fa-briefcase text-indigo-500 mr-1"></i>Jabatan / Spesialisasi
                    </label>
                    <input type="text" name="JobTitle" value="@Model.JobTitle"
                           placeholder="Contoh: Senior Fullstack Developer"
                           class="w-full px-4 py-2.5 rounded-xl border border-indigo-200 focus:outline-none focus:ring-2 focus:ring-indigo-400 text-slate-800 text-sm">
                </div>
            </div>

            <!-- Phone & Role -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                        <i class="fas fa-phone text-indigo-500 mr-1"></i>Nomor Telepon / WhatsApp
                    </label>
                    <input type="text" name="PhoneNumber" value="@Model.PhoneNumber"
                           placeholder="08123456789"
                           class="w-full px-4 py-2.5 rounded-xl border border-indigo-200 focus:outline-none focus:ring-2 focus:ring-indigo-400 text-slate-800 text-sm">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                        <i class="fas fa-shield-alt text-indigo-500 mr-1"></i>Peran (Role)
                    </label>
                    <select name="Role" class="select2 w-full" data-placeholder="Pilih Peran">
                        <option value="User" selected>👤 User / Team Member</option>
                        <option value="Admin">🛡️ Administrator</option>
                    </select>
                </div>
            </div>

            <!-- Password Initial -->
            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                    <i class="fas fa-lock text-indigo-500 mr-1"></i>Password Awal (Opsional, Default: Password123!)
                </label>
                <input type="password" name="Password" value="@Model.Password"
                       placeholder="Minimal 6 karakter..."
                       class="w-full px-4 py-2.5 rounded-xl border border-indigo-200 focus:outline-none focus:ring-2 focus:ring-indigo-400 text-slate-800 text-sm">
            </div>

            <!-- Avatar Color Selection -->
            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                    <i class="fas fa-palette text-indigo-500 mr-1"></i>Warna Aksen Avatar
                </label>
                <div class="flex items-center gap-3">
                    @foreach (var color in avatarColors)
                    {
                        <label class="cursor-pointer">
                            <input type="radio" name="AvatarColor" value="@color" class="sr-only peer" @(Model.AvatarColor == color || (string.IsNullOrEmpty(Model.AvatarColor) && color == "#6366F1") ? "checked" : "") />
                            <div class="w-8 h-8 rounded-xl ring-2 ring-transparent peer-checked:ring-indigo-500 peer-checked:scale-110 transition-all flex items-center justify-center" style="background:@color;">
                                <i class="fas fa-check text-white text-[10px] opacity-0 peer-checked:opacity-100"></i>
                            </div>
                        </label>
                    }
                </div>
            </div>

            <!-- Submit Button -->
            <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
                <a href="/Member" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-bold text-xs hover:bg-slate-50 transition-colors">
                    Batal
                </a>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-indigo-500 to-purple-600 text-white font-bold text-xs shadow-lg hover:shadow-indigo-200 hover:scale-105 transition-all">
                    <i class="fas fa-save mr-1.5"></i>Simpan Anggota Baru
                </button>
            </div>
        </form>
    </div>
</div>
