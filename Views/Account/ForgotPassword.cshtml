@model TrackerKerja.ViewModels.ForgotPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="id" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lupa Kata Sandi — Work Tracker Pro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .glass { background: rgba(255,255,255,0.94); backdrop-filter: blur(24px); }
        .input-field { transition: all 0.2s; }
        .input-field:focus { transform: translateY(-1px); box-shadow: 0 4px 20px rgba(99,102,241,0.15); }
        .floating-shape { animation: float 6s ease-in-out infinite; }
        @@keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-15px); }
        }
        .btn-gradient {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 50%, #4338ca 100%);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .btn-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 25px -4px rgba(79, 70, 229, 0.4);
        }
    </style>
</head>
<body class="min-h-full bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-900 flex items-center justify-center p-4 relative overflow-x-hidden">

    <!-- Decorative floating shapes -->
    <div class="floating-shape absolute top-12 right-20 w-80 h-80 rounded-full bg-indigo-500/15 blur-3xl pointer-events-none"></div>
    <div class="floating-shape absolute bottom-12 left-20 w-72 h-72 rounded-full bg-purple-500/15 blur-3xl pointer-events-none"></div>

    <!-- Main Card -->
    <div class="glass border border-white/40 rounded-3xl shadow-2xl w-full max-w-lg p-8 sm:p-10 relative z-10 my-8">
        
        <!-- Header -->
        <div class="text-center mb-6">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center mx-auto mb-3 shadow-xl shadow-indigo-500/30 text-white text-2xl">
                <i class="fas fa-key"></i>
            </div>
            <h1 class="text-2xl font-black text-slate-800">Atur Ulang Kata Sandi</h1>
            <p class="text-slate-500 text-xs sm:text-sm mt-1">Masukkan alamat email akun terdaftar Anda untuk memulai proses reset</p>
        </div>

        <!-- Security & Policy Information Box -->
        <div class="mb-5 p-4 bg-indigo-50/80 border border-indigo-200/80 rounded-2xl space-y-2 text-xs text-indigo-950">
            <div class="flex items-center gap-2 font-bold text-indigo-700">
                <i class="fas fa-shield-halved text-sm"></i>
                <span>Ketentuan & Kebijakan Keamanan:</span>
            </div>
            <ul class="space-y-1.5 pl-5 list-disc text-slate-600 text-[11px] leading-relaxed">
                <li>Jika server email (SMTP) <strong>telah dikonfigurasi</strong>, tautan reset akan dikirimkan langsung ke email Anda.</li>
                <li>Jika server email <strong>belum disetting</strong>, sistem otomatis membuat <strong>Tautan Klaim Pengguna (User Claim Link)</strong> langsung di layar ini.</li>
                <li><strong class="text-rose-600">Proteksi Lockout</strong>: Tautan berlaku selama <strong>15 menit</strong>. Jika tautan kedaluwarsa atau terjadi salah re-entry sebanyak <strong>3 kali</strong>, akun akan otomatis <strong>DIKUNCI</strong> selama 30 menit.</li>
            </ul>
        </div>

        <!-- Error Summary -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="mb-5 p-4 bg-rose-50 border border-rose-200 rounded-2xl text-rose-700 text-xs">
                <div class="flex items-start gap-2.5">
                    <i class="fas fa-triangle-exclamation text-base flex-shrink-0 mt-0.5"></i>
                    <div>
                        <span class="font-bold">Permintaan Tidak Dapat Diproses:</span>
                        <div class="mt-1">
                            @Html.ValidationSummary(true, null, new { @class = "list-disc pl-4" })
                            <span asp-validation-for="Email" class="block font-medium"></span>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Form -->
        <form method="post" asp-action="ForgotPassword" asp-controller="Account" class="space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label for="email-input" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                    <i class="fas fa-envelope text-indigo-500"></i>
                    <span>Alamat Email Akun</span>
                </label>
                <div class="relative">
                    <input type="email" 
                           id="email-input" 
                           asp-for="Email" 
                           required 
                           autocomplete="email"
                           placeholder="nama@email.com" 
                           class="input-field w-full px-4 py-3.5 pl-11 rounded-2xl border border-slate-300 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:border-indigo-500 font-medium transition-all" />
                    <i class="fas fa-at absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                </div>
            </div>

            <button type="submit" 
                    class="btn-gradient w-full text-white font-black py-3.5 px-6 rounded-2xl text-sm shadow-xl flex items-center justify-center gap-2 cursor-pointer mt-4">
                <i class="fas fa-paper-plane text-xs"></i>
                <span>Lanjutkan Reset Kata Sandi</span>
            </button>
        </form>

        <!-- Back to Login -->
        <div class="mt-6 pt-5 border-t border-slate-200/80 text-center">
            <a href="/Account/Login" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 flex items-center justify-center gap-1.5 transition-colors">
                <i class="fas fa-arrow-left text-xs"></i>
                <span>Kembali ke Halaman Masuk (Login)</span>
            </a>
        </div>
    </div>
</body>
</html>
