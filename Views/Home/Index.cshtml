@model TrackerKerja.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var hour = DateTime.Now.Hour;
    var greeting = hour < 11 ? "Selamat Pagi" : hour < 15 ? "Selamat Siang" : hour < 18 ? "Selamat Sore" : "Selamat Malam";
}

<div class="space-y-6 w-full">
    @Html.AntiForgeryToken()

    <!-- 1. PERSONAL MEMBER WELCOME BANNER -->
    <div class="bg-gradient-to-r from-violet-600 via-indigo-600 to-purple-700 rounded-3xl p-6 text-white shadow-xl relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
        <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-white/20 backdrop-blur-md flex items-center justify-center text-white text-2xl font-black shadow-inner ring-2 ring-white/30 flex-shrink-0">
                    <i class="fas fa-user-circle"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2 flex-wrap">
                        <span class="text-xs font-bold uppercase tracking-wider text-indigo-200">@greeting</span>
                        <span class="text-[10px] font-extrabold px-2.5 py-0.5 rounded-full @(Model.IsAdmin ? "bg-amber-400 text-amber-950" : "bg-white/20 text-white")">
                            @(Model.IsAdmin ? "🛡️ Administrator" : "👤 Anggota Tim")
                        </span>
                    </div>
                    <h2 class="text-2xl font-black text-white mt-0.5">@Model.CurrentUserName</h2>
                    <p class="text-indigo-100 text-xs mt-0.5">Pantau tugas personal Anda, pencatatan durasi kerja, dan kontribusi tim</p>
                </div>
            </div>

            <!-- Quick Action Buttons -->
            <div class="flex items-center gap-2.5 flex-wrap" id="dashboard-quick-actions" data-tour="quick-actions">
                <a href="/Task/Create" class="flex items-center gap-1.5 px-4 py-2 rounded-xl bg-white text-indigo-700 hover:bg-indigo-50 text-xs font-bold transition-all shadow-md">
                    <i class="fas fa-plus"></i> Tambah Tugas
                </a>
                <a href="/Note/Create" class="flex items-center gap-1.5 px-4 py-2 rounded-xl bg-indigo-500/40 hover:bg-indigo-500/60 text-white text-xs font-bold transition-all border border-white/20">
                    <i class="fas fa-pen-nib"></i> Tulis Catatan
                </a>
                <button type="button" onclick="OnboardingTour.startTour()" class="flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-amber-400 hover:bg-amber-300 text-amber-950 text-xs font-black transition-all shadow-md cursor-pointer" title="Mulai Tur Panduan Aplikasi Interaktif">
                    <i class="fas fa-magic"></i> Panduan Tur
                </button>
                @if (Model.IsAdmin)
                {
                    <a href="/Member" class="flex items-center gap-1.5 px-4 py-2 rounded-xl bg-purple-500/40 hover:bg-purple-500/60 text-white text-xs font-bold transition-all border border-white/20">
                        <i class="fas fa-users"></i> Kelola Tim
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- 1.2. DAILY CHECK-IN REQUIREMENT & STREAK STATUS CARD -->
    @if (!Model.CheckInStatus.HasCheckedInToday)
    {
        <div class="bg-gradient-to-r from-amber-500/15 via-orange-500/10 to-amber-500/5 rounded-2xl p-4 sm:p-5 border-2 border-amber-400 shadow-md relative overflow-hidden flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
            <div class="flex items-center gap-3.5">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-amber-500 to-orange-600 text-white flex items-center justify-center text-2xl shadow-md shadow-orange-500/30 flex-shrink-0 animate-bounce">
                    🔥
                </div>
                <div>
                    <div class="flex items-center gap-2 flex-wrap">
                        <span class="text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full bg-rose-500 text-white animate-pulse">
                            Wajib Hari Ini
                        </span>
                        <span class="text-xs font-black text-amber-950">
                            Kamu Belum Melakukan Daily Check-In!
                        </span>
                    </div>
                    <p class="text-xs text-amber-900 mt-1 font-medium leading-relaxed">
                        Pertahankan streak <strong>@Model.CheckInStatus.CurrentStreak Hari</strong> kamu. Capai 15 hari untuk mencairkan <strong>1/2 poin</strong> dan 30 hari untuk <strong>1x total akumulasi poin penuh</strong>!
                        <span class="text-[11px] text-amber-800 block sm:inline mt-0.5 sm:mt-0 font-semibold">⚠️ Saldo hadiah mulai dari 0. Streak reset jika absen @Model.CheckInStatus.MissedDaysReset hari berturut-turut.</span>
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3 w-full md:w-auto justify-between md:justify-end flex-shrink-0">
                <div class="text-right hidden sm:block">
                    <span class="text-[11px] text-slate-500 block font-semibold">Saldo Poin</span>
                    <span class="text-xs font-black text-slate-800">💎 @Model.PointsSummary.AvailablePoints Poin</span>
                </div>
                <button type="button" onclick="performDashboardCheckIn()" id="btnBannerCheckIn"
                        class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-600 hover:to-orange-700 text-white text-xs font-black shadow-lg shadow-orange-500/25 transition-all flex items-center justify-center gap-2 cursor-pointer hover:scale-[1.02] active:scale-[0.98]">
                    <i class="fas fa-hand-sparkles text-amber-200"></i>
                    <span>Check-In Sekarang (+@Model.CheckInStatus.PointsPerCheckIn P)</span>
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="bg-white rounded-2xl p-3.5 px-5 border border-emerald-200 shadow-2xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-base font-black flex-shrink-0">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2 flex-wrap">
                        <span class="text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-800">
                            Check-In Hari Ini Selesai
                        </span>
                        <span class="text-xs font-bold text-slate-800">
                            Tercatat Pukul @(Model.CheckInStatus.LastCheckInDate?.ToString("HH:mm") ?? "Hari ini")
                        </span>
                        <span class="text-xs font-black text-orange-600">
                            🔥 Streak @Model.CheckInStatus.CurrentStreak Hari
                        </span>
                    </div>
                    <p class="text-[11px] text-slate-500 mt-0.5">
                        @if (Model.CheckInStatus.IsEligibleForMonthlyReward)
                        {
                            <span class="text-amber-600 font-bold">🏆 Target 30 Hari tercapai! 1x Total poin cair penuh dan hadiah eksklusif siap diklaim. Saldo Anda: <strong>💎 @Model.PointsSummary.AvailablePoints Poin</strong>.</span>
                        }
                        else if (Model.CheckInStatus.IsEligibleForHalfReward)
                        {
                            <span class="text-indigo-600 font-bold">🎯 Milestone 15 Hari tercapai (1/2 Poin cair)! Sisa <strong>@Model.CheckInStatus.DaysRemainingForMonthlyReward hari</strong> lagi menuju 1x total poin 30 hari. Saldo: <strong>💎 @Model.PointsSummary.AvailablePoints Poin</strong>.</span>
                        }
                        else
                        {
                            <span>Sisa <strong>@Model.CheckInStatus.DaysRemainingForHalfReward hari</strong> menuju pencairan 1/2 Poin (15 Hari). Saldo Poin: <strong>💎 @Model.PointsSummary.AvailablePoints Poin</strong> (Rp @Model.PointsSummary.RupiahEquivalent.ToString("N0")).</span>
                        }
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2 w-full sm:w-auto justify-between sm:justify-end flex-shrink-0">
                <a href="/Gamification?tab=rewards" class="px-3 py-1.5 rounded-xl bg-purple-50 hover:bg-purple-100 text-purple-700 text-xs font-bold transition-all flex items-center gap-1.5 shadow-2xs">
                    <i class="fas fa-gift text-purple-600"></i>
                    <span>Tukar Hadiah</span>
                </a>
                <a href="/Gamification" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition-all flex items-center gap-1.5">
                    <i class="fas fa-trophy text-amber-500"></i>
                    <span>Gamifikasi</span>
                </a>
            </div>
        </div>
    }

    <!-- 1.5. BACKGROUND SYNC WORKER STATUS WIDGET -->
    <div class="bg-white rounded-2xl p-3.5 px-5 border border-slate-200 shadow-2xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <div class="relative flex items-center justify-center">
                <span class="w-3 h-3 rounded-full bg-emerald-500 animate-ping absolute opacity-75"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 relative shadow-xs"></span>
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <h4 class="text-xs font-black text-slate-800">Background Process Worker Aktif</h4>
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-800">Real-Time Sync</span>
                </div>
                <p class="text-[11px] text-slate-500">Memeriksa jatuh tempo, sinkronisasi progress 100% untuk status Done, dan pembaruan metrik otomatis.</p>
            </div>
        </div>
        <div class="flex items-center gap-2.5 w-full sm:w-auto justify-between sm:justify-end">
            <span class="text-[11px] font-mono text-slate-500 bg-slate-100 px-2.5 py-1 rounded-xl" id="bgSyncTimestamp">
                Sync: @DateTime.Now.ToString("HH:mm:ss")
            </span>
            <button type="button" onclick="triggerManualSync()" id="btnManualSync"
                    class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-bold transition-all">
                <i class="fas fa-sync-alt" id="syncIcon"></i>
                <span>Sync Sekarang</span>
            </button>
        </div>
    </div>

    <!-- 1.6. ANALYTICS PERIOD FILTER TOOLBAR -->
    <div class="bg-white rounded-2xl border border-indigo-100 shadow-sm">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 p-4 px-5">
            <!-- Left: Title + Period info -->
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-indigo-600 text-white flex items-center justify-center text-sm flex-shrink-0">
                    <i class="fas fa-chart-area"></i>
                </div>
                <div>
                    <h3 class="text-sm font-black text-slate-800 flex items-center gap-2">
                        Analitik Dashboard
                        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-indigo-100 text-indigo-700" id="analyticsperiodLabel">7 Hari Terakhir</span>
                    </h3>
                    <p class="text-[11px] text-slate-400" id="analyticsdateRange">Memuat data...</p>
                </div>
            </div>
            <!-- Right: Filter Controls -->
            <div class="flex items-center gap-2 flex-wrap w-full sm:w-auto">
                <!-- Period Segmented Buttons -->
                <div class="flex items-center bg-slate-100 rounded-xl p-1 gap-1">
                    <button onclick="loadAnalytics('today')" data-period="today"
                        class="period-btn px-3 py-1.5 rounded-lg text-[11px] font-bold text-slate-600 hover:bg-white hover:text-indigo-700 transition-all">
                        Hari Ini
                    </button>
                    <button onclick="loadAnalytics('week')" data-period="week"
                        class="period-btn active-period px-3 py-1.5 rounded-lg text-[11px] font-bold bg-white text-indigo-700 shadow-sm transition-all">
                        7 Hari
                    </button>
                    <button onclick="loadAnalytics('month')" data-period="month"
                        class="period-btn px-3 py-1.5 rounded-lg text-[11px] font-bold text-slate-600 hover:bg-white hover:text-indigo-700 transition-all">
                        30 Hari
                    </button>
                    <button onclick="loadAnalytics('quarter')" data-period="quarter"
                        class="period-btn px-3 py-1.5 rounded-lg text-[11px] font-bold text-slate-600 hover:bg-white hover:text-indigo-700 transition-all">
                        90 Hari
                    </button>
                </div>
                <!-- Project Filter -->
                <select id="analyticsProjectFilter" onchange="loadAnalytics(currentAnalyticsPeriod)"
                    class="text-[11px] font-bold text-slate-700 bg-white border border-slate-200 rounded-xl px-3 py-1.5 pr-7 hover:border-indigo-300 focus:border-indigo-500 focus:outline-none transition-all">
                    <option value="0">📁 Semua Proyek</option>
                    @foreach (var proj in Model.AllProjects)
                    {
                        <option value="@proj.Id">@proj.Name</option>
                    }
                </select>
                <!-- Refresh Button -->
                <button onclick="loadAnalytics(currentAnalyticsPeriod)"
                    class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-[11px] font-bold transition-all" title="Muat Ulang">
                    <i class="fas fa-redo" id="analyticsRefreshIcon"></i>
                </button>
            </div>
        </div>

        <!-- Analytics KPI Cards Row (Dynamic) -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-0 border-t border-slate-100" id="analyticsKpiRow">
            <!-- KPI cards rendered by JS -->
            <div class="p-4 text-center border-r border-slate-100 last:border-r-0 col-span-2 sm:col-span-3 lg:col-span-6">
                <i class="fas fa-spinner fa-spin text-indigo-400"></i>
                <span class="text-xs text-slate-400 ml-2">Memuat analitik...</span>
            </div>
        </div>
    </div>

    <!-- 2. PERSONAL METRICS CARDS (FOR LOGGED IN USER) -->
    <div>
        <div class="flex items-center justify-between mb-3">
            <h3 class="text-xs font-extrabold uppercase tracking-wider text-slate-500 flex items-center gap-2">
                <i class="fas fa-id-badge text-indigo-500"></i>
                Ringkasan Tugas Personal Saya
            </h3>
            <span class="text-[11px] text-indigo-600 font-semibold">Tugas ditugaskan kepada Anda</span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
            <!-- My Total Tasks -->
            <div class="card-hover bg-white rounded-2xl p-4 shadow-sm border border-indigo-100 relative overflow-hidden">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-bold text-slate-500">Total Tugas Saya</span>
                    <div class="w-8 h-8 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xs">
                        <i class="fas fa-user-check"></i>
                    </div>
                </div>
                <p class="text-2xl font-black text-slate-800">@Model.MyTotalTasks</p>
                <p class="text-[11px] text-slate-400 mt-0.5">Penugasan Personal</p>
            </div>

            <!-- My In Progress -->
            <div class="card-hover bg-white rounded-2xl p-4 shadow-sm border border-cyan-100 relative overflow-hidden">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-bold text-slate-500">Sedang Dikerjakan</span>
                    <div class="w-8 h-8 rounded-xl bg-cyan-50 text-cyan-600 flex items-center justify-center text-xs">
                        <i class="fas fa-spinner"></i>
                    </div>
                </div>
                <p class="text-2xl font-black text-cyan-600">@Model.MyInProgressTasks</p>
                <p class="text-[11px] text-cyan-600 font-semibold mt-0.5">Aktif Berjalan</p>
            </div>

            <!-- My Done Tasks -->
            <div class="card-hover bg-white rounded-2xl p-4 shadow-sm border border-emerald-100 relative overflow-hidden">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-bold text-slate-500">Tugas Selesai</span>
                    <div class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs">
                        <i class="fas fa-check-circle"></i>
                    </div>
                </div>
                <p class="text-2xl font-black text-emerald-600">@Model.MyDoneTasks</p>
                <p class="text-[11px] text-emerald-600 font-semibold mt-0.5">Terselesaikan</p>
            </div>

            <!-- My Work Time Today -->
            <div class="card-hover bg-white rounded-2xl p-4 shadow-sm border border-purple-100 relative overflow-hidden">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-bold text-slate-500">Jam Kerja Hari Ini</span>
                    <div class="w-8 h-8 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-xs">
                        <i class="fas fa-clock"></i>
                    </div>
                </div>
                <p class="text-2xl font-black text-purple-600 font-mono">@Model.MyTodayWorkFormatted</p>
                <p class="text-[11px] text-purple-600 font-semibold mt-0.5">Log Personal Anda</p>
            </div>

            <!-- Daily Check-In & Streak Card -->
            <div class="card-hover bg-white rounded-2xl p-4 shadow-sm border @(Model.CheckInStatus.HasCheckedInToday ? "border-emerald-200 bg-gradient-to-b from-white to-emerald-50/20" : "border-amber-300 ring-2 ring-amber-400/20 bg-gradient-to-b from-white to-amber-50/30") relative overflow-hidden flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-bold text-slate-500">Daily Check-In</span>
                        <div class="w-8 h-8 rounded-xl @(Model.CheckInStatus.HasCheckedInToday ? "bg-emerald-50 text-emerald-600" : "bg-amber-100 text-amber-600 animate-pulse") flex items-center justify-center text-xs">
                            <i class="fas @(Model.CheckInStatus.HasCheckedInToday ? "fa-calendar-check" : "fa-fire")"></i>
                        </div>
                    </div>
                    <div class="flex items-baseline gap-1.5">
                        <p class="text-2xl font-black @(Model.CheckInStatus.HasCheckedInToday ? "text-slate-800" : "text-amber-600")">
                            🔥 @Model.CheckInStatus.CurrentStreak
                        </p>
                        <span class="text-[11px] font-bold text-slate-500">Hari</span>
                    </div>
                    <p class="text-[11px] font-semibold mt-0.5 @(Model.CheckInStatus.HasCheckedInToday ? "text-emerald-600" : "text-rose-600 font-extrabold")">
                        @(Model.CheckInStatus.HasCheckedInToday ? "Sudah Check-In Hari Ini" : "Belum Check-In Hari Ini!")
                    </p>
                </div>

                @if (!Model.CheckInStatus.HasCheckedInToday)
                {
                    <button type="button" onclick="performDashboardCheckIn()" id="btnCardCheckIn"
                            class="mt-2.5 w-full py-1.5 px-2 rounded-xl bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-600 hover:to-orange-700 text-white font-black text-[11px] shadow-sm transition-all flex items-center justify-center gap-1.5 cursor-pointer hover:scale-[1.02] active:scale-[0.98]">
                        <i class="fas fa-hand-sparkles text-[10px]"></i>
                        <span>Check-In (+@Model.CheckInStatus.PointsPerCheckIn P)</span>
                    </button>
                }
                else
                {
                    <div class="mt-2.5 pt-2 border-t border-slate-100 flex items-center justify-between text-[10px] text-slate-500">
                        <span>Target: @Model.CheckInStatus.CurrentStreak/30H</span>
                        <a href="/Gamification" class="text-indigo-600 font-bold hover:underline">Detail &rarr;</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- 3. TEAM & GLOBAL OVERVIEW (ADMIN & CHARTS) -->
    <div class="space-y-6">
        
        <!-- ROW 1: TIMER + STATUS DOUGHNUT + WEEKLY HOURS -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
            <!-- Global Timer & Progress Card -->
            <div class="bg-gradient-to-br from-indigo-500 via-indigo-600 to-purple-700 rounded-3xl p-5 text-white shadow-lg relative overflow-hidden flex flex-col justify-between">
                <div class="relative z-10">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-indigo-200 text-xs font-bold uppercase tracking-wider flex items-center gap-1.5">
                            <i class="fas fa-business-time"></i> Total Waktu Tim Hari Ini
                        </span>
                        <span class="text-[10px] bg-white/20 px-2 py-0.5 rounded-full font-bold">@Model.TotalProjects Proyek</span>
                    </div>
                    <p class="text-3xl font-black font-mono tracking-tight">@Model.TodayWorkFormatted</p>
                    <p class="text-indigo-200 text-xs mt-1">Total durasi seluruh anggota tim hari ini</p>

                    @if (Model.RunningSession != null)
                    {
                        <div class="mt-4 p-3 bg-white/10 rounded-2xl backdrop-blur-sm border border-white/20">
                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-emerald-400 pulse-dot"></span>
                                <span class="text-emerald-300 text-xs font-bold">Timer Aktif Sedang Berjalan</span>
                            </div>
                            <p class="text-white text-xs font-bold truncate mt-1">@Model.RunningSession.Task?.Title</p>
                            <p class="text-indigo-100 font-mono text-lg font-black mt-1" id="page-timer-display">00:00:00</p>
                            <button onclick="stopCurrentTimer(@Model.RunningSession.Id)"
                                    class="mt-2 w-full bg-red-500 hover:bg-red-600 text-white text-xs font-bold py-2 rounded-xl transition-colors shadow-sm">
                                <i class="fas fa-stop mr-1"></i> Hentikan Timer
                            </button>
                        </div>
                    }
                </div>
                <div class="relative z-10 mt-4 pt-3 border-t border-indigo-400/30 flex items-center justify-between text-xs text-indigo-200">
                    <span>Progress Tugas Global</span>
                    <span class="font-bold text-white">@(Model.TotalTasks > 0 ? (int)((double)Model.DoneTasks / Model.TotalTasks * 100) : 0)% Selesai</span>
                </div>
            </div>

            <!-- Status Distribution Doughnut Chart -->
            <div class="bg-white rounded-3xl p-5 shadow-sm border border-indigo-100">
                <div class="flex items-center justify-between mb-2">
                    <h3 class="font-bold text-slate-800 flex items-center gap-2 text-xs uppercase tracking-wider">
                        <i class="fas fa-chart-pie text-cyan-500"></i>
                        Status Tugas Global
                    </h3>
                    <span class="text-xs font-bold text-slate-400">@Model.TotalTasks Task</span>
                </div>
                <div class="relative flex items-center justify-center h-48">
                    <canvas id="statusDoughnutChart"></canvas>
                </div>
            </div>

            <!-- Dynamic Trend Chart (period-filtered) -->
            <div class="bg-white rounded-3xl p-5 shadow-sm border border-indigo-100">
                <div class="flex items-center justify-between mb-2">
                    <h3 class="font-bold text-slate-800 flex items-center gap-2 text-xs uppercase tracking-wider">
                        <i class="fas fa-chart-line text-indigo-500"></i>
                        <span id="trendChartTitle">Tren Jam Kerja</span>
                    </h3>
                    <div class="flex items-center gap-2">
                        <button onclick="toggleTrendMode()" id="trendModeBtn"
                            class="text-[10px] font-bold px-2 py-0.5 rounded-lg bg-indigo-50 text-indigo-600 hover:bg-indigo-100 transition-all"
                            title="Toggle antara Jam Kerja dan Tugas Selesai">
                            <i class="fas fa-exchange-alt"></i> Jam / Selesai
                        </button>
                        <a href="/Report" class="text-xs text-indigo-500 hover:text-indigo-700 font-bold">Laporan →</a>
                    </div>
                </div>
                <div class="h-48 flex items-center justify-center">
                    <canvas id="weekChart"></canvas>
                </div>
            </div>
        </div>

        <!-- ROW 2: MEMBER WORKLOAD DISTRIBUTION & PROJECT TASK DISTRIBUTION -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
            
            <!-- CHART A: MEMBER WORKLOAD DISTRIBUTION -->
            <div class="bg-white rounded-3xl p-5 shadow-sm border border-indigo-100">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <h3 class="font-bold text-slate-800 flex items-center gap-2 text-sm">
                            <i class="fas fa-users text-indigo-600"></i>
                            Distribusi Tugas per Anggota Tim (Member)
                        </h3>
                        <p class="text-xs text-slate-400 mt-0.5">Beban tugas (Todo, In Progress, Done) masing-masing personel</p>
                    </div>
                    <a href="/Member" class="text-xs text-indigo-600 hover:text-indigo-800 font-bold">Detail Member →</a>
                </div>
                <div class="h-64">
                    <canvas id="memberWorkloadChart"></canvas>
                </div>
            </div>

            <!-- CHART B: PROJECT TASK DISTRIBUTION -->
            <div class="bg-white rounded-3xl p-5 shadow-sm border border-indigo-100">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <h3 class="font-bold text-slate-800 flex items-center gap-2 text-sm">
                            <i class="fas fa-layer-group text-amber-500"></i>
                            Distribusi Tugas per Nama Proyek
                        </h3>
                        <p class="text-xs text-slate-400 mt-0.5">Perbandingan jumlah status tugas pada masing-masing proyek</p>
                    </div>
                    <a href="/Project" class="text-xs text-indigo-500 hover:text-indigo-700 font-bold">Semua Proyek →</a>
                </div>
                <div class="h-64">
                    <canvas id="projectBarChart"></canvas>
                </div>
            </div>
        </div>

        <!-- ROW 3: PROJECT-MEMBER MATRIX INTERACTIVE FILTER -->
        <div class="bg-white rounded-3xl p-5 shadow-sm border border-indigo-100">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-4">
                <div>
                    <h3 class="font-bold text-slate-800 flex items-center gap-2 text-sm">
                        <i class="fas fa-project-diagram text-purple-600"></i>
                        Distribusi & Kontribusi Anggota dalam 1 Proyek
                    </h3>
                    <p class="text-xs text-slate-400 mt-0.5">Pilih proyek untuk melihat alokasi tugas gabungan seluruh anggota tim</p>
                </div>

                <!-- Project Selector Dropdown -->
                <div class="flex items-center gap-2 w-full sm:w-auto">
                    <label for="projectFilterSelect" class="text-xs font-bold text-slate-500 whitespace-nowrap">Filter Proyek:</label>
                    <div class="w-full sm:w-64">
                        <select id="projectFilterSelect" onchange="filterProjectMemberChart(this.value)"
                                class="select2 select2-compact w-full" data-placeholder="⭐ Semua Proyek (Gabungan Tim)">
                            <option value="0">⭐ Semua Proyek (Gabungan Tim)</option>
                            @foreach (var proj in Model.AllProjects)
                            {
                                <option value="@proj.Id">📁 @proj.Name</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- Dynamic Interactive Project-Member Chart -->
            <div class="h-64 mb-3">
                <canvas id="projectMemberChart"></canvas>
            </div>
        </div>

        <!-- ROW 4: MEMBER PRODUCTIVITY TABLE (Period-Filtered) -->
        <div class="bg-white rounded-3xl p-5 shadow-sm border border-indigo-100">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h3 class="font-bold text-slate-800 flex items-center gap-2 text-sm">
                        <i class="fas fa-medal text-amber-500"></i>
                        Produktivitas Anggota Tim
                    </h3>
                    <p class="text-xs text-slate-400 mt-0.5">Tugas selesai &amp; jam kerja per anggota sesuai periode filter</p>
                </div>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-700" id="productivityPeriodBadge">7 Hari Terakhir</span>
            </div>
            <div id="memberProductivityTable">
                <div class="text-center p-6 text-slate-400"><i class="fas fa-spinner fa-spin"></i> Memuat...</div>
            </div>
        </div>
    </div>

    <!-- 4. BOTTOM SECTION: MY TASKS & RECENT NOTES / OVERDUE -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
        
        <!-- LEFT 2 COLS: MY PERSONAL TASKS -->
        <div class="bg-white rounded-3xl shadow-sm border border-indigo-100 lg:col-span-2 overflow-hidden">
            <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                <div>
                    <h3 class="font-bold text-slate-800 text-sm flex items-center gap-2">
                        <i class="fas fa-clipboard-list text-indigo-500"></i>
                        Daftar Tugas Personal Saya
                    </h3>
                    <p class="text-xs text-slate-400 mt-0.5">Tugas aktif yang ditugaskan kepada @Model.CurrentUserName</p>
                </div>
                <a href="/Task" class="text-xs text-indigo-600 hover:text-indigo-800 font-bold">
                    Lihat Semua Tugas →
                </a>
            </div>

            @if (!Model.MyTasks.Any())
            {
                <div class="p-10 text-center text-slate-400">
                    <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-400 flex items-center justify-center mx-auto mb-2 text-xl">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <p class="text-sm font-bold text-slate-700">Tidak ada tugas aktif yang ditugaskan kepada Anda saat ini</p>
                    <a href="/Task/Create" class="mt-2 inline-block text-xs font-bold text-indigo-600 hover:underline">+ Buat Tugas Baru</a>
                </div>
            }
            else
            {
                <div class="divide-y divide-slate-100">
                    @foreach (var task in Model.MyTasks)
                    {
                        var isDone = task.Status == TrackerKerja.Models.TaskStatus.Done;
                        var isOverdue = task.DueDate.HasValue && task.DueDate.Value < DateTime.Now && !isDone;

                        <div class="p-4 flex items-center gap-3 hover:bg-indigo-50/20 transition-colors group">
                            <!-- Priority Dot -->
                            <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0
                                @(task.Priority == TrackerKerja.Models.TaskPriority.Critical ? "bg-red-100 text-red-600" :
                                  task.Priority == TrackerKerja.Models.TaskPriority.High ? "bg-amber-100 text-amber-600" :
                                  task.Priority == TrackerKerja.Models.TaskPriority.Medium ? "bg-blue-100 text-blue-600" : "bg-emerald-100 text-emerald-600")">
                                <i class="fas fa-circle text-[9px]"></i>
                            </div>

                            <!-- Title & Project -->
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2">
                                    <a href="/Task/Edit/@task.Id" class="font-bold text-slate-800 text-xs truncate hover:text-indigo-600 block">
                                        @task.Title
                                    </a>
                                    @if (isOverdue)
                                    {
                                        <span class="text-[9px] bg-red-100 text-red-600 font-extrabold px-1.5 py-0.2 rounded">Telat</span>
                                    }
                                </div>
                                <div class="flex items-center gap-3 text-[11px] text-slate-400 mt-0.5 flex-wrap">
                                    @if (task.Project != null)
                                    {
                                        <span class="font-semibold text-slate-600">📁 @task.Project.Name</span>
                                    }
                                    <span>Deadline: @(task.DueDate?.ToString("dd MMM yyyy") ?? "-")</span>
                                    <span class="font-mono text-indigo-600 font-bold">⏱️ @task.TotalDurationFormatted</span>
                                </div>
                            </div>

                            <!-- Status Badge -->
                            <span class="text-[10px] font-bold px-2 py-0.5 rounded-lg
                                @(isDone ? "bg-emerald-100 text-emerald-700" :
                                  task.Status == TrackerKerja.Models.TaskStatus.InProgress ? "bg-indigo-100 text-indigo-700" : "bg-slate-100 text-slate-600")">
                                @task.Status
                            </span>

                            <!-- Actions -->
                            <div class="flex items-center gap-1.5">
                                @if (!isDone)
                                {
                                    <button onclick="startTimer(@task.Id, '@task.Title.Replace("'","\\'")')"
                                            class="p-2 rounded-xl bg-indigo-50 hover:bg-indigo-600 text-indigo-600 hover:text-white text-xs transition-colors" title="Mulai Timer">
                                        <i class="fas fa-play"></i>
                                    </button>
                                }
                                <a href="/Task/Edit/@task.Id" class="p-2 rounded-xl bg-slate-50 hover:bg-slate-200 text-slate-600 text-xs transition-colors" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- RIGHT 1 COL: OVERDUE & MY NOTES -->
        <div class="space-y-5">
            
            <!-- OVERDUE ALERT -->
            @if (Model.OverdueTaskList.Any())
            {
                <div class="bg-red-50 rounded-3xl border border-red-200 p-4 shadow-sm">
                    <h3 class="font-bold text-red-700 text-xs uppercase tracking-wider flex items-center gap-2 mb-2.5">
                        <i class="fas fa-exclamation-triangle"></i>
                        Tugas Terlambat Tim (@Model.OverdueTaskList.Count)
                    </h3>
                    <div class="space-y-2">
                        @foreach (var task in Model.OverdueTaskList.Take(3))
                        {
                            <div class="flex items-center justify-between gap-2 p-2.5 bg-white rounded-xl shadow-xs">
                                <div class="min-w-0 flex-1">
                                    <a href="/Task/Edit/@task.Id" class="text-red-800 text-xs font-bold truncate block hover:underline">@task.Title</a>
                                    <p class="text-[10px] text-red-500">PIC: @(task.AssignedToUser?.FullName ?? "Belum Ditugaskan")</p>
                                </div>
                                <span class="text-[9px] bg-red-100 text-red-700 px-2 py-0.5 rounded font-extrabold">Telat</span>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- MY RECENT NOTES -->
            <div class="bg-white rounded-3xl p-5 shadow-sm border border-indigo-100">
                <div class="flex items-center justify-between mb-3">
                    <h4 class="font-bold text-slate-800 text-xs uppercase tracking-wider flex items-center gap-2">
                        <i class="fas fa-pen-fancy text-purple-500"></i>
                        Catatan Kontribusi Saya
                    </h4>
                    <a href="/Note" class="text-xs text-indigo-600 font-bold hover:underline">Semua →</a>
                </div>

                @if (!Model.MyRecentNotes.Any())
                {
                    <div class="text-center p-6 text-slate-400">
                        <p class="text-xs">Belum ada catatan yang Anda tulis.</p>
                        <a href="/Note/Create" class="text-xs text-indigo-600 font-bold hover:underline block mt-1">+ Tulis Catatan Baru</a>
                    </div>
                }
                else
                {
                    <div class="space-y-2.5">
                        @foreach (var note in Model.MyRecentNotes)
                        {
                            <div class="p-3 rounded-2xl bg-slate-50 border-l-4 hover:bg-indigo-50/30 transition-all" style="border-left-color: @note.Color;">
                                <div class="flex items-center justify-between text-[10px] text-slate-400 mb-1">
                                    <span class="font-bold text-slate-600">@note.Category</span>
                                    <span>@note.UpdatedAt.ToString("dd MMM")</span>
                                </div>
                                <a href="/Note/Details/@note.Id" class="font-bold text-slate-800 text-xs hover:text-indigo-600 block truncate">
                                    @note.Title
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- KPI DRILL-DOWN MODAL -->
<div id="kpiDrillDownModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4" role="dialog">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="closeDrillDown()"></div>
    <div class="relative bg-white rounded-3xl shadow-2xl w-full max-w-2xl max-h-[80vh] flex flex-col overflow-hidden">
        <!-- Header -->
        <div class="flex items-center justify-between p-5 border-b border-slate-100">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center text-white text-sm" id="drillDownIconBox">
                    <i class="fas fa-list"></i>
                </div>
                <div>
                    <h3 class="font-black text-slate-800 text-sm" id="drillDownTitle">Daftar Tugas</h3>
                    <p class="text-[11px] text-slate-400" id="drillDownSubtitle">Memuat...</p>
                </div>
            </div>
            <button onclick="closeDrillDown()" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-all">
                <i class="fas fa-times text-xs"></i>
            </button>
        </div>
        <!-- Task List -->
        <div class="flex-1 overflow-y-auto p-5" id="drillDownContent">
            <div class="text-center py-8 text-slate-400"><i class="fas fa-spinner fa-spin"></i></div>
        </div>
        <!-- Footer -->
        <div class="p-4 border-t border-slate-100 bg-slate-50 flex items-center justify-between">
            <span class="text-xs text-slate-500" id="drillDownFooter">-</span>
            <a href="/Task" class="text-xs font-bold text-indigo-600 hover:text-indigo-800">Lihat Semua Tugas →</a>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ── ANALYTICS STATE ──────────────────────────────────────────────
    let currentAnalyticsPeriod = 'week';
    let trendChartInstance = null;
    let trendShowHours = true; // toggle mode: hours vs done tasks

    // 1. Trend Chart (replaces static weekChart, now dynamic)
    const ctxWeek = document.getElementById('weekChart').getContext('2d');

    function buildTrendChart(labels, hoursData, doneData, mode) {
        if (trendChartInstance) trendChartInstance.destroy();
        const isHours = mode === 'hours';
        trendChartInstance = new Chart(ctxWeek, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: isHours ? 'Jam Kerja' : 'Tugas Selesai',
                    data: isHours ? hoursData : doneData,
                    backgroundColor: isHours ? 'rgba(99,102,241,0.18)' : 'rgba(16,185,129,0.18)',
                    borderColor: isHours ? '#6366F1' : '#10B981',
                    borderWidth: 2,
                    borderRadius: 6,
                    borderSkipped: false,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: 'rgba(99,102,241,0.06)' },
                        ticks: { font: { size: 10 }, color: '#94A3B8' }
                    },
                    x: {
                        grid: { display: false },
                        ticks: {
                            font: { size: labels.length > 20 ? 8 : 10, weight: '600' },
                            color: isHours ? '#6366F1' : '#10B981',
                            maxRotation: labels.length > 14 ? 45 : 0
                        }
                    }
                }
            }
        });
    }

    function toggleTrendMode() {
        trendShowHours = !trendShowHours;
        const mode = trendShowHours ? 'hours' : 'done';
        document.getElementById('trendChartTitle').textContent = trendShowHours ? 'Tren Jam Kerja' : 'Tren Tugas Selesai';
        if (window._lastAnalyticsData) {
            buildTrendChart(
                window._lastAnalyticsData.trendLabels,
                window._lastAnalyticsData.trendHours,
                window._lastAnalyticsData.trendDoneTasks,
                mode
            );
        }
    }

    // Initial fallback render using Razor data (Week 7 hari)
    buildTrendChart(
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeekLabels)),
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeekHours)),
        [],
        'hours'
    );


    // 2. Status Doughnut Chart
    const ctxStatus = document.getElementById('statusDoughnutChart').getContext('2d');
    new Chart(ctxStatus, {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatusChartLabels)),
            datasets: [{
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatusChartCounts)),
                backgroundColor: [
                    '#F59E0B', // Todo - Amber
                    '#06B6D4', // In Progress - Cyan
                    '#10B981', // Done - Emerald
                    '#EF4444'  // Overdue - Red
                ],
                borderWidth: 2,
                borderColor: '#FFFFFF',
                hoverOffset: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '70%',
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        boxWidth: 10,
                        font: { size: 11, weight: '500' },
                        padding: 10
                    }
                }
            }
        }
    });

    // 3. Member Workload Distribution Chart (Task per Member)
    const ctxMember = document.getElementById('memberWorkloadChart').getContext('2d');
    new Chart(ctxMember, {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MemberChartLabels)),
            datasets: [
                {
                    label: 'Todo',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MemberChartTodo)),
                    backgroundColor: '#F59E0B',
                    borderRadius: 4
                },
                {
                    label: 'In Progress',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MemberChartInProgress)),
                    backgroundColor: '#06B6D4',
                    borderRadius: 4
                },
                {
                    label: 'Done',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MemberChartDone)),
                    backgroundColor: '#10B981',
                    borderRadius: 4
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'top',
                    labels: { boxWidth: 10, font: { size: 10, weight: '600' } }
                }
            },
            scales: {
                x: {
                    stacked: true,
                    grid: { display: false },
                    ticks: { font: { size: 10, weight: '600' }, color: '#475569' }
                },
                y: {
                    stacked: true,
                    beginAtZero: true,
                    ticks: { stepSize: 1, font: { size: 10 }, color: '#94A3B8' },
                    grid: { color: 'rgba(99,102,241,0.06)' }
                }
            }
        }
    });

    // 4. Project Task Distribution Bar Chart
    const ctxProject = document.getElementById('projectBarChart').getContext('2d');
    new Chart(ctxProject, {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProjectChartLabels)),
            datasets: [
                {
                    label: 'Todo',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProjectChartTodo)),
                    backgroundColor: '#F59E0B',
                    borderRadius: 4
                },
                {
                    label: 'In Progress',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProjectChartInProgress)),
                    backgroundColor: '#06B6D4',
                    borderRadius: 4
                },
                {
                    label: 'Done',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProjectChartDone)),
                    backgroundColor: '#10B981',
                    borderRadius: 4
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'top',
                    labels: { boxWidth: 10, font: { size: 10, weight: '600' } }
                }
            },
            scales: {
                x: {
                    stacked: true,
                    grid: { display: false },
                    ticks: { font: { size: 10, weight: '500' }, color: '#475569' }
                },
                y: {
                    stacked: true,
                    beginAtZero: true,
                    ticks: { stepSize: 1, font: { size: 10 }, color: '#94A3B8' },
                    grid: { color: 'rgba(99,102,241,0.06)' }
                }
            }
        }
    });

    // 5. Interactive Project-Member Matrix Chart
    let projectMemberChartInstance = null;
    const ctxProjectMember = document.getElementById('projectMemberChart').getContext('2d');

    function renderProjectMemberChart(data) {
        if (projectMemberChartInstance) {
            projectMemberChartInstance.destroy();
        }

        const labels = data.map(d => d.memberName);
        const todoData = data.map(d => d.todo);
        const inProgressData = data.map(d => d.inProgress);
        const doneData = data.map(d => d.done);
        const hoursData = data.map(d => d.hours);

        projectMemberChartInstance = new Chart(ctxProjectMember, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Todo',
                        data: todoData,
                        backgroundColor: '#F59E0B',
                        borderRadius: 4
                    },
                    {
                        label: 'In Progress',
                        data: inProgressData,
                        backgroundColor: '#06B6D4',
                        borderRadius: 4
                    },
                    {
                        label: 'Done',
                        data: doneData,
                        backgroundColor: '#10B981',
                        borderRadius: 4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: { boxWidth: 12, font: { size: 11, weight: '600' } }
                    },
                    tooltip: {
                        callbacks: {
                            afterBody: function(context) {
                                const idx = context[0].dataIndex;
                                return 'Total Waktu: ' + hoursData[idx] + ' Jam';
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        stacked: true,
                        grid: { display: false },
                        ticks: { font: { size: 11, weight: '600' }, color: '#475569' }
                    },
                    y: {
                        stacked: true,
                        beginAtZero: true,
                        ticks: { stepSize: 1, font: { size: 10 }, color: '#94A3B8' },
                        grid: { color: 'rgba(99,102,241,0.06)' }
                    }
                }
            }
        });
    }

    async function filterProjectMemberChart(projectId) {
        try {
            const res = await fetch('/Home/GetProjectMemberDistribution?projectId=' + projectId);
            const data = await res.json();
            renderProjectMemberChart(data);
        } catch (e) {
            console.error('Error fetching project member distribution', e);
        }
    }

    // Initial load for project member chart
    filterProjectMemberChart(0);

    // ── ANALYTICS PERIOD FILTER SYSTEM ─────────────────────────────
    async function loadAnalytics(period) {
        currentAnalyticsPeriod = period;

        // Update active button style
        document.querySelectorAll('.period-btn').forEach(btn => {
            const isActive = btn.dataset.period === period;
            btn.classList.toggle('active-period', isActive);
            btn.classList.toggle('bg-white', isActive);
            btn.classList.toggle('shadow-sm', isActive);
            btn.classList.toggle('text-indigo-700', isActive);
            btn.classList.toggle('text-slate-600', !isActive);
        });

        const refreshIcon = document.getElementById('analyticsRefreshIcon');
        if (refreshIcon) refreshIcon.classList.add('fa-spin');

        const projectId = document.getElementById('analyticsProjectFilter')?.value || 0;
        try {
            const res = await fetch(`/Home/GetDashboardAnalytics?period=${period}&projectId=${projectId}`);
            const data = await res.json();
            window._lastAnalyticsData = data;

            // Update period label
            const labelEl = document.getElementById('analyticsperiodLabel');
            const rangeEl = document.getElementById('analyticsdateRange');
            if (labelEl) labelEl.textContent = data.periodLabel;
            if (rangeEl) rangeEl.textContent = `${data.dateFrom} – ${data.dateTo}`;

            // Update productivity badge
            const prodBadge = document.getElementById('productivityPeriodBadge');
            if (prodBadge) prodBadge.textContent = data.periodLabel;

            // Render KPI cards
            renderAnalyticsKpiCards(data, period);

            // Update trend chart
            buildTrendChart(data.trendLabels, data.trendHours, data.trendDoneTasks, trendShowHours ? 'hours' : 'done');

            // Update productivity table
            renderProductivityTable(data.memberProductivity);

        } catch(e) {
            console.error('Analytics load failed', e);
        } finally {
            if (refreshIcon) refreshIcon.classList.remove('fa-spin');
        }
    }

    function renderAnalyticsKpiCards(data, period) {
        const row = document.getElementById('analyticsKpiRow');
        if (!row) return;

        const pct = data.completionRatePercent;
        const pctColor = pct >= 75 ? 'text-emerald-600' : pct >= 40 ? 'text-amber-600' : 'text-rose-600';
        const pctBg = pct >= 75 ? 'bg-emerald-50' : pct >= 40 ? 'bg-amber-50' : 'bg-rose-50';

        row.innerHTML = `
            <div class="p-4 text-center border-r border-slate-100 cursor-pointer hover:bg-indigo-50/40 transition-colors group" onclick="openDrillDown('done','${period}')">
                <p class="text-2xl font-black text-emerald-600">${data.doneTasks}</p>
                <p class="text-[11px] font-bold text-slate-500 mt-0.5 group-hover:text-emerald-700">✅ Selesai</p>
                <p class="text-[10px] text-slate-400 mt-0.5">Klik → Detail</p>
            </div>
            <div class="p-4 text-center border-r border-slate-100 cursor-pointer hover:bg-indigo-50/40 transition-colors group" onclick="openDrillDown('inprogress','${period}')">
                <p class="text-2xl font-black text-cyan-600">${data.inProgressTasks}</p>
                <p class="text-[11px] font-bold text-slate-500 mt-0.5 group-hover:text-cyan-700">🔄 In Progress</p>
                <p class="text-[10px] text-slate-400 mt-0.5">Klik → Detail</p>
            </div>
            <div class="p-4 text-center border-r border-slate-100 cursor-pointer hover:bg-indigo-50/40 transition-colors group" onclick="openDrillDown('todo','${period}')">
                <p class="text-2xl font-black text-amber-600">${data.todoTasks}</p>
                <p class="text-[11px] font-bold text-slate-500 mt-0.5 group-hover:text-amber-700">📋 Todo</p>
                <p class="text-[10px] text-slate-400 mt-0.5">Klik → Detail</p>
            </div>
            <div class="p-4 text-center border-r border-slate-100 cursor-pointer hover:bg-rose-50/40 transition-colors group" onclick="openDrillDown('overdue','${period}')">
                <p class="text-2xl font-black text-rose-600">${data.overdueTasks}</p>
                <p class="text-[11px] font-bold text-slate-500 mt-0.5 group-hover:text-rose-700">⚠️ Overdue</p>
                <p class="text-[10px] text-slate-400 mt-0.5">Klik → Detail</p>
            </div>
            <div class="p-4 text-center border-r border-slate-100">
                <p class="text-2xl font-black text-indigo-600">${data.totalWorkHours}j</p>
                <p class="text-[11px] font-bold text-slate-500 mt-0.5">⏱️ Jam Kerja</p>
                <p class="text-[10px] text-slate-400 mt-0.5">~${data.avgDailyWorkHours}j/hari</p>
            </div>
            <div class="p-4 text-center">
                <p class="text-2xl font-black ${pctColor}">${pct}%</p>
                <p class="text-[11px] font-bold text-slate-500 mt-0.5">🎯 Completion</p>
                <div class="mt-1.5 bg-slate-100 rounded-full h-1.5 overflow-hidden">
                    <div class="h-full rounded-full transition-all duration-500 ${pct >= 75 ? 'bg-emerald-500' : pct >= 40 ? 'bg-amber-500' : 'bg-rose-500'}" style="width:${pct}%"></div>
                </div>
            </div>
        `;
    }

    function renderProductivityTable(members) {
        const container = document.getElementById('memberProductivityTable');
        if (!container) return;

        if (!members || members.length === 0) {
            container.innerHTML = '<div class="text-center py-6 text-slate-400 text-xs">Tidak ada data anggota untuk periode ini.</div>';
            return;
        }

        // Sort by done tasks desc
        const sorted = [...members].sort((a, b) => b.doneTasks - a.doneTasks);
        const maxDone = sorted[0]?.doneTasks || 1;

        container.innerHTML = `
            <div class="space-y-2">
                ${sorted.map((m, i) => {
                    const barPct = maxDone > 0 ? Math.round((m.doneTasks / maxDone) * 100) : 0;
                    const medal = i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : `${i+1}.`;
                    return `
                    <div class="flex items-center gap-3 p-3 rounded-2xl bg-slate-50 hover:bg-indigo-50/40 transition-all group">
                        <span class="text-sm w-6 text-center flex-shrink-0 font-black text-slate-500">${medal}</span>
                        <div class="w-8 h-8 rounded-xl flex items-center justify-center text-white text-xs font-black flex-shrink-0" style="background:${m.memberColor}">${m.initials}</div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-xs font-bold text-slate-800 truncate">${m.memberName}</span>
                                <div class="flex items-center gap-3 text-[11px] font-bold flex-shrink-0 ml-2">
                                    <span class="text-emerald-600">✅ ${m.doneTasks}</span>
                                    <span class="text-indigo-600">⏱ ${m.workHours}j</span>
                                    <span class="text-slate-500">${m.completionRatePercent}%</span>
                                </div>
                            </div>
                            <div class="bg-slate-200 rounded-full h-1.5 overflow-hidden">
                                <div class="h-full rounded-full bg-gradient-to-r from-indigo-500 to-emerald-500 transition-all duration-700" style="width:${barPct}%"></div>
                            </div>
                        </div>
                    </div>`;
                }).join('')}
            </div>
        `;
    }

    // ── KPI DRILL-DOWN MODAL ────────────────────────────────────────
    const kpiConfig = {
        done:      { title: 'Tugas Selesai', color: '#10B981', icon: 'fa-check-circle', bg: 'bg-emerald-500' },
        inprogress:{ title: 'Tugas In Progress', color: '#06B6D4', icon: 'fa-spinner', bg: 'bg-cyan-500' },
        todo:      { title: 'Tugas Todo', color: '#F59E0B', icon: 'fa-clipboard-list', bg: 'bg-amber-500' },
        overdue:   { title: 'Tugas Overdue', color: '#EF4444', icon: 'fa-exclamation-triangle', bg: 'bg-rose-500' },
    };

    async function openDrillDown(kpi, period) {
        const modal = document.getElementById('kpiDrillDownModal');
        const cfg = kpiConfig[kpi] || kpiConfig.done;
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';

        // Update header
        document.getElementById('drillDownTitle').textContent = cfg.title;
        document.getElementById('drillDownSubtitle').textContent = 'Memuat daftar tugas...';
        document.getElementById('drillDownIconBox').className = `w-10 h-10 rounded-xl flex items-center justify-center text-white text-sm ${cfg.bg}`;
        document.getElementById('drillDownIconBox').innerHTML = `<i class="fas ${cfg.icon}"></i>`;
        document.getElementById('drillDownContent').innerHTML = '<div class="text-center py-8 text-slate-400"><i class="fas fa-spinner fa-spin"></i></div>';

        try {
            const projectId = document.getElementById('analyticsProjectFilter')?.value || 0;
            const res = await fetch(`/Home/GetKpiDrillDown?kpi=${kpi}&period=${period}&projectId=${projectId}`);
            const data = await res.json();

            document.getElementById('drillDownSubtitle').textContent = `${data.total} tugas ditemukan`;
            document.getElementById('drillDownFooter').textContent = `Menampilkan ${Math.min(data.total, 50)} dari ${data.total} tugas`;

            if (!data.tasks || data.tasks.length === 0) {
                document.getElementById('drillDownContent').innerHTML =
                    '<div class="text-center py-10 text-slate-400"><i class="fas fa-inbox text-2xl mb-2 block"></i>Tidak ada tugas dalam kategori ini.</div>';
                return;
            }

            const priorityColors = { Critical: 'bg-red-100 text-red-700', High: 'bg-amber-100 text-amber-700', Medium: 'bg-blue-100 text-blue-700', Low: 'bg-emerald-100 text-emerald-700' };
            const statusColors  = { Done: 'bg-emerald-100 text-emerald-700', InProgress: 'bg-cyan-100 text-cyan-700', Todo: 'bg-slate-100 text-slate-600', Overdue: 'bg-rose-100 text-rose-700' };

            document.getElementById('drillDownContent').innerHTML = `
                <div class="space-y-2">
                    ${data.tasks.map(t => `
                        <a href="${t.editUrl}" class="flex items-start gap-3 p-3 rounded-2xl bg-slate-50 hover:bg-indigo-50 transition-all group border border-transparent hover:border-indigo-200">
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-1.5 flex-wrap mb-1">
                                    <span class="text-xs font-bold text-slate-800 group-hover:text-indigo-700 truncate max-w-xs">${t.title}</span>
                                    ${t.isOverdue ? '<span class="text-[9px] bg-rose-100 text-rose-600 font-extrabold px-1.5 py-0.5 rounded">Telat</span>' : ''}
                                </div>
                                <div class="flex items-center gap-2 flex-wrap text-[10px] text-slate-400">
                                    ${t.projectName ? `<span class="font-semibold text-slate-600">📁 ${t.projectName}</span>` : ''}
                                    ${t.assigneeName ? `<span>👤 ${t.assigneeName}</span>` : '<span class="text-slate-400">Belum Ditugaskan</span>'}
                                    ${t.dueDate ? `<span>📅 ${t.dueDate}</span>` : ''}
                                    <span class="font-mono text-indigo-600 font-bold">⏱ ${t.workHours}j</span>
                                </div>
                            </div>
                            <div class="flex flex-col items-end gap-1.5 flex-shrink-0">
                                <span class="text-[9px] font-bold px-2 py-0.5 rounded-lg ${priorityColors[t.priority] || 'bg-slate-100 text-slate-600'}">${t.priority}</span>
                                <span class="text-[9px] font-bold px-2 py-0.5 rounded-lg ${statusColors[t.status] || 'bg-slate-100 text-slate-600'}">${t.status}</span>
                            </div>
                        </a>
                    `).join('')}
                </div>
            `;
        } catch(e) {
            document.getElementById('drillDownContent').innerHTML =
                '<div class="text-center py-8 text-rose-400"><i class="fas fa-exclamation-triangle"></i> Gagal memuat data.</div>';
        }
    }

    function closeDrillDown() {
        document.getElementById('kpiDrillDownModal').classList.add('hidden');
        document.body.style.overflow = '';
    }

    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDrillDown(); });

    // Auto-load analytics on page load (default: week)
    loadAnalytics('week');

    // Timer functions
    function startTimer(taskId, taskTitle) {
        startGlobalTimer(taskId, taskTitle);
    }

    function stopCurrentTimer(sessionId) {
        stopGlobalTimer(sessionId);
    }

    // ── DASHBOARD BACKGROUND SYNC WORKER ──────────────────────
    async function runBackgroundProcess() {
        const syncIcon = document.getElementById('syncIcon');
        if (syncIcon) syncIcon.classList.add('fa-spin');

        try {
            const resp = await fetch('/Home/RunBackgroundSync', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await resp.json();
            if (data.success) {
                const tsElem = document.getElementById('bgSyncTimestamp');
                if (tsElem) tsElem.innerText = 'Sync: ' + data.timestamp;
            }
        } catch (e) {
            console.error('Background sync failed:', e);
        } finally {
            if (syncIcon) syncIcon.classList.remove('fa-spin');
        }
    }

    function triggerManualSync() {
        runBackgroundProcess();
    }

    // Auto-run background sync every 30 seconds
    setInterval(runBackgroundProcess, 30000);

    // ── DASHBOARD DAILY CHECK-IN HANDLER ──────────────────────
    async function performDashboardCheckIn() {
        const btnCard = document.getElementById('btnCardCheckIn');
        const btnBanner = document.getElementById('btnBannerCheckIn');
        if (btnCard) { btnCard.disabled = true; btnCard.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Memproses...'; }
        if (btnBanner) { btnBanner.disabled = true; btnBanner.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Memproses...'; }

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const formData = new FormData();
            formData.append('notes', 'Check-in via Dashboard Card');
            if (token) formData.append('__RequestVerificationToken', token);

            const res = await fetch('/Gamification/CheckIn', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token
                },
                body: formData
            });

            const data = await res.json();
            if (data.success) {
                if (typeof confetti === 'function') {
                    confetti({
                        particleCount: 110,
                        spread: 75,
                        origin: { y: 0.6 }
                    });
                }
                Swal.fire({
                    icon: 'success',
                    title: data.isMonthlyMilestone ? '🎉 Hadiah Bulanan Terbuka!' : '🔥 Check-In Berhasil!',
                    text: data.message,
                    confirmButtonColor: '#F59E0B',
                    confirmButtonText: 'Keren!'
                }).then(() => {
                    window.location.reload();
                });
            } else {
                Swal.fire({
                    icon: 'info',
                    title: 'Pemberitahuan',
                    text: data.message,
                    confirmButtonColor: '#6366F1'
                });
                if (btnCard) { btnCard.disabled = false; btnCard.innerHTML = '<i class="fas fa-hand-sparkles"></i> Check-In (+@(Model.CheckInStatus.PointsPerCheckIn) P)'; }
                if (btnBanner) { btnBanner.disabled = false; btnBanner.innerHTML = '<i class="fas fa-hand-sparkles"></i> Check-In Sekarang (+@(Model.CheckInStatus.PointsPerCheckIn) P)'; }
            }
        } catch (err) {
            console.error('Check-in error:', err);
            Swal.fire({
                icon: 'error',
                title: 'Gagal',
                text: 'Terjadi kesalahan jaringan saat melakukan check-in.',
                confirmButtonColor: '#EF4444'
            });
            if (btnCard) { btnCard.disabled = false; btnCard.innerHTML = '<i class="fas fa-hand-sparkles"></i> Check-In (+@(Model.CheckInStatus.PointsPerCheckIn) P)'; }
            if (btnBanner) { btnBanner.disabled = false; btnBanner.innerHTML = '<i class="fas fa-hand-sparkles"></i> Check-In Sekarang (+@(Model.CheckInStatus.PointsPerCheckIn) P)'; }
        }
    }
</script>
}
