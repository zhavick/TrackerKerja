@model TrackerKerja.ViewModels.RegisterViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="id" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Daftar Akun & Perusahaan — Work Tracker Pro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        body { font-family: 'Outfit', sans-serif; }
        .glass { background: rgba(255,255,255,0.95); backdrop-filter: blur(24px); }
        .input-field { transition: all 0.2s; }
        .input-field:focus { transform: translateY(-1px); box-shadow: 0 4px 20px rgba(16,185,129,0.15); }
        .floating-shape { animation: float 6s ease-in-out infinite; }
        @@keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-15px); }
        }
        .btn-register { transition: all 0.3s; }
        .btn-register:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(16,185,129,0.35); }
    </style>
</head>
<body class="min-h-full bg-gradient-to-br from-emerald-950 via-teal-900 to-slate-950 flex items-center justify-center p-4 relative overflow-x-hidden">

    <!-- Decorative shapes -->
    <div class="floating-shape absolute top-10 right-20 w-80 h-80 rounded-full bg-emerald-500/10 blur-3xl pointer-events-none"></div>
    <div class="floating-shape absolute bottom-10 left-20 w-72 h-72 rounded-full bg-teal-500/10 blur-3xl pointer-events-none"></div>

    <div class="glass w-full max-w-xl rounded-3xl shadow-2xl border border-white/20 p-8 sm:p-10 relative z-10 my-8">

        <!-- Header -->
        <div class="text-center mb-6">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center mx-auto mb-3 shadow-xl shadow-emerald-500/30 text-white text-2xl">
                <i class="fas fa-building-user"></i>
            </div>
            <h1 class="text-2xl sm:text-3xl font-black text-slate-800 tracking-tight">Daftar Akun Workspace</h1>
            <p class="text-slate-500 text-xs sm:text-sm mt-1">Sistem Multi-Perusahaan Terisolasi & Aman</p>
        </div>

        <!-- Privacy & Multi-Tenant Notice -->
        <div class="mb-5 p-3.5 bg-emerald-50 border border-emerald-200 rounded-2xl flex items-start gap-2.5 text-xs text-emerald-900">
            <i class="fas fa-shield-halved text-emerald-600 mt-0.5 text-sm flex-shrink-0"></i>
            <div>
                <span class="font-bold">Privasi Data Terjamin:</span>
                Setiap perusahaan memiliki ruang kerja tersendiri. Anggota dari perusahaan lain tidak dapat melihat tugas, proyek, ataupun catatan milik perusahaan Anda.
            </div>
        </div>

        <!-- Errors -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="mb-5 p-4 bg-rose-50 border border-rose-200 rounded-2xl text-rose-700 text-xs sm:text-sm">
                @Html.ValidationSummary(false, "Mohon periksa kembali input pendaftaran:", new { @class = "list-disc pl-4 font-medium" })
            </div>
        }

        <form method="post" asp-action="Register" asp-controller="Account">
            @Html.AntiForgeryToken()
            <input type="hidden" name="CompanyOption" id="companyOptionInput" value="@(Model?.CompanyOption ?? "existing")" />

            <!-- STEP 1: Profil Pengguna -->
            <div class="mb-5 pb-5 border-b border-slate-200/80">
                <div class="flex items-center gap-2 mb-3 text-xs font-bold uppercase tracking-wider text-slate-400">
                    <i class="fas fa-user-circle text-emerald-500"></i> Informasi Profil
                </div>

                <!-- Full Name -->
                <div class="mb-3.5">
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">
                        Nama Lengkap <span class="text-red-500">*</span>
                    </label>
                    <input type="text" name="FullName" value="@Model?.FullName" required placeholder="Contoh: Rian Prasetya"
                           class="input-field w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-400 text-slate-800 text-sm font-medium">
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                    <!-- Email -->
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5">
                            Email Kerja <span class="text-red-500">*</span>
                        </label>
                        <input type="email" name="Email" value="@Model?.Email" required placeholder="nama@perusahaan.com"
                               class="input-field w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-400 text-slate-800 text-sm">
                    </div>

                    <!-- Job Title -->
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5">
                            Jabatan / Posisi <span class="text-red-500">*</span>
                        </label>
                        <input type="text" name="JobTitle" value="@Model?.JobTitle" required placeholder="Contoh: Software Engineer"
                               class="input-field w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-400 text-slate-800 text-sm">
                    </div>
                </div>
            </div>

            <!-- STEP 2: Afiliasi Perusahaan (Kode Perusahaan) -->
            <div class="mb-5 pb-5 border-b border-slate-200/80">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-1.5">
                        <i class="fas fa-building text-emerald-500"></i> Afiliasi Perusahaan <span class="text-red-500">*</span>
                    </span>
                </div>

                <!-- Company Option Selector Tabs -->
                <div class="grid grid-cols-2 gap-2 p-1.5 bg-slate-100 rounded-2xl mb-4 border border-slate-200">
                    <button type="button" onclick="setCompanyMode('existing')" id="tabModeExisting"
                            class="py-2.5 px-3 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5 cursor-pointer">
                        <i class="fas fa-key text-emerald-500"></i> Masukkan Kode Perusahaan
                    </button>
                    <button type="button" onclick="setCompanyMode('new')" id="tabModeNew"
                            class="py-2.5 px-3 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5 cursor-pointer">
                        <i class="fas fa-plus-circle text-teal-500"></i> Buat Perusahaan Baru
                    </button>
                </div>

                <!-- Mode 1: Masukkan Kode Perusahaan yang Sudah Ada -->
                <div id="companyExistingSection" class="space-y-2">
                    <label class="block text-xs font-bold text-slate-700 mb-1">
                        Kode Perusahaan <span class="text-red-500">*</span>
                    </label>
                    <div class="relative">
                        <i class="fas fa-qrcode absolute left-3.5 top-1/2 -translate-y-1/2 text-emerald-500 text-sm"></i>
                        <input type="text" name="ExistingCompanyCode" id="existingCompanyCodeInput" value="@Model?.ExistingCompanyCode"
                               placeholder="Contoh: ELISTEC" style="text-transform: uppercase;"
                               class="input-field w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-400 text-slate-800 text-sm font-mono tracking-wider font-bold">
                    </div>
                    <p class="text-[11px] text-slate-500 mt-1 leading-relaxed">
                        <i class="fas fa-info-circle text-emerald-500 mr-1"></i>
                        Mintalah kode perusahaan kepada Administrator atau pimpinan tim Anda. Kode ini menghubungkan akun Anda langsung ke workspace tim yang tepat.
                    </p>
                </div>

                <!-- Mode 2: Daftarkan Perusahaan Baru -->
                <div id="companyNewSection" class="space-y-3.5 hidden">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">
                            Nama Perusahaan Baru <span class="text-red-500">*</span>
                        </label>
                        <input type="text" name="NewCompanyName" id="newCompanyNameInput" value="@Model?.NewCompanyName"
                               placeholder="Contoh: PT Wahana Makmur Sejahtera"
                               class="input-field w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-400 text-slate-800 text-sm">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">
                            Buat Kode Perusahaan Unik <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <i class="fas fa-fingerprint absolute left-3.5 top-1/2 -translate-y-1/2 text-teal-500 text-sm"></i>
                            <input type="text" name="NewCompanyCode" id="newCompanyCodeInput" value="@Model?.NewCompanyCode"
                                   placeholder="Contoh: WAHANA" style="text-transform: uppercase;"
                                   class="input-field w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-400 text-slate-800 text-sm font-mono tracking-wider font-bold">
                        </div>
                        <p class="text-[11px] text-slate-500 mt-1 leading-relaxed">
                            <i class="fas fa-check-circle text-teal-500 mr-1"></i>
                            Gunakan singkatan alfanumerik yang mudah diingat (3–15 karakter). Rekan kerja Anda akan memasukkan kode ini saat bergabung.
                        </p>
                    </div>
                </div>
            </div>

            <!-- STEP 3: Keamanan & Kata Sandi -->
            <div class="mb-6">
                <div class="flex items-center gap-2 mb-3 text-xs font-bold uppercase tracking-wider text-slate-400">
                    <i class="fas fa-lock text-emerald-500"></i> Kata Sandi
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5">
                            Password <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <input type="password" name="Password" id="pwd" required placeholder="Min. 6 karakter"
                                   class="input-field w-full px-4 py-2.5 pr-10 rounded-xl border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-400 text-slate-800 text-sm">
                            <button type="button" onclick="togglePwd('pwd','eye1')"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-emerald-500">
                                <i class="fas fa-eye text-sm" id="eye1"></i>
                            </button>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5">
                            Konfirmasi Password <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <input type="password" name="ConfirmPassword" id="pwd2" required placeholder="Ulangi password"
                                   class="input-field w-full px-4 py-2.5 pr-10 rounded-xl border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-400 text-slate-800 text-sm">
                            <button type="button" onclick="togglePwd('pwd2','eye2')"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-emerald-500">
                                <i class="fas fa-eye text-sm" id="eye2"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Submit -->
            <button type="submit"
                    class="btn-register w-full bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white font-bold py-3.5 rounded-2xl text-sm shadow-lg shadow-emerald-600/25 flex items-center justify-center gap-2 cursor-pointer transition-all">
                <i class="fas fa-user-plus"></i> Selesaikan Pendaftaran
            </button>
        </form>

        <p class="text-center text-slate-500 text-xs mt-6">
            Sudah memiliki akun terdaftar?
            <a href="/Account/Login" class="text-emerald-600 font-bold hover:text-emerald-800 transition-colors ml-1">Masuk di sini</a>
        </p>
    </div>

    <script>
        function togglePwd(fieldId, iconId) {
            const f = document.getElementById(fieldId);
            const i = document.getElementById(iconId);
            f.type = f.type === 'password' ? 'text' : 'password';
            i.className = f.type === 'password' ? 'fas fa-eye text-sm' : 'fas fa-eye-slash text-sm';
        }

        function setCompanyMode(mode) {
            const hiddenInput = document.getElementById('companyOptionInput');
            const tabNew = document.getElementById('tabModeNew');
            const tabExisting = document.getElementById('tabModeExisting');
            const secNew = document.getElementById('companyNewSection');
            const secExisting = document.getElementById('companyExistingSection');
            const newNameInput = document.getElementById('newCompanyNameInput');
            const newCodeInput = document.getElementById('newCompanyCodeInput');
            const existingCodeInput = document.getElementById('existingCompanyCodeInput');

            hiddenInput.value = mode;

            if (mode === 'new') {
                tabNew.className = 'py-2.5 px-3 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5 bg-white text-teal-700 shadow-sm border border-teal-200 cursor-pointer';
                tabExisting.className = 'py-2.5 px-3 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5 text-slate-500 hover:text-slate-800 cursor-pointer';
                secNew.classList.remove('hidden');
                secExisting.classList.add('hidden');
                if (newNameInput) newNameInput.required = true;
                if (newCodeInput) newCodeInput.required = true;
                if (existingCodeInput) existingCodeInput.required = false;
            } else {
                tabExisting.className = 'py-2.5 px-3 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5 bg-white text-emerald-700 shadow-sm border border-emerald-200 cursor-pointer';
                tabNew.className = 'py-2.5 px-3 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5 text-slate-500 hover:text-slate-800 cursor-pointer';
                secExisting.classList.remove('hidden');
                secNew.classList.add('hidden');
                if (newNameInput) newNameInput.required = false;
                if (newCodeInput) newCodeInput.required = false;
                if (existingCodeInput) existingCodeInput.required = true;
            }
        }

        // Init based on model
        const currentOption = '@(Model?.CompanyOption ?? "existing")';
        setCompanyMode(currentOption === 'new' ? 'new' : 'existing');
    </script>
</body>
</html>
