@model TrackerKerja.ViewModels.TaskFormViewModel
@{
    ViewData["Title"] = "Edit Tugas";
    var priorities = new[] { ("Low","🟢 Low"), ("Medium","🔵 Medium"), ("High","🟡 High"), ("Critical","🔴 Critical") };
    var statuses = new[] { ("Todo","📋 Todo"), ("InProgress","🔄 In Progress"), ("Done","✅ Done") };
    var sessions = Model.Task.Sessions.OrderByDescending(s => s.StartTime).ToList();
}

<div class="max-w-4xl mx-auto space-y-6">

    <!-- Alert Notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-2xl flex items-center gap-3">
            <i class="fas fa-check-circle text-emerald-500 text-lg"></i>
            <p class="text-emerald-700 text-sm font-semibold">@TempData["Success"]</p>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="p-4 bg-red-50 border border-red-200 rounded-2xl flex items-center gap-3">
            <i class="fas fa-exclamation-circle text-red-500 text-lg"></i>
            <p class="text-red-700 text-sm font-semibold">@TempData["Error"]</p>
        </div>
    }

    <!-- Main Edit Form Card -->
    <div class="bg-white rounded-2xl shadow-sm border border-indigo-100 overflow-hidden">
        <div class="bg-gradient-to-r from-indigo-500 to-purple-600 p-6 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center">
                    <i class="fas fa-edit text-white"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h2 class="text-white font-bold text-lg">Edit Tugas: @Model.Task.Title</h2>
                        <span class="bg-white/20 text-white font-mono text-xs px-2 py-0.5 rounded-md font-bold">@Model.Task.TaskCode</span>
                    </div>
                    <p class="text-indigo-200 text-xs mt-0.5">
                        Kode Induk: <strong class="text-white font-mono">@Model.Task.ParentCode</strong> • Dibuat @Model.Task.CreatedAt.ToString("dd MMM yyyy HH:mm")
                    </p>
                </div>
            </div>
            <a href="/Task" class="text-white/80 hover:text-white text-xs bg-white/10 hover:bg-white/20 px-3 py-1.5 rounded-lg transition-colors">
                <i class="fas fa-arrow-left mr-1"></i>Kembali
            </a>
        </div>

        <div class="p-6">
            <form method="post" action="/Task/Edit/@Model.Task.Id">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@Model.Task.Id" />

                <!-- Title -->
                <div class="mb-5">
                    <label class="block text-sm font-semibold text-slate-700 mb-2">
                        <i class="fas fa-heading text-indigo-400 mr-2"></i>Judul Tugas <span class="text-red-500">*</span>
                    </label>
                    <input type="text" name="Title" value="@Model.Task.Title" required
                           class="w-full px-4 py-3 rounded-xl border border-indigo-200 focus:outline-none focus:ring-2 focus:ring-indigo-400 text-slate-800 transition-all font-medium">
                </div>

                <!-- Description -->
                <div class="mb-5">
                    <label class="block text-sm font-semibold text-slate-700 mb-2">
                        <i class="fas fa-align-left text-indigo-400 mr-2"></i>Deskripsi Tugas
                    </label>
                    <textarea name="Description" rows="3" placeholder="Deskripsi tugas (opsional)..."
                              class="w-full px-4 py-3 rounded-xl border border-indigo-200 focus:outline-none focus:ring-2 focus:ring-indigo-400 text-slate-800 transition-all resize-none">@Model.Task.Description</textarea>
                </div>

                <!-- Kendala / Hambatan -->
                <div class="mb-5">
                    <label class="block text-sm font-semibold text-slate-700 mb-2">
                        <i class="fas fa-exclamation-triangle text-amber-500 mr-2"></i>Kendala / Isu / Hambatan
                    </label>
                    <textarea name="Obstacle" rows="3" placeholder="Tuliskan kendala atau masalah yang dihadapi dalam pengerjaan tugas (opsional)..."
                              class="w-full px-4 py-3 rounded-xl border border-amber-200 focus:outline-none focus:ring-2 focus:ring-amber-400 text-slate-800 transition-all resize-none bg-amber-50/20">@Model.Task.Obstacle</textarea>
                </div>

                <!-- Solusi / Tindakan Penyelesaian -->
                <div class="mb-5">
                    <label class="block text-sm font-semibold text-slate-700 mb-2">
                        <i class="fas fa-lightbulb text-emerald-500 mr-2"></i>Solusi / Rencana Penyelesaian
                    </label>
                    <textarea name="Solution" rows="3" placeholder="Tuliskan solusi, tindakan penanganan, atau hasil troubleshooting (opsional)..."
                              class="w-full px-4 py-3 rounded-xl border border-emerald-200 focus:outline-none focus:ring-2 focus:ring-emerald-400 text-slate-800 transition-all resize-none bg-emerald-50/20">@Model.Task.Solution</textarea>
                </div>

                <!-- Assignee (Ditugaskan Kepada) -->
                <div class="mb-5">
                    <label class="block text-sm font-semibold text-slate-700 mb-2">
                        <i class="fas fa-user-check text-indigo-500 mr-2"></i>Ditugaskan Kepada (PIC)
                    </label>
                    <select name="AssignedToUserId" class="select2 w-full" data-placeholder="-- Cari PIC / Anggota Tim --">
                        <option value="">-- Tanpa Penugasan / Belum Ditugaskan --</option>
                        @foreach (var u in Model.Users)
                        {
                            if (Model.Task.AssignedToUserId == u.Id)
                            {
                                <option value="@u.Id" selected>👤 @u.FullName (@u.Email - @u.JobTitle)</option>
                            }
                            else
                            {
                                <option value="@u.Id">👤 @u.FullName (@u.Email - @u.JobTitle)</option>
                            }
                        }
                    </select>
                </div>

                <!-- Parent Task (Tugas Induk) -->
                <div class="mb-5 bg-slate-50/70 p-4 rounded-2xl border border-slate-200/80">
                    <div class="flex items-center justify-between mb-2">
                        <label class="block text-sm font-semibold text-slate-700">
                            <i class="fas fa-sitemap text-indigo-500 mr-2"></i>Tugas Induk (Parent Task)
                        </label>
                        <span class="text-[11px] font-bold text-slate-500 bg-white px-2.5 py-1 rounded-lg border border-slate-200">
                            Kode Induk: <strong class="font-mono text-indigo-600">@Model.Task.ParentCode</strong>
                        </span>
                    </div>
                    <select name="ParentTaskId" id="parentTaskEditSelect" class="select2 w-full" data-placeholder="-- Cari & Pilih Tugas Induk (Kode/Judul/Proyek) --">
                        <option value="">-- (Tugas Utama / Mandiri - Tanpa Induk) --</option>
                        @foreach (var parent in Model.AvailableParentTasks)
                        {
                            <option value="@parent.Id" selected="@(Model.Task.ParentTaskId == parent.Id)">
                                [@parent.TaskCode] @parent.Title (@(parent.Project?.Name ?? "Tanpa Proyek"))
                            </option>
                        }
                    </select>
                    <p class="text-[11px] text-slate-500 mt-2">
                        <i class="fas fa-info-circle text-indigo-400 mr-1"></i>Ketik kode tugas, judul, atau nama proyek untuk mencari tugas induk dengan cepat. Jika tanpa induk, kode induk otomatis adalah: <strong class="font-mono">@Model.Task.TaskCode</strong>.
                    </p>

                    @if (Model.Task.ChildTasks != null && Model.Task.ChildTasks.Any())
                    {
                        <div class="mt-3 pt-3 border-t border-slate-200">
                            <p class="text-xs font-bold text-slate-700 mb-2">
                                <i class="fas fa-network-wired text-purple-500 mr-1.5"></i>Daftar Sub-Task / Child Tasks (@Model.Task.ChildTasks.Count):
                            </p>
                            <div class="space-y-1.5">
                                @foreach (var child in Model.Task.ChildTasks)
                                {
                                    <div class="flex items-center justify-between p-2 rounded-xl bg-white border border-slate-200 text-xs">
                                        <div class="flex items-center gap-2">
                                            <span class="font-mono font-bold text-[10px] text-indigo-600 bg-indigo-50 px-1.5 py-0.5 rounded">@child.TaskCode</span>
                                            <span class="font-semibold text-slate-800">@child.Title</span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full @(child.Status == TrackerKerja.Models.TaskStatus.Done ? "bg-emerald-100 text-emerald-700" : "bg-indigo-100 text-indigo-700")">
                                                @child.Status (@child.Progress%)
                                            </span>
                                            <a href="/Task/Edit/@child.Id" class="text-indigo-600 hover:text-indigo-800 text-[11px] font-bold">Edit &rarr;</a>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Milestone (SDLC Waterfall Phase) -->
                <div class="mb-5 bg-indigo-50/40 p-4 rounded-2xl border border-indigo-100">
                    <div class="flex items-center justify-between mb-2">
                        <label class="block text-sm font-semibold text-slate-700">
                            <i class="fas fa-layer-group text-indigo-500 mr-2"></i>Milestone (Fase SDLC Waterfall) <span class="text-indigo-600 font-bold">*</span>
                        </label>
                        <span class="text-[11px] font-bold text-indigo-700 bg-white px-2 py-0.5 rounded-lg border border-indigo-200">
                            Waterfall SDLC
                        </span>
                    </div>
                    <select name="Milestone" class="select2 w-full" data-placeholder="-- Pilih Milestone Fase SDLC --">
                        @if (Model.Milestones != null && Model.Milestones.Any())
                        {
                            foreach (var m in Model.Milestones)
                            {
                                <option value="@m.Name" selected="@(Model.Task.Milestone == m.Name)">
                                    🎯 @m.Name (@m.Description)
                                </option>
                            }
                        }
                        else
                        {
                            <option value="Requirement Analysis" selected="@(Model.Task.Milestone == "Requirement Analysis")">📋 1. Requirement Analysis (Analisis Kebutuhan & Dokumen SRS/BRD)</option>
                            <option value="System Design" selected="@(Model.Task.Milestone == "System Design")">📐 2. System Design (Desain Sistem, Arsitektur & UI/UX)</option>
                            <option value="Implementation" selected="@(string.IsNullOrEmpty(Model.Task.Milestone) || Model.Task.Milestone == "Implementation")">💻 3. Implementation (Pengembangan & Coding Backend/Frontend)</option>
                            <option value="Testing & QA" selected="@(Model.Task.Milestone == "Testing & QA")">🧪 4. Testing & QA (Pengujian, QA, Bug Fixing & UAT)</option>
                            <option value="Deployment" selected="@(Model.Task.Milestone == "Deployment")">🚀 5. Deployment (Penyebaran / Rilis Production & CI/CD)</option>
                            <option value="Maintenance" selected="@(Model.Task.Milestone == "Maintenance")">🛠️ 6. Maintenance (Pemeliharaan, Monitoring & Support)</option>
                        }
                    </select>
                    <p class="text-[11px] text-slate-500 mt-2">
                        <i class="fas fa-info-circle text-indigo-400 mr-1"></i>Pilih fase SDLC Waterfall yang sesuai untuk memproyeksikan tahapan siklus hidup tugas ini.
                    </p>
                </div>

                <!-- Project & Category -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">
                            <i class="fas fa-folder text-amber-400 mr-2"></i>Proyek
                        </label>
                        <select name="ProjectId" class="select2 w-full" data-placeholder="-- Pilih Proyek --">
                            <option value="">-- Pilih Proyek --</option>
                            @foreach (var proj in Model.Projects)
                            {
                                if (Model.Task.ProjectId == proj.Id)
                                {
                                    <option value="@proj.Id" selected>@proj.Name</option>
                                }
                                else
                                {
                                    <option value="@proj.Id">@proj.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">
                            <i class="fas fa-tag text-cyan-400 mr-2"></i>Kategori
                        </label>
                        <select name="CategoryId" class="select2 w-full" data-placeholder="-- Pilih Kategori --">
                            <option value="">-- Pilih Kategori --</option>
                            @foreach (var cat in Model.Categories)
                            {
                                if (Model.Task.CategoryId == cat.Id)
                                {
                                    <option value="@cat.Id" selected>@cat.Name</option>
                                }
                                else
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <!-- Priority & Status -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">
                            <i class="fas fa-flag text-red-400 mr-2"></i>Prioritas
                        </label>
                        <select name="Priority" class="select2 w-full" data-placeholder="-- Pilih Prioritas --">
                            @foreach (var (val, label) in priorities)
                            {
                                if (Model.Task.Priority.ToString() == val)
                                {
                                    <option value="@val" selected>@label</option>
                                }
                                else
                                {
                                    <option value="@val">@label</option>
                                }
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">
                            <i class="fas fa-spinner text-indigo-400 mr-2"></i>Status
                        </label>
                        <select name="Status" id="taskEditStatusSelect" class="select2 w-full" data-placeholder="-- Pilih Status --">
                            @foreach (var (val, label) in statuses)
                            {
                                if (Model.Task.Status.ToString() == val)
                                {
                                    <option value="@val" selected>@label</option>
                                }
                                else
                                {
                                    <option value="@val">@label</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <!-- Progress Task (%) -->
                <div class="mb-5 bg-indigo-50/40 p-4 rounded-2xl border border-indigo-100/80">
                    <div class="flex items-center justify-between mb-2">
                        <label class="text-sm font-semibold text-slate-700 flex items-center gap-2">
                            <i class="fas fa-chart-line text-indigo-500"></i>Progress Pengerjaan Tugas
                        </label>
                        <span id="editProgressDisplay" class="text-sm font-extrabold text-indigo-600 bg-white px-3 py-1 rounded-xl shadow-xs border border-indigo-100">
                            @(Model.Task.Progress)%
                        </span>
                    </div>

                    <input type="range" name="Progress" id="editProgressSlider" min="0" max="100" step="5" value="@Model.Task.Progress"
                           class="w-full h-2.5 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-indigo-600">

                    <!-- Quick Preset Buttons -->
                    <div class="flex items-center justify-between gap-1.5 mt-3 flex-wrap sm:flex-nowrap">
                        <button type="button" onclick="setEditProgress(0)" class="flex-1 py-1.5 text-xs font-bold rounded-lg bg-white border border-slate-200 text-slate-600 hover:bg-indigo-50 hover:text-indigo-600 transition-all cursor-pointer">0%</button>
                        <button type="button" onclick="setEditProgress(25)" class="flex-1 py-1.5 text-xs font-bold rounded-lg bg-white border border-slate-200 text-slate-600 hover:bg-indigo-50 hover:text-indigo-600 transition-all cursor-pointer">25%</button>
                        <button type="button" onclick="setEditProgress(50)" class="flex-1 py-1.5 text-xs font-bold rounded-lg bg-white border border-slate-200 text-slate-600 hover:bg-indigo-50 hover:text-indigo-600 transition-all cursor-pointer">50%</button>
                        <button type="button" onclick="setEditProgress(75)" class="flex-1 py-1.5 text-xs font-bold rounded-lg bg-white border border-slate-200 text-slate-600 hover:bg-indigo-50 hover:text-indigo-600 transition-all cursor-pointer">75%</button>
                        <button type="button" onclick="setEditProgress(100)" class="flex-1 py-1.5 text-xs font-bold rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-700 hover:bg-emerald-100 transition-all cursor-pointer">100%</button>
                    </div>
                </div>

                <!-- Dates -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">
                            <i class="fas fa-play-circle text-emerald-400 mr-2"></i>Tanggal Mulai
                        </label>
                        <input type="date" name="StartDate" value="@(Model.Task.StartDate?.ToString("yyyy-MM-dd"))"
                               class="w-full px-4 py-3 rounded-xl border border-indigo-200 focus:outline-none focus:ring-2 focus:ring-indigo-400 text-slate-700 transition-all">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">
                            <i class="fas fa-calendar-times text-red-400 mr-2"></i>Deadline
                        </label>
                        <input type="date" name="DueDate" value="@(Model.Task.DueDate?.ToString("yyyy-MM-dd"))"
                               class="w-full px-4 py-3 rounded-xl border border-indigo-200 focus:outline-none focus:ring-2 focus:ring-indigo-400 text-slate-700 transition-all">
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                    <button type="submit"
                            class="flex-1 bg-gradient-to-r from-indigo-500 to-purple-600 text-white font-semibold py-3 rounded-xl hover:shadow-lg hover:shadow-indigo-200 transition-all duration-200 cursor-pointer text-center">
                        <i class="fas fa-save mr-2"></i>Simpan Perubahan
                    </button>
                    <a href="/Task" class="px-6 py-3 rounded-xl border border-slate-200 text-slate-600 hover:border-indigo-300 hover:text-indigo-600 font-medium transition-all text-center">
                        Batal
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- WORK DURATION & MANUAL LOGGING CARD -->
    <div class="bg-white rounded-2xl shadow-sm border border-indigo-100 overflow-hidden">
        <div class="bg-gradient-to-r from-amber-500 to-orange-600 p-6 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center">
                    <i class="fas fa-clock text-white"></i>
                </div>
                <div>
                    <h3 class="text-white font-bold text-lg">Pencatatan & Penyesuaian Jam Kerja Manual</h3>
                    <p class="text-amber-100 text-sm">Kelola durasi waktu pengerjaan tugas secara manual atau otomatis</p>
                </div>
            </div>
            <!-- Current Total Duration Badge -->
            <div class="bg-white/20 rounded-2xl px-4 py-2 text-right backdrop-blur-sm">
                <p class="text-[11px] text-amber-100 font-semibold uppercase">Total Durasi</p>
                <p class="text-2xl font-black font-mono text-white">@Model.Task.TotalDurationFormatted</p>
            </div>
        </div>

        <div class="p-6">
            <!-- Manual Log Input Form -->
            <div class="bg-amber-50/60 rounded-2xl p-5 border border-amber-200 mb-6">
                <h4 class="font-bold text-slate-800 text-sm mb-3 flex items-center gap-2">
                    <i class="fas fa-plus-circle text-amber-500"></i>
                    Tambah Log Waktu Kerja Manual
                </h4>
                <form method="post" action="/Task/AddManualSession" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="taskId" value="@Model.Task.Id" />

                    <!-- Hours -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Jam</label>
                        <input type="number" name="hours" min="0" max="999" value="1" required
                               class="w-full px-3 py-2 rounded-xl border border-amber-300 text-sm font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-400 bg-white">
                    </div>

                    <!-- Minutes -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Menit</label>
                        <input type="number" name="minutes" min="0" max="59" value="0" required
                               class="w-full px-3 py-2 rounded-xl border border-amber-300 text-sm font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-400 bg-white">
                    </div>

                    <!-- Date -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Tanggal Pengerjaan</label>
                        <input type="date" name="sessionDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required
                               class="w-full px-3 py-2 rounded-xl border border-amber-300 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-400 bg-white">
                    </div>

                    <!-- Notes -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Catatan / Keterangan</label>
                        <input type="text" name="notes" placeholder="Contoh: Coding fitur auth"
                               class="w-full px-3 py-2 rounded-xl border border-amber-300 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-400 bg-white">
                    </div>

                    <!-- Submit Button -->
                    <div class="flex items-end">
                        <button type="submit"
                                class="w-full bg-gradient-to-r from-amber-500 to-orange-600 text-white font-bold py-2 px-3 rounded-xl text-sm hover:shadow-md transition-all">
                            <i class="fas fa-plus mr-1"></i>Tambah Waktu
                        </button>
                    </div>
                </form>
            </div>

            <!-- Sessions History Table -->
            <div>
                <h4 class="font-bold text-slate-800 text-sm mb-3 flex items-center justify-between">
                    <span class="flex items-center gap-2">
                        <i class="fas fa-history text-slate-400"></i>
                        Riwayat Sesi Kerja (@sessions.Count sesi)
                    </span>
                </h4>

                @if (!sessions.Any())
                {
                    <div class="p-8 text-center bg-slate-50 rounded-2xl border border-slate-100 text-slate-400">
                        <i class="fas fa-hourglass-start text-2xl mb-2 text-slate-300 block"></i>
                        <p class="text-xs">Belum ada sesi kerja tercatat untuk tugas ini.</p>
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto rounded-xl border border-slate-100">
                        <table class="w-full text-sm">
                            <thead>
                                <tr class="bg-slate-50 border-b border-slate-100 text-slate-500 text-xs">
                                    <th class="text-left px-4 py-2.5 font-semibold">Waktu Mulai</th>
                                    <th class="text-left px-4 py-2.5 font-semibold">Waktu Selesai</th>
                                    <th class="text-left px-4 py-2.5 font-semibold">Durasi</th>
                                    <th class="text-left px-4 py-2.5 font-semibold">Keterangan</th>
                                    <th class="text-right px-4 py-2.5 font-semibold">Aksi</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-50">
                                @foreach (var session in sessions)
                                {
                                    var h = session.Duration / 3600;
                                    var m = (session.Duration % 3600) / 60;
                                    var s = session.Duration % 60;
                                    var isRunning = session.EndTime == null;

                                    <tr class="hover:bg-slate-50/80 transition-colors">
                                        <td class="px-4 py-2.5 text-xs text-slate-700 whitespace-nowrap">
                                            @session.StartTime.ToString("dd MMM yyyy HH:mm")
                                        </td>
                                        <td class="px-4 py-2.5 text-xs text-slate-700 whitespace-nowrap">
                                            @if (isRunning)
                                            {
                                                <span class="inline-flex items-center gap-1.5 text-emerald-600 font-bold bg-emerald-50 px-2 py-0.5 rounded-full">
                                                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                                                    Sedang Berjalan
                                                </span>
                                            }
                                            else
                                            {
                                                @(session.EndTime?.ToString("dd MMM yyyy HH:mm") ?? "-")
                                            }
                                        </td>
                                        <td class="px-4 py-2.5 font-mono font-bold text-xs text-slate-800 whitespace-nowrap">
                                            @if (isRunning)
                                            {
                                                <span class="text-emerald-600">--:--:--</span>
                                            }
                                            else
                                            {
                                                <span>@($"{h:D2}:{m:D2}:{s:D2}")</span>
                                                <span class="text-slate-400 font-sans text-[11px] font-normal">(@h j @m m)</span>
                                            }
                                        </td>
                                        <td class="px-4 py-2.5 text-xs text-slate-500">
                                            @(string.IsNullOrEmpty(session.Notes) ? "Otomatis (Timer)" : session.Notes)
                                        </td>
                                        <td class="px-4 py-2.5 text-right whitespace-nowrap">
                                            @if (!isRunning)
                                            {
                                                <form method="post" action="/Task/DeleteSession" class="inline"
                                                      data-confirm="Apakah Anda yakin ingin menghapus catatan sesi kerja ini? Durasi kerja yang tersimpan akan dikurangi."
                                                      data-confirm-title="Hapus Sesi Kerja"
                                                      data-confirm-btn="<i class='fas fa-trash-alt mr-1.5'></i>Hapus Sesi">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="sessionId" value="@session.Id" />
                                                    <input type="hidden" name="taskId" value="@Model.Task.Id" />
                                                    <button type="submit" class="text-red-400 hover:text-red-600 p-1 rounded-lg hover:bg-red-50 transition-colors cursor-pointer" title="Hapus Sesi">
                                                        <i class="fas fa-trash-alt text-xs"></i>
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- LINKED NOTES / DOCUMENTATION CARD -->
    @{
        var taskNotes = Model.Task.Notes?.OrderByDescending(n => n.UpdatedAt).ToList() ?? new();
    }
    <div class="bg-white rounded-2xl shadow-sm border border-indigo-100 overflow-hidden">
        <div class="bg-gradient-to-r from-violet-600 to-indigo-600 p-6 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center">
                    <i class="fas fa-book-open text-white"></i>
                </div>
                <div>
                    <h3 class="text-white font-bold text-lg">Catatan & Dokumentasi Tugas (@taskNotes.Count)</h3>
                    <p class="text-indigo-100 text-sm">Dokumentasi teknis, instruksi, dan catatan yang ditautkan ke tugas ini</p>
                </div>
            </div>
            <a href="/Note/Create?taskId=@Model.Task.Id"
               class="bg-white text-indigo-700 hover:bg-indigo-50 font-bold px-4 py-2 rounded-xl text-xs flex items-center gap-1.5 shadow-md hover:scale-105 transition-all">
                <i class="fas fa-plus"></i>
                <span>Tulis Catatan</span>
            </a>
        </div>

        <div class="p-6">
            @if (!taskNotes.Any())
            {
                <div class="p-8 text-center bg-slate-50 rounded-2xl border border-slate-100 text-slate-400">
                    <i class="fas fa-sticky-note text-2xl mb-2 text-slate-300 block"></i>
                    <p class="text-xs">Belum ada catatan atau dokumentasi yang ditautkan ke tugas ini.</p>
                    <a href="/Note/Create?taskId=@Model.Task.Id" class="inline-flex items-center gap-1.5 mt-3 text-xs font-bold text-indigo-600 hover:underline">
                        <i class="fas fa-pen-nib"></i> Tulis catatan sekarang
                    </a>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    @foreach (var n in taskNotes)
                    {
                        var nColor = string.IsNullOrEmpty(n.Color) ? "#6366F1" : n.Color;
                        <div class="bg-slate-50 hover:bg-white rounded-2xl p-4 border border-slate-200 hover:border-indigo-200 hover:shadow-md transition-all flex flex-col justify-between group">
                            <div>
                                <div class="flex items-center justify-between gap-2 mb-2">
                                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-indigo-100 text-indigo-700">
                                        @n.Category
                                    </span>
                                    <div class="flex items-center gap-1 opacity-80 group-hover:opacity-100">
                                        <a href="/Note/Details/@n.Id" class="p-1 text-slate-400 hover:text-indigo-600" title="Buka Catatan">
                                            <i class="fas fa-external-link-alt text-xs"></i>
                                        </a>
                                        <a href="/Note/Edit/@n.Id" class="p-1 text-slate-400 hover:text-indigo-600" title="Edit">
                                            <i class="fas fa-pencil-alt text-xs"></i>
                                        </a>
                                    </div>
                                </div>
                                <a href="/Note/Details/@n.Id" class="block font-black text-slate-800 text-sm group-hover:text-indigo-600 transition-colors line-clamp-1">
                                    @n.Title
                                </a>
                                <p class="text-slate-500 text-xs mt-1 line-clamp-2">
                                    @n.PlainTextPreview
                                </p>
                            </div>

                            <div class="mt-3 pt-2.5 border-t border-slate-200/60 flex items-center justify-between text-[11px] text-slate-400">
                                <span class="font-medium text-slate-600">
                                    👤 @(n.AuthorUser?.FullName ?? "Pengguna")
                                </span>
                                <span>@n.UpdatedAt.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<script>
    const editSlider = document.getElementById('editProgressSlider');
    const editDisplay = document.getElementById('editProgressDisplay');
    const editStatusSelect = document.getElementById('taskEditStatusSelect');

    function updateEditProgress(val) {
        val = parseInt(val) || 0;
        if (editSlider) editSlider.value = val;
        if (editDisplay) editDisplay.innerText = val + '%';
        if (editStatusSelect) {
            var oldVal = editStatusSelect.value;
            var newVal = oldVal;
            if (val >= 100) {
                newVal = 'Done';
            } else if (val > 0 && oldVal === 'Todo') {
                newVal = 'InProgress';
            } else if (val < 100 && oldVal === 'Done') {
                newVal = 'InProgress';
            }
            if (newVal !== oldVal) {
                editStatusSelect.value = newVal;
                if (typeof jQuery !== 'undefined' && jQuery(editStatusSelect).hasClass('select2-hidden-accessible')) {
                    jQuery(editStatusSelect).trigger('change.select2');
                }
            }
        }
    }

    function setEditProgress(val) {
        updateEditProgress(val);
    }

    if (editSlider) {
        editSlider.addEventListener('input', function(e) {
            updateEditProgress(e.target.value);
        });
    }

    if (editStatusSelect) {
        editStatusSelect.addEventListener('change', function(e) {
            if (e.target.value === 'Done') {
                updateEditProgress(100);
            } else if (e.target.value === 'Todo' && parseInt(editSlider?.value || 0) === 100) {
                updateEditProgress(0);
            } else if (e.target.value === 'InProgress' && parseInt(editSlider?.value || 0) === 100) {
                updateEditProgress(50);
            }
        });
    }
</script>
