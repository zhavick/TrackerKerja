@model TrackerKerja.ViewModels.MasterDataViewModel
@{
    ViewData["Title"] = "Pengaturan Master Data";
    var activeTab = Model.ActiveTab;
}

<div class="space-y-6">

    <!-- Header Card -->
    <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 rounded-3xl p-6 md:p-8 text-white shadow-xl relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-indigo-300 text-xs font-semibold backdrop-blur-md mb-3">
                    <i class="fas fa-sliders-h"></i> Sistem Konfigurasi
                </div>
                <h1 class="text-2xl md:text-3xl font-extrabold text-white tracking-tight">Pengaturan Master Data</h1>
                <p class="text-slate-300 text-sm mt-1">Kelola data master kategori tugas, tingkatan prioritas, dan alur status kerja dalam satu tempat.</p>
            </div>
            
            <!-- Tab Quick Navigation -->
            <div class="flex items-center bg-white/10 p-1.5 rounded-2xl backdrop-blur-md border border-white/10 flex-wrap gap-1 w-full md:w-auto">
                <a href="/MasterData?tab=categories" class="flex-1 md:flex-none justify-center px-3.5 sm:px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 sm:gap-2 @(activeTab == "categories" ? "bg-indigo-600 text-white shadow-lg shadow-indigo-600/50" : "text-slate-300 hover:text-white hover:bg-white/5")">
                    <i class="fas fa-tags"></i> <span>Kategori (@Model.Categories.Count)</span>
                </a>
                <a href="/MasterData?tab=priorities" class="flex-1 md:flex-none justify-center px-3.5 sm:px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 sm:gap-2 @(activeTab == "priorities" ? "bg-indigo-600 text-white shadow-lg shadow-indigo-600/50" : "text-slate-300 hover:text-white hover:bg-white/5")">
                    <i class="fas fa-flag"></i> <span>Prioritas (@Model.Priorities.Count)</span>
                </a>
                <a href="/MasterData?tab=statuses" class="flex-1 md:flex-none justify-center px-3.5 sm:px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 sm:gap-2 @(activeTab == "statuses" ? "bg-indigo-600 text-white shadow-lg shadow-indigo-600/50" : "text-slate-300 hover:text-white hover:bg-white/5")">
                    <i class="fas fa-tasks"></i> <span>Status (@Model.Statuses.Count)</span>
                </a>
                <a href="/MasterData?tab=milestones" class="flex-1 md:flex-none justify-center px-3.5 sm:px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 sm:gap-2 @(activeTab == "milestones" ? "bg-indigo-600 text-white shadow-lg shadow-indigo-600/50" : "text-slate-300 hover:text-white hover:bg-white/5")">
                    <i class="fas fa-layer-group"></i> <span>Milestone SDLC (@Model.Milestones.Count)</span>
                </a>
                <a href="/MasterData?tab=badges" class="flex-1 md:flex-none justify-center px-3.5 sm:px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 sm:gap-2 @(activeTab == "badges" ? "bg-amber-500 text-white shadow-lg shadow-amber-500/50" : "text-slate-300 hover:text-white hover:bg-white/5")">
                    <i class="fas fa-medal"></i> <span>Badge & Achievement (@Model.Badges.Count)</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-2xl flex items-center gap-3 shadow-sm animate-fade-in">
            <i class="fas fa-check-circle text-emerald-500 text-lg"></i>
            <p class="text-emerald-800 text-sm font-semibold">@TempData["Success"]</p>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="p-4 bg-rose-50 border border-rose-200 rounded-2xl flex items-center gap-3 shadow-sm animate-fade-in">
            <i class="fas fa-exclamation-circle text-rose-500 text-lg"></i>
            <p class="text-rose-800 text-sm font-semibold">@TempData["Error"]</p>
        </div>
    }

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- TAB 1: MASTER KATEGORI                                  -->
    <!-- ═══════════════════════════════════════════════════════ -->
    @if (activeTab == "categories")
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left: Add Category Form -->
            <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm h-fit">
                <div class="flex items-center gap-3 mb-5">
                    <div class="w-9 h-9 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold">
                        <i class="fas fa-plus"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-slate-800 text-base">Tambah Kategori Baru</h3>
                        <p class="text-xs text-slate-400">Buat klasifikasi bidang/kategori tugas</p>
                    </div>
                </div>

                <form method="post" action="/MasterData/CreateCategory" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Nama Kategori <span class="text-rose-500">*</span></label>
                        <input type="text" name="Name" required placeholder="Contoh: Mobile App, Security, dll"
                               class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Warna Aksen</label>
                        <div class="flex items-center gap-3">
                            <input type="color" name="Color" value="#6366F1" id="catColorPicker"
                                   class="w-10 h-10 rounded-xl border border-slate-200 cursor-pointer p-0.5">
                            <span class="text-xs text-slate-500 font-mono" id="catColorHex">#6366F1</span>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Deskripsi</label>
                        <textarea name="Description" rows="2" placeholder="Keterangan kategori (opsional)..."
                                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all resize-none"></textarea>
                    </div>

                    <button type="submit" class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-bold text-sm shadow-md shadow-indigo-600/30 transition-all">
                        <i class="fas fa-save mr-1.5"></i> Simpan Kategori
                    </button>
                </form>
            </div>

            <!-- Right: Categories List Table -->
            <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                    <div>
                        <h3 class="font-bold text-slate-800 text-base">Daftar Kategori Tersedia</h3>
                        <p class="text-xs text-slate-400">Total @Model.Categories.Count kategori terdaftar</p>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-slate-50 text-slate-500 font-semibold text-xs uppercase tracking-wider border-b border-slate-100">
                            <tr>
                                <th class="py-3 px-4">Kategori</th>
                                <th class="py-3 px-4">Warna</th>
                                <th class="py-3 px-4">Deskripsi</th>
                                <th class="py-3 px-4 text-center">Tugas Terkait</th>
                                <th class="py-3 px-4 text-right">Aksi</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-slate-700">
                            @foreach (var cat in Model.Categories)
                            {
                                <tr class="hover:bg-slate-50/80 transition-colors">
                                    <td class="py-3.5 px-4 font-bold text-slate-800 flex items-center gap-2.5">
                                        <span class="w-3 h-3 rounded-full flex-shrink-0" style="background: @cat.Color"></span>
                                        @cat.Name
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <span class="px-2.5 py-1 rounded-lg text-xs font-bold text-white shadow-xs" style="background: @cat.Color">
                                            @cat.Color
                                        </span>
                                    </td>
                                    <td class="py-3.5 px-4 text-xs text-slate-500 max-w-xs truncate">
                                        @(string.IsNullOrEmpty(cat.Description) ? "-" : cat.Description)
                                    </td>
                                    <td class="py-3.5 px-4 text-center">
                                        <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700">
                                            @cat.Tasks.Count Tugas
                                        </span>
                                    </td>
                                    <td class="py-3.5 px-4 text-right">
                                        <div class="flex items-center justify-end gap-1.5">
                                            <!-- Edit Trigger Button -->
                                            <button type="button" onclick="openEditCatModal(@cat.Id, '@cat.Name', '@cat.Color', '@(cat.Description?.Replace("'", "\\'"))')"
                                                    class="p-1.5 rounded-lg text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 transition-colors" title="Edit Kategori">
                                                <i class="fas fa-edit"></i>
                                            </button>

                                            <!-- Delete Form -->
                                            <form method="post" action="/MasterData/DeleteCategory"
                                                  data-confirm="Apakah Anda yakin ingin menghapus kategori '@cat.Name'?"
                                                  data-confirm-title="Hapus Kategori"
                                                  data-confirm-btn="<i class='fas fa-trash-alt mr-1.5'></i>Ya, Hapus" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@cat.Id" />
                                                <button type="submit" class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors cursor-pointer" title="Hapus Kategori">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- TAB 2: MASTER PRIORITAS                                 -->
    <!-- ═══════════════════════════════════════════════════════ -->
    @if (activeTab == "priorities")
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left: Add Priority Form -->
            <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm h-fit">
                <div class="flex items-center gap-3 mb-5">
                    <div class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold">
                        <i class="fas fa-flag"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-slate-800 text-base">Tambah Prioritas Baru</h3>
                        <p class="text-xs text-slate-400">Atur tingkat urgensi tugas</p>
                    </div>
                </div>

                <form method="post" action="/MasterData/CreatePriority" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Nama Prioritas <span class="text-rose-500">*</span></label>
                        <input type="text" name="Name" required placeholder="Contoh: Urgent, Low, Normal"
                               class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 transition-all">
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Warna</label>
                            <input type="color" name="Color" value="#F59E0B"
                                   class="w-full h-10 rounded-xl border border-slate-200 cursor-pointer p-0.5">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Urutan (Index)</label>
                            <input type="number" name="OrderIndex" value="@(Model.Priorities.Count + 1)"
                                   class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Deskripsi</label>
                        <textarea name="Description" rows="2" placeholder="Penjelasan tingkat urgensi..."
                                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 transition-all resize-none"></textarea>
                    </div>

                    <div class="flex items-center gap-2">
                        <input type="checkbox" name="IsDefault" value="true" id="priIsDefault" class="rounded text-amber-600 focus:ring-amber-500 w-4 h-4">
                        <label for="priIsDefault" class="text-xs font-semibold text-slate-700 cursor-pointer">Jadikan Prioritas Bawaan (Default)</label>
                    </div>

                    <button type="submit" class="w-full py-2.5 bg-amber-500 hover:bg-amber-600 text-white rounded-xl font-bold text-sm shadow-md shadow-amber-500/30 transition-all">
                        <i class="fas fa-save mr-1.5"></i> Simpan Prioritas
                    </button>
                </form>
            </div>

            <!-- Right: Priorities List Table -->
            <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                    <div>
                        <h3 class="font-bold text-slate-800 text-base">Tingkatan Prioritas Sistem</h3>
                        <p class="text-xs text-slate-400">Urutan menentukan level eskalasi tugas</p>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-slate-50 text-slate-500 font-semibold text-xs uppercase tracking-wider border-b border-slate-100">
                            <tr>
                                <th class="py-3 px-4">Urutan</th>
                                <th class="py-3 px-4">Nama Prioritas</th>
                                <th class="py-3 px-4">Badge Preview</th>
                                <th class="py-3 px-4">Deskripsi</th>
                                <th class="py-3 px-4 text-center">Default</th>
                                <th class="py-3 px-4 text-right">Aksi</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-slate-700">
                            @foreach (var pri in Model.Priorities)
                            {
                                <tr class="hover:bg-slate-50/80 transition-colors">
                                    <td class="py-3.5 px-4 font-mono text-xs font-bold text-slate-500">
                                        #@pri.OrderIndex
                                    </td>
                                    <td class="py-3.5 px-4 font-bold text-slate-800 flex items-center gap-2">
                                        <i class="fas @(string.IsNullOrEmpty(pri.Icon) ? "fa-flag" : pri.Icon)" style="color: @pri.Color"></i>
                                        @pri.Name
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <span class="px-2.5 py-1 rounded-xl text-xs font-bold text-white inline-flex items-center gap-1 shadow-xs" style="background: @pri.Color">
                                            <i class="fas @(string.IsNullOrEmpty(pri.Icon) ? "fa-flag" : pri.Icon) text-[10px]"></i> @pri.Name
                                        </span>
                                    </td>
                                    <td class="py-3.5 px-4 text-xs text-slate-500 max-w-xs truncate">
                                        @(string.IsNullOrEmpty(pri.Description) ? "-" : pri.Description)
                                    </td>
                                    <td class="py-3.5 px-4 text-center">
                                        @if (pri.IsDefault)
                                        {
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">
                                                Default
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-slate-300">-</span>
                                        }
                                    </td>
                                    <td class="py-3.5 px-4 text-right">
                                        <div class="flex items-center justify-end gap-1.5">
                                            <button type="button" onclick="openEditPriorityModal(@pri.Id, '@pri.Name', '@pri.Color', '@pri.Icon', @pri.OrderIndex, @(pri.IsDefault ? "true" : "false"), '@(pri.Description?.Replace("'", "\\'"))')"
                                                    class="p-1.5 rounded-lg text-slate-400 hover:text-amber-600 hover:bg-amber-50 transition-colors" title="Edit Prioritas">
                                                <i class="fas fa-edit"></i>
                                            </button>

                                            <form method="post" action="/MasterData/DeletePriority"
                                                  data-confirm="Apakah Anda yakin ingin menghapus prioritas '@pri.Name'?"
                                                  data-confirm-title="Hapus Prioritas"
                                                  data-confirm-btn="<i class='fas fa-trash-alt mr-1.5'></i>Ya, Hapus" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@pri.Id" />
                                                <button type="submit" class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors cursor-pointer" title="Hapus Prioritas">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- TAB 3: MASTER STATUS                                    -->
    <!-- ═══════════════════════════════════════════════════════ -->
    @if (activeTab == "statuses")
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left: Add Status Form -->
            <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm h-fit">
                <div class="flex items-center gap-3 mb-5">
                    <div class="w-9 h-9 rounded-xl bg-cyan-50 text-cyan-600 flex items-center justify-center font-bold">
                        <i class="fas fa-tasks"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-slate-800 text-base">Tambah Status Baru</h3>
                        <p class="text-xs text-slate-400">Atur alur tahapan pengerjaan tugas</p>
                    </div>
                </div>

                <form method="post" action="/MasterData/CreateStatus" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Nama Status <span class="text-rose-500">*</span></label>
                        <input type="text" name="Name" required placeholder="Contoh: Testing, Deployment, In Review"
                               class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 transition-all">
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Warna</label>
                            <input type="color" name="Color" value="#06B6D4"
                                   class="w-full h-10 rounded-xl border border-slate-200 cursor-pointer p-0.5">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Urutan Alur</label>
                            <input type="number" name="OrderIndex" value="@(Model.Statuses.Count + 1)"
                                   class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Deskripsi</label>
                        <textarea name="Description" rows="2" placeholder="Penjelasan status alur..."
                                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 transition-all resize-none"></textarea>
                    </div>

                    <div class="space-y-2">
                        <div class="flex items-center gap-2">
                            <input type="checkbox" name="IsDoneState" value="true" id="statIsDone" class="rounded text-emerald-600 focus:ring-emerald-500 w-4 h-4">
                            <label for="statIsDone" class="text-xs font-semibold text-slate-700 cursor-pointer">Menandai Tugas Telah Selesai (Done State)</label>
                        </div>
                        <div class="flex items-center gap-2">
                            <input type="checkbox" name="IsDefault" value="true" id="statIsDefault" class="rounded text-cyan-600 focus:ring-cyan-500 w-4 h-4">
                            <label for="statIsDefault" class="text-xs font-semibold text-slate-700 cursor-pointer">Jadikan Status Bawaan Awal (Default)</label>
                        </div>
                    </div>

                    <button type="submit" class="w-full py-2.5 bg-cyan-600 hover:bg-cyan-700 text-white rounded-xl font-bold text-sm shadow-md shadow-cyan-600/30 transition-all">
                        <i class="fas fa-save mr-1.5"></i> Simpan Status
                    </button>
                </form>
            </div>

            <!-- Right: Statuses List Table -->
            <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                    <div>
                        <h3 class="font-bold text-slate-800 text-base">Alur Status Pengerjaan</h3>
                        <p class="text-xs text-slate-400">Alur siklus hidup penyelesaian tugas</p>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-slate-50 text-slate-500 font-semibold text-xs uppercase tracking-wider border-b border-slate-100">
                            <tr>
                                <th class="py-3 px-4">Urutan</th>
                                <th class="py-3 px-4">Nama Status</th>
                                <th class="py-3 px-4">Badge Preview</th>
                                <th class="py-3 px-4">Tipe Status</th>
                                <th class="py-3 px-4 text-center">Default</th>
                                <th class="py-3 px-4 text-right">Aksi</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-slate-700">
                            @foreach (var stat in Model.Statuses)
                            {
                                <tr class="hover:bg-slate-50/80 transition-colors">
                                    <td class="py-3.5 px-4 font-mono text-xs font-bold text-slate-500">
                                        #@stat.OrderIndex
                                    </td>
                                    <td class="py-3.5 px-4 font-bold text-slate-800 flex items-center gap-2">
                                        <span class="w-2.5 h-2.5 rounded-full" style="background: @stat.Color"></span>
                                        @stat.Name
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <span class="px-2.5 py-1 rounded-xl text-xs font-bold text-white inline-flex items-center gap-1 shadow-xs" style="background: @stat.Color">
                                            @stat.Name
                                        </span>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        @if (stat.IsDoneState)
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">
                                                <i class="fas fa-check-circle text-[10px]"></i> Selesai (Done)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700">
                                                <i class="fas fa-spinner text-[10px] text-slate-400"></i> Berjalan / Aktif
                                            </span>
                                        }
                                    </td>
                                    <td class="py-3.5 px-4 text-center">
                                        @if (stat.IsDefault)
                                        {
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-cyan-100 text-cyan-800">
                                                Default
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-slate-300">-</span>
                                        }
                                    </td>
                                    <td class="py-3.5 px-4 text-right">
                                        <div class="flex items-center justify-end gap-1.5">
                                            <button type="button" onclick="openEditStatusModal(@stat.Id, '@stat.Name', '@stat.Color', @stat.OrderIndex, @(stat.IsDoneState ? "true" : "false"), @(stat.IsDefault ? "true" : "false"), '@(stat.Description?.Replace("'", "\\'"))')"
                                                    class="p-1.5 rounded-lg text-slate-400 hover:text-cyan-600 hover:bg-cyan-50 transition-colors" title="Edit Status">
                                                <i class="fas fa-edit"></i>
                                            </button>

                                            <form method="post" action="/MasterData/DeleteStatus"
                                                  data-confirm="Apakah Anda yakin ingin menghapus status '@stat.Name'?"
                                                  data-confirm-title="Hapus Status"
                                                  data-confirm-btn="<i class='fas fa-trash-alt mr-1.5'></i>Ya, Hapus" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@stat.Id" />
                                                <button type="submit" class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors cursor-pointer" title="Hapus Status">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- TAB 4: MASTER MILESTONE (SDLC WATERFALL)                -->
    <!-- ═══════════════════════════════════════════════════════ -->
    @if (activeTab == "milestones")
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left: Add Milestone Form -->
            <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm h-fit">
                <div class="flex items-center gap-3 mb-5">
                    <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-lg">
                        <i class="fas fa-layer-group"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-slate-800 text-base">Tambah Milestone SDLC</h3>
                        <p class="text-xs text-slate-400">Tahapan fase siklus pengembangan Waterfall</p>
                    </div>
                </div>

                <form method="post" action="/MasterData/CreateMilestone" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Nama Milestone <span class="text-red-500">*</span></label>
                        <input type="text" name="Name" required placeholder="Contoh: Requirement Analysis"
                               class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all">
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Warna</label>
                            <input type="color" name="Color" value="#6366F1"
                                   class="w-full h-10 rounded-xl border border-slate-200 cursor-pointer p-0.5 bg-slate-50">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Urutan (Index)</label>
                            <input type="number" name="OrderIndex" value="@(Model.Milestones.Count + 1)"
                                   class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-indigo-500">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Icon FontAwesome</label>
                        <input type="text" name="Icon" value="fa-flag" placeholder="fa-code, fa-vial, fa-rocket..."
                               class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-indigo-500">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Deskripsi</label>
                        <textarea name="Description" rows="2" placeholder="Penjelasan ruang lingkup fase milestone ini..."
                                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-indigo-500 resize-none"></textarea>
                    </div>

                    <div class="flex items-center gap-2">
                        <input type="checkbox" name="IsDefault" value="true" id="addMilestoneIsDefault" class="rounded text-indigo-600 focus:ring-indigo-500 w-4 h-4">
                        <label for="addMilestoneIsDefault" class="text-xs font-semibold text-slate-700 cursor-pointer">Jadikan Milestone Default saat Buat Task</label>
                    </div>

                    <button type="submit" class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm rounded-xl shadow-md shadow-indigo-200 transition-all flex items-center justify-center gap-2">
                        <i class="fas fa-plus"></i> Simpan Milestone
                    </button>
                </form>
            </div>

            <!-- Right: Milestones Table List -->
            <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden flex flex-col">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between flex-wrap gap-2">
                    <div>
                        <h3 class="font-bold text-slate-800 text-base">Daftar Fase Milestone SDLC Waterfall</h3>
                        <p class="text-xs text-slate-400 mt-0.5">Total @Model.Milestones.Count tahapan terdaftar</p>
                    </div>
                </div>

                <div class="overflow-x-auto flex-1">
                    <table class="w-full text-left text-sm whitespace-nowrap">
                        <thead>
                            <tr class="bg-slate-50 border-b border-slate-100 text-slate-500 text-xs uppercase font-bold tracking-wider">
                                <th class="py-3 px-4 w-12">Urutan</th>
                                <th class="py-3 px-4">Nama Fase Milestone</th>
                                <th class="py-3 px-4">Badge Preview</th>
                                <th class="py-3 px-4">Deskripsi</th>
                                <th class="py-3 px-4 text-center">Default</th>
                                <th class="py-3 px-4 text-right">Aksi</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-slate-700">
                            @foreach (var m in Model.Milestones)
                            {
                                <tr class="hover:bg-slate-50/80 transition-colors">
                                    <td class="py-3.5 px-4 font-mono text-xs font-bold text-slate-500">
                                        #@m.OrderIndex
                                    </td>
                                    <td class="py-3.5 px-4 font-bold text-slate-800 flex items-center gap-2">
                                        <div class="w-7 h-7 rounded-lg flex items-center justify-center text-white text-xs font-bold shadow-2xs" style="background: @m.Color">
                                            <i class="fas @(string.IsNullOrEmpty(m.Icon) ? "fa-flag" : m.Icon)"></i>
                                        </div>
                                        <span>@m.Name</span>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <span class="px-2.5 py-1 rounded-xl text-xs font-bold text-white inline-flex items-center gap-1.5 shadow-2xs" style="background: @m.Color">
                                            <i class="fas @(string.IsNullOrEmpty(m.Icon) ? "fa-flag" : m.Icon) text-[10px]"></i>
                                            @m.Name
                                        </span>
                                    </td>
                                    <td class="py-3.5 px-4 text-xs text-slate-500 truncate max-w-[200px]" title="@m.Description">
                                        @(string.IsNullOrEmpty(m.Description) ? "-" : m.Description)
                                    </td>
                                    <td class="py-3.5 px-4 text-center">
                                        @if (m.IsDefault)
                                        {
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-indigo-100 text-indigo-800">
                                                Default
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-slate-300">-</span>
                                        }
                                    </td>
                                    <td class="py-3.5 px-4 text-right">
                                        <div class="flex items-center justify-end gap-1.5">
                                            <button type="button" onclick="openEditMilestoneModal(@m.Id, '@m.Name', '@m.Color', '@m.Icon', @m.OrderIndex, @(m.IsDefault ? "true" : "false"), '@(m.Description?.Replace("'", "\\'"))')"
                                                    class="p-1.5 rounded-lg text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 transition-colors" title="Edit Milestone">
                                                <i class="fas fa-edit"></i>
                                            </button>

                                            <form method="post" action="/MasterData/DeleteMilestone"
                                                  data-confirm="Apakah Anda yakin ingin menghapus milestone '@m.Name'?"
                                                  data-confirm-title="Hapus Milestone"
                                                  data-confirm-btn="<i class='fas fa-trash-alt mr-1.5'></i>Ya, Hapus" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@m.Id" />
                                                <button type="submit" class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors cursor-pointer" title="Hapus Milestone">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- TAB 5: MASTER BADGES & ACHIEVEMENTS                     -->
    <!-- ═══════════════════════════════════════════════════════ -->
    @if (activeTab == "badges")
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left: Add Badge Form -->
            <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm h-fit">
                <div class="flex items-center gap-3 mb-5">
                    <div class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold">
                        <i class="fas fa-medal"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-slate-800 text-base">Tambah Badge Baru</h3>
                        <p class="text-xs text-slate-400">Buat pencapaian & penghargaan gamifikasi</p>
                    </div>
                </div>

                <form method="post" action="/MasterData/CreateBadge" class="space-y-4">
                    @Html.AntiForgeryToken()
                    
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Kode Unik <span class="text-rose-500">*</span></label>
                            <input type="text" name="Code" required placeholder="TASK_10, WORK_50H..."
                                   class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm uppercase font-mono focus:ring-2 focus:ring-amber-500 transition-all">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Kategori</label>
                            <select name="Category" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-amber-500 transition-all bg-white">
                                <option value="Tasks">Tasks</option>
                                <option value="Timesheets">Timesheets</option>
                                <option value="Notes">Notes</option>
                                <option value="Profile">Profile</option>
                                <option value="Special">Special / Award</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Nama Badge <span class="text-rose-500">*</span></label>
                        <input type="text" name="Name" required placeholder="Contoh: Task Crusher ⚡"
                               class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-amber-500 transition-all">
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Kelangkaan (Rarity)</label>
                            <select name="Rarity" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-amber-500 transition-all bg-white">
                                <option value="1">Common (⚪ Biasa)</option>
                                <option value="2">Rare (🔵 Langka)</option>
                                <option value="3">Epic (🟣 Epik)</option>
                                <option value="4">Legendary (🟡 Legendaris)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Poin EXP Reward</label>
                            <input type="number" name="Points" value="100" min="10" step="10"
                                   class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-amber-500 transition-all">
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Icon FontAwesome</label>
                            <div class="flex items-center gap-2">
                                <input type="text" name="Icon" id="addBadgeIconInput" value="fa-solid fa-award"
                                       class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-amber-500"
                                       oninput="document.getElementById('addBadgeIconPreview').className = this.value">
                                <div class="w-9 h-9 rounded-xl bg-slate-100 flex items-center justify-center text-amber-500 border border-slate-200 flex-shrink-0">
                                    <i id="addBadgeIconPreview" class="fa-solid fa-award"></i>
                                </div>
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Warna Aksen</label>
                            <input type="color" name="Color" value="#F59E0B"
                                   class="w-full h-10 rounded-xl border border-slate-200 cursor-pointer p-0.5">
                        </div>
                    </div>

                    <div class="p-3.5 bg-amber-50/60 rounded-xl border border-amber-200/80 space-y-3">
                        <label class="block text-xs font-bold text-amber-900 uppercase tracking-wider">Mekanisme Pemicu (Trigger)</label>
                        <div>
                            <select name="TriggerType" class="w-full px-3 py-2 rounded-xl border border-amber-200 text-xs bg-white focus:ring-2 focus:ring-amber-500 font-semibold">
                                <option value="1">Auto: Jumlah Tugas Selesai (Done Tasks)</option>
                                <option value="2">Auto: Total Jam Kerja (Hours Logged)</option>
                                <option value="3">Auto: Jumlah Catatan Kerja (Notes Count)</option>
                                <option value="4">Auto: Total Tugas Pernah Ditugaskan</option>
                                <option value="5">Auto: Kelengkapan Profil Pengguna</option>
                                <option value="0">Manual: Diberikan Spesial oleh Admin</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-amber-800 mb-1">Target Ambang Batas (Threshold Target)</label>
                            <input type="number" name="TriggerThreshold" value="1" min="1"
                                   class="w-full px-3 py-1.5 rounded-xl border border-amber-200 text-xs bg-white" placeholder="Misal: 10 tugas, 50 jam, dll">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Deskripsi / Cara Mendapatkan</label>
                        <textarea name="Description" rows="2" placeholder="Syarat atau instruksi membuka badge ini..."
                                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-amber-500 resize-none"></textarea>
                    </div>

                    <div class="flex items-center gap-2">
                        <input type="checkbox" name="IsActive" value="true" checked id="addBadgeIsActive" class="rounded text-amber-600 focus:ring-amber-500 w-4 h-4">
                        <label for="addBadgeIsActive" class="text-xs font-semibold text-slate-700 cursor-pointer">Badge Aktif & Dapat Dibuka Pengguna</label>
                    </div>

                    <button type="submit" class="w-full py-2.5 bg-amber-500 hover:bg-amber-600 text-white font-bold text-sm rounded-xl shadow-md shadow-amber-500/30 transition-all flex items-center justify-center gap-2">
                        <i class="fas fa-plus"></i> Simpan Badge
                    </button>
                </form>
            </div>

            <!-- Right: Badges Table / Cards List -->
            <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden flex flex-col">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between flex-wrap gap-2">
                    <div>
                        <h3 class="font-bold text-slate-800 text-base">Koleksi Master Badge & Pencapaian</h3>
                        <p class="text-xs text-slate-400 mt-0.5">Total @Model.Badges.Count badge terdaftar dalam sistem gamifikasi</p>
                    </div>
                </div>

                <div class="overflow-x-auto flex-1">
                    <table class="w-full text-left text-sm whitespace-nowrap">
                        <thead>
                            <tr class="bg-slate-50 border-b border-slate-100 text-slate-500 text-xs uppercase font-bold tracking-wider">
                                <th class="py-3 px-4">Badge</th>
                                <th class="py-3 px-4">Kategori & Rarity</th>
                                <th class="py-3 px-4">EXP</th>
                                <th class="py-3 px-4">Pemicu Otomatis</th>
                                <th class="py-3 px-4 text-center">Status</th>
                                <th class="py-3 px-4 text-right">Aksi</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-slate-700">
                            @foreach (var b in Model.Badges)
                            {
                                var rarityBadgeClass = b.Rarity switch
                                {
                                    TrackerKerja.Models.BadgeRarity.Rare => "bg-blue-100 text-blue-800 border-blue-200",
                                    TrackerKerja.Models.BadgeRarity.Epic => "bg-purple-100 text-purple-800 border-purple-200",
                                    TrackerKerja.Models.BadgeRarity.Legendary => "bg-amber-100 text-amber-800 border-amber-300 font-black",
                                    _ => "bg-slate-100 text-slate-700 border-slate-200"
                                };

                                <tr class="hover:bg-slate-50/80 transition-colors @(!b.IsActive ? "opacity-60 bg-slate-50/30" : "")">
                                    <td class="py-3.5 px-4">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 rounded-2xl flex items-center justify-center text-white text-base shadow-sm flex-shrink-0" style="background: @b.Color">
                                                <i class="@b.Icon"></i>
                                            </div>
                                            <div>
                                                <div class="font-bold text-slate-800 text-sm flex items-center gap-1.5">
                                                    <span>@b.Name</span>
                                                </div>
                                                <p class="text-[11px] text-slate-400 font-mono">@b.Code</p>
                                                <p class="text-xs text-slate-500 mt-0.5 max-w-[220px] truncate" title="@b.Description">@b.Description</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <div class="space-y-1">
                                            <span class="px-2 py-0.5 rounded-md text-[10px] font-bold border @rarityBadgeClass">
                                                @b.Rarity.ToString().ToUpper()
                                            </span>
                                            <p class="text-[11px] text-slate-400">@b.Category</p>
                                        </div>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-xl text-xs font-extrabold bg-amber-50 text-amber-700 border border-amber-200">
                                            <i class="fas fa-star text-amber-500 text-[10px]"></i> +@b.Points EXP
                                        </span>
                                    </td>
                                    <td class="py-3.5 px-4 text-xs">
                                        @if (b.TriggerType == TrackerKerja.Models.BadgeTriggerType.Manual)
                                        {
                                            <span class="text-slate-500 font-semibold flex items-center gap-1">
                                                <i class="fas fa-hand-holding-heart text-pink-500"></i> Manual Admin
                                            </span>
                                        }
                                        else if (b.TriggerType == TrackerKerja.Models.BadgeTriggerType.Auto_DoneTasks)
                                        {
                                            <span class="text-emerald-700 font-semibold flex items-center gap-1">
                                                <i class="fas fa-check-double text-emerald-500"></i> Selesai @b.TriggerThreshold Tugas
                                            </span>
                                        }
                                        else if (b.TriggerType == TrackerKerja.Models.BadgeTriggerType.Auto_TotalHours)
                                        {
                                            <span class="text-orange-700 font-semibold flex items-center gap-1">
                                                <i class="fas fa-stopwatch text-orange-500"></i> @b.TriggerThreshold Jam Kerja
                                            </span>
                                        }
                                        else if (b.TriggerType == TrackerKerja.Models.BadgeTriggerType.Auto_NotesCount)
                                        {
                                            <span class="text-indigo-700 font-semibold flex items-center gap-1">
                                                <i class="fas fa-sticky-note text-indigo-500"></i> @b.TriggerThreshold Catatan
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-slate-600 font-semibold">
                                                @b.TriggerType (@b.TriggerThreshold)
                                            </span>
                                        }
                                    </td>
                                    <td class="py-3.5 px-4 text-center">
                                        <form method="post" action="/MasterData/ToggleBadgeStatus" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@b.Id" />
                                            <button type="submit" class="px-2.5 py-1 rounded-full text-[10px] font-bold cursor-pointer transition-all @(b.IsActive ? "bg-emerald-100 text-emerald-800 hover:bg-emerald-200" : "bg-slate-200 text-slate-600 hover:bg-slate-300")">
                                                @(b.IsActive ? "Aktif" : "Nonaktif")
                                            </button>
                                        </form>
                                    </td>
                                    <td class="py-3.5 px-4 text-right">
                                        <div class="flex items-center justify-end gap-1.5">
                                            <button type="button" onclick="openEditBadgeModal(@b.Id, '@b.Code', '@b.Name.Replace("'", "\\'")', '@(b.Description?.Replace("'", "\\'"))', '@b.Category', '@b.Icon', '@b.Color', @b.Points, @((int)b.Rarity), @((int)b.TriggerType), @b.TriggerThreshold, @(b.IsActive ? "true" : "false"), @b.OrderIndex)"
                                                    class="p-1.5 rounded-lg text-slate-400 hover:text-amber-600 hover:bg-amber-50 transition-colors" title="Edit Badge">
                                                <i class="fas fa-edit"></i>
                                            </button>

                                            <form method="post" action="/MasterData/DeleteBadge"
                                                  data-confirm="Apakah Anda yakin ingin menghapus badge '@b.Name'?"
                                                  data-confirm-title="Hapus Badge Gamifikasi"
                                                  data-confirm-btn="<i class='fas fa-trash-alt mr-1.5'></i>Ya, Hapus" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@b.Id" />
                                                <button type="submit" class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors cursor-pointer" title="Hapus Badge">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

</div>

