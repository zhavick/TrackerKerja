                        class="px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-100 rounded-xl transition-colors cursor-pointer">
                    Tutup
                </button>
                <a href="/Configuration/ExportSqlScript"
                   class="flex items-center gap-1.5 px-4 py-2 bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-700 hover:to-blue-700 text-white text-xs font-bold rounded-xl shadow-xs transition-all cursor-pointer">
                    <i class="fas fa-download"></i>
                    <span>Unduh File .sql Lengkap</span>
