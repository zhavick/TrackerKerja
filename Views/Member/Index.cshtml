@model List<TrackerKerja.ViewModels.MemberListItemViewModel>
@{
    ViewData["Title"] = "Direktori Anggota Tim";
    var totalTasks = Model.Sum(m => m.TotalTasks);
    var totalHours = Model.Sum(m => m.TotalHours);
    var totalNotes = Model.Sum(m => m.NotesContributedCount);
}

<div class="space-y-6 max-w-7xl mx-auto">

    <!-- Header & Action -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-indigo-500 to-purple-600 text-white flex items-center justify-center shadow-lg shadow-indigo-200">
                <i class="fas fa-users text-lg"></i>
            </div>
            <div>
                <h2 class="text-2xl font-black text-slate-800">Direktori Anggota Tim</h2>
                <p class="text-slate-500 text-xs mt-0.5">Pantau data member, distribusi penugasan tugas, dan kontribusi catatan kerja</p>
            </div>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <div class="flex gap-2">
                <a href="/Member/Create" class="flex items-center gap-2 bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow-lg hover:shadow-indigo-200 hover:scale-105 transition-all">
                    <i class="fas fa-user-plus"></i><span>Tambah Member</span>
                </a>
            </div>
        }
    </div>

    <!-- Admin Pending Approvals Banner -->
    @if (User.IsInRole("Admin") && (ViewBag.PendingCount ?? 0) > 0)
    {
        <div class="p-4 rounded-2xl bg-gradient-to-r from-amber-500/15 via-orange-500/10 to-amber-500/15 border border-amber-300 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 animate-fadeIn">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center text-lg flex-shrink-0 shadow-md shadow-amber-200">
                    <i class="fas fa-user-clock"></i>
                </div>
                <div>
                    <h4 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                        <span>Persetujuan Registrasi Baru</span>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-amber-500 text-white shadow-2xs">@ViewBag.PendingCount Menunggu</span>
                    </h4>
                    <p class="text-xs text-slate-600 mt-0.5">Terdapat <strong>@ViewBag.PendingCount pendaftaran pengguna baru</strong> yang belum disetujui. Akun baru belum dapat login sebelum Anda menyetujuinya.</p>
                </div>
            </div>
            <a href="/Member?approvalStatus=pending" class="px-3.5 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold transition-all flex items-center gap-1.5 shadow-sm hover:shadow-md flex-shrink-0">
                <i class="fas fa-filter"></i><span>Filter Akun Pending</span>
            </a>
        </div>
    }

    <!-- Summary Stats Bar -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl p-4 border border-indigo-100 shadow-sm">
            <div class="flex items-center justify-between mb-1">
                <span class="text-xs font-bold text-slate-500">Total Anggota</span>
                <div class="w-8 h-8 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xs">
                    <i class="fas fa-user-friends"></i>
                </div>
            </div>
            <p class="text-2xl font-black text-slate-800">@Model.Count</p>
            <p class="text-[11px] text-slate-400 mt-0.5">Personel Terdaftar</p>
        </div>

        <div class="bg-white rounded-2xl p-4 border border-emerald-100 shadow-sm">
            <div class="flex items-center justify-between mb-1">
                <span class="text-xs font-bold text-slate-500">Tugas Terdistribusi</span>
                <div class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs">
                    <i class="fas fa-tasks"></i>
                </div>
            </div>
            <p class="text-2xl font-black text-slate-800">@totalTasks</p>
            <p class="text-[11px] text-emerald-600 font-semibold mt-0.5">Penugasan Aktif & Selesai</p>
        </div>

        <div class="bg-white rounded-2xl p-4 border border-amber-100 shadow-sm">
            <div class="flex items-center justify-between mb-1">
                <span class="text-xs font-bold text-slate-500">Total Jam Kerja</span>
                <div class="w-8 h-8 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xs">
                    <i class="fas fa-business-time"></i>
                </div>
            </div>
            <p class="text-2xl font-black text-slate-800">@totalHours.ToString("F1")j</p>
            <p class="text-[11px] text-amber-600 font-semibold mt-0.5">Log Waktu Pengerjaan</p>
        </div>

        <div class="bg-white rounded-2xl p-4 border border-purple-100 shadow-sm">
            <div class="flex items-center justify-between mb-1">
                <span class="text-xs font-bold text-slate-500">Catatan & Dokumen</span>
                <div class="w-8 h-8 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-xs">
                    <i class="fas fa-book-open"></i>
                </div>
            </div>
            <p class="text-2xl font-black text-slate-800">@totalNotes</p>
            <p class="text-[11px] text-purple-600 font-semibold mt-0.5">Dokumen Kontribusi</p>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="bg-white rounded-2xl shadow-sm border border-indigo-100 p-3.5 sm:p-4">
        <form method="get" action="/Member" data-ajax-grid="true" data-target-grid="#ajaxGridContainer" class="flex flex-wrap items-center gap-2.5">
            <div class="relative flex-1 min-w-[180px]">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-indigo-400 text-xs"></i>
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Cari nama anggota, email, jabatan..."
                       class="w-full pl-8 pr-3 py-2 rounded-xl border border-indigo-200 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-400 bg-slate-50/50">
            </div>

            <div class="min-w-[180px]">
                <select name="role" class="select2 select2-compact w-full" data-placeholder="Semua Peran (Role)">
                    <option value="">Semua Peran (Role)</option>
                    @if (ViewBag.RoleFilter == "Admin") { <option value="Admin" selected>🛡️ Admin</option> } else { <option value="Admin">🛡️ Admin</option> }
                    @if (ViewBag.RoleFilter == "User") { <option value="User" selected>👤 User / Team Member</option> } else { <option value="User">👤 User / Team Member</option> }
                </select>
            </div>

            @if (User.IsInRole("Admin"))
            {
                <div class="min-w-[180px]">
                    <select name="approvalStatus" class="select2 select2-compact w-full" data-placeholder="Status Approval">
                        <option value="all" selected="@(ViewBag.ApprovalStatus == "all" || string.IsNullOrEmpty(ViewBag.ApprovalStatus))">👥 Semua Approval</option>
                        <option value="approved" selected="@(ViewBag.ApprovalStatus == "approved")">✅ Akun Disetujui</option>
                        <option value="pending" selected="@(ViewBag.ApprovalStatus == "pending")">⏳ Menunggu Approval @((ViewBag.PendingCount ?? 0) > 0 ? $"({ViewBag.PendingCount})" : "")</option>
                    </select>
                </div>
            }

            @if (User.IsInRole("Admin") && ViewBag.Companies != null)
            {
                <div class="min-w-[180px]">
                    <select name="companyId" class="select2 select2-compact w-full" data-placeholder="Semua Perusahaan">
                        <option value="">🏢 Semua Perusahaan</option>
                        @foreach (var c in (List<TrackerKerja.Models.Company>)ViewBag.Companies)
                        {
                            <option value="@c.Id" selected="@(ViewBag.CompanyFilter == c.Id)">🏢 @c.Name</option>
                        }
                    </select>
                </div>
            }

            <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-xl text-xs font-semibold transition-colors shadow-sm cursor-pointer">
                <i class="fas fa-filter mr-1"></i>Filter
            </button>
            <a href="/Member" class="text-slate-500 hover:text-indigo-600 px-3 py-2 rounded-xl text-xs border border-slate-200 hover:border-indigo-300 font-semibold transition-colors">
                Reset
            </a>
        </form>
    </div>

    <!-- Members Pure Grid Cards Container (Anti-Overflow & Responsive) -->
    <div id="ajaxGridContainer" data-ajax-grid="true" class="ajax-grid-container space-y-4">
        @if (!Model.Any())
        {
            <div class="bg-white rounded-3xl p-16 border border-indigo-100 shadow-sm text-center">
                <div class="w-16 h-16 rounded-2xl bg-indigo-50 text-indigo-400 flex items-center justify-center mx-auto mb-4 text-2xl">
                    <i class="fas fa-user-slash"></i>
                </div>
                <h3 class="text-base font-bold text-slate-700">Tidak ada anggota tim yang sesuai kriteria</h3>
                <p class="text-xs text-slate-400 mt-1">Coba ubah kata kunci pencarian atau reset filter peran di atas.</p>
                <a href="/Member" class="mt-4 inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-bold transition-all">
                    <i class="fas fa-undo"></i><span>Tampilkan Semua Anggota</span>
                </a>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-5">
                @foreach (var m in Model)
                {
                    var isLocked = m.User.LockoutEnd.HasValue && m.User.LockoutEnd.Value > DateTimeOffset.Now;
                    var isAdmin = m.Role == "Admin";
                    var isPending = !m.User.IsApproved;

                    <div class="bg-white rounded-3xl p-5 border border-slate-200/80 hover:border-indigo-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group relative overflow-hidden @(isPending ? "ring-2 ring-amber-400/60 bg-amber-50/20" : (isLocked ? "opacity-65 bg-slate-50/80" : ""))">
                        
                        <!-- Top Accent Role Bar -->
                        <div class="h-1.5 w-full absolute top-0 left-0 @(isPending ? "bg-gradient-to-r from-amber-400 to-orange-500" : (isAdmin ? "bg-gradient-to-r from-purple-500 to-indigo-600" : "bg-gradient-to-r from-indigo-500 to-teal-500"))"></div>

                        <div class="min-w-0">
                            <!-- Header: Avatar, Name & Role Badges -->
                            <div class="flex items-start gap-3 mb-3.5 pt-1">
                                <!-- Avatar with Status Dot -->
                                <div class="relative flex-shrink-0">
                                    @if (!string.IsNullOrEmpty(m.User.ProfilePictureUrl))
                                    {
                                        <img src="@m.User.ProfilePictureUrl" alt="@m.User.FullName"
                                             class="w-12 h-12 rounded-2xl object-cover shadow-sm border-2 border-white ring-2 ring-indigo-100" />
                                    }
                                    else
                                    {
                                        <div class="w-12 h-12 rounded-2xl flex items-center justify-center text-white text-sm font-black shadow-sm ring-2 ring-indigo-50 select-none"
                                             style="background:@(string.IsNullOrEmpty(m.User.AvatarColor) ? "#6366F1" : m.User.AvatarColor)">
                                            @m.User.Initials
                                        </div>
                                    }
                                    <span class="w-3.5 h-3.5 rounded-full absolute -bottom-1 -right-1 border-2 border-white @(isPending ? "bg-amber-500 animate-pulse" : (isLocked ? "bg-red-500" : "bg-emerald-500"))"
                                          title="@(isPending ? "Menunggu Persetujuan Admin" : (isLocked ? "Akun Dinonaktifkan" : "Akun Aktif"))"></span>
                                </div>

                                <!-- User Name & Job Title (Anti-Overflow with Ellipsis) -->
                                <div class="min-w-0 flex-1">
                                    <a href="/Member/Details/@m.User.Id" 
                                       class="font-extrabold text-slate-800 text-sm hover:text-indigo-600 block truncate transition-colors leading-snug" 
                                       title="@m.User.FullName">
                                        @m.User.FullName
                                    </a>
                                    <p class="text-[11px] font-semibold text-slate-400 truncate mt-0.5" title="@(m.User.JobTitle ?? "Team Member")">
                                        @(m.User.JobTitle ?? "Team Member")
                                    </p>
                                </div>
                            </div>

                            <!-- Badges Row (Role, Level, Featured Badge, Status) -->
                            <div class="flex items-center gap-1.5 flex-wrap mb-3">
                                @if (isPending)
                                {
                                    <span class="inline-flex items-center gap-1 text-[10px] font-black px-2 py-0.5 rounded-lg bg-amber-100 text-amber-800 border border-amber-300">
                                        <i class="fas fa-clock text-[9px] text-amber-600"></i>
                                        <span>Menunggu Approval</span>
                                    </span>
                                }

                                <span class="inline-flex items-center gap-1 text-[10px] font-black px-2 py-0.5 rounded-lg @(isAdmin ? "bg-purple-100 text-purple-700 border border-purple-200" : "bg-slate-100 text-slate-700 border border-slate-200")">
                                    <i class="fas @(isAdmin ? "fa-shield-halved text-purple-600" : "fa-user text-slate-500") text-[9px]"></i>
                                    <span>@(isAdmin ? "Admin" : "Member")</span>
                                </span>

                                <span class="inline-flex items-center gap-1 text-[10px] font-black px-2 py-0.5 rounded-lg bg-amber-50 text-amber-800 border border-amber-200 shadow-2xs">
                                    <i class="fas fa-crown text-[9px] text-amber-500"></i>
                                    <span>LVL @m.UserLevel</span>
                                </span>

                                @if (!string.IsNullOrEmpty(m.FeaturedBadgeIcon))
                                {
                                    <span class="w-5 h-5 rounded-md flex items-center justify-center text-white text-[9px] shadow-2xs flex-shrink-0" 
                                          style="background: @(m.FeaturedBadgeColor ?? "#F59E0B")" 
                                          title="Badge: @m.FeaturedBadgeName">
                                        <i class="@m.FeaturedBadgeIcon"></i>
                                    </span>
                                }

                                @if (m.User.Company != null)
                                {
                                    <span class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-200" title="Afiliasi: @m.User.Company.Name">
                                        <i class="fas fa-building text-[8px] text-emerald-500"></i>
                                        <span class="truncate max-w-[120px]">@m.User.Company.Name</span>
                                    </span>
                                }

                                @if (isLocked)
                                {
                                    <span class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded-lg bg-red-100 text-red-700 border border-red-200">
                                        <i class="fas fa-lock text-[8px]"></i> Kunci
                                    </span>
                                }
                            </div>

                            <!-- Contact Info Section (Clean & Truncated) -->
                            <div class="space-y-1 bg-slate-50/60 p-2.5 rounded-2xl border border-slate-100/90 mb-3.5 text-xs text-slate-500">
                                <p class="flex items-center gap-2 min-w-0 text-[11px]" title="@m.User.Email">
                                    <i class="far fa-envelope text-indigo-400 text-xs w-3.5 flex-shrink-0"></i>
                                    <span class="truncate font-mono">@m.User.Email</span>
                                </p>
                                @if (!string.IsNullOrEmpty(m.User.PhoneNumber))
                                {
                                    <p class="flex items-center gap-2 min-w-0 text-[11px]" title="@m.User.PhoneNumber">
                                        <i class="fas fa-phone text-emerald-500 text-xs w-3.5 flex-shrink-0"></i>
                                        <span class="truncate">@m.User.PhoneNumber</span>
                                    </p>
                                }
                            </div>

                            <!-- Work & Contribution Metrics 3-Col Matrix -->
                            <div class="grid grid-cols-3 gap-1.5 bg-slate-50/90 p-2.5 rounded-2xl border border-slate-100 mb-3.5 text-center">
                                <div class="px-1 min-w-0">
                                    <p class="text-xs font-black text-slate-800 truncate">@m.TotalTasks</p>
                                    <p class="text-[9px] font-bold text-slate-400 uppercase tracking-wider truncate">Tugas</p>
                                </div>
                                <div class="px-1 min-w-0 border-x border-slate-200/70">
                                    <p class="text-xs font-black text-indigo-600 truncate">@m.TotalHours.ToString("F1")j</p>
                                    <p class="text-[9px] font-bold text-slate-400 uppercase tracking-wider truncate">Waktu</p>
                                </div>
                                <div class="px-1 min-w-0">
                                    <p class="text-xs font-black text-purple-600 truncate">@m.NotesContributedCount</p>
                                    <p class="text-[9px] font-bold text-slate-400 uppercase tracking-wider truncate">Catatan</p>
                                </div>
                            </div>

                            <!-- Progress Completion -->
                            <div class="space-y-1 mb-4">
                                <div class="flex items-center justify-between text-[11px]">
                                    <span class="text-slate-400 font-semibold truncate">Tugas Selesai</span>
                                    <span class="font-bold text-slate-700 flex-shrink-0">@m.DoneTasks / @m.TotalTasks (@m.CompletionRate%)</span>
                                </div>
                                <div class="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden">
                                    <div class="h-full bg-gradient-to-r from-indigo-500 to-emerald-500 rounded-full transition-all duration-500"
                                         style="width: @(m.CompletionRate)%"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Card Action Footer -->
                        @if (isPending && User.IsInRole("Admin"))
                        {
                            <div class="pt-3 border-t border-amber-200/80 flex items-center justify-between gap-2">
                                <!-- Approve Button -->
                                <form method="post" action="/Member/Approve/@m.User.Id" class="flex-1"
                                      data-confirm="Apakah Anda yakin ingin menyetujui pendaftaran akun '@m.User.FullName' (@m.User.Email)?"
                                      data-confirm-title="Setujui Pendaftaran Member"
                                      data-confirm-btn="<i class='fas fa-check mr-1.5'></i>Setujui Akun">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="w-full py-2 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-black transition-all shadow-sm hover:shadow-md flex items-center justify-center gap-1.5 cursor-pointer">
                                        <i class="fas fa-check"></i><span>Setujui</span>
                                    </button>
                                </form>

                                <!-- Reject Button -->
                                <form method="post" action="/Member/Reject/@m.User.Id" class="inline"
                                      data-confirm="Apakah Anda yakin ingin menolak dan membatalkan pendaftaran akun '@m.User.FullName' (@m.User.Email)?"
                                      data-confirm-title="Tolak Pendaftaran Member"
                                      data-confirm-btn="<i class='fas fa-trash-alt mr-1.5'></i>Tolak Pendaftaran">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="py-2 px-3 rounded-xl bg-rose-50 hover:bg-rose-600 text-rose-600 hover:text-white text-xs font-bold transition-all shadow-xs flex items-center justify-center gap-1.5 cursor-pointer" title="Tolak Pendaftaran">
                                        <i class="fas fa-times"></i><span>Tolak</span>
                                    </button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-1.5">
                                <!-- Primary Detail Link -->
                                <a href="/Member/Details/@m.User.Id"
                                   class="flex-1 text-center py-2 px-2.5 rounded-xl bg-indigo-50 hover:bg-indigo-600 text-indigo-700 hover:text-white text-xs font-bold transition-all shadow-xs truncate">
                                    <i class="far fa-id-card mr-1"></i><span>Kontribusi</span>
                                </a>

                                @if (User.IsInRole("Admin"))
                                {
                                    <!-- Reset Password Button -->
                                    <button type="button" onclick="openAdminResetPasswordModal('@m.User.Id', '@m.User.FullName.Replace("'", "\\'")')"
                                            class="w-8 h-8 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-600 hover:text-amber-700 flex items-center justify-center text-xs transition-colors cursor-pointer flex-shrink-0" 
                                            title="Ubah Password Member (Khusus Admin)">
                                        <i class="fas fa-key"></i>
                                    </button>

                                    <!-- Edit Member Button -->
                                    <a href="/Member/Edit/@m.User.Id"
                                       class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-indigo-100 text-slate-600 hover:text-indigo-700 flex items-center justify-center text-xs transition-colors flex-shrink-0" 
                                       title="Edit Data Profil Member">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    <!-- Lock / Unlock Button -->
                                    <form method="post" action="/Member/ToggleStatus/@m.User.Id" class="inline"
                                          data-confirm="@(isLocked ? $"Apakah Anda yakin ingin mengaktifkan kembali akses akun '{m.User.FullName}'?" : $"Apakah Anda yakin ingin menonaktifkan / mengunci akses akun '{m.User.FullName}'?")"
                                          data-confirm-title="@(isLocked ? "Aktifkan Akun Member" : "Nonaktifkan Akun Member")"
                                          data-confirm-btn="@(isLocked ? "<i class='fas fa-unlock mr-1.5'></i>Aktifkan" : "<i class='fas fa-user-lock mr-1.5'></i>Kunci Akun")">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="w-8 h-8 rounded-xl @(isLocked ? "bg-emerald-50 text-emerald-600 hover:bg-emerald-600 hover:text-white" : "bg-slate-100 text-slate-500 hover:bg-slate-600 hover:text-white") flex items-center justify-center text-xs transition-colors cursor-pointer flex-shrink-0"
                                                title="@(isLocked ? "Aktifkan Akun" : "Kunci Akun")">
                                            <i class="fas @(isLocked ? "fa-unlock" : "fa-user-lock")"></i>
                                        </button>
                                    </form>

                                    <!-- Delete Member & Login Account Button (Permanent) -->
                                    <button type="button" 
                                            onclick="openDeleteMemberModal('@m.User.Id', '@m.User.FullName.Replace("'", "\\'") ', '@(m.User.Email?.Replace("'", "\\'") ?? "")', '@m.Role')"
                                            class="w-8 h-8 rounded-xl bg-red-50 hover:bg-red-600 text-red-500 hover:text-white flex items-center justify-center text-xs transition-colors cursor-pointer flex-shrink-0 shadow-xs"
                                            title="Hapus Akun & Data Member Permanen">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (User.IsInRole("Admin"))
{
    <!-- MODAL ADMIN DIRECT RESET PASSWORD -->
    <div id="adminResetPasswordModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs hidden animate-fadeIn">
        <div class="bg-white rounded-3xl shadow-2xl border border-indigo-100 max-w-md w-full overflow-hidden transform transition-all">
            <!-- Header -->
            <div class="bg-gradient-to-r from-amber-500 to-orange-600 p-5 text-white flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-white/20 flex items-center justify-center text-lg shadow-inner">
                        <i class="fas fa-key"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-black">Ubah Password Member</h3>
                        <p class="text-amber-100 text-xs mt-0.5" id="modalMemberNameLabel">Setel kata sandi baru</p>
                    </div>
                </div>
                <button type="button" onclick="closeAdminResetPasswordModal()" class="w-8 h-8 rounded-xl bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors cursor-pointer">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Form -->
            <form method="post" action="/Member/ResetPassword" id="adminResetPasswordForm" class="p-6 space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="modalResetUserId" value="" />
                <input type="hidden" name="returnUrl" value="/Member" />

                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                        Password Baru <span class="text-red-500">*</span>
                    </label>
                    <div class="relative">
                        <input type="password" name="newPassword" id="modalNewPassword" required minlength="6" placeholder="Masukkan password baru..."
                               class="w-full pl-3.5 pr-10 py-2.5 rounded-xl border border-slate-200 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-400 bg-slate-50">
                        <button type="button" onclick="togglePasswordVisibility('modalNewPassword', this)" 
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-xs cursor-pointer">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <p class="text-[11px] text-slate-400 mt-1">Minimal 6 karakter. Password langsung aktif tanpa perlu konfirmasi email atau password lama.</p>
                </div>

                <!-- Footer -->
                <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-2.5">
                    <button type="button" onclick="closeAdminResetPasswordModal()" class="px-4 py-2 rounded-xl text-xs font-bold text-slate-500 hover:text-slate-700 bg-white border border-slate-200 hover:bg-slate-100 transition-all cursor-pointer">
                        Batal
                    </button>
                    <button type="submit" class="flex items-center gap-2 bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-600 hover:to-orange-700 text-white text-xs font-bold px-5 py-2.5 rounded-xl shadow-md hover:shadow-amber-200 transition-all cursor-pointer">
                        <i class="fas fa-check"></i>
                        <span>Simpan Password Baru</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL PERMANENT DELETE MEMBER & LOGIN ACCOUNT -->
    <div id="deleteMemberModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs hidden animate-fadeIn">
        <div class="bg-white rounded-3xl shadow-2xl border border-red-100 max-w-md w-full overflow-hidden transform transition-all">
            <!-- Header -->
            <div class="bg-gradient-to-r from-red-600 to-rose-600 p-5 text-white flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-white/20 flex items-center justify-center text-lg shadow-inner">
                        <i class="fas fa-user-xmark"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-black">Hapus Akun & Member</h3>
                        <p class="text-red-100 text-xs mt-0.5">Penghapusan permanen dari sistem</p>
                    </div>
                </div>
                <button type="button" onclick="closeDeleteMemberModal()" class="w-8 h-8 rounded-xl bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors cursor-pointer">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Body -->
            <form method="post" id="deleteMemberForm" action="/Member/Delete" class="p-6 space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="modalDeleteUserId" value="" />

                <div class="p-4 rounded-2xl bg-red-50/80 border border-red-200 text-xs text-red-900 space-y-2">
                    <div class="flex items-center gap-2 font-bold text-red-700">
                        <i class="fas fa-exclamation-triangle text-base"></i>
                        <span>Peringatan Penghapusan Akun:</span>
                    </div>
                    <p class="leading-relaxed text-[11px] text-red-800">
                        Apakah Anda yakin ingin menghapus member <strong id="deleteMemberNameText" class="text-red-950 font-black"></strong> (<span id="deleteMemberEmailText" class="font-mono text-red-950"></span>)?
                    </p>
                    <ul class="list-disc pl-4 text-[10px] text-red-700 space-y-0.5">
                        <li>Akun login ASP.NET Identity akan dihapus secara permanen.</li>
                        <li>User tidak dapat login kembali ke sistem.</li>
                        <li>Penugasan tugas akan dialihkan menjadi <em>unassigned</em> agar data proyek tetap aman.</li>
                    </ul>
                </div>

                <!-- Footer Actions -->
                <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-2.5">
                    <button type="button" onclick="closeDeleteMemberModal()" class="px-4 py-2.5 rounded-xl text-xs font-bold text-slate-600 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 transition-all cursor-pointer">
                        Batal
                    </button>
                    <button type="submit" class="flex items-center gap-2 bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-700 hover:to-rose-700 text-white text-xs font-black px-5 py-2.5 rounded-xl shadow-lg hover:shadow-red-200 hover:scale-102 transition-all cursor-pointer">
                        <i class="fas fa-trash-alt"></i>
                        <span>Ya, Hapus Permanen</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    @section Scripts {
    <script>
        function openAdminResetPasswordModal(userId, fullName) {
            const modal = document.getElementById('adminResetPasswordModal');
            const idInput = document.getElementById('modalResetUserId');
            const nameLabel = document.getElementById('modalMemberNameLabel');
            const pwdInput = document.getElementById('modalNewPassword');

            if (idInput) idInput.value = userId;
            if (nameLabel) nameLabel.textContent = `Anggota: ${fullName}`;
            if (pwdInput) pwdInput.value = '';
            if (modal) modal.classList.remove('hidden');
        }

        function closeAdminResetPasswordModal() {
            const modal = document.getElementById('adminResetPasswordModal');
            if (modal) modal.classList.add('hidden');
        }

        function openDeleteMemberModal(userId, fullName, email, role) {
            const modal = document.getElementById('deleteMemberModal');
            const idInput = document.getElementById('modalDeleteUserId');
            const nameText = document.getElementById('deleteMemberNameText');
            const emailText = document.getElementById('deleteMemberEmailText');
            const form = document.getElementById('deleteMemberForm');

            if (idInput) idInput.value = userId;
            if (nameText) nameText.textContent = fullName.trim();
            if (emailText) emailText.textContent = email.trim();
            if (form) form.action = `/Member/Delete/${userId}`;
            if (modal) modal.classList.remove('hidden');
        }

        function closeDeleteMemberModal() {
            const modal = document.getElementById('deleteMemberModal');
            if (modal) modal.classList.add('hidden');
        }

        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            if (!input) return;
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                if (icon) { icon.classList.remove('fa-eye'); icon.classList.add('fa-eye-slash'); }
            } else {
                input.type = 'password';
                if (icon) { icon.classList.remove('fa-eye-slash'); icon.classList.add('fa-eye'); }
            }
        }
    </script>
    }
}
