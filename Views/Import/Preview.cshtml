@model TrackerKerja.ViewModels.ImportResultViewModel
@inject TrackerKerja.Data.AppDbContext DbContext
@{
    ViewData["Title"] = "Pratinjau Analisis & Sinkronisasi Excel";
    var users = (ViewBag.Users as List<TrackerKerja.Models.AppUser>) ?? DbContext.Users.OrderBy(u => u.FullName).ToList();
}

<div class="mb-5 flex items-center justify-between">
    <a href="/Import" class="text-indigo-600 hover:text-indigo-800 text-xs font-bold flex items-center gap-1.5 transition-colors">
        <i class="fas fa-arrow-left"></i> Kembali ke Dashboard Import
    </a>

    @if (Model.ProcessedSheets.Any())
    {
        <div class="flex items-center gap-1.5 flex-wrap">
            <span class="text-[11px] text-slate-500 font-semibold">Sheet Terproses:</span>
            @foreach (var s in Model.ProcessedSheets.Take(6))
            {
                <span class="px-2 py-0.5 rounded-md bg-indigo-50 text-indigo-700 border border-indigo-100 text-[10px] font-mono">
                    @s
                </span>
            }
            @if (Model.ProcessedSheets.Count > 6)
            {
                <span class="text-[10px] text-slate-400 font-bold">+@(Model.ProcessedSheets.Count - 6) lainnya</span>
            }
        </div>
    }
</div>

<!-- Summary Cards Bar -->
<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3.5 mb-6">
    <!-- Total Rows -->
    <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-xs">
        <div class="flex items-center justify-between">
            <p class="text-xs text-slate-500 font-semibold">Total Baris</p>
            <div class="w-7 h-7 rounded-lg bg-slate-100 text-slate-500 flex items-center justify-center text-xs">
                <i class="fas fa-list"></i>
            </div>
        </div>
        <p class="text-2xl font-black text-slate-800 mt-1">@Model.TotalRows</p>
        <p class="text-[10px] text-slate-400 mt-0.5 truncate" title="@Model.FileName">@Model.FileName</p>
    </div>

    <!-- Insert / New Tasks -->
    <div class="bg-white border border-emerald-200 rounded-2xl p-4 shadow-xs">
        <div class="flex items-center justify-between">
            <p class="text-xs text-emerald-700 font-semibold">Tugas Baru (Insert)</p>
            <div class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs">
                <i class="fas fa-plus-circle"></i>
            </div>
        </div>
        <p class="text-2xl font-black text-emerald-600 mt-1">@Model.InsertCount</p>
        <p class="text-[10px] text-emerald-600/80 mt-0.5">Akan ditambahkan baru</p>
    </div>

    <!-- Update Tasks -->
    <div class="bg-white border border-blue-200 rounded-2xl p-4 shadow-xs">
        <div class="flex items-center justify-between">
            <p class="text-xs text-blue-700 font-semibold">Pembaruan (Update)</p>
            <div class="w-7 h-7 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center text-xs">
                <i class="fas fa-sync-alt"></i>
            </div>
        </div>
        <p class="text-2xl font-black text-blue-600 mt-1">@Model.UpdateCount</p>
        <p class="text-[10px] text-blue-600/80 mt-0.5">Data lama diperbarui</p>
    </div>

    <!-- Unchanged Tasks -->
    <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-xs">
        <div class="flex items-center justify-between">
            <p class="text-xs text-slate-500 font-semibold">Tanpa Perubahan</p>
            <div class="w-7 h-7 rounded-lg bg-slate-100 text-slate-500 flex items-center justify-center text-xs">
                <i class="fas fa-equals"></i>
            </div>
        </div>
        <p class="text-2xl font-black text-slate-600 mt-1">@Model.UnchangedCount</p>
        <p class="text-[10px] text-slate-400 mt-0.5">Data sudah identik</p>
    </div>

    <!-- Failed Rows -->
    <div class="bg-white border border-rose-200 rounded-2xl p-4 shadow-xs col-span-2 sm:col-span-1">
        <div class="flex items-center justify-between">
            <p class="text-xs text-rose-700 font-semibold">Baris Gagal (Error)</p>
            <div class="w-7 h-7 rounded-lg bg-rose-100 text-rose-600 flex items-center justify-center text-xs">
                <i class="fas fa-times-circle"></i>
            </div>
        </div>
        <p class="text-2xl font-black text-rose-600 mt-1">@Model.FailedRows</p>
        <p class="text-[10px] text-rose-600/80 mt-0.5">Akan dilewati</p>
    </div>
</div>

<form method="post" action="/Import/Confirm" id="confirm-import-form">
    @Html.AntiForgeryToken()

    <!-- Table Card -->
    <div class="bg-white rounded-3xl shadow-sm border border-slate-200/80 mb-6 overflow-hidden">
        
        <!-- Header Toolbar -->
        <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <!-- Filter Tabs -->
            <div class="flex items-center gap-1.5 flex-wrap">
                <button type="button" onclick="filterTable('all')" id="tab-filter-all" class="table-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-indigo-600 text-white shadow-xs transition-all">
                    Semua (@Model.TotalRows)
                </button>
                <button type="button" onclick="filterTable('INSERT')" id="tab-filter-insert" class="table-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold text-slate-600 hover:bg-emerald-50 hover:text-emerald-700 transition-all">
                    <i class="fas fa-plus text-[10px] mr-1 text-emerald-500"></i>Baru (@Model.InsertCount)
                </button>
                <button type="button" onclick="filterTable('UPDATE')" id="tab-filter-update" class="table-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold text-slate-600 hover:bg-blue-50 hover:text-blue-700 transition-all">
                    <i class="fas fa-sync text-[10px] mr-1 text-blue-500"></i>Update (@Model.UpdateCount)
                </button>
                <button type="button" onclick="filterTable('UNCHANGED')" id="tab-filter-unchanged" class="table-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 hover:text-slate-700 transition-all">
                    <i class="fas fa-equals text-[10px] mr-1 text-slate-400"></i>Identik (@Model.UnchangedCount)
                </button>
                @if (Model.FailedRows > 0)
                {
                    <button type="button" onclick="filterTable('ERROR')" id="tab-filter-error" class="table-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold text-slate-600 hover:bg-rose-50 hover:text-rose-700 transition-all">
                        <i class="fas fa-times text-[10px] mr-1 text-rose-500"></i>Gagal (@Model.FailedRows)
                    </button>
                }
            </div>

            <!-- Bulk PIC Toolbar -->
            <div class="flex items-center gap-2 bg-white border border-indigo-200/80 p-1.5 px-3 rounded-2xl shadow-xs shrink-0 flex-wrap">
                <span class="text-xs font-bold text-indigo-900 flex items-center gap-1.5">
                    <i class="fas fa-user-edit text-indigo-600"></i>
                    <span>Atur Semua PIC:</span>
                </span>
                <div class="min-w-[200px]">
                    <select id="bulk-pic-select" class="select2 select2-compact w-full" data-placeholder="-- Pilih PIC Massal --">
                        <option value="">-- Pilih PIC Massal --</option>
                        <option value="none">-- Kosongkan PIC --</option>
                        @foreach (var u in users)
                        {
                            <option value="@u.Id">@u.FullName (@u.Email)</option>
                        }
                    </select>
                </div>
                <button type="button" onclick="applyBulkPic()" class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold px-3 py-1.5 rounded-xl transition-all cursor-pointer">
                    Terapkan
                </button>
            </div>
        </div>

        <!-- Table Responsive -->
        <div class="overflow-x-auto">
            <table class="w-full text-xs">
                <thead>
                    <tr class="border-b border-slate-100 bg-slate-50 text-slate-500 font-bold uppercase tracking-wider">
                        <th class="text-left px-3.5 py-3">#</th>
                        <th class="text-left px-3.5 py-3">Aksi</th>
                        <th class="text-left px-3.5 py-3">Sheet Asal</th>
                        <th class="text-left px-3.5 py-3 min-w-[280px]">Nama Tugas & Perubahan</th>
                        <th class="text-left px-3.5 py-3">Proyek</th>
                        <th class="text-left px-3.5 py-3 min-w-[220px]">PIC / Penugasan</th>
                        <th class="text-center px-3.5 py-3">Prioritas</th>
                        <th class="text-center px-3.5 py-3">Status</th>
                        <th class="text-center px-3.5 py-3">Progress</th>
                        <th class="text-left px-3.5 py-3">Mulai</th>
                        <th class="text-left px-3.5 py-3">Deadline</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100" id="preview-table-body">
                    @foreach (var row in Model.Rows)
                    {
                        var rowBg = row.ActionType switch
                        {
                            "INSERT" => "hover:bg-emerald-50/30",
                            "UPDATE" => "hover:bg-blue-50/30",
                            "UNCHANGED" => "hover:bg-slate-50/50 text-slate-600",
                            _ => "bg-rose-50/40"
                        };

                        <tr class="table-row-item @rowBg transition-colors" data-action="@row.ActionType">
                            <td class="px-3.5 py-3 font-mono text-slate-400">@row.RowNumber</td>
                            
                            <!-- Action Badge -->
                            <td class="px-3.5 py-3 whitespace-nowrap">
                                @if (row.ActionType == "INSERT")
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-700 border border-emerald-200">
                                        <i class="fas fa-plus text-[9px]"></i> Baru
                                    </span>
                                }
                                else if (row.ActionType == "UPDATE")
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-100 text-blue-700 border border-blue-200">
                                        <i class="fas fa-sync-alt text-[9px]"></i> Update
                                    </span>
                                }
                                else if (row.ActionType == "UNCHANGED")
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 text-slate-600 border border-slate-200">
                                        <i class="fas fa-equals text-[9px]"></i> Identik
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-700 border border-rose-200">
                                        <i class="fas fa-times text-[9px]"></i> Gagal
                                    </span>
                                }
                            </td>

                            <!-- Sheet Name Badge -->
                            <td class="px-3.5 py-3 whitespace-nowrap">
                                <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-700 text-[10px] font-mono border border-slate-200 truncate max-w-[140px] inline-block" title="@row.SheetName">
                                    @row.SheetName
                                </span>
                            </td>

                            <!-- Title & Diff Details -->
                            <td class="px-3.5 py-3">
                                <p class="font-bold text-slate-800 text-xs leading-snug">@row.Title</p>

                                @if (row.ActionType == "UPDATE" && row.ChangedFields.Any())
                                {
                                    <div class="mt-1.5 flex flex-wrap gap-1">
                                        @foreach (var ch in row.ChangedFields)
                                        {
                                            <span class="px-1.5 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200 text-[10px] font-semibold">
                                                <i class="fas fa-edit text-[8px] mr-0.5"></i> @ch
                                            </span>
                                        }
                                    </div>
                                }

                                <div class="flex flex-wrap gap-1.5 mt-1">
                                    @if (!string.IsNullOrEmpty(row.Requirement))
                                    {
                                        <span class="inline-flex items-center gap-1 text-[10px] font-bold bg-indigo-50 text-indigo-700 px-1.5 py-0.5 rounded border border-indigo-100">
                                            <i class="fas fa-bookmark text-[8px]"></i> @row.Requirement
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(row.ModuleName))
                                    {
                                        <span class="inline-flex items-center gap-1 text-[10px] font-semibold bg-slate-100 text-slate-700 px-1.5 py-0.5 rounded">
                                            <i class="fas fa-cube text-[8px]"></i> @row.ModuleName
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(row.Obstacle))
                                    {
                                        <span class="inline-flex items-center gap-1 text-[10px] font-semibold bg-rose-50 text-rose-600 px-1.5 py-0.5 rounded" title="Kendala: @row.Obstacle">
                                            <i class="fas fa-exclamation-triangle text-[8px]"></i> Kendala
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(row.Solution))
                                    {
                                        <span class="inline-flex items-center gap-1 text-[10px] font-semibold bg-emerald-50 text-emerald-600 px-1.5 py-0.5 rounded" title="Solusi: @row.Solution">
                                            <i class="fas fa-lightbulb text-[8px]"></i> Solusi
                                        </span>
                                    }
                                </div>

                                @if (!string.IsNullOrEmpty(row.ErrorMessage))
                                {
                                    <p class="text-[11px] text-rose-600 font-semibold mt-1">
                                        <i class="fas fa-times-circle mr-1"></i>@row.ErrorMessage
                                    </p>
                                }
                                @if (!string.IsNullOrEmpty(row.WarningMessage))
                                {
                                    <p class="text-[11px] text-amber-600 mt-1">
                                        <i class="fas fa-exclamation-triangle mr-1"></i>@row.WarningMessage
                                    </p>
                                }
                            </td>

                            <!-- Project -->
                            <td class="px-3.5 py-3 whitespace-nowrap text-slate-600">
                                @(string.IsNullOrEmpty(row.Project) ? "—" : row.Project)
                            </td>

                            <!-- PIC / Assignee with smart resolution & dropdown -->
                            <td class="px-3.5 py-3">
                                @if (row.IsValid)
                                {
                                    <select name="rowAssignees[@row.RowNumber]" class="row-pic-select select2 select2-compact w-full" data-placeholder="-- Belum Ditugaskan --">
                                        <option value="">-- Belum Ditugaskan --</option>
                                        @foreach (var u in users)
                                        {
                                            var isSelected = (!string.IsNullOrEmpty(row.AssigneeUserId) && row.AssigneeUserId == u.Id) ||
                                                             (!string.IsNullOrEmpty(row.Assignee) && (row.Assignee.Equals(u.Email, StringComparison.OrdinalIgnoreCase) || row.Assignee.Equals(u.FullName, StringComparison.OrdinalIgnoreCase))) ||
                                                             (!string.IsNullOrEmpty(row.Pic) && (row.Pic.Equals(u.Email, StringComparison.OrdinalIgnoreCase) || row.Pic.Equals(u.FullName, StringComparison.OrdinalIgnoreCase)));
                                            <option value="@u.Id" selected="@(isSelected ? "selected" : null)">
                                                @u.FullName (@(u.Email?.Split('@')[0] ?? ""))
                                            </option>
                                        }
                                    </select>
                                    @if (!string.IsNullOrEmpty(row.Pic))
                                    {
                                        <div class="text-[10px] text-slate-400 mt-1 truncate" title="PIC dari File Excel/Sheet: @row.Pic">
                                            <i class="fas fa-user-tag text-indigo-400 mr-1"></i>Asal: <span class="font-medium text-slate-600">@row.Pic</span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-slate-400 italic">—</span>
                                }
                            </td>

                            <!-- Priority -->
                            <td class="px-3.5 py-3 text-center whitespace-nowrap">
                                @{
                                    var pBadge = row.Priority switch
                                    {
                                        "Critical" => "bg-rose-100 text-rose-700 border-rose-200",
                                        "High" => "bg-amber-100 text-amber-700 border-amber-200",
                                        "Low" => "bg-emerald-100 text-emerald-700 border-emerald-200",
                                        _ => "bg-blue-100 text-blue-700 border-blue-200"
                                    };
                                }
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold border @pBadge">
                                    @row.Priority
                                </span>
                            </td>

                            <!-- Status -->
                            <td class="px-3.5 py-3 text-center whitespace-nowrap">
                                <span class="font-semibold text-slate-700">@row.Status</span>
                            </td>

                            <!-- Progress -->
                            <td class="px-3.5 py-3 text-center whitespace-nowrap">
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-[10px] font-bold @(row.Progress == 100 ? "bg-emerald-100 text-emerald-700" : row.Progress > 0 ? "bg-indigo-50 text-indigo-700" : "bg-slate-100 text-slate-600")">
                                    @(row.Progress)%
                                </span>
                            </td>

                            <!-- Dates -->
                            <td class="px-3.5 py-3 whitespace-nowrap font-mono text-slate-500">
                                @(string.IsNullOrEmpty(row.StartDate) ? "—" : row.StartDate)
                            </td>
                            <td class="px-3.5 py-3 whitespace-nowrap font-mono text-slate-500">
                                @(string.IsNullOrEmpty(row.Deadline) ? (string.IsNullOrEmpty(row.EndDate) ? "—" : row.EndDate) : row.Deadline)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Confirm Execution Sticky Action Footer -->
    @if (Model.SuccessRows > 0)
    {
        <div class="bg-gradient-to-r from-slate-900 to-indigo-950 text-white rounded-3xl p-6 shadow-xl flex flex-col md:flex-row md:items-center justify-between gap-5 sticky bottom-4 z-20 border border-white/10 backdrop-blur-md">
            <div>
                <p class="font-bold text-base flex items-center gap-2">
                    <i class="fas fa-check-double text-emerald-400"></i>
                    <span>Siap Menerapkan Sinkronisasi</span>
                </p>
                <p class="text-xs text-slate-300 mt-1">
                    <span class="font-bold text-emerald-400">@Model.InsertCount Tugas Baru</span> akan ditambahkan,
                    <span class="font-bold text-blue-400">@Model.UpdateCount Tugas</span> akan diperbarui nilainya, dan
                    <span class="text-slate-400">@Model.UnchangedCount Tugas</span> tetap dipertahankan.
                </p>
            </div>

            <div class="flex items-center gap-3">
                <a href="/Import" class="px-5 py-3 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold transition-all">
                    Batal
                </a>
                <button type="submit"
                        class="bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white font-black text-xs px-8 py-3.5 rounded-xl shadow-lg hover:shadow-emerald-500/20 transition-all cursor-pointer flex items-center gap-2">
                    <i class="fas fa-database text-sm"></i>
                    <span>Konfirmasi & Eksekusi Sinkronisasi</span>
                </button>
            </div>
        </div>
    }
</form>

@section Scripts {
<script>
function filterTable(action) {
    document.querySelectorAll('.table-filter-btn').forEach(btn => {
        btn.classList.remove('bg-indigo-600', 'text-white', 'shadow-xs');
        btn.classList.add('text-slate-600');
    });

    let activeBtnId = 'tab-filter-all';
    if (action === 'INSERT') activeBtnId = 'tab-filter-insert';
    if (action === 'UPDATE') activeBtnId = 'tab-filter-update';
    if (action === 'UNCHANGED') activeBtnId = 'tab-filter-unchanged';
    if (action === 'ERROR') activeBtnId = 'tab-filter-error';

    const activeBtn = document.getElementById(activeBtnId);
    if (activeBtn) {
        activeBtn.classList.remove('text-slate-600');
        activeBtn.classList.add('bg-indigo-600', 'text-white', 'shadow-xs');
    }

    const rows = document.querySelectorAll('.table-row-item');
    rows.forEach(r => {
        const rowAction = r.getAttribute('data-action');
        if (action === 'all' || rowAction === action) {
            r.style.display = '';
        } else {
            r.style.display = 'none';
        }
    });
}

function applyBulkPic() {
    const bulkSelect = document.getElementById('bulk-pic-select');
    const selectedVal = bulkSelect.value;
    if (!selectedVal) {
        if (typeof SwalAlert === 'function') {
            SwalAlert('Pilih PIC', 'Pilih nama PIC terlebih dahulu.', 'warning');
        } else {
            alert('Pilih nama PIC terlebih dahulu.');
        }
        return;
    }

    const targetVal = selectedVal === 'none' ? '' : selectedVal;
    const rowSelects = document.querySelectorAll('.row-pic-select');
    rowSelects.forEach(sel => {
        sel.value = targetVal;
        if (typeof jQuery !== 'undefined' && jQuery(sel).hasClass('select2-hidden-accessible')) {
            jQuery(sel).trigger('change.select2');
        }
    });

    const selectedText = bulkSelect.options[bulkSelect.selectedIndex].text;
    if (typeof showToast === 'function') {
        showToast(`Semua PIC baris berhasil diatur ke: ${selectedText}`, 'success');
    } else if (typeof SwalAlert === 'function') {
        SwalAlert('Berhasil', `Semua PIC baris berhasil diatur ke: ${selectedText}`, 'success');
    }
}
</script>
}
