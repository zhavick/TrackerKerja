@model TrackerKerja.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Profil Saya";
    var avatarColors = new[] { "#6366F1","#06B6D4","#10B981","#F59E0B","#EF4444","#8B5CF6","#EC4899","#F97316" };
}

<div class="max-w-4xl mx-auto">

    <!-- Profile Header -->
    <div class="bg-gradient-to-br from-indigo-500 via-purple-600 to-pink-600 rounded-3xl p-5 sm:p-8 text-white mb-6 relative overflow-hidden shadow-xl">
        <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
        <div class="absolute bottom-0 left-0 w-48 h-48 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/2"></div>

        <div class="relative flex flex-col sm:flex-row items-center sm:items-start text-center sm:text-left gap-4 sm:gap-6">
            <!-- Avatar Display -->
            <div class="relative flex-shrink-0">
                @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                {
                    <img src="@Model.ProfilePictureUrl" alt="@Model.FullName" id="header-avatar-img"
                         class="w-20 sm:w-24 h-20 sm:h-24 rounded-3xl object-cover shadow-2xl border-2 border-white/40" />
                    <div id="avatar-preview" class="hidden w-20 sm:w-24 h-20 sm:h-24 rounded-3xl items-center justify-center text-2xl sm:text-3xl font-black shadow-2xl"
                         style="background: @Model.AvatarColor">
                        @Model.Initials
                    </div>
                }
                else
                {
                    <img id="header-avatar-img" class="hidden w-20 sm:w-24 h-20 sm:h-24 rounded-3xl object-cover shadow-2xl border-2 border-white/40" />
                    <div class="w-20 sm:w-24 h-20 sm:h-24 rounded-3xl flex items-center justify-center text-2xl sm:text-3xl font-black shadow-2xl"
                         id="avatar-preview" style="background: @Model.AvatarColor">
                        @Model.Initials
                    </div>
                }

                @if (Model.Gamification?.FeaturedBadge != null)
                {
                    <div class="absolute -bottom-2 -right-2 w-8 h-8 rounded-full border-2 border-white shadow-lg flex items-center justify-center text-white text-xs animate-bounce"
                         style="background: @Model.Gamification.FeaturedBadge.Color" title="Badge Utama: @Model.Gamification.FeaturedBadge.Name">
                        <i class="@Model.Gamification.FeaturedBadge.Icon"></i>
                    </div>
                }
            </div>

            <div class="flex-1">
                <div class="flex items-center justify-center sm:justify-start gap-2 flex-wrap">
                    <h2 class="text-2xl sm:text-3xl font-black">@Model.FullName</h2>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-black bg-amber-400 text-amber-950 shadow-sm border border-amber-300 inline-flex items-center gap-1">
                        <i class="fas fa-crown text-[10px]"></i> LVL @(Model.Gamification?.Level ?? 1)
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-white/20 text-white backdrop-blur-md border border-white/20">
                        @(Model.Gamification?.LevelTitle ?? "🌱 Novice Tracker")
                    </span>
                </div>
                <p class="text-white/90 text-sm sm:text-base mt-0.5">@Model.JobTitle</p>
                <p class="text-white/70 text-xs sm:text-sm mt-0.5">@Model.Email</p>

                <!-- EXP Progress Bar -->
                <div class="mt-3 bg-black/20 p-2.5 rounded-2xl border border-white/10 max-w-md">
                    <div class="flex items-center justify-between text-xs font-bold mb-1">
                        <span class="text-amber-300 flex items-center gap-1">
                            <i class="fas fa-bolt text-amber-400"></i> @(Model.Gamification?.TotalExp ?? 0) Total EXP
                        </span>
                        <span class="text-white/80 text-[11px]">
                            @(Model.Gamification?.CurrentLevelExp ?? 0) / @(Model.Gamification?.NextLevelExp ?? 200) EXP (Level @((Model.Gamification?.Level ?? 1) + 1))
                        </span>
                    </div>
                    <div class="w-full bg-white/20 rounded-full h-2 overflow-hidden">
                        <div class="bg-gradient-to-r from-amber-400 to-yellow-300 h-2 rounded-full transition-all duration-500 shadow-sm"
                             style="width: @(Model.Gamification?.ExpProgressPercent ?? 0)%"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="relative grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-4 mt-6">
            <div class="bg-white/10 rounded-2xl p-3 sm:p-4 text-center backdrop-blur-sm">
                <p class="text-xl sm:text-2xl font-black">@Model.TotalTasks</p>
                <p class="text-white/70 text-xs mt-0.5">Total Tugas</p>
            </div>
            <div class="bg-white/10 rounded-2xl p-3 sm:p-4 text-center backdrop-blur-sm">
                <p class="text-xl sm:text-2xl font-black">@Model.DoneTasks</p>
                <p class="text-white/70 text-xs mt-0.5">Selesai</p>
            </div>
            <div class="bg-white/10 rounded-2xl p-3 sm:p-4 text-center backdrop-blur-sm">
                <p class="text-xl sm:text-2xl font-black">@(Model.Gamification?.UnlockedBadgesCount ?? 0) / @(Model.Gamification?.TotalBadgesCount ?? 0)</p>
                <p class="text-white/70 text-xs mt-0.5">Badge Terbuka</p>
            </div>
            <div class="bg-white/10 rounded-2xl p-3 sm:p-4 text-center backdrop-blur-sm">
                <p class="text-xl sm:text-2xl font-black">@Model.TotalHours</p>
                <p class="text-white/70 text-xs mt-0.5">Jam Kerja</p>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">

        <!-- Edit Profile Form -->
        <div class="bg-white rounded-2xl shadow-sm border border-indigo-100 overflow-hidden">
            <div class="bg-gradient-to-r from-indigo-500 to-purple-600 px-6 py-4">
                <h3 class="text-white font-bold flex items-center gap-2">
                    <i class="fas fa-user-edit"></i> Edit Profil & Foto
                </h3>
            </div>
            <div class="p-6">
                <form method="post" asp-action="Profile" asp-controller="Account" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <!-- Profile Picture Upload -->
                    <div class="mb-5 p-4 bg-indigo-50/50 rounded-2xl border border-indigo-100">
                        <label class="block text-sm font-semibold text-slate-700 mb-2">
                            <i class="fas fa-camera text-indigo-500 mr-1.5"></i>Foto Profil
                        </label>
                        <div class="flex items-center gap-4">
                            <div class="w-16 h-16 rounded-2xl bg-white border border-indigo-200 overflow-hidden flex items-center justify-center flex-shrink-0 shadow-sm">
                                <img id="preview-img" src="@(string.IsNullOrEmpty(Model.ProfilePictureUrl) ? "/images/default-avatar.png" : Model.ProfilePictureUrl)"
                                     alt="Preview" class="@(string.IsNullOrEmpty(Model.ProfilePictureUrl) ? "hidden" : "") w-full h-full object-cover" />
                                <div id="preview-placeholder" class="@(string.IsNullOrEmpty(Model.ProfilePictureUrl) ? "" : "hidden") text-slate-400 text-xs text-center font-bold">
                                    @Model.Initials
                                </div>
                            </div>
                            <div class="flex-1">
                                <input type="file" name="ProfilePicture" id="avatar-file-input" accept="image/*"
                                       class="block w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-indigo-600 file:text-white hover:file:bg-indigo-700 cursor-pointer"
                                       onchange="previewFile(event)" />
                                <p class="text-[11px] text-slate-400 mt-1">Format: JPG, PNG, WEBP (Max 5MB)</p>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="block text-sm font-semibold text-slate-700 mb-2">
                            <i class="fas fa-user text-indigo-400 mr-1.5"></i>Nama Lengkap
                        </label>
                        <input type="text" name="FullName" value="@Model.FullName" required
                               class="w-full px-4 py-3 rounded-xl border border-indigo-200 focus:outline-none focus:ring-2 focus:ring-indigo-400 text-slate-800">
                    </div>

                    <div class="mb-4">
                        <label class="block text-sm font-semibold text-slate-700 mb-2">
                            <i class="fas fa-briefcase text-indigo-400 mr-1.5"></i>Jabatan / Posisi
                        </label>
                        <input type="text" name="JobTitle" value="@Model.JobTitle"
                               class="w-full px-4 py-3 rounded-xl border border-indigo-200 focus:outline-none focus:ring-2 focus:ring-indigo-400 text-slate-800">
                    </div>

                    <!-- Avatar Color -->
                    <div class="mb-5">
                        <label class="block text-sm font-semibold text-slate-700 mb-2">
                            <i class="fas fa-palette text-indigo-400 mr-1.5"></i>Warna Background Avatar
                        </label>
                        <div class="flex items-center gap-3 flex-wrap">
                            <input type="color" name="AvatarColor" id="color-input" value="@Model.AvatarColor"
                                   class="w-10 h-10 rounded-xl border border-indigo-200 cursor-pointer"
                                   onchange="updateAvatarPreview(this.value)">
                            <div class="flex gap-2 flex-wrap">
                                @foreach (var color in avatarColors)
                                {
                                    <button type="button"
                                            onclick="setColor('@color')"
                                            class="w-8 h-8 rounded-xl border-2 @(Model.AvatarColor == color ? "border-slate-800 scale-110" : "border-white") shadow-sm hover:scale-110 transition-all"
                                            style="background:@color"></button>
                                }
                            </div>
                        </div>
                    </div>

                    <button type="submit"
                            class="w-full bg-gradient-to-r from-indigo-500 to-purple-600 text-white font-bold py-3 rounded-xl hover:shadow-lg hover:shadow-indigo-200 transition-all">
                        <i class="fas fa-save mr-2"></i>Simpan Profil
                    </button>
                </form>
            </div>
        </div>

        <!-- Change Password Form -->
        <div id="change-password" class="bg-white rounded-2xl shadow-sm border border-indigo-100 overflow-hidden scroll-mt-6">
            <div class="bg-gradient-to-r from-emerald-500 to-teal-600 px-6 py-4">
                <h3 class="text-white font-bold flex items-center gap-2">
                    <i class="fas fa-lock"></i> Ganti Password (Change Password)
                </h3>
            </div>
            <div class="p-6">

                @if (TempData["Error"] != null)
                {
                    <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm flex items-center gap-2">
                        <i class="fas fa-times-circle"></i>
                        <span>@TempData["Error"]</span>
                    </div>
                }

                <form method="post" asp-action="ChangePassword" asp-controller="Account">
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label class="block text-sm font-semibold text-slate-700 mb-2">
                            <i class="fas fa-key text-emerald-500 mr-1.5"></i>Password Lama
                        </label>
                        <input type="password" name="CurrentPassword" required placeholder="Password saat ini"
                               class="w-full px-4 py-3 rounded-xl border border-emerald-200 focus:outline-none focus:ring-2 focus:ring-emerald-400 text-slate-800">
                    </div>

                    <div class="mb-4">
                        <label class="block text-sm font-semibold text-slate-700 mb-2">
                            <i class="fas fa-lock text-emerald-500 mr-1.5"></i>Password Baru
                        </label>
                        <input type="password" name="NewPassword" required placeholder="Min. 6 karakter"
                               class="w-full px-4 py-3 rounded-xl border border-emerald-200 focus:outline-none focus:ring-2 focus:ring-emerald-400 text-slate-800">
                    </div>

                    <div class="mb-5">
                        <label class="block text-sm font-semibold text-slate-700 mb-2">
                            <i class="fas fa-lock text-emerald-500 mr-1.5"></i>Konfirmasi Password Baru
                        </label>
                        <input type="password" name="ConfirmPassword" required placeholder="Ulangi password baru"
                               class="w-full px-4 py-3 rounded-xl border border-emerald-200 focus:outline-none focus:ring-2 focus:ring-emerald-400 text-slate-800">
                    </div>

                    <button type="submit"
                            class="w-full bg-gradient-to-r from-emerald-500 to-teal-600 text-white font-bold py-3 rounded-xl hover:shadow-lg hover:shadow-emerald-200 transition-all">
                        <i class="fas fa-key mr-2"></i>Ubah Password
                    </button>
                </form>

                <!-- Logout -->
                <div class="mt-5 pt-5 border-t border-slate-100">
                    <form method="post" asp-action="Logout" asp-controller="Account">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="w-full bg-red-50 hover:bg-red-100 text-red-600 font-semibold py-3 rounded-xl border border-red-200 transition-all flex items-center justify-center gap-2">
                            <i class="fas fa-sign-out-alt"></i>Keluar dari Akun
                        </button>
                    </form>
                </div>
            </div>
        </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- BADGES & ACHIEVEMENTS SHOWCASE                          -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <div class="mt-6 bg-white rounded-3xl shadow-sm border border-slate-200/80 overflow-hidden">
        <div class="bg-gradient-to-r from-amber-500 via-orange-500 to-amber-600 px-6 py-4 flex items-center justify-between text-white">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-2xl bg-white/20 text-white flex items-center justify-center text-base font-black backdrop-blur-md border border-white/20 shadow-inner">
                    <i class="fas fa-medal"></i>
                </div>
                <div>
                    <h3 class="text-base font-black text-white flex items-center gap-2">
                        <span>Koleksi Badge & Pencapaian</span>
                        <span class="text-xs px-2.5 py-0.5 rounded-full bg-white/20 text-white font-bold backdrop-blur-md">
                            @(Model.Gamification?.UnlockedBadgesCount ?? 0) / @(Model.Gamification?.TotalBadgesCount ?? 0) Terbuka
                        </span>
                    </h3>
                    <p class="text-xs text-amber-100">Kumpulkan EXP dari tugas, jam kerja, dan raih penghargaan prestasi kerja!</p>
                </div>
            </div>

            <!-- Filter Badges -->
            <div class="flex items-center bg-white/20 p-1 rounded-xl backdrop-blur-md text-xs font-bold gap-1">
                <button type="button" onclick="filterBadges('all')" id="filter-all" class="px-3 py-1 rounded-lg bg-white text-amber-900 shadow-sm transition-all">Semua</button>
                <button type="button" onclick="filterBadges('unlocked')" id="filter-unlocked" class="px-3 py-1 rounded-lg text-white hover:bg-white/10 transition-all">Terbuka (@(Model.Gamification?.UnlockedBadgesCount ?? 0))</button>
                <button type="button" onclick="filterBadges('locked')" id="filter-locked" class="px-3 py-1 rounded-lg text-white hover:bg-white/10 transition-all">Terkunci (@((Model.Gamification?.TotalBadgesCount ?? 0) - (Model.Gamification?.UnlockedBadgesCount ?? 0)))</button>
            </div>
        </div>

        <div class="p-6">
            @if (Model.Gamification?.Badges != null && Model.Gamification.Badges.Any())
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4" id="badgesGrid">
                    @foreach (var badge in Model.Gamification.Badges)
                    {
                        var rarityBadgeClass = badge.Rarity switch
                        {
                            TrackerKerja.Models.BadgeRarity.Rare => "bg-blue-100 text-blue-800 border-blue-200",
                            TrackerKerja.Models.BadgeRarity.Epic => "bg-purple-100 text-purple-800 border-purple-200",
                            TrackerKerja.Models.BadgeRarity.Legendary => "bg-amber-100 text-amber-800 border-amber-300 font-black",
                            _ => "bg-slate-100 text-slate-700 border-slate-200"
                        };

                        if (badge.IsUnlocked)
                        {
                            <!-- UNLOCKED BADGE CARD -->
                            <div class="badge-card badge-unlocked relative bg-gradient-to-b from-white to-amber-50/30 rounded-2xl p-4 border-2 border-amber-300/80 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all flex flex-col justify-between">
                                @if (badge.IsFeatured)
                                {
                                    <div class="absolute -top-2.5 -right-2 px-2 py-0.5 rounded-full text-[10px] font-black bg-amber-400 text-amber-950 border border-amber-300 shadow-sm flex items-center gap-1">
                                        <i class="fas fa-star text-amber-800 text-[9px]"></i> Disematkan
                                    </div>
                                }

                                <div>
                                    <div class="flex items-start gap-3 mb-2.5">
                                        <div class="w-12 h-12 rounded-2xl flex items-center justify-center text-white text-xl shadow-md flex-shrink-0"
                                             style="background: @badge.Color">
                                            <i class="@badge.Icon"></i>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <div class="flex items-center gap-1.5 flex-wrap">
                                                <h4 class="font-extrabold text-slate-800 text-sm truncate">@badge.Name</h4>
                                            </div>
                                            <div class="flex items-center gap-1.5 mt-0.5">
                                                <span class="px-1.5 py-0.5 rounded text-[9px] font-bold border @rarityBadgeClass">
                                                    @badge.Rarity.ToString().ToUpper()
                                                </span>
                                                <span class="text-[10px] font-extrabold text-amber-700 bg-amber-100 px-1.5 py-0.5 rounded border border-amber-200">
                                                    +@badge.Points EXP
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <p class="text-xs text-slate-600 leading-relaxed mb-3">@badge.Description</p>
                                </div>

                                <div class="pt-2.5 border-t border-amber-200/60 flex items-center justify-between text-[11px] text-slate-500">
                                    <span class="text-emerald-600 font-semibold flex items-center gap-1">
                                        <i class="fas fa-check-circle"></i> @(badge.UnlockedAt.HasValue ? badge.UnlockedAt.Value.ToString("dd MMM yyyy") : "Terbuka")
                                    </span>

                                    @if (badge.UserBadgeId.HasValue)
                                    {
                                        <form method="post" asp-action="ToggleFeatureBadge" asp-controller="Account" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@badge.UserBadgeId.Value" />
                                            @if (badge.IsFeatured)
                                            {
                                                <button type="submit" class="px-2 py-1 rounded-lg text-[10px] font-bold bg-amber-400 text-amber-950 hover:bg-amber-500 transition-all flex items-center gap-1" title="Lepas Pin">
                                                    <i class="fas fa-check"></i> Utama
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="px-2 py-1 rounded-lg text-[10px] font-bold bg-slate-100 hover:bg-amber-100 text-slate-600 hover:text-amber-800 transition-all flex items-center gap-1" title="Jadikan Badge Utama di Avatar">
                                                    <i class="far fa-star"></i> Pin Avatar
                                                </button>
                                            }
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- LOCKED BADGE CARD -->
                            <div class="badge-card badge-locked relative bg-slate-50/80 rounded-2xl p-4 border border-slate-200 shadow-2xs opacity-80 hover:opacity-100 transition-all flex flex-col justify-between">
                                <div>
                                    <div class="flex items-start gap-3 mb-2.5">
                                        <div class="w-12 h-12 rounded-2xl flex items-center justify-center bg-slate-200 text-slate-400 text-xl flex-shrink-0 border border-slate-300">
                                            <i class="fas fa-lock"></i>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <h4 class="font-bold text-slate-600 text-sm truncate">@badge.Name</h4>
                                            <div class="flex items-center gap-1.5 mt-0.5">
                                                <span class="px-1.5 py-0.5 rounded text-[9px] font-bold border @rarityBadgeClass">
                                                    @badge.Rarity.ToString().ToUpper()
                                                </span>
                                                <span class="text-[10px] font-bold text-slate-500 bg-slate-200 px-1.5 py-0.5 rounded">
                                                    +@badge.Points EXP
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <p class="text-xs text-slate-500 leading-relaxed mb-3">@badge.Description</p>
                                </div>

                                <div class="pt-2.5 border-t border-slate-200 space-y-1.5">
                                    <div class="flex items-center justify-between text-[10px] font-bold text-slate-500">
                                        <span>Progress: @badge.CurrentProgress / @badge.TriggerThreshold</span>
                                        <span>@badge.ProgressPercent%</span>
                                    </div>
                                    <div class="w-full bg-slate-200 rounded-full h-1.5 overflow-hidden">
                                        <div class="bg-indigo-500 h-1.5 rounded-full transition-all duration-300" style="width: @badge.ProgressPercent%"></div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
            else
            {
                <div class="text-center py-8 text-slate-400">
                    <i class="fas fa-medal text-3xl text-slate-300 mb-2"></i>
                    <p class="text-sm">Belum ada badge yang tersedia dalam sistem.</p>
                </div>
            }
        </div>
    </div>

    <!-- THEME CUSTOMIZATION CARD (16 THEMES: 10 LIGHT & 6 DARK) -->
    <div class="mt-6 bg-white rounded-3xl shadow-sm border border-slate-200/80 overflow-hidden">
        <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-purple-950 px-6 py-4 flex items-center justify-between text-white">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-xl bg-indigo-500/30 text-indigo-300 flex items-center justify-center text-sm font-bold border border-indigo-400/30">
                    <i class="fas fa-palette"></i>
                </div>
                <div>
                    <h3 class="text-sm font-black text-white">Kostumasi Warna & Tema Aplikasi</h3>
                    <p class="text-[11px] text-indigo-200">Pilih dari 16 tema modern (Tema Terang & Dark Mode) sesuai kenyamanan visual Anda</p>
                </div>
            </div>
            <span class="text-xs px-2.5 py-1 rounded-lg bg-white/10 text-indigo-200 font-semibold border border-white/10">16 Pilihan Tema</span>
        </div>

        <div class="p-6">
            <div id="profileThemeCardsGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3.5">
                <!-- Populated dynamically by ThemeManager.js -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function() {
    if (window.ThemeManager) {
        ThemeManager.renderProfileThemeCards('profileThemeCardsGrid');
    }
});

function filterBadges(type) {
    const cards = document.querySelectorAll('.badge-card');
    const btnAll = document.getElementById('filter-all');
    const btnUnlocked = document.getElementById('filter-unlocked');
    const btnLocked = document.getElementById('filter-locked');

    // Reset button styles
    [btnAll, btnUnlocked, btnLocked].forEach(b => {
        if (b) {
            b.className = "px-3 py-1 rounded-lg text-white hover:bg-white/10 transition-all";
        }
    });

    if (type === 'all') {
        if (btnAll) btnAll.className = "px-3 py-1 rounded-lg bg-white text-amber-900 shadow-sm transition-all";
        cards.forEach(c => c.classList.remove('hidden'));
    } else if (type === 'unlocked') {
        if (btnUnlocked) btnUnlocked.className = "px-3 py-1 rounded-lg bg-white text-amber-900 shadow-sm transition-all";
        cards.forEach(c => {
            if (c.classList.contains('badge-unlocked')) c.classList.remove('hidden');
            else c.classList.add('hidden');
        });
    } else if (type === 'locked') {
        if (btnLocked) btnLocked.className = "px-3 py-1 rounded-lg bg-white text-amber-900 shadow-sm transition-all";
        cards.forEach(c => {
            if (c.classList.contains('badge-locked')) c.classList.remove('hidden');
            else c.classList.add('hidden');
        });
    }
}

function updateAvatarPreview(color) {
    const previewEl = document.getElementById('avatar-preview');
    if (previewEl) previewEl.style.background = color;
}
function setColor(color) {
    document.getElementById('color-input').value = color;
    updateAvatarPreview(color);
}

function previewFile(e) {
    const file = e.target.files[0];
    if (file) {
        const reader = new FileReader();
        reader.onload = function(event) {
            const previewImg = document.getElementById('preview-img');
            const placeholder = document.getElementById('preview-placeholder');
            const headerImg = document.getElementById('header-avatar-img');
            const headerAvatar = document.getElementById('avatar-preview');

            previewImg.src = event.target.result;
            previewImg.classList.remove('hidden');
            if (placeholder) placeholder.classList.add('hidden');

            if (headerImg) {
                headerImg.src = event.target.result;
                headerImg.classList.remove('hidden');
                if (headerAvatar) headerAvatar.classList.add('hidden');
            }
        };
        reader.readAsDataURL(file);
    }
}
</script>
}
