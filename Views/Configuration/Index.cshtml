                       placeholder="RESET-CONFIRM" oninput="validateResetCode()"
                       class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono font-bold focus:outline-none focus:ring-2 focus:ring-rose-500">
            </div>

            <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-3">
                <button type="button" onclick="closeResetModal()"
                        class="px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-100 rounded-xl transition-colors cursor-pointer">
                    Batal
                </button>
                <button type="submit" id="btn-execute-reset" disabled
                        class="px-4 py-2 bg-rose-600 hover:bg-rose-700 disabled:opacity-40 disabled:cursor-not-allowed text-white text-xs font-bold rounded-xl shadow-sm transition-all cursor-pointer">
                    <i class="fas fa-trash-alt mr-1"></i>Eksekusi Reset
