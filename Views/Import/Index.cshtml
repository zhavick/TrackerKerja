@model List<TrackerKerja.Models.ImportLog>
@{
    ViewData["Title"] = "Import Task dari Excel";
}

<!-- Alert notifications -->
@if (TempData["Success"] != null)
{
    <div id="success-alert" class="mb-5 p-4 bg-emerald-50 border border-emerald-200 rounded-2xl flex items-center gap-3 animate-pulse">
        <i class="fas fa-check-circle text-emerald-500 text-xl"></i>
        <p class="text-emerald-700 font-semibold">@TempData["Success"]</p>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="mb-5 p-4 bg-red-50 border border-red-200 rounded-2xl flex items-center gap-3">
        <i class="fas fa-times-circle text-red-500 text-xl"></i>
        <p class="text-red-700 font-semibold">@TempData["Error"]</p>
    </div>
}

<div class="grid grid-cols-1 xl:grid-cols-3 gap-5">

    <!-- Upload Section -->
    <div class="xl:col-span-2">

        <!-- Upload Card -->
        <div class="bg-white rounded-2xl shadow-sm border border-indigo-100 overflow-hidden mb-5">
            <div class="bg-gradient-to-r from-indigo-500 to-purple-600 p-5">
                <h3 class="text-white font-bold text-lg flex items-center gap-2">
                    <i class="fas fa-file-excel"></i> Upload File Excel
                </h3>
                <p class="text-indigo-200 text-sm mt-1">Upload file .xlsx atau .xls yang berisi daftar task Anda</p>
            </div>

            <div class="p-6">
                <form method="post" action="/Import/Upload" enctype="multipart/form-data" id="upload-form">
                    @Html.AntiForgeryToken()

                    <!-- Drag & Drop Zone -->
                    <div id="drop-zone"
                         class="border-2 border-dashed border-indigo-300 rounded-2xl p-10 text-center cursor-pointer hover:border-indigo-500 hover:bg-indigo-50/30 transition-all mb-5"
                         onclick="document.getElementById('file-input').click()">
                        <div id="drop-content">
                            <div class="w-16 h-16 rounded-2xl bg-indigo-50 flex items-center justify-center mx-auto mb-4">
                                <i class="fas fa-cloud-upload-alt text-indigo-400 text-3xl"></i>
                            </div>
                            <p class="text-slate-600 font-semibold text-base">Klik atau drag & drop file Excel di sini</p>
                            <p class="text-slate-400 text-sm mt-1">Format: .xlsx atau .xls (Max 10MB)</p>
                        </div>
                        <div id="file-selected" class="hidden">
                            <i class="fas fa-file-excel text-emerald-500 text-4xl mb-3"></i>
                            <p id="file-name" class="text-emerald-700 font-bold text-base"></p>
                            <p id="file-size" class="text-slate-400 text-sm mt-1"></p>
                        </div>
                    </div>

                    <input type="file" id="file-input" name="file" accept=".xlsx,.xls" class="hidden" onchange="fileSelected(event)">

                    <div class="flex gap-2 flex-wrap">
                        <button type="submit" id="btn-upload"
                                class="flex-1 bg-gradient-to-r from-indigo-500 to-purple-600 text-white font-bold py-3 px-4 rounded-xl hover:shadow-lg transition-all disabled:opacity-50 text-xs"
                                disabled>
                            <i class="fas fa-upload mr-2"></i>Upload & Preview File
                        </button>
                        <a href="/Import/Template"
                           class="flex items-center gap-1.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-4 py-3 rounded-xl shadow-sm transition-all text-xs"
                           title="Download Template Format Tracker (21 Kolom Standar)">
                            <i class="fas fa-file-excel"></i>
                            <span>Download Template Excel (21 Kolom)</span>
                        </a>
                        <a href="/Task/ExportArmsExcel"
                           class="flex items-center gap-1.5 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold px-4 py-3 rounded-xl border border-slate-300 transition-colors text-xs"
                           title="Export Semua Task ke Format Tracker 21 Kolom">
                            <i class="fas fa-file-export text-slate-700"></i>
                            <span>Export Data ke Excel</span>
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Format Guide -->
        <div class="bg-white rounded-2xl shadow-sm border border-indigo-100 p-5">
            <div class="flex items-center justify-between mb-4">
                <h4 class="font-bold text-slate-800 flex items-center gap-2">
                    <i class="fas fa-table-list text-indigo-600"></i>
                    Spesifikasi Format Kolom Excel (Proposed 21 Kolom)
                </h4>
                <span class="text-xs bg-indigo-50 text-indigo-700 font-bold px-2.5 py-1 rounded-full border border-indigo-100">Standar 21 Kolom</span>
            </div>
            <div class="overflow-x-auto max-h-96">
                <table class="w-full text-xs">
                    <thead>
                        <tr class="border-b border-slate-100 bg-slate-50 sticky top-0">
                            <th class="text-left font-bold text-slate-600 px-3 py-2">#</th>
                            <th class="text-left font-bold text-slate-600 px-3 py-2">Nama Kolom (Header)</th>
                            <th class="text-left font-bold text-slate-600 px-3 py-2">Keterangan / Nilai</th>
                            <th class="text-center font-bold text-slate-600 px-3 py-2">Wajib</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        @{
                            var cols = new[]
                            {
                                (1, "project_name", "Nama proyek (dibuat otomatis jika baru)", false),
                                (2, "requirement_code", "Kode requirement / BRD / TSD", false),
                                (3, "title", "Judul tugas / task", true),
                                (4, "status", "TODO / IN_PROGRESS / DONE / TESTING", false),
                                (5, "priority", "LOW / MEDIUM / HIGH / CRITICAL", false),
                                (6, "jenis_task", "Kategori (NEW_APP, ENHANCEMENT, BUGFIX, dll)", false),
                                (7, "module_name", "Nama modul / milestone (TCES, TICS, Auth, dll)", false),
                                (8, "bug_type", "Tipe isu / bug (Feature, Bug, Task, Enhancement)", false),
                                (9, "progress", "0 s/d 100 (Done otomatis diset 100%)", false),
                                (10, "start_date", "Tanggal mulai (YYYY-MM-DD atau Excel date)", false),
                                (11, "due_date", "Tenggat waktu (deadline)", false),
                                (12, "completed_date", "Tanggal selesai aktual", false),
                                (13, "developer_emails", "Email PIC Dev (bisa dipisah ';' jika banyak)", false),
                                (14, "ba_emails", "Email Business Analyst", false),
                                (15, "infra_emails", "Email Tim DevOps / IT Infra", false),
                                (16, "master_data_emails", "Email Tim Master Data", false),
                                (17, "tester_emails", "Email Tim QA / Tester", false),
                                (18, "tw_emails", "Email Tim Technical Writer", false),
                                (19, "kendala", "Catatan blocker / kendala pengerjaan", false),
                                (20, "solusi", "Solusi teknis / rencana perbaikan", false),
                                (21, "Notes Tracker", "Catatan tambahan / deskripsi tugas", false)
                            };
                            foreach (var (idx, name, format, required) in cols)
                            {
                                <tr class="hover:bg-indigo-50/20">
                                    <td class="px-3 py-2 font-mono text-slate-400">@idx</td>
                                    <td class="px-3 py-2 font-mono font-semibold text-indigo-700">@name</td>
                                    <td class="px-3 py-2 text-slate-600">@format</td>
                                    <td class="px-3 py-2 text-center">
                                        @if (required) { <span class="text-rose-600 font-bold">✓</span> }
                                        else { <span class="text-slate-300">—</span> }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Import History -->
    <div class="bg-white rounded-2xl shadow-sm border border-indigo-100 overflow-hidden">
        <div class="p-5 border-b border-slate-100">
            <h3 class="font-bold text-slate-800 flex items-center gap-2">
                <i class="fas fa-history text-indigo-400"></i> Riwayat Import
            </h3>
        </div>

        @if (!Model.Any())
        {
            <div class="p-10 text-center text-slate-400">
                <i class="fas fa-clock text-4xl text-slate-200 mb-3 block"></i>
                <p class="text-sm">Belum ada riwayat import</p>
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-50">
                @foreach (var log in Model)
                {
                    <div class="p-4">
                        <p class="text-sm font-semibold text-slate-700 truncate" title="@log.FileName">@log.FileName</p>
                        <div class="flex items-center gap-3 mt-2">
                            <span class="text-xs text-emerald-600 font-semibold bg-emerald-50 px-2 py-0.5 rounded-full">✓ @log.SuccessRows</span>
                            @if (log.FailedRows > 0)
                            {
                                <span class="text-xs text-red-600 font-semibold bg-red-50 px-2 py-0.5 rounded-full">✗ @log.FailedRows</span>
                            }
                            <span class="text-xs text-slate-400">@log.TotalRows baris</span>
                        </div>
                        <p class="text-xs text-slate-400 mt-1">@log.ImportedAt.ToString("dd MMM yyyy HH:mm") @(log.ImportedBy != null ? $"• {log.ImportedBy}" : "")</p>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
const dropZone = document.getElementById('drop-zone');
const fileInput = document.getElementById('file-input');
const btnUpload = document.getElementById('btn-upload');

function fileSelected(e) {
    const file = e.target.files[0];
    if (!file) return;
    document.getElementById('drop-content').classList.add('hidden');
    document.getElementById('file-selected').classList.remove('hidden');
    document.getElementById('file-name').textContent = file.name;
    document.getElementById('file-size').textContent = (file.size / 1024).toFixed(1) + ' KB';
    btnUpload.disabled = false;
    dropZone.classList.add('border-emerald-400', 'bg-emerald-50/30');
    dropZone.classList.remove('border-indigo-300');
}

dropZone.addEventListener('dragover', e => {
    e.preventDefault();
    dropZone.classList.add('border-indigo-500', 'bg-indigo-50/30');
});
dropZone.addEventListener('dragleave', () => {
    dropZone.classList.remove('border-indigo-500', 'bg-indigo-50/30');
});
dropZone.addEventListener('drop', e => {
    e.preventDefault();
    const dt = new DataTransfer();
    dt.items.add(e.dataTransfer.files[0]);
    fileInput.files = dt.files;
    fileInput.dispatchEvent(new Event('change'));
});

// Auto-hide success alert
setTimeout(() => {
    const alert = document.getElementById('success-alert');
    if (alert) alert.style.opacity = '0', alert.style.transition = '1s', setTimeout(() => alert.remove(), 1000);
}, 4000);
</script>
}
