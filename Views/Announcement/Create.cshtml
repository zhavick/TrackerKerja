@model TrackerKerja.ViewModels.AnnouncementFormViewModel
@{
    ViewData["Title"] = "Tambah Pengumuman Baru";
}

<div class="space-y-6 max-w-5xl mx-auto animate-fade-in">

    <!-- Header -->
    <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <a href="/Announcement" class="w-10 h-10 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:text-slate-900 flex items-center justify-center transition-colors shadow-2xs">
                <i class="fas fa-arrow-left text-sm"></i>
            </a>
            <div>
                <h1 class="text-2xl font-black text-slate-800 dark:text-white">Tambah Pengumuman Baru</h1>
                <p class="text-slate-500 dark:text-slate-400 text-xs mt-0.5">Buat pemberitahuan yang akan muncul sebagai modal popup saat user membuka sistem</p>
            </div>
        </div>

        <a href="/Announcement" class="text-xs font-bold text-slate-500 hover:text-slate-800 transition-colors">
            Batal
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        <div class="p-4 rounded-2xl bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800 text-red-800 dark:text-red-200 text-xs font-semibold space-y-1">
            <div class="flex items-center gap-2 font-bold mb-1">
                <i class="fas fa-exclamation-circle text-red-600"></i>
                <span>Terdapat kesalahan pada formulir:</span>
            </div>
            @Html.ValidationSummary(false, "", new { @class = "list-disc list-inside text-red-700 dark:text-red-300" })
        </div>
    }

    <form method="post" action="/Announcement/Create" class="space-y-6">
        @Html.AntiForgeryToken()

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            <!-- Left 2 Cols: Form Inputs -->
            <div class="lg:col-span-2 space-y-5 bg-white dark:bg-slate-800 rounded-3xl p-6 sm:p-8 border border-slate-200/80 dark:border-slate-700 shadow-2xs">
                
                <!-- Judul Pengumuman -->
                <div>
                    <label asp-for="Title" class="block text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-200 mb-1.5">
                        Judul Pengumuman <span class="text-rose-500">*</span>
                    </label>
                    <input asp-for="Title" id="inputTitle" oninput="updateLivePreview()" placeholder="Contoh: Pemeliharaan Server Terjadwal / Kebijakan Jam Kerja Baru"
                           class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-xs sm:text-sm text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-rose-500 transition-all font-semibold" required />
                    <span asp-validation-for="Title" class="text-[11px] text-red-500 mt-1 block"></span>
                </div>

                <!-- Status Pengumuman (Informasi Penting / Pengumuman Umum) -->
                <div>
                    <label class="block text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-200 mb-2">
                        Status Pengumuman <span class="text-rose-500">*</span>
                    </label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <!-- Option 1: Informasi Penting -->
                        <label class="relative flex items-start gap-3 p-3.5 rounded-2xl border-2 cursor-pointer transition-all hover:bg-slate-50 dark:hover:bg-slate-700/30"
                               id="labelStatusImportant">
                            <input type="radio" asp-for="Status" value="Informasi Penting" id="radioStatusImportant" onchange="updateLivePreview()" class="mt-1 text-rose-600 focus:ring-rose-500" />
                            <div>
                                <div class="flex items-center gap-1.5 text-xs font-black text-rose-600">
                                    <i class="fas fa-exclamation-triangle"></i>
                                    <span>Informasi Penting</span>
                                </div>
                                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Tampilan peringatan mendesak berwarna merah/oranye dengan badge darurat.</p>
                            </div>
                        </label>

                        <!-- Option 2: Pengumuman Umum -->
                        <label class="relative flex items-start gap-3 p-3.5 rounded-2xl border-2 cursor-pointer transition-all hover:bg-slate-50 dark:hover:bg-slate-700/30"
                               id="labelStatusGeneral">
                            <input type="radio" asp-for="Status" value="Pengumuman Umum" id="radioStatusGeneral" onchange="updateLivePreview()" class="mt-1 text-indigo-600 focus:ring-indigo-500" />
                            <div>
                                <div class="flex items-center gap-1.5 text-xs font-black text-indigo-600">
                                    <i class="fas fa-bullhorn"></i>
                                    <span>Pengumuman Umum</span>
                                </div>
                                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Pemberitahuan informasi kerja standar, agenda, atau kabar terbaru tim.</p>
                            </div>
                        </label>
                    </div>
                    <span asp-validation-for="Status" class="text-[11px] text-red-500 mt-1 block"></span>
                </div>

                <!-- Date Range (Tanggal Pemberitahuan & Tanggal Berakhir) -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="AnnouncementDate" class="block text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-200 mb-1.5">
                            Tanggal Pemberitahuan / Pengumuman <span class="text-rose-500">*</span>
                        </label>
                        <input asp-for="AnnouncementDate" type="date" id="inputStartDate" oninput="updateLivePreview()"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-xs sm:text-sm text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-rose-500 transition-all font-semibold" required />
                        <span asp-validation-for="AnnouncementDate" class="text-[11px] text-red-500 mt-1 block"></span>
                        <p class="text-[10px] text-slate-400 mt-1">Tanggal mulai tayang ke pengguna</p>
                    </div>

                    <div>
                        <label asp-for="EndDate" class="block text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-200 mb-1.5">
                            Tanggal Berakhir <span class="text-rose-500">*</span>
                        </label>
                        <input asp-for="EndDate" type="date" id="inputEndDate" oninput="updateLivePreview()"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-xs sm:text-sm text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-rose-500 transition-all font-semibold" required />
                        <span asp-validation-for="EndDate" class="text-[11px] text-red-500 mt-1 block"></span>
                        <p class="text-[10px] text-slate-400 mt-1">Pengumuman otomatis berhenti setelah tanggal ini</p>
                    </div>
                </div>

                <!-- Isi Pengumuman -->
                <div>
                    <label asp-for="Content" class="block text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-200 mb-1.5">
                        Isi Pengumuman <span class="text-rose-500">*</span>
                    </label>
                    <textarea asp-for="Content" rows="6" id="inputContent" oninput="updateLivePreview()"
                              placeholder="Tuliskan pesan lengkap pengumuman di sini..."
                              class="w-full px-4 py-3 rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-xs sm:text-sm text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-rose-500 transition-all leading-relaxed" required></textarea>
                    <span asp-validation-for="Content" class="text-[11px] text-red-500 mt-1 block"></span>
                    <p class="text-[10px] text-slate-400 mt-1">Dapat memuat beberapa paragraf atau instruksi kerja.</p>
                </div>

                <!-- Status Aktif Toggle -->
                <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-700 flex items-center justify-between">
                    <div>
                        <strong class="text-xs font-bold text-slate-800 dark:text-white block">Aktifkan Pengumuman</strong>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400">Jika aktif dan masih dalam periode tanggal, modal popup akan otomatis ditampilkan kepada pengguna.</p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" asp-for="IsActive" class="sr-only peer" />
                        <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-rose-600"></div>
                    </label>
                </div>

                <!-- Action Submit -->
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100 dark:border-slate-700">
                    <a href="/Announcement" class="px-5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 text-xs font-bold transition-all">
                        Batal
                    </a>
                    <button type="submit" class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-rose-600 to-pink-600 hover:from-rose-700 hover:to-pink-700 text-white text-xs font-bold shadow-md shadow-rose-500/25 transition-all flex items-center gap-2 cursor-pointer">
                        <i class="fas fa-paper-plane"></i>
                        <span>Publikasikan Pengumuman</span>
                    </button>
                </div>

            </div>

            <!-- Right 1 Col: Live Simulation Card -->
            <div class="space-y-4">
                <div class="sticky top-6">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-black uppercase tracking-wider text-slate-500">Pratinjau Modal Popup</span>
                        <span class="text-[10px] px-2 py-0.5 rounded-full bg-rose-100 text-rose-700 font-bold">Realtime</span>
                    </div>

                    <!-- Simulated Popup Window -->
                    <div class="bg-white dark:bg-slate-800 rounded-3xl shadow-xl border border-slate-200 dark:border-slate-700 overflow-hidden">
                        
                        <!-- Header Preview -->
                        <div id="simHeader" class="px-5 py-4 bg-gradient-to-r from-rose-600 via-pink-600 to-purple-600 text-white relative">
                            <div class="flex items-center gap-3">
                                <div id="simIconWrap" class="w-9 h-9 rounded-xl bg-white/20 backdrop-blur-md flex items-center justify-center text-white text-base flex-shrink-0">
                                    <i id="simIcon" class="fas fa-bullhorn"></i>
                                </div>
                                <div class="min-w-0">
                                    <span id="simBadge" class="text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full bg-white/20 text-white">
                                        PENGUMUMAN UMUM
                                    </span>
                                    <h3 id="simTitle" class="font-black text-sm truncate mt-1">Judul Pengumuman</h3>
                                </div>
                            </div>
                        </div>

                        <!-- Body Preview -->
                        <div class="p-5 space-y-3 bg-slate-50/50 dark:bg-slate-900/50">
                            <div class="flex items-center justify-between text-[11px] text-slate-400 border-b border-slate-100 dark:border-slate-700 pb-2">
                                <span><i class="fas fa-calendar-alt mr-1"></i><span id="simDates">Hari ini s/d 7 hari</span></span>
                                <span class="font-bold text-rose-600">Pop-up User</span>
                            </div>
                            <div id="simContent" class="text-xs text-slate-700 dark:text-slate-300 whitespace-pre-line leading-relaxed min-h-[80px]">
                                Isi pengumuman akan ditampilkan di sini secara otomatis sesuai teks yang Anda ketikkan pada formulir di sebelah kiri.
                            </div>
                        </div>

                        <!-- Footer Preview -->
                        <div class="p-4 bg-white dark:bg-slate-800 border-t border-slate-100 dark:border-slate-700 flex items-center justify-between">
                            <label class="flex items-center gap-1.5 text-[10px] text-slate-400 select-none">
                                <input type="checkbox" disabled class="rounded text-rose-600 w-3 h-3">
                                <span>Jangan tampilkan lagi</span>
                            </label>
                            <button type="button" class="px-3.5 py-1.5 rounded-xl bg-rose-600 text-white text-[11px] font-bold shadow-xs">
                                Tutup & Mengerti
                            </button>
                        </div>
                    </div>

                    <div class="mt-3 p-3.5 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/60 text-amber-800 dark:text-amber-200 text-[11px] leading-relaxed">
                        <i class="fas fa-info-circle mr-1"></i>
                        <strong>Catatan Logika Tampilan:</strong> Popup pengumuman ini secara otomatis mematuhi aturan urutan: jika user sedang membuka atau belum menutup panduan (guide / tour), popup ini akan menanti sampai panduan ditutup terlebih dahulu.
                    </div>
                </div>
            </div>

        </div>
    </form>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
    function updateLivePreview() {
        const title = document.getElementById('inputTitle').value || 'Judul Pengumuman';
        const content = document.getElementById('inputContent').value || 'Isi pengumuman akan ditampilkan di sini secara otomatis sesuai teks yang Anda ketikkan pada formulir di sebelah kiri.';
        const startDate = document.getElementById('inputStartDate').value;
        const endDate = document.getElementById('inputEndDate').value;
        const isImportant = document.getElementById('radioStatusImportant').checked;

        // Elements
        const simTitle = document.getElementById('simTitle');
        const simContent = document.getElementById('simContent');
        const simDates = document.getElementById('simDates');
        const simHeader = document.getElementById('simHeader');
        const simIcon = document.getElementById('simIcon');
        const simBadge = document.getElementById('simBadge');
        const labelImportant = document.getElementById('labelStatusImportant');
        const labelGeneral = document.getElementById('labelStatusGeneral');

        simTitle.textContent = title;
        simContent.textContent = content;

        if (startDate && endDate) {
            simDates.textContent = `${startDate} s/d ${endDate}`;
        }

        if (isImportant) {
            simHeader.className = 'px-5 py-4 bg-gradient-to-r from-red-600 via-rose-600 to-amber-600 text-white relative';
            simIcon.className = 'fas fa-exclamation-triangle';
            simBadge.textContent = '🚨 INFORMASI PENTING';
            simBadge.className = 'text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full bg-white/30 text-white';
            
            labelImportant.classList.add('border-rose-500', 'bg-rose-50/50');
            labelGeneral.classList.remove('border-indigo-500', 'bg-indigo-50/50');
        } else {
            simHeader.className = 'px-5 py-4 bg-gradient-to-r from-indigo-600 via-purple-600 to-violet-700 text-white relative';
            simIcon.className = 'fas fa-bullhorn';
            simBadge.textContent = '📢 PENGUMUMAN UMUM';
            simBadge.className = 'text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full bg-white/20 text-white';
            
            labelGeneral.classList.add('border-indigo-500', 'bg-indigo-50/50');
            labelImportant.classList.remove('border-rose-500', 'bg-rose-50/50');
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        updateLivePreview();
    });
</script>
}
