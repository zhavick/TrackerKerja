@{
    ViewData["Title"] = "Konfigurasi Sistem, Database & Sinkronisasi Host";
    var baseUrl = ViewBag.GlobalBaseUrl as string ?? "http://localhost:5000";
    var currentAppFont = ViewBag.GlobalAppFont as string ?? "inter";
    var tableStats = ViewBag.TableStats as Dictionary<string, int> ?? new Dictionary<string, int>();
    var syncSettings = ViewBag.SyncSettings as TrackerKerja.ViewModels.SyncSettingsDto ?? new TrackerKerja.ViewModels.SyncSettingsDto();
    var hostSyncTargetUrl = ViewBag.HostSyncTargetUrl as string ?? "http://localhost:5000";
    var hostSyncApiKey = ViewBag.HostSyncApiKey as string ?? "TK-SYNC-SECRET-KEY-2026";
    var hostSyncRole = ViewBag.HostSyncRole as string ?? "child";
    var lastSyncAt = ViewBag.LastSyncAt as DateTime?;
    var lastSyncStatus = ViewBag.LastSyncStatus as string;
}

<!-- Page Header -->
<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
    <div>
        <div class="flex items-center gap-2.5">
            <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-indigo-500 via-purple-600 to-pink-600 flex items-center justify-center text-white shadow-md">
                <i class="fas fa-network-wired text-sm"></i>
            </div>
            <div>
                <h1 class="text-2xl font-black text-slate-800 tracking-tight">Konfigurasi Sistem &amp; Sinkronisasi Host</h1>
                <p class="text-xs text-slate-500 font-medium">Pengaturan Sinkronisasi Host Induk (Local Server &amp; Cloud), Global Base URL, dan Pemeliharaan Database</p>
            </div>
        </div>
    </div>
    <div class="flex items-center gap-2.5 flex-wrap">
        <a href="/Configuration/ExportSyncSql"
           class="flex items-center gap-2 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white text-xs font-bold px-3.5 py-2.5 rounded-2xl shadow-sm transition-all"
           title="Unduh Naskah SQL Sinkronisasi untuk Host Induk (.sql)">
            <i class="fas fa-file-export"></i>
            <span>Export SQL Sync</span>
        </a>
        <a href="/Configuration/ExportDatabaseFile"
           class="flex items-center gap-2 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-bold px-3.5 py-2.5 rounded-2xl border border-emerald-200 shadow-xs transition-all"
           title="Unduh Snapshot File SQLite (.db)">
            <i class="fas fa-database text-emerald-600"></i>
            <span>Export .db</span>
        </a>
        <a href="/swagger" target="_blank"
           class="flex items-center gap-2 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-bold px-3.5 py-2.5 rounded-2xl border border-indigo-200 shadow-xs transition-all"
           title="Buka Swagger API Documentation">
            <i class="fas fa-code text-indigo-500"></i>
            <span>Swagger API</span>
        </a>
        <a href="/AuditTrail"
           class="flex items-center gap-2 bg-amber-50 hover:bg-amber-100 text-amber-700 text-xs font-bold px-3.5 py-2.5 rounded-2xl border border-amber-200 shadow-xs transition-all"
           title="Lihat Log Audit Trail">
            <i class="fas fa-shield-alt text-amber-500"></i>
            <span>Audit Trail</span>
        </a>
    </div>
</div>

<!-- Alerts for Success & Error TempData -->
@if (TempData["Success"] != null)
{
    <div class="p-4 mb-6 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-start gap-3 shadow-xs animate-slideIn">
        <i class="fas fa-check-circle text-emerald-500 text-lg mt-0.5"></i>
        <div class="flex-1">
            <h4 class="font-bold text-xs">Operasi Berhasil</h4>
            <p class="text-xs mt-0.5">@TempData["Success"]</p>
        </div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="p-4 mb-6 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 flex items-start gap-3 shadow-xs animate-slideIn">
        <i class="fas fa-exclamation-triangle text-rose-500 text-lg mt-0.5"></i>
        <div class="flex-1">
            <h4 class="font-bold text-xs">Terjadi Kesalahan</h4>
            <p class="text-xs mt-0.5">@TempData["Error"]</p>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- 1. FEATURED SECTION: SINKRONISASI MULTI-INSTANCE & HOST INDUK -->
<!-- ========================================================================= -->
<div class="bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 rounded-3xl p-6 sm:p-7 text-white shadow-xl border border-indigo-500/20 mb-8 relative overflow-hidden">
    <!-- Decorative background elements -->
    <div class="absolute -right-16 -bottom-16 w-64 h-64 rounded-full bg-indigo-500/10 blur-3xl pointer-events-none"></div>
    <div class="absolute -left-16 -top-16 w-64 h-64 rounded-full bg-cyan-500/10 blur-3xl pointer-events-none"></div>

    <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4 pb-5 border-b border-slate-700/60 relative z-10">
        <div class="flex items-center gap-3.5">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-cyan-500 to-indigo-600 flex items-center justify-center text-xl text-white shadow-lg shadow-cyan-500/20">
                <i class="fas fa-sync-alt animate-spin-slow"></i>
            </div>
            <div>
                <div class="flex items-center gap-2.5">
                    <h2 class="text-lg font-black tracking-tight text-white">Sinkronisasi Host Induk &amp; Cabang</h2>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-indigo-500/30 text-indigo-200 border border-indigo-400/30">
                        <i class="fas fa-cloud text-[9px] text-cyan-400"></i> Multi-Location Ready
                    </span>
                </div>
                <p class="text-xs text-slate-300 mt-0.5">
                    Sinkronisasi data terpusat antara aplikasi berjalan (Child / <code class="text-cyan-300 font-mono bg-indigo-900/60 px-1 py-0.2 rounded">https://tracker.saidilmuna.space/</code>) dan Host Induk Server Lokal
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <button type="button" onclick="testHostIndukConnection()" id="btn-ping-host"
                    class="flex items-center gap-2 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 px-3.5 py-2 rounded-xl text-xs font-bold transition-all shadow-xs cursor-pointer">
                <i class="fas fa-plug text-cyan-400" id="ping-icon"></i>
                <span id="ping-text">Test Koneksi Host</span>
            </button>
            <span id="ping-status-badge" class="hidden text-xs font-bold px-3 py-1.5 rounded-xl"></span>
        </div>
    </div>

    <!-- Sync Mode Tabs -->
    <div class="mt-5">
        <div class="flex items-center gap-2 p-1 bg-slate-800/80 rounded-2xl max-w-fit border border-slate-700/60 mb-5">
            <button type="button" onclick="switchSyncTab('tab-online')" id="tab-btn-online"
                    class="flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold transition-all bg-indigo-600 text-white shadow-md cursor-pointer">
                <i class="fas fa-bolt text-amber-300"></i>
                <span>1. Mode Online API (Push / Pull)</span>
            </button>
            <button type="button" onclick="switchSyncTab('tab-manual-export')" id="tab-btn-manual-export"
                    class="flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold transition-all text-slate-400 hover:text-white cursor-pointer">
                <i class="fas fa-file-archive text-cyan-400"></i>
                <span>2. Ekspor Paket Lengkap (.zip / .sql)</span>
            </button>
            <button type="button" onclick="switchSyncTab('tab-host-receiver')" id="tab-btn-host-receiver"
                    class="flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold transition-all text-slate-400 hover:text-white cursor-pointer">
                <i class="fas fa-server text-emerald-400"></i>
                <span>3. Host Induk (Impor Paket &amp; Bersihkan)</span>
            </button>
        </div>

        <!-- TAB 1: ONLINE API SYNC (SUBMIT KE HOST INDUK / TARIK DARI HOST) -->
        <div id="tab-online" class="space-y-5">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
                <!-- Host Settings Form (Left: 7 Cols) -->
                <div class="lg:col-span-7 bg-slate-800/50 rounded-2xl p-5 border border-slate-700/60 space-y-4">
                    <form method="post" asp-action="UpdateSyncSettings" asp-controller="Configuration" id="form-sync-settings" class="space-y-4">
                        @Html.AntiForgeryToken()

                        <div class="flex items-center justify-between">
                            <h3 class="text-xs font-bold text-slate-200 uppercase tracking-wider flex items-center gap-2">
                                <i class="fas fa-cogs text-indigo-400"></i> Konfigurasi Target Host Induk &amp; Keamanan
                            </h3>
                            <span class="text-[11px] text-slate-400">Role: <span class="text-cyan-300 font-bold uppercase">@hostSyncRole</span></span>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-300 mb-1">
                                Target Host Induk URL (Alamat Server Lokal / Endpoint Induk)
                            </label>
                            <div class="relative">
                                <i class="fas fa-network-wired absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                <input type="url" id="syncHostUrlInput" name="TargetHostUrl" value="@hostSyncTargetUrl" required
                                       placeholder="http://192.168.1.100:5000 atau https://host-induk-anda.com"
                                       class="w-full pl-9 pr-3 py-2.5 bg-slate-900/90 border border-slate-700 rounded-xl text-xs font-mono text-white focus:outline-none focus:ring-2 focus:ring-cyan-400">
                            </div>
                            <p class="text-[11px] text-slate-400 mt-1">
                                Alamat server Host Induk yang menjalankan REST API penerima sinkronisasi (<code class="text-cyan-400">/api/sync/receive</code>).
                            </p>
                        </div>

                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <label class="block text-xs font-bold text-slate-300">
                                    Secret API Key Sinkronisasi (Shared Token)
                                </label>
                                <div class="flex items-center gap-2">
                                    <button type="button" onclick="generateRandomApiKey()" class="text-[11px] text-cyan-400 hover:text-cyan-300 font-semibold cursor-pointer">
                                        <i class="fas fa-dice mr-1"></i>Acak Kunci
                                    </button>
                                    <button type="button" onclick="copyApiKey()" class="text-[11px] text-slate-400 hover:text-white font-semibold cursor-pointer">
                                        <i class="fas fa-copy mr-1"></i>Salin
                                    </button>
                                </div>
                            </div>
                            <div class="relative">
                                <i class="fas fa-key absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                <input type="password" id="syncApiKeyInput" name="ApiKey" value="@hostSyncApiKey" required
                                       placeholder="TK-SYNC-SECRET-KEY-..."
                                       class="w-full pl-9 pr-10 py-2.5 bg-slate-900/90 border border-slate-700 rounded-xl text-xs font-mono text-white focus:outline-none focus:ring-2 focus:ring-cyan-400">
                                <button type="button" onclick="toggleApiKeyVisibility()" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white text-xs cursor-pointer">
                                    <i class="fas fa-eye" id="toggle-key-icon"></i>
                                </button>
                            </div>
                            <p class="text-[11px] text-slate-400 mt-1">
                                Token rahasia ini harus <strong>sama persis</strong> antara child aplikasi dan Host Induk sebagai otorisasi keamanan.
                            </p>
                        </div>

                        <div class="flex items-center justify-between pt-2 border-t border-slate-700/60">
                            <input type="hidden" name="Role" value="@hostSyncRole" id="syncRoleInput" />
                            <div class="text-[11px] text-slate-400">
                                @if (lastSyncAt.HasValue)
                                {
                                    <span>Sync Terakhir: <strong class="text-cyan-300">@lastSyncAt.Value.ToString("dd MMM yyyy HH:mm:ss")</strong></span>
                                }
                                else
                                {
                                    <span>Belum pernah melakukan sinkronisasi API</span>
                                }
                            </div>
                            <button type="submit" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-xl text-xs font-bold transition-all shadow-xs cursor-pointer">
                                <i class="fas fa-save mr-1.5 text-indigo-400"></i>Simpan Konfigurasi
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Submit / Push / Pull Action Card (Right: 5 Cols) -->
                <div class="lg:col-span-5 bg-gradient-to-br from-indigo-900/70 to-purple-900/70 rounded-2xl p-5 border border-indigo-500/30 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between pb-3 border-b border-indigo-500/30 mb-3">
                            <span class="text-xs font-black uppercase tracking-wider text-indigo-200 flex items-center gap-1.5">
                                <i class="fas fa-sync-alt text-cyan-400 animate-spin-slow"></i> Eksekusi Sinkronisasi Online
                            </span>
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                        </div>
                        <p class="text-xs text-slate-200 leading-relaxed mb-4">
                            Kirim atau tarik seluruh rekaman tugas, sesi timesheet, proyek, kategori, catatan, dan <strong>berkas lampiran upload (avatar &amp; file catatan)</strong> melalui API aman terenkripsi.
                        </p>

                        <div class="space-y-2.5 mb-4 bg-slate-900/60 rounded-xl p-3 border border-slate-800 text-xs">
                            <label class="flex items-center gap-2 cursor-pointer select-none">
                                <input type="checkbox" id="pushCleanBeforeSync" checked class="rounded text-indigo-500 focus:ring-indigo-400">
                                <span class="text-slate-200 font-medium text-[11px]">Bersihkan data lama di target (Clean Slate)</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer select-none">
                                <input type="checkbox" id="pushBackupBeforeSync" checked class="rounded text-indigo-500 focus:ring-indigo-400">
                                <span class="text-slate-200 font-medium text-[11px]">Buat backup snapshot di target sebelum proses</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer select-none">
                                <input type="checkbox" id="pushSyncFiles" checked class="rounded text-emerald-400 focus:ring-emerald-400">
                                <span class="text-emerald-300 font-bold text-[11px]">
                                    <i class="fas fa-paperclip mr-1"></i>Sertakan Berkas Upload &amp; Lampiran Catatan
                                </span>
                            </label>
                        </div>
                    </div>

                    <div class="space-y-2">
                        @if (!string.IsNullOrEmpty(lastSyncStatus))
                        {
                            <div class="p-2.5 bg-slate-900/80 rounded-xl border border-slate-800 text-[11px] text-slate-300 mb-2 flex items-start gap-2">
                                <i class="fas fa-info-circle text-cyan-400 mt-0.5"></i>
                                <div class="truncate">@lastSyncStatus</div>
                            </div>
                        }

                        <button type="button" onclick="executeOnlinePushSync()" id="btn-push-sync"
                                class="w-full flex items-center justify-center gap-2.5 bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 text-white text-xs font-extrabold py-3 px-4 rounded-xl shadow-lg shadow-indigo-600/30 transition-all cursor-pointer">
                            <i class="fas fa-cloud-upload-alt text-base"></i>
                            <span>Kirim &amp; Sinkronkan ke Host Induk (Push)</span>
                        </button>

                        <button type="button" onclick="executeOnlinePullSync()" id="btn-pull-sync"
                                class="w-full flex items-center justify-center gap-2 bg-slate-800/90 hover:bg-slate-700 text-slate-200 border border-slate-600 text-xs font-bold py-2.5 px-4 rounded-xl transition-all cursor-pointer">
                            <i class="fas fa-cloud-download-alt text-cyan-400"></i>
                            <span>Tarik Data &amp; Berkas dari Host Induk (Pull)</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: EKSPOR MANUAL PAKET (OFFLINE FALLBACK DENGAN BERKAS) -->
        <div id="tab-manual-export" class="hidden space-y-4">
            <div class="bg-slate-800/50 rounded-2xl p-5 border border-slate-700/60">
                <div class="flex items-start justify-between gap-4 mb-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-cyan-500/20 text-cyan-400 flex items-center justify-center text-lg">
                            <i class="fas fa-archive"></i>
                        </div>
                        <div>
                            <h3 class="text-sm font-bold text-white">Ekspor Paket Sinkronisasi Lengkap (.zip / .sql)</h3>
                            <p class="text-xs text-slate-400">Unduh seluruh database berserta berkas lampiran catatan &amp; foto avatar untuk dipindahkan secara offline</p>
                        </div>
                    </div>
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">
                        Offline Fallback
                    </span>
                </div>

                <p class="text-xs text-slate-300 leading-relaxed mb-5 max-w-3xl">
                    Jika server lokal Host Induk berada di balik router/firewall kantor tanpa IP Publik atau koneksi langsung, unduh <strong>Paket Lengkap (.zip)</strong> dari instance online ini (<code class="text-cyan-300 font-mono">tracker.saidilmuna.space</code>), lalu buka menu <strong>"Host Induk (Impor Paket &amp; Bersihkan)"</strong> di server lokal Anda untuk mengunggah paket ini. Seluruh data transaksi dan file fisik lampiran akan otomatis terpasang.
                </p>

                <div class="space-y-4">
                    <!-- Option 1: Full Zip Package (Recommended) -->
                    <div class="p-4 bg-slate-900/70 rounded-2xl border border-indigo-500/30">
                        <div class="flex items-center justify-between mb-2">
                            <div class="flex items-center gap-2">
                                <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 text-[10px] font-bold uppercase">Direkomendasikan</span>
                                <span class="text-xs font-bold text-white">1. Paket Lengkap Sinkronisasi (.zip - Database + Berkas Uploads)</span>
                            </div>
                            <span class="text-[11px] text-slate-400">Termasuk Lampiran Catatan &amp; Avatar</span>
                        </div>
                        <p class="text-[11px] text-slate-400 mb-3">
                            Mengemas naskah SQL SQLite serta seluruh berkas pada folder <code class="text-cyan-400">wwwroot/uploads</code> ke dalam satu arsip terkompresi.
                        </p>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-xl">
                            <a href="/Configuration/ExportSyncPackage?cleanBeforeSync=true"
                               class="flex items-center justify-center gap-2 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white text-xs font-bold py-2.5 px-4 rounded-xl shadow-md transition-all cursor-pointer">
                                <i class="fas fa-file-archive"></i>
                                <span>Unduh Paket .zip (Clean Slate)</span>
                            </a>
                            <a href="/Configuration/ExportSyncPackage?cleanBeforeSync=false"
                               class="flex items-center justify-center gap-2 bg-slate-700 hover:bg-slate-600 text-slate-200 border border-slate-600 text-xs font-bold py-2.5 px-4 rounded-xl transition-all cursor-pointer">
                                <i class="fas fa-copy"></i>
                                <span>Unduh Paket .zip (Merge)</span>
                            </a>
                        </div>
                    </div>

                    <!-- Option 2: SQL Only -->
                    <div class="p-4 bg-slate-900/40 rounded-2xl border border-slate-800">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-bold text-slate-300">2. Naskah SQL Saja (.sql - Hanya Data Database)</span>
                            <span class="text-[11px] text-slate-500">Tanpa Berkas Fisik</span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-xl">
                            <a href="/Configuration/ExportSyncSql?cleanBeforeSync=true"
                               class="flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 text-xs font-bold py-2 px-3 rounded-xl transition-all cursor-pointer">
                                <i class="fas fa-file-code text-cyan-400"></i>
                                <span>Unduh SQL Saja (Clean Slate)</span>
                            </a>
                            <a href="/Configuration/ExportSyncSql?cleanBeforeSync=false"
                               class="flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 text-xs font-bold py-2 px-3 rounded-xl transition-all cursor-pointer">
                                <i class="fas fa-file-code text-indigo-400"></i>
                                <span>Unduh SQL Saja (Merge)</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 3: HOST INDUK RECEIVER (UNGGAH PAKET .ZIP / .SQL & BERSIHKAN DATA) -->
        <div id="tab-host-receiver" class="hidden space-y-4">
            <div class="bg-slate-800/50 rounded-2xl p-5 border border-slate-700/60">
                <div class="flex items-start justify-between gap-4 mb-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-lg">
                            <i class="fas fa-server"></i>
                        </div>
                        <div>
                            <h3 class="text-sm font-bold text-white">Panel Penerima Host Induk (Impor Paket .zip / .sql &amp; Pembersihan)</h3>
                            <p class="text-xs text-slate-400">Jalankan di server Host Induk untuk menerapkan paket sinkronisasi beserta berkas lampiran</p>
                        </div>
                    </div>
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                        Host Receiver
                    </span>
                </div>

                <form method="post" asp-action="UploadAndSyncPackage" asp-controller="Configuration" enctype="multipart/form-data" id="form-upload-package-sync" class="space-y-4">
                    @Html.AntiForgeryToken()

                    <!-- File Dropzone Input -->
                    <div class="border-2 border-dashed border-slate-700 hover:border-emerald-500 rounded-2xl p-6 text-center transition-all bg-slate-900/60 cursor-pointer"
                         onclick="document.getElementById('packageFileInput').click()">
                        <i class="fas fa-cloud-upload-alt text-3xl text-emerald-400 mb-2"></i>
                        <h4 class="text-xs font-bold text-slate-200" id="packageFileLabel">Pilih atau Drag &amp; Drop berkas paket (.zip) atau naskah SQL (.sql) dari Child</h4>
                        <p class="text-[11px] text-slate-400 mt-1">Mendukung berkas paket lengkap .zip (SQL + Folder Uploads) atau berkas naskah .sql</p>
                        <input type="file" id="packageFileInput" name="packageFile" accept=".zip,.sql" class="hidden" onchange="handlePackageFileSelect(this)" required>
                    </div>

                    <!-- Options Checkbox -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 bg-slate-900/80 p-4 rounded-xl border border-slate-800 text-xs">
                        <label class="flex items-start gap-2.5 cursor-pointer select-none">
                            <input type="checkbox" name="cleanBeforeSync" value="true" checked class="mt-0.5 rounded text-emerald-500 focus:ring-emerald-400">
                            <div>
                                <span class="text-slate-200 font-bold block">1. Bersihkan Data Lama (Clean Slate)</span>
                                <span class="text-slate-400 text-[11px]">Membersihkan data transaksi lama di Host Induk sebelum menerapkan paket.</span>
                            </div>
