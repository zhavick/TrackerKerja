@{
    ViewData["Title"] = "Kalender Tugas";
}

<div class="bg-white rounded-2xl shadow-sm border border-indigo-100 overflow-hidden">
    <!-- Calendar Header -->
    <div class="p-5 border-b border-slate-100 flex items-center justify-between flex-wrap gap-3">
        <h3 class="font-bold text-slate-800 flex items-center gap-2">
            <i class="fas fa-calendar-alt text-indigo-500"></i>
            Kalender Tugas
        </h3>
        <div class="flex items-center gap-3 flex-wrap">
            <!-- Legend -->
            <div class="flex items-center gap-3 text-xs">
                <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span> Selesai</span>
                <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-indigo-500 inline-block"></span> In Progress</span>
                <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-amber-400 inline-block"></span> Pending</span>
                <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-red-500 inline-block"></span> Terlambat</span>
            </div>
            <a href="/Task/Create" class="bg-gradient-to-r from-indigo-500 to-purple-600 text-white text-xs font-semibold px-4 py-2 rounded-lg hover:shadow-md transition-all">
                <i class="fas fa-plus mr-1"></i>Tugas Baru
            </a>
        </div>
    </div>

    <!-- Overlap Warning -->
    <div id="overlap-warning" class="hidden mx-5 mt-4 p-3 bg-amber-50 border border-amber-200 rounded-xl text-sm text-amber-700 flex items-center gap-2">
        <i class="fas fa-exclamation-triangle text-amber-500"></i>
        <span id="overlap-message">Terdeteksi tugas yang beririsan jadwal!</span>
    </div>

    <!-- Calendar Container -->
    <div class="p-5">
        <div id="calendar"></div>
    </div>
</div>

<!-- Task Detail Modal -->
<div id="task-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 slide-in">
        <div class="flex items-center justify-between mb-4">
            <h3 class="font-bold text-slate-800 text-lg" id="modal-title">Detail Tugas</h3>
            <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div id="modal-content" class="space-y-3 text-sm text-slate-600"></div>
        <div class="flex gap-2 mt-5">
            <a id="modal-edit-link" href="#" class="flex-1 bg-gradient-to-r from-indigo-500 to-purple-600 text-white text-center py-2.5 rounded-xl font-semibold text-sm hover:shadow-md transition-all">
                <i class="fas fa-edit mr-1"></i>Edit Tugas
            </a>
            <button onclick="closeModal()" class="px-4 py-2.5 border border-slate-200 rounded-xl text-slate-600 text-sm hover:border-indigo-300 transition-colors">
                Tutup
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    const calendarEl = document.getElementById('calendar');
    let allEvents = [];

    const isMobile = window.innerWidth < 768;
    const calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: isMobile ? 'dayGridMonth' : 'dayGridMonth',
        locale: 'id',
        headerToolbar: isMobile ? {
            left: 'prev,next today',
            center: 'title',
            right: 'dayGridMonth,listWeek'
        } : {
            left: 'prev,next today',
            center: 'title',
            right: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek'
        },
        editable: true,
        eventSources: [{
            url: '/Calendar/GetEvents',
            method: 'GET',
            failure: function() { console.error('Failed to load events'); }
        }],
        eventsSet: function(events) {
            allEvents = events;
            detectOverlaps(events);
        },
        eventClick: function(info) {
            showModal(info.event);
        },
        eventDrop: async function(info) {
            const res = await fetch('/Calendar/UpdateTaskDate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ taskId: info.event.id, newDate: info.event.startStr })
            });
            const data = await res.json();
            if (!data.success) info.revert();
        },
        eventDidMount: function(info) {
            info.el.title = `${info.event.title} | ${info.event.extendedProps.status} | ${info.event.extendedProps.priority}`;
        }
    });

    calendar.render();

    function detectOverlaps(events) {
        const overlaps = [];
        for (let i = 0; i < events.length; i++) {
            for (let j = i + 1; j < events.length; j++) {
                const a = events[i], b = events[j];
                if (a.start && b.start) {
                    const aStart = a.start.getTime(), aEnd = (a.end || a.start).getTime();
                    const bStart = b.start.getTime(), bEnd = (b.end || b.start).getTime();
                    if (aStart < bEnd && aEnd > bStart) {
                        overlaps.push(`"${a.title}" & "${b.title}"`);
                    }
                }
            }
        }
        const warning = document.getElementById('overlap-warning');
        if (overlaps.length > 0) {
            warning.classList.remove('hidden');
            document.getElementById('overlap-message').textContent = `⚠️ ${overlaps.length} tugas beririsan jadwal: ${overlaps.slice(0,2).join(', ')}${overlaps.length > 2 ? ` dan ${overlaps.length-2} lainnya` : ''}`;
        } else {
            warning.classList.add('hidden');
        }
    }

    function showModal(event) {
        document.getElementById('modal-title').textContent = event.title;
        document.getElementById('modal-edit-link').href = event.url || '#';
        const props = event.extendedProps;
        document.getElementById('modal-content').innerHTML = `
            <div class="flex items-center gap-2 p-3 rounded-xl" style="background:${event.backgroundColor}22">
                <span class="w-3 h-3 rounded-full" style="background:${event.backgroundColor}"></span>
                <span class="font-semibold" style="color:${event.backgroundColor}">${props.status}</span>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div class="p-3 bg-slate-50 rounded-xl">
                    <p class="text-xs text-slate-400">Prioritas</p>
                    <p class="font-semibold text-slate-700">${props.priority}</p>
                </div>
                <div class="p-3 bg-slate-50 rounded-xl">
                    <p class="text-xs text-slate-400">Proyek</p>
                    <p class="font-semibold text-slate-700">${props.projectName || '-'}</p>
                </div>
            </div>
            ${event.start ? `<div class="p-3 bg-indigo-50 rounded-xl"><p class="text-xs text-indigo-400">Deadline</p><p class="font-semibold text-indigo-700">${event.start.toLocaleDateString('id-ID', {weekday:'long', day:'numeric', month:'long', year:'numeric'})}</p></div>` : ''}
        `;
        document.getElementById('task-modal').classList.remove('hidden');
    }

    window.closeModal = function() {
        document.getElementById('task-modal').classList.add('hidden');
    }

    document.getElementById('task-modal').addEventListener('click', function(e) {
        if (e.target === this) closeModal();
    });
});
</script>
}
