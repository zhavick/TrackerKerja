@model TrackerKerja.Models.Project
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Proyek" : "Proyek Baru";
    var colors = new[] { "#6366F1","#06B6D4","#10B981","#F59E0B","#EF4444","#8B5CF6","#EC4899" };
}

<div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-2xl shadow-sm border border-indigo-100 overflow-hidden">
        <div class="bg-gradient-to-r from-amber-400 to-orange-500 p-6">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center">
                    <i class="fas @(isEdit ? "fa-edit" : "fa-folder-plus") text-white"></i>
                </div>
                <div>
                    <h2 class="text-white font-bold text-lg">@(isEdit ? "Edit Proyek" : "Buat Proyek Baru")</h2>
                    <p class="text-orange-100 text-sm">@(isEdit ? "Perbarui informasi proyek" : "Tambahkan proyek baru")</p>
                </div>
            </div>
        </div>

        <div class="p-6">
            <form method="post" action="@(isEdit ? $"/Project/Edit/{Model.Id}" : "/Project/Create")">
                @Html.AntiForgeryToken()
                @if (isEdit) { <input type="hidden" name="Id" value="@Model.Id" /> }

                <div class="mb-5">
                    <label class="block text-sm font-semibold text-slate-700 mb-2">
                        <i class="fas fa-folder text-amber-400 mr-2"></i>Nama Proyek <span class="text-red-500">*</span>
                    </label>
                    <input type="text" name="Name" value="@Model.Name" required
                           class="w-full px-4 py-3 rounded-xl border border-indigo-200 focus:outline-none focus:ring-2 focus:ring-amber-400 text-slate-800 transition-all">
                </div>

                <div class="mb-5">
                    <label class="block text-sm font-semibold text-slate-700 mb-2">
                        <i class="fas fa-align-left text-amber-400 mr-2"></i>Deskripsi
                    </label>
                    <textarea name="Description" rows="3"
                              class="w-full px-4 py-3 rounded-xl border border-indigo-200 focus:outline-none focus:ring-2 focus:ring-amber-400 text-slate-800 transition-all resize-none">@Model.Description</textarea>
                </div>

                <div class="grid grid-cols-2 gap-4 mb-5">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">
                            <i class="fas fa-palette text-amber-400 mr-2"></i>Warna
                        </label>
                        <div class="flex items-center gap-3">
                            <input type="color" name="Color" value="@(string.IsNullOrEmpty(Model.Color) ? "#6366F1" : Model.Color)"
                                   class="w-12 h-12 rounded-xl border border-indigo-200 cursor-pointer">
                            <div class="flex gap-2 flex-wrap">
                                @foreach (var color in colors)
                                {
                                    <button type="button" onclick="document.querySelector('[name=Color]').value='@color'"
                                            class="w-7 h-7 rounded-full border-2 border-white shadow-sm hover:scale-110 transition-transform"
                                            style="background:@color"></button>
                                }
                            </div>
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">
                            <i class="fas fa-toggle-on text-amber-400 mr-2"></i>Status
                        </label>
                        <select name="Status" class="select2 w-full" data-placeholder="Pilih Status">
                            @if (Model.Status == TrackerKerja.Models.ProjectStatus.Active)
                            { <option value="Active" selected>🟢 Active</option> }
                            else { <option value="Active">🟢 Active</option> }
                            @if (Model.Status == TrackerKerja.Models.ProjectStatus.Completed)
                            { <option value="Completed" selected>✅ Completed</option> }
                            else { <option value="Completed">✅ Completed</option> }
                            @if (Model.Status == TrackerKerja.Models.ProjectStatus.Archived)
                            { <option value="Archived" selected>📦 Archived</option> }
                            else { <option value="Archived">📦 Archived</option> }
                        </select>
                    </div>
                </div>

                <div class="mb-6">
                    <label class="block text-sm font-semibold text-slate-700 mb-2">
                        <i class="fas fa-calendar text-amber-400 mr-2"></i>Deadline
                    </label>
                    <input type="date" name="Deadline" value="@(Model.Deadline?.ToString("yyyy-MM-dd"))"
                           class="w-full px-4 py-3 rounded-xl border border-indigo-200 focus:outline-none focus:ring-2 focus:ring-amber-400 text-slate-700">
                </div>

                <div class="flex gap-3">
                    <button type="submit"
                            class="flex-1 bg-gradient-to-r from-amber-400 to-orange-500 text-white font-semibold py-3 rounded-xl hover:shadow-lg transition-all">
                        <i class="fas @(isEdit ? "fa-save" : "fa-plus") mr-2"></i>
                        @(isEdit ? "Simpan" : "Buat Proyek")
                    </button>
                    <a href="/Project" class="px-6 py-3 rounded-xl border border-slate-200 text-slate-600 hover:border-amber-300 font-medium transition-all">Batal</a>
                </div>
            </form>
        </div>
    </div>
</div>
