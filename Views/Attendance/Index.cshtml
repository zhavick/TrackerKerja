@model TrackerKerja.ViewModels.AttendanceIndexViewModel
@{
    ViewData["Title"] = "Presensi & Kelola Cuti";

    string[] monthNames = { "", "Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember" };
    string[] dayNamesIndo = { "Minggu", "Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu" };
    var today = DateTime.Today;
    var currentDayIndo = dayNamesIndo[(int)today.DayOfWeek];
}

<!-- Top Header & Actions -->
<div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4 mb-6">
    <div>
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-teal-500 to-emerald-600 flex items-center justify-center text-white shadow-md shadow-teal-200">
                <i class="fas fa-clipboard-user text-lg"></i>
            </div>
            <div>
                <h1 class="text-2xl font-black text-slate-800 tracking-tight">Presensi & Kelola Cuti</h1>
                <p class="text-xs text-slate-500 font-medium">Pencatatan jam kedatangan, jam pulang, cuti & izin karyawan (data pendukung Timesheet)</p>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-wrap items-center gap-2.5">
        <a href="/Timesheet" class="flex items-center gap-2 bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 text-xs font-bold px-3.5 py-2.5 rounded-2xl shadow-xs hover:border-indigo-300 hover:text-indigo-600 transition-all">
            <i class="fas fa-user-clock text-indigo-500 text-sm"></i>
            <span>Buka Timesheet</span>
        </a>

        <a href="/Attendance/ExportExcel?month=@Model.Month&year=@Model.Year&memberId=@Model.SelectedMemberId"
           class="flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-3.5 py-2.5 rounded-2xl shadow-md shadow-emerald-200 transition-all cursor-pointer"
           title="Unduh Rekapitulasi Presensi (.xlsx)">
            <i class="fas fa-file-excel text-sm"></i>
            <span>Export Excel</span>
        </a>

        <button type="button" onclick="openLeaveModal()"
                class="flex items-center gap-2 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white text-xs font-bold px-3.5 py-2.5 rounded-2xl shadow-md shadow-amber-200 transition-all cursor-pointer">
            <i class="fas fa-umbrella-beach"></i>
            <span>Ajukan Cuti / Izin</span>
        </button>

        <button type="button" onclick="openManualAttendanceModal()"
                class="flex items-center gap-2 bg-gradient-to-r from-teal-500 to-emerald-600 hover:from-teal-600 hover:to-emerald-700 text-white text-xs font-bold px-4 py-2.5 rounded-2xl shadow-md shadow-teal-200 transition-all cursor-pointer">
            <i class="fas fa-plus"></i>
            <span>Catat Manual</span>
        </button>
    </div>
</div>

<!-- Widget Status Kehadiran Hari Ini (Real-time Clock-In/Clock-Out Card) -->
<div class="bg-gradient-to-br from-white via-slate-50/70 to-teal-50/30 rounded-3xl p-5 sm:p-6 border border-teal-100 shadow-sm mb-6 relative overflow-hidden">
    <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6 relative z-10">
        <!-- User & Date Info -->
        <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-teal-600 text-white flex items-center justify-center text-xl shadow-md shadow-teal-200 flex-shrink-0">
                <i class="fas fa-calendar-check"></i>
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <span class="text-xs font-extrabold text-teal-700 uppercase tracking-wider bg-teal-100 px-2.5 py-0.5 rounded-full">
                        @currentDayIndo, @today.ToString("dd MMMM yyyy")
                    </span>
                    <span class="text-xs text-slate-400 font-mono" id="live-digital-clock">@DateTime.Now.ToString("HH:mm:ss")</span>
                </div>
                <h3 class="text-lg font-black text-slate-800 mt-1">Status Presensi Anda Hari Ini</h3>
                <p class="text-xs text-slate-500">
                    Akun: <strong>@Model.CurrentUser?.FullName</strong> (@Model.CurrentUser?.JobTitle)
                </p>
            </div>
        </div>

        <!-- Clock-In / Clock-Out Interaction Panel -->
        <div class="w-full lg:w-auto">
            @if (Model.TodayRecord == null)
            {
                <!-- BELUM CLOCK-IN -->
                <form method="post" action="/Attendance/ClockIn" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 bg-white p-3.5 rounded-2xl border border-slate-200/90 shadow-xs">
                    @Html.AntiForgeryToken()
                    <div class="flex items-center gap-2 min-w-[170px]">
                        <label class="text-xs font-bold text-slate-700 whitespace-nowrap">Lokasi:</label>
                        <select name="location" class="select2 select2-compact w-full" data-placeholder="Pilih Lokasi">
                            <option value="WFO">🏢 Kantor (WFO)</option>
                            <option value="WFH">🏠 Rumah (WFH)</option>
                            <option value="Dinas">✈️ Dinas Luar</option>
                            <option value="Remote">🌐 Remote</option>
                        </select>
                    </div>
                    <input type="text" name="notes" placeholder="Catatan opsional..." class="text-xs px-3 py-2 rounded-xl border border-slate-200 text-slate-800 focus:ring-2 focus:ring-teal-400 focus:outline-none w-full sm:w-48 bg-slate-50/50" />
                    <button type="submit" class="flex items-center justify-center gap-2 bg-gradient-to-r from-teal-500 to-emerald-600 hover:from-teal-600 hover:to-emerald-700 text-white font-black text-xs px-5 py-2.5 rounded-xl shadow-md shadow-teal-200 hover:shadow-teal-300 transition-all cursor-pointer">
                        <i class="fas fa-sign-in-alt"></i>
                        <span>Catat Jam Masuk (Clock-In)</span>
                    </button>
                </form>
            }
            else if (Model.TodayRecord.Type == TrackerKerja.Models.AttendanceType.Present)
            {
                if (!Model.TodayRecord.ClockOut.HasValue)
                {
                    <!-- SUDAH CLOCK-IN, BELUM CLOCK-OUT -->
                    <form method="post" action="/Attendance/ClockOut" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 bg-white p-3.5 rounded-2xl border border-teal-200 shadow-xs">
                        @Html.AntiForgeryToken()
                        <div class="flex items-center gap-2 text-xs">
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                            <span class="text-slate-500">Jam Masuk:</span>
                            <strong class="font-mono text-emerald-700 font-black text-sm">@Model.TodayRecord.ClockIn?.ToString("HH:mm")</strong>
                            <span class="text-slate-400 font-bold">(@Model.TodayRecord.WorkLocation)</span>
                        </div>
                        <input type="text" name="notes" placeholder="Catatan kepulangan..." class="text-xs px-3 py-2 rounded-xl border border-slate-200 text-slate-800 focus:ring-2 focus:ring-teal-400 focus:outline-none w-full sm:w-48 bg-slate-50/50" />
                        <button type="submit" class="flex items-center justify-center gap-2 bg-gradient-to-r from-orange-500 to-amber-600 hover:from-orange-600 hover:to-amber-700 text-white font-black text-xs px-5 py-2.5 rounded-xl shadow-md shadow-orange-200 transition-all cursor-pointer">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Catat Jam Pulang (Clock-Out)</span>
                        </button>
                    </form>
                }
                else
                {
                    <!-- SUDAH LENGKAP CLOCK-IN & CLOCK-OUT -->
                    <div class="flex flex-wrap items-center gap-3 bg-white p-3 rounded-2xl border border-emerald-200 shadow-xs">
                        <div class="flex items-center gap-2 text-xs">
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                            <span class="text-slate-500">Hadir:</span>
                            <strong class="font-mono text-slate-800 font-bold">@Model.TodayRecord.ClockIn?.ToString("HH:mm") — @Model.TodayRecord.ClockOut?.ToString("HH:mm")</strong>
                            <span class="text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded-md">(@Model.TodayRecord.WorkLocation)</span>
                        </div>
                        <div class="text-xs font-black text-slate-700 bg-slate-100 px-3 py-1 rounded-xl">
                            Durasi: <span class="text-teal-700">@Model.TodayRecord.DurationFormatted</span> (@Model.TodayRecord.TotalHours jam)
                        </div>
                        <button type="button" onclick="editAttendanceRecord(@Model.TodayRecord.Id, '@Model.TodayRecord.UserId', '@Model.TodayRecord.Date.ToString("yyyy-MM-dd")', '@((int)Model.TodayRecord.Type)', '@((int)Model.TodayRecord.WorkLocation)', '@Model.TodayRecord.ClockIn?.ToString("HH:mm")', '@Model.TodayRecord.ClockOut?.ToString("HH:mm")', '@Model.TodayRecord.LeaveReason', '@Model.TodayRecord.Notes')"
                                class="text-xs font-bold text-teal-600 hover:text-teal-800 underline px-2 py-1">
                            Koreksi Jam
                        </button>
                    </div>
                }
            }
            else
            {
                <!-- SEDANG CUTI / IZIN HARI INI -->
                <div class="flex items-center gap-3 bg-amber-50 border border-amber-200 p-3 rounded-2xl text-xs text-amber-900">
                    <i class="fas fa-info-circle text-amber-600 text-base"></i>
                    <div>
                        <p class="font-black">Hari Ini Tercatat: @Model.TodayRecord.TypeDisplayName</p>
                        <p class="text-[11px] text-amber-700/80">Keterangan: @(string.IsNullOrEmpty(Model.TodayRecord.Notes) ? "-" : Model.TodayRecord.Notes)</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Monthly Summary KPI Stats Cards -->
<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
    <!-- Total Hadir Card -->
    <div class="bg-white rounded-3xl p-5 border border-emerald-100 shadow-xs flex items-center justify-between">
        <div>
            <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Hari Hadir</p>
            <h3 class="text-2xl font-black text-emerald-600 mt-1 font-mono">@Model.TotalPresentDays <span class="text-sm font-semibold text-slate-400">hari</span></h3>
            <p class="text-[11px] text-slate-500 mt-0.5">WFO: <strong>@Model.TotalWfoDays</strong> | WFH: <strong>@Model.TotalWfhDays</strong></p>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-emerald-50 flex items-center justify-center text-emerald-600 text-xl shadow-xs">
            <i class="fas fa-building-user"></i>
        </div>
    </div>

    <!-- Total Cuti Card -->
    <div class="bg-white rounded-3xl p-5 border border-amber-100 shadow-xs flex items-center justify-between">
        <div>
            <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Cuti Digunakan</p>
            <h3 class="text-2xl font-black text-amber-600 mt-1 font-mono">@Model.TotalLeaveDays <span class="text-sm font-semibold text-slate-400">hari</span></h3>
            <p class="text-[11px] text-slate-500 mt-0.5">Bulan @monthNames[Model.Month]</p>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-amber-50 flex items-center justify-center text-amber-500 text-xl shadow-xs">
            <i class="fas fa-umbrella-beach"></i>
        </div>
    </div>

    <!-- Total Izin / Sakit Card -->
    <div class="bg-white rounded-3xl p-5 border border-rose-100 shadow-xs flex items-center justify-between">
        <div>
            <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Izin & Sakit</p>
            <h3 class="text-2xl font-black text-rose-600 mt-1 font-mono">@(Model.TotalSickDays + Model.TotalPermissionDays) <span class="text-sm font-semibold text-slate-400">hari</span></h3>
            <p class="text-[11px] text-slate-500 mt-0.5">Sakit: <strong>@Model.TotalSickDays</strong> | Izin: <strong>@Model.TotalPermissionDays</strong></p>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-rose-50 flex items-center justify-center text-rose-500 text-xl shadow-xs">
            <i class="fas fa-user-nurse"></i>
        </div>
    </div>

    <!-- Average Hours Card -->
    <div class="bg-white rounded-3xl p-5 border border-teal-100 shadow-xs flex items-center justify-between">
        <div>
            <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Rata-Rata Kehadiran</p>
            <h3 class="text-2xl font-black text-teal-600 mt-1 font-mono">@Model.AverageDailyHours <span class="text-sm font-semibold text-slate-400">jam/hari</span></h3>
            <p class="text-[11px] text-slate-500 mt-0.5">Total jam: <strong>@Model.TotalMonthHours j</strong></p>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-teal-50 flex items-center justify-center text-teal-600 text-xl shadow-xs">
            <i class="fas fa-stopwatch-20"></i>
        </div>
    </div>
</div>

<!-- Filters Bar -->
<div class="bg-white rounded-3xl p-4 border border-slate-200/80 shadow-xs mb-6">
    <form method="get" action="/Attendance" data-ajax-grid="true" data-target-grid="#ajaxGridContainer" class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-center">
        <!-- Month Selector -->
        <div class="sm:col-span-3">
            <select name="month" onchange="this.form.submit()" class="select2 select2-compact w-full" data-placeholder="Pilih Bulan">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(Model.Month == m)">@monthNames[m]</option>
                }
            </select>
        </div>

        <!-- Year Selector -->
        <div class="sm:col-span-2">
            <select name="year" onchange="this.form.submit()" class="select2 select2-compact w-full" data-placeholder="Pilih Tahun">
                @for (int y = DateTime.Today.Year - 2; y <= DateTime.Today.Year + 1; y++)
                {
                    <option value="@y" selected="@(Model.Year == y)">@y</option>
                }
            </select>
        </div>

        <!-- Type Filter -->
        <div class="sm:col-span-3">
            <select name="type" onchange="this.form.submit()" class="select2 select2-compact w-full" data-placeholder="Semua Status / Tipe">
                <option value="">Semua Status / Tipe</option>
                <option value="Present" selected="@(Model.SelectedType == "Present")">🟢 Hadir</option>
                <option value="Leave" selected="@(Model.SelectedType == "Leave")">🟡 Cuti</option>
                <option value="Sick" selected="@(Model.SelectedType == "Sick")">🔴 Sakit</option>
                <option value="Permission" selected="@(Model.SelectedType == "Permission")">🟣 Izin</option>
                <option value="BusinessTrip" selected="@(Model.SelectedType == "BusinessTrip")">🔵 Dinas Luar</option>
            </select>
        </div>

        <!-- Member Filter (Admin only or user lock) -->
        @if (Model.IsAdmin)
        {
            <div class="sm:col-span-3">
                <select name="memberId" onchange="this.form.submit()" class="select2 select2-compact w-full" data-placeholder="Pilih Karyawan">
                    <option value="all" selected="@(Model.SelectedMemberId == "all")">Semua Anggota Tim (All)</option>
                    @foreach (var member in Model.Members)
                    {
                        <option value="@member.Id" selected="@(Model.SelectedMemberId == member.Id)">@member.FullName</option>
                    }
                </select>
            </div>
        }
        else
        {
            <div class="sm:col-span-3">
                <input type="hidden" name="memberId" value="@Model.CurrentUser?.Id" />
                <div class="px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-600 truncate">
                    👤 @Model.CurrentUser?.FullName
                </div>
            </div>
        }

        <!-- Reset Button -->
        <div class="sm:col-span-1">
            <a href="/Attendance" class="w-full py-2 px-3 text-center text-xs font-bold text-slate-500 hover:text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors block" title="Reset Filter">
                <i class="fas fa-undo"></i>
            </a>
        </div>
    </form>
</div>

<!-- Attendance & Leaves Records Table -->
<div id="ajaxGridContainer" data-ajax-grid="true" class="ajax-grid-container bg-white rounded-3xl shadow-sm border border-slate-200/80 overflow-hidden mb-6">
    <div class="p-5 border-b border-slate-100 flex items-center justify-between flex-wrap gap-3">
        <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center text-sm font-bold">
                <i class="fas fa-list-check"></i>
            </div>
            <div>
                <h3 class="font-bold text-slate-800 text-sm">Riwayat Presensi & Cuti (@Model.Attendances.Count Rekaman)</h3>
                <p class="text-[11px] text-slate-400">Periode @monthNames[Model.Month] @Model.Year</p>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <span class="text-xs font-semibold px-3 py-1 bg-teal-50 text-teal-700 rounded-full">
                Total Hadir: @Model.TotalPresentDays Hari
            </span>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
            <thead>
                <tr class="bg-slate-50/80 border-b border-slate-200 text-slate-600 font-bold">
                    <th class="py-3.5 px-4 min-w-[140px]">Tanggal & Hari</th>
                    @if (Model.IsAdmin)
                    {
                        <th class="py-3.5 px-3 min-w-[150px]">Karyawan</th>
                    }
                    <th class="py-3.5 px-3 min-w-[130px]">Status / Tipe</th>
                    <th class="py-3.5 px-3 min-w-[100px]">Lokasi</th>
                    <th class="py-3.5 px-3 text-center min-w-[90px]">Jam Masuk</th>
                    <th class="py-3.5 px-3 text-center min-w-[90px]">Jam Pulang</th>
                    <th class="py-3.5 px-3 text-right min-w-[110px]">Durasi Hadir</th>
                    <th class="py-3.5 px-4 min-w-[200px]">Keterangan / Alasan</th>
                    <th class="py-3.5 px-3 text-center min-w-[80px]">Aksi</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (!Model.Attendances.Any())
                {
                    <tr>
                        <td colspan="@(Model.IsAdmin ? 9 : 8)" class="py-12 text-center text-slate-400">
                            <i class="fas fa-calendar-times text-3xl mb-2 block text-slate-300"></i>
                            <p class="font-semibold">Belum ada catatan presensi atau cuti pada periode ini.</p>
                            <p class="text-[11px] text-slate-400 mt-1">Gunakan tombol "Catat Manual" atau "Ajukan Cuti / Izin" untuk menambahkan data.</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Attendances)
                    {
                        var isToday = item.Date.Date == today;
                        <tr class="hover:bg-teal-50/20 transition-colors group @(isToday ? "bg-teal-50/40" : "")">
                            <!-- Tanggal & Hari -->
                            <td class="py-3.5 px-4">
                                <div class="flex items-center gap-2">
                                    <div class="font-bold text-slate-800 font-mono">
                                        @item.Date.ToString("dd MMM yyyy")
                                    </div>
                                    <span class="text-[10px] font-semibold text-slate-500 bg-slate-100 px-2 py-0.5 rounded-md">
                                        @dayNamesIndo[(int)item.Date.DayOfWeek]
                                    </span>
                                </div>
                            </td>

                            <!-- Karyawan (Admin view) -->
                            @if (Model.IsAdmin)
                            {
                                <td class="py-3.5 px-3">
                                    <div class="flex items-center gap-2">
                                        <div class="w-6 h-6 rounded-full bg-slate-200 text-slate-700 flex items-center justify-center font-bold text-[10px]"
                                             style="background-color: @(item.User?.AvatarColor ?? "#6366F1"); color: white;">
                                            @(item.User?.Initials ?? "?")
                                        </div>
                                        <span class="font-medium text-slate-800 truncate max-w-[130px]" title="@item.User?.FullName">
                                            @(item.User?.FullName ?? "-")
                                        </span>
                                    </div>
                                </td>
                            }

                            <!-- Status / Tipe -->
                            <td class="py-3.5 px-3">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl text-[11px] font-bold border @item.TypeBadgeColor">
                                    <i class="fas @item.TypeIcon text-[10px]"></i>
                                    <span>@item.TypeDisplayName</span>
                                </span>
                            </td>

                            <!-- Lokasi -->
                            <td class="py-3.5 px-3">
                                @if (item.Type == TrackerKerja.Models.AttendanceType.Present)
                                {
                                    <span class="text-xs font-semibold text-slate-700">@item.WorkLocation</span>
                                }
                                else
                                {
                                    <span class="text-slate-300">—</span>
                                }
                            </td>

                            <!-- Jam Masuk -->
                            <td class="py-3.5 px-3 text-center font-mono">
                                @if (item.ClockIn.HasValue)
                                {
                                    <span class="font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-lg">
                                        @item.ClockIn.Value.ToString("HH:mm")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-slate-300">—</span>
                                }
                            </td>

                            <!-- Jam Pulang -->
                            <td class="py-3.5 px-3 text-center font-mono">
                                @if (item.ClockOut.HasValue)
                                {
                                    <span class="font-bold text-slate-800 bg-slate-100 px-2 py-0.5 rounded-lg">
                                        @item.ClockOut.Value.ToString("HH:mm")
                                    </span>
                                }
                                else if (item.ClockIn.HasValue)
                                {
                                    <span class="text-[10px] font-bold text-amber-600 bg-amber-50 px-2 py-0.5 rounded-lg animate-pulse">
                                        Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="text-slate-300">—</span>
                                }
                            </td>

                            <!-- Durasi Hadir -->
                            <td class="py-3.5 px-3 text-right font-mono">
                                @if (item.TotalHours > 0)
                                {
                                    <span class="font-bold text-slate-800">
                                        @item.DurationFormatted <span class="text-[10px] text-slate-400">(@item.TotalHours j)</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="text-slate-300">—</span>
                                }
                            </td>

                            <!-- Keterangan / Alasan -->
                            <td class="py-3.5 px-4 text-slate-600">
                                @if (!string.IsNullOrEmpty(item.Notes))
                                {
                                    <span class="line-clamp-1" title="@item.Notes">@item.Notes</span>
                                }
                                else if (!string.IsNullOrEmpty(item.LeaveReason))
                                {
                                    <span class="line-clamp-1 text-slate-500 italic" title="@item.LeaveReason">@item.LeaveReason</span>
                                }
                                else
                                {
                                    <span class="text-slate-300">—</span>
                                }
                            </td>

                            <!-- Aksi -->
                            <td class="py-3.5 px-3 text-center">
                                <div class="flex items-center justify-center gap-1.5 opacity-80 group-hover:opacity-100 transition-opacity">
                                    <button type="button" onclick="editAttendanceRecord(@item.Id, '@item.UserId', '@item.Date.ToString("yyyy-MM-dd")', '@((int)item.Type)', '@((int)item.WorkLocation)', '@item.ClockIn?.ToString("HH:mm")', '@item.ClockOut?.ToString("HH:mm")', '@item.LeaveReason', '@item.Notes')"
                                            class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-teal-50 text-slate-500 hover:text-teal-600 flex items-center justify-center text-xs transition-colors" title="Koreksi / Edit">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <form method="post" action="/Attendance/Delete/@item.Id" class="inline"
                                          data-confirm="Apakah Anda yakin ingin menghapus catatan presensi/cuti tanggal @item.Date.ToString("dd MMM yyyy")?"
                                          data-confirm-title="Hapus Presensi"
                                          data-confirm-btn="<i class='fas fa-trash mr-1.5'></i>Ya, Hapus">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-red-50 text-slate-500 hover:text-red-600 flex items-center justify-center text-xs transition-colors" title="Hapus">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL 1: Catat Manual / Koreksi Jam Presensi -->
<div id="manualAttendanceModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4 z-50 animate-fadeIn">
    <div class="bg-white rounded-3xl p-6 w-full max-w-md shadow-2xl border border-slate-100">
        <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center font-bold">
                    <i class="fas fa-clock"></i>
                </div>
                <h4 class="font-bold text-slate-800 text-sm" id="manualModalTitle">Catat Presensi Harian Manual</h4>
            </div>
            <button type="button" onclick="closeManualModal()" class="text-slate-400 hover:text-slate-600">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <form method="post" action="/Attendance/SaveManual" id="manualAttendanceForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="manualId" value="0" />

            @if (Model.IsAdmin)
            {
                <div class="mb-3">
                    <label class="block text-xs font-bold text-slate-700 mb-1">Pilih Karyawan</label>
                    <select name="UserId" id="manualUserId" required class="select2 w-full">
                        @foreach (var m in Model.Members)
                        {
                            <option value="@m.Id" selected="@(m.Id == Model.CurrentUser?.Id)">@m.FullName</option>
                        }
                    </select>
                </div>
            }
            else
            {
                <input type="hidden" name="UserId" id="manualUserId" value="@Model.CurrentUser?.Id" />
            }

            <div class="mb-3">
                <label class="block text-xs font-bold text-slate-700 mb-1">Tanggal</label>
                <input type="date" name="Date" id="manualDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required
                       class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-800 focus:ring-2 focus:ring-teal-400 focus:outline-none">
            </div>

            <div class="grid grid-cols-2 gap-3 mb-3">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Tipe / Status</label>
                    <select name="Type" id="manualType" onchange="toggleManualTypeFields()" class="select2 w-full" data-placeholder="Pilih Tipe">
                        <option value="1">🟢 Hadir</option>
                        <option value="2">🟡 Cuti</option>
                        <option value="3">🔴 Sakit</option>
                        <option value="4">🟣 Izin</option>
                        <option value="5">🔵 Dinas Luar</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Lokasi Kerja</label>
                    <select name="WorkLocation" id="manualLocation" class="select2 w-full" data-placeholder="Pilih Lokasi">
                        <option value="1">WFO (Kantor)</option>
                        <option value="2">WFH (Rumah)</option>
                        <option value="3">Dinas Luar</option>
                        <option value="4">Remote</option>
                    </select>
                </div>
            </div>

            <div id="manualTimeFields" class="grid grid-cols-2 gap-3 mb-3">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Jam Masuk (Kedatangan)</label>
                    <input type="time" name="ClockInTime" id="manualClockIn" value="08:30"
                           class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-800 focus:ring-2 focus:ring-teal-400 focus:outline-none">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Jam Pulang</label>
                    <input type="time" name="ClockOutTime" id="manualClockOut" value="17:30"
                           class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-800 focus:ring-2 focus:ring-teal-400 focus:outline-none">
                </div>
            </div>

            <div class="mb-3" id="manualReasonField" style="display: none;">
                <label class="block text-xs font-bold text-slate-700 mb-1">Alasan Cuti / Keterangan Izin</label>
                <input type="text" name="LeaveReason" id="manualReason" placeholder="Misal: Cuti Tahunan / Izin Keluarga"
                       class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs text-slate-800 focus:ring-2 focus:ring-teal-400 focus:outline-none">
            </div>

            <div class="mb-5">
                <label class="block text-xs font-bold text-slate-700 mb-1">Catatan Tambahan</label>
                <input type="text" name="Notes" id="manualNotes" placeholder="Catatan pekerjaan atau keterangan"
                       class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs text-slate-800 focus:ring-2 focus:ring-teal-400 focus:outline-none">
            </div>

            <div class="flex items-center gap-2">
                <button type="submit" class="flex-1 bg-gradient-to-r from-teal-500 to-emerald-600 text-white font-bold py-2.5 rounded-xl text-xs shadow-md shadow-teal-200 transition-all cursor-pointer">
                    Simpan Presensi
                </button>
                <button type="button" onclick="closeManualModal()" class="px-4 py-2.5 border border-slate-200 text-slate-600 font-bold rounded-xl text-xs hover:bg-slate-50 transition-all">
                    Batal
                </button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL 2: Pengajuan Cuti / Izin (Rentang Tanggal) -->
<div id="leaveModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4 z-50 animate-fadeIn">
    <div class="bg-white rounded-3xl p-6 w-full max-w-md shadow-2xl border border-slate-100">
        <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold">
                    <i class="fas fa-umbrella-beach"></i>
                </div>
                <h4 class="font-bold text-slate-800 text-sm">Form Pengajuan Cuti & Izin</h4>
            </div>
            <button type="button" onclick="closeLeaveModal()" class="text-slate-400 hover:text-slate-600">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <form method="post" action="/Attendance/SubmitLeave">
            @Html.AntiForgeryToken()

            @if (Model.IsAdmin)
            {
                <div class="mb-3">
                    <label class="block text-xs font-bold text-slate-700 mb-1">Pilih Karyawan</label>
                    <select name="UserId" required class="select2 w-full">
                        @foreach (var m in Model.Members)
                        {
                            <option value="@m.Id" selected="@(m.Id == Model.CurrentUser?.Id)">@m.FullName</option>
                        }
                    </select>
                </div>
            }

            <div class="mb-3">
                <label class="block text-xs font-bold text-slate-700 mb-1">Jenis Pengajuan</label>
                <select name="Type" required class="select2 w-full" data-placeholder="Pilih Jenis Pengajuan">
                    <option value="2">🏖️ Cuti (Annual / Special Leave)</option>
                    <option value="3">🏥 Sakit (Medical Leave)</option>
                    <option value="4">📝 Izin Keperluan Pribadi</option>
                    <option value="5">✈️ Dinas Luar Kantor</option>
                </select>
            </div>

            <div class="grid grid-cols-2 gap-3 mb-3">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Dari Tanggal</label>
                    <input type="date" name="StartDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required
                           class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-800 focus:ring-2 focus:ring-amber-400 focus:outline-none">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Sampai Tanggal</label>
                    <input type="date" name="EndDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required
                           class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-800 focus:ring-2 focus:ring-amber-400 focus:outline-none">
                </div>
            </div>

            <div class="mb-3">
                <label class="block text-xs font-bold text-slate-700 mb-1">Alasan / Sub-Kategori</label>
                <input type="text" name="LeaveReason" value="Cuti Tahunan" required placeholder="Contoh: Cuti Tahunan, Sakit Demam, Urusan Keluarga"
                       class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-800 focus:ring-2 focus:ring-amber-400 focus:outline-none">
            </div>

            <div class="mb-5">
                <label class="block text-xs font-bold text-slate-700 mb-1">Catatan / Detail Tambahan</label>
                <textarea name="Notes" rows="2" placeholder="Catatan opsional atau keterangan serah terima tugas..."
                          class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs text-slate-800 focus:ring-2 focus:ring-amber-400 focus:outline-none"></textarea>
            </div>

            <div class="flex items-center gap-2">
                <button type="submit" class="flex-1 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white font-bold py-2.5 rounded-xl text-xs shadow-md shadow-amber-200 transition-all cursor-pointer">
                    Ajukan Cuti / Izin
                </button>
                <button type="button" onclick="closeLeaveModal()" class="px-4 py-2.5 border border-slate-200 text-slate-600 font-bold rounded-xl text-xs hover:bg-slate-50 transition-all">
                    Batal
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    // Real-time clock update
    setInterval(function() {
        const el = document.getElementById('live-digital-clock');
        if (el) {
            const now = new Date();
            const h = String(now.getHours()).padStart(2, '0');
            const m = String(now.getMinutes()).padStart(2, '0');
            const s = String(now.getSeconds()).padStart(2, '0');
            el.innerText = `${h}:${m}:${s}`;
        }
    }, 1000);

    function openManualAttendanceModal() {
        document.getElementById('manualId').value = "0";
        document.getElementById('manualModalTitle').innerText = "Catat Presensi Harian Manual";
        document.getElementById('manualDate').value = "@DateTime.Today.ToString("yyyy-MM-dd")";
        document.getElementById('manualType').value = "1";
        document.getElementById('manualLocation').value = "1";
        document.getElementById('manualClockIn').value = "08:30";
        document.getElementById('manualClockOut').value = "17:30";
        document.getElementById('manualReason').value = "";
        document.getElementById('manualNotes').value = "";
        toggleManualTypeFields();

        document.getElementById('manualAttendanceModal').classList.remove('hidden');
        if (typeof initAppSelect2 === 'function') {
            setTimeout(() => initAppSelect2('#manualAttendanceModal'), 50);
        }
    }

    function closeManualModal() {
        document.getElementById('manualAttendanceModal').classList.add('hidden');
    }

    function openLeaveModal() {
        document.getElementById('leaveModal').classList.remove('hidden');
        if (typeof initAppSelect2 === 'function') {
            setTimeout(() => initAppSelect2('#leaveModal'), 50);
        }
    }

    function closeLeaveModal() {
        document.getElementById('leaveModal').classList.add('hidden');
    }

    function toggleManualTypeFields() {
        const typeVal = document.getElementById('manualType').value;
        const timeFields = document.getElementById('manualTimeFields');
        const reasonField = document.getElementById('manualReasonField');
        const locField = document.getElementById('manualLocation').parentElement;

        if (typeVal === "1") {
            // Hadir
            timeFields.style.display = "grid";
            reasonField.style.display = "none";
            locField.style.display = "block";
        } else {
            // Cuti / Izin / Sakit
            timeFields.style.display = "none";
            reasonField.style.display = "block";
            locField.style.display = "none";
        }
    }

    function editAttendanceRecord(id, userId, dateStr, type, location, clockIn, clockOut, reason, notes) {
        document.getElementById('manualId').value = id;
        document.getElementById('manualModalTitle').innerText = "Koreksi / Edit Presensi";
        document.getElementById('manualDate').value = dateStr;
        document.getElementById('manualType').value = type;
        document.getElementById('manualLocation').value = location || "1";
        document.getElementById('manualClockIn').value = clockIn || "";
        document.getElementById('manualClockOut').value = clockOut || "";
        document.getElementById('manualReason').value = reason || "";
        document.getElementById('manualNotes').value = notes || "";

        if (document.getElementById('manualUserId')) {
            document.getElementById('manualUserId').value = userId;
            if ($(document.getElementById('manualUserId')).hasClass('select2-hidden-accessible')) {
                $(document.getElementById('manualUserId')).trigger('change');
            }
        }

        toggleManualTypeFields();
        document.getElementById('manualAttendanceModal').classList.remove('hidden');
    }
</script>
